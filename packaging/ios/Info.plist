        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- Schist draws its own chrome edge to edge and pads by the safe
         area; the status bar stays, over the title bar's colour. -->
    <key>UIViewControllerBasedStatusBarAppearance</key><true/>
    <key>UILaunchScreen</key><dict/>
    <!-- gpui's app delegate runs the scene lifecycle; the manifest names
         its scene delegate for the SDKs that insist on one. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array><dict>
                <key>UISceneConfigurationName</key><string>gpui</string>
                <key>UISceneDelegateClassName</key><string>GPUISceneDelegate</string>
            </dict></array>
        </dict>
    </dict>
    <!-- Stage Manager and Split View on iPad. -->
    <key>UIRequiresFullScreen</key><false/>
    <!-- The app's Documents folder is where the gallery looks and where
         saves land; both keys make it a folder in the Files app, and
         let documents opened from Files be edited where they are. -->
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <!-- Photos access: the gallery's import, and the camera-roll backup
         to Schist Cloud, which reads the library to find new photos. -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Schist imports photos from your library into its gallery, and backs up your camera roll to Schist Cloud when you turn that on.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Schist saves exported images to your photo library.</string>
    <!-- The camera-roll backup's background launch: iOS starts the app
         now and then, on a network, to upload what is new
         (crates/camera-sync/src/ios.rs). -->
    <key>UIBackgroundModes</key>
    <array><string>processing</string></array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array><string>com.infrawrench.schist.camera-sync</string></array>

