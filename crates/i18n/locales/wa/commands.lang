command.edit.undo.title = Disfé
command.edit.undo.description = Raler ene accion en erî dins l' istwere des disfaijhaedjes do documint.
command.edit.redo.title = Rifé
command.edit.redo.description = Rifé li dierin candjmint k' a stî disfait.
command.edit.copy.title = Copyî
command.edit.copy.description = Copyî les picsels tchoezis del coûtche en alaedje dins l' presse-papîs divintrin (tote li coûtche si rén n' est tchoezi).
command.edit.copy_merged.title = Copyî rafondou
command.edit.copy_merged.description = Copyî l' tchoezixhaedje come totes les coûtches veyåves el compôzèt, nén del seule coûtche en alaedje.
command.edit.cut.title = Côper
command.edit.cut.description = Copyî les picsels tchoezis e presse-papîs et les disfacer del coûtche en alaedje.
command.edit.paste.title = Claper
command.edit.paste.description = Claper l' presse-papîs dins ene novele coûtche å dzeu del coûtche en alaedje, å mitan do tåvlea.
command.edit.paste.layer_name = Coûtche clapêye
command.edit.paste_in_place.title = Claper al minme plaece
command.edit.paste_in_place.description = Claper l' presse-papîs dins ene novele coûtche, ås coordonêyes ki l' contnou a stî copyî.
command.edit.fill_foreground.title = Rimpli avou l' coleur di dvant
command.edit.fill_foreground.description = Rimpli l' tchoezixhaedje (ou tot l' tåvlea si rén n' est tchoezi) avou l' coleur di dvant.
command.edit.fill_background.title = Rimpli avou l' coleur di drî
command.edit.fill_background.description = Rimpli l' tchoezixhaedje (ou tot l' tåvlea si rén n' est tchoezi) avou l' coleur di drî.
command.select.all.title = Tot tchoezi
command.select.all.description = Tchoezi tot l' tåvlea.
command.select.deselect.title = Distchoezi
command.select.deselect.description = Leyî toumer l' tchoezixhaedje, po k' les candjmints si metaxhe co so tote li coûtche.
command.select.inverse.title = Inviertixh li tchoezixhaedje
command.select.inverse.description = Discandjî les redjons tchoezeyes et nén tchoezeyes.
command.select.reselect.title = Ritchoezi
command.select.reselect.description = Rimete li dierin tchoezixhaedje leyî toumer.
command.select.reselect.msg.nothing_to_reselect = Rén a ritchoezi
command.select.feather.title = Adoûci les boirds do tchoezixhaedje
command.select.feather.description = Adoûci l' boird do tchoezixhaedje avou on flou di deus picsels, po k' li candjmint shuvant disparexhe doirmint sol boird.
command.select.grow.title = Agrandi
command.select.grow.description = Astinde li tchoezixhaedje dins les picsels loyîs ki rshonnèt a çou k' est dedja tchoezi, sorlon l' tolerince do baston madjike.
command.select.similar.title = Rimshonnant
command.select.similar.description = Tchoezi tos les picsels del coûtche ki rshonnèt å tchoezixhaedje, k' i soeyexhe loyîs ou nén, sorlon l' tolerince do baston madjike.
command.select.save.title = Schaper l' tchoezixhaedje
command.select.save.description = Wårder l' tchoezixhaedje do moumint e documint come on canå alfa lomé.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Tcherdjî on tchoezixhaedje
command.select.load.description = Rimete li dierin tchoezixhaedje schapé.
command.layer.new.title = Novele coûtche
command.layer.new.description = Radjouter ene coûtche raster vude å dzeu del coûtche en alaedje et l' mete en alaedje.
command.layer.duplicate.title = Dobler l' coûtche
command.layer.duplicate.description = Copyî l' coûtche en alaedje, avou tot çou k' i gn a dvins, dins ene novele coûtche å dzeu.
command.layer.smart_object.title = Covierser e cayet malén
command.layer.smart_object.description = Mete les picsels del coûtche raster en alaedje dins on cayet malén, po k' les candjmints et passetes shuvantes resamplexhe li sourçaedje nén candjî.
command.layer.rasterize.title = Rasterizer l' coûtche
command.layer.rasterize.description = Candjî ene coûtche di fôme, di scrijhaedje ou di cayet malén e simpes picsels.
command.layer.delete.title = Disfacer l' coûtche
command.layer.delete.description = Disfacer les coûtches tchoezeyes.
command.layer.group.title = Grouper les coûtches
command.layer.group.description = Mete les coûtches tchoezeyes dins on novea groupe al minme plaece.
command.layer.raise.title = Monter d' ene plaece
command.layer.raise.description = Monter l' coûtche en alaedje d' ene plaece dins l' trosse di si groupe.
command.layer.lower.title = Dischinde d' ene plaece
command.layer.lower.description = Dischinde l' coûtche en alaedje d' ene plaece dins l' trosse di si groupe.
command.layer.to_front.title = Mete tot al copete
command.layer.to_front.description = Mete li coûtche en alaedje al copete di si groupe.
command.layer.to_back.title = Mete tot å fond
command.layer.to_back.description = Mete li coûtche en alaedje å fond di si groupe.
command.layer.clipping_mask.title = Ahiver/Disfé l' måsse di côpaedje
command.layer.clipping_mask.description = Côper l' coûtche en alaedje sorlon l' cisse pa dzo, ou l' disfé si c' est dedja l' cas; ene coûtche côpêye ni s' mostere ki wice ki s' båze a des picsels.
command.layer.cut_to_new.title = Coûtche pa côpaedje
command.layer.cut_to_new.description = Oister les picsels tchoezis del coûtche en alaedje et les mete dins ene novele coûtche å dzeu.
command.layer.cut_to_new.layer_name = Coûtche pa côpaedje
command.layer.add_mask.title = Radjouter on måsse di coûtche
command.layer.add_mask.description = Radjouter on måsse al coûtche en alaedje, ki n' mostere ki l' tchoezixhaedje si gn a onk.
command.layer.flatten.title = Raplati l' imådje
command.layer.flatten.description = Compôzer tot çou k' est veyåve dins ene seule coûtche di drî opake et rnoncî ås coûtches catchêyes.
command.layer.merge_down.title = Rafonde avou l' coûtche pa dzo
command.layer.merge_down.description = Compôzer l' coûtche en alaedje dins l' coûtche pa dzo.
command.layer.merge_down.msg.no_layer_below = Nole coûtche pa dzo pol rafonde
command.layer.merge_visible.title = Rafonde les coûtches veyåves
command.layer.merge_visible.description = Compôzer totes les coûtches veyåves dins ene seule, sins candjî les coûtches catchêyes.
command.msg.nothing_to_copy = Tchoezixhoz ene coûtche di picsels pol copyî
