tool.brush.name = Pincea
tool.brush.description = Pondez ene roye ås boirds doûs el coleur di dvant, al grandeu, dureté et opacité do pincea apontyîs e candjeu.
tool.brush.history.stroke = Pincea
tool.pencil.name = Croyon
tool.pencil.description = Pondez ene roye ås boirds deurs et sins anticlintchaedje el coleur di dvant.
tool.pencil.history.stroke = Croyon
tool.eraser.name = Gome
tool.eraser.description = Disfacez tot shuvant l' roye, po rimete li coûtche al transparince.
tool.eraser.history.stroke = Gome
tool.clone.name = Tampon di clonaedje
tool.clone.description = Tampon di clonaedje: Alt-clitchîz po defini l' pont sourçaedje, poy pondez les picsels copyîs di ç' pont la avou l' minme dismetaedje.
tool.clone.history.stroke = Tampon di clonaedje
tool.dodge.name = Esclairixheu
tool.dodge.description = Esclairixhoz les picsels ki l' roye passe pa dzeu.
tool.dodge.history.stroke = Esclairixheu
tool.burn.name = Assombrixheu
tool.burn.description = Assombrixhoz les picsels ki l' roye passe pa dzeu.
tool.burn.history.stroke = Assombrixheu
tool.sponge.name = Spongne
tool.sponge.description = Saturez ou disaturez les picsels ki l' roye passe pa dzeu.
tool.sponge.history.stroke = Spongne
tool.blur.name = Flou
tool.blur.description = Rindez moens nets les picsels ki l' roye passe pa dzeu.
tool.blur.history.stroke = Flou
tool.sharpen.name = Rinde net
tool.sharpen.description = Rindez pus nets les picsels ki l' roye passe pa dzeu.
tool.sharpen.history.stroke = Rinde net
tool.smudge.name = Distinde
tool.smudge.description = Saetchîz l' coleur tot shuvant l' roye, come si vos botrîz del pondeure frèss.
tool.smudge.history.stroke = Distinde
tool.heal.name = Pincea rwareu
tool.heal.description = Pincea rwareu: Alt-clitchîz po defini l' sourçaedje, poy pondez; li tecsure do sourçaedje est maxhêye avou l' coleur et l' loumiere do destinaedje.
tool.heal.history.stroke = Pincea rwareu
tool.spot_heal.name = Pincea rwareu pontou
tool.spot_heal.description = Pincea rwareu pontou: pondez sol må et i s' replaece pa ene tecsure prinjhowe åtoû d' lu — nou pont sourçaedje a defini.
tool.spot_heal.history.stroke = Pincea rwareu pontou
tool.history_brush.name = Pincea d' istwere
tool.history_brush.description = Ripondez des picsels foû del copeye d' istwere do documint, po disfé les ovraedjes pus noûs roye pa roye.
tool.history_brush.history.stroke = Pincea d' istwere
tool.background_eraser.name = Gome di drî
tool.background_eraser.description = Disfacez l' coleur eshantiyonêye å mitan do pincea et leyîz les picsels diferins, po distaker on sudjet di s' fond.
tool.background_eraser.history.stroke = Gome di drî
tool.gradient.name = Fondou
tool.gradient.description = Saetchîz po rimpli l' coûtche — houte do tchoezixhaedje si gn a onk — avou on fondou lineyå del coleur di dvant al coleur di drî, sol direccion do saetchaedje.
tool.gradient.radial.name = Fondou riyonant
tool.gradient.radial.description = Saetchîz do mitan viè l' difoû po rimpli avou on fondou riyonant inte les coleurs di dvant et di drî.
tool.gradient.option.gradient = Fondou
tool.gradient.option.reverse = Å rvier
tool.gradient.option.dither = Tramaedje
tool.gradient.choice.foreground_to_background = Do dvant å drî
tool.gradient.choice.foreground_to_transparent = Do dvant al transparince
tool.gradient.choice.linear = Lineyå
tool.gradient.choice.radial = Riyonant
tool.gradient.choice.angle = Inglêye
tool.gradient.choice.reflected = Riflété
tool.gradient.choice.diamond = Diamant
tool.gradient.history.gradient = Fondou
tool.bucket.name = Seay d' pondeure
tool.bucket.description = Clitchîz po rimpli l' redjon loyeye del minme coleur pa dzo l' pwinteu avou l' coleur di dvant, sorlon l' tolerince di l' usteye.
tool.bucket.option.contiguous = A costé onk di l' ôte
tool.bucket.option.all_layers = Totes les coûtches
tool.bucket.history.fill = Seay d' pondeure
