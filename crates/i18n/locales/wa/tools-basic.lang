# Pipete
tool.eyedropper.name = Pipete
tool.eyedropper.description = Prinde on eshantiyon del coleur pa dzo l' pwinteu pol mete dins l' coleur di dvant, ou dins l' coleur di drî si Alt est tchôcî. Tant k' vos saetchîz, l' eshantiyonaedje continouwe.
