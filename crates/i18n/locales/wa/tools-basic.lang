# Mwin et zoumaedje
tool.hand.name = Mwin
tool.hand.description = Hosse li vuwe. Li camp veyou apårtént al finièsse; sins eterface grafike, ciste usteye ni candje rén e documint.
tool.zoom.name = Zoumaedje
tool.zoom.description = Agrandi ou rapetixhe li vuwe. Li camp veyou apårtént al finièsse; sins eterface grafike, ciste usteye ni candje rén e documint.
