# Lens profile controls.
lens_profiles.invalid = Kies 'n geldige Lensfun v1/v2 XML-databasis (tot 8 MiB) met ondersteunde kamera- of lensdata.
lens_profiles.calibration = Lenskalibrasie
lens_profiles.no_calibration = Geen kalibrasie dek hierdie instellings nie. Gaan brandpuntafstand en kamera-oesfaktor na; handmatige regstelling bly beskikbaar.
lens_profiles.import = Voer Lensfun XML in …
lens_profiles.imported = Lensfun-databasis is vir hierdie sessie ingevoer. Kies 'n profiel of pas by die foto-metadata.
lens_profiles.manual = Slegs handmatige regstelling
lens_profiles.saved = Gestoorde kalibrasie (databasis nie beskikbaar nie)
lens_profiles.profile = Lensprofiel
lens_profiles.aperture = Diafragma (0 = onbekend)
lens_profiles.distance = Fokusafstand (0 = onbekend)
lens_profiles.vignette = Gekalibreerde vignettering
lens_profiles.color_context = Gekalibreerde vignettering vereis die ingeboude sRGB-profiel. Skakel na sRGB om om voorkoms te behou, maak dan Lenskorreksie weer oop. Vir reeds-sRGB ongemerkte pieksels, is die toewysing van sRGB voldoende. Meetkunde en chromatiese regstelling bly beskikbaar.
lens_profiles.vignette_missing = Geen vignettering-kalibrasie dek die diafragma en fokusafstand nie. Voer gemete waardes in om dit te aktiveer; 1000 m verteenwoordig verre fokus in baie Lensfun-profiele.
lens_profiles.note = Gekalibreerde regstelling word voor die handmatige kontroles toegepas. Gebruik die oorspronklike volle raam; sny dit daarna uit. Stoor die filterstapel in PSD/PSB om die kalibrasie bewerkbaar te hou.
lens_profiles.automatic = Pas foto-metadata
lens_profiles.components = Profiel slaag: vervorming {distortion}; kleur rande {tca}; vignettering {vignette}.
