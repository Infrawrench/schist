command.edit.undo.title = Ontdoen
command.edit.undo.description = Gaan een inskrywing terug in die dokument se ontdoengeskiedenis.
command.edit.redo.title = Herdoen
command.edit.redo.description = Herhaal die wysiging wat laas ontdoen is.
command.edit.copy.title = Kopieer
command.edit.copy.description = Kopieer die aktiewe laag se geselekteerde pixels na die interne knipbord (die hele laag wanneer niks geselekteer is nie).
command.edit.copy_merged.title = Kopieer saamgevoeg
command.edit.copy_merged.description = Kopieer die seleksie soos al die sigbare lae dit saamstel, eerder as net uit die aktiewe laag.
command.edit.cut.title = Knip
command.edit.cut.description = Kopieer die geselekteerde pixels na die knipbord en vee hulle uit die aktiewe laag.
command.edit.paste.title = Plak
command.edit.paste.description = Plak die knipbord in 'n nuwe laag bo die aktiewe laag, gesentreer op die doek.
command.edit.paste.layer_name = Geplakte laag
command.edit.paste_in_place.title = Plak op plek
command.edit.paste_in_place.description = Plak die knipbord in 'n nuwe laag op die koördinate waarvandaan dit gekopieer is.
command.edit.fill_foreground.title = Vul met voorgrond
command.edit.fill_foreground.description = Vul die seleksie (of die hele doek wanneer niks geselekteer is nie) met die voorgrondkleur.
command.edit.fill_background.title = Vul met agtergrond
command.edit.fill_background.description = Vul die seleksie (of die hele doek wanneer niks geselekteer is nie) met die agtergrondkleur.

command.select.all.title = Selekteer alles
command.select.all.description = Selekteer die hele doek.
command.select.deselect.title = Ontselekteer
command.select.deselect.description = Verwyder die seleksie sodat wysigings weer op die hele laag toegepas word.
command.select.inverse.title = Keer seleksie om
command.select.inverse.description = Ruil geselekteerde en ongeselekteerde gebiede om.
command.select.reselect.title = Herselekteer
command.select.reselect.description = Herstel die seleksie wat laas verwyder is.
command.select.reselect.msg.nothing_to_reselect = Niks om te herselekteer nie
command.select.feather.title = Versag seleksie
command.select.feather.description = Versag die seleksie se rand met 'n vervaging van twee pixels sodat die volgende wysiging geleidelik daaroor uitdoof.
command.select.grow.title = Vergroot
command.select.grow.description = Brei die seleksie uit na aangrensende pixels wat binne die towerstaffie se toleransie lyk soos dit wat reeds geselekteer is.
command.select.similar.title = Soortgelyk
command.select.similar.description = Selekteer elke pixel in die laag wat binne die towerstaffie se toleransie soos die seleksie lyk, of dit daaraan raak of nie.
command.select.save.title = Stoor seleksie
command.select.save.description = Bêre die huidige seleksie as 'n benoemde alfakanaal in die dokument.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Laai seleksie
command.select.load.description = Herstel die seleksie wat die onlangsste gestoor is.

command.layer.new.title = Nuwe laag
command.layer.new.description = Voeg 'n leë rasterlaag bo die aktiewe laag by en maak dit aktief.
command.layer.duplicate.title = Dupliseer laag
command.layer.duplicate.description = Kopieer die aktiewe laag, met al sy inhoud, na 'n nuwe laag daarbo.
command.layer.smart_object.title = Skakel om na slimvoorwerp
command.layer.smart_object.description = Omhul die aktiewe rasterlaag se pixels in 'n slimvoorwerp sodat latere transformasies en filters die onaangeraakte bron hermonster.
command.layer.rasterize.title = Rasteriseer laag
command.layer.rasterize.description = Verwerk 'n vorm-, teks- of slimvoorwerplaag tot gewone pixels.
command.layer.delete.title = Skrap laag
command.layer.delete.description = Skrap die geselekteerde lae.
command.layer.group.title = Groepeer lae
command.layer.group.description = Plaas die geselekteerde lae op dieselfde plek in 'n nuwe groep.
command.layer.raise.title = Bring vorentoe
command.layer.raise.description = Skuif die aktiewe laag een plek op in sy groep se stapel.
command.layer.lower.title = Stuur agtertoe
command.layer.lower.description = Skuif die aktiewe laag een plek af in sy groep se stapel.
command.layer.to_front.title = Bring heel voor
command.layer.to_front.description = Skuif die aktiewe laag na die bokant van sy groep.
command.layer.to_back.title = Stuur heel agter
command.layer.to_back.description = Skuif die aktiewe laag na die onderkant van sy groep.
command.layer.clipping_mask.title = Skep/hef knipmasker op
command.layer.clipping_mask.description = Knip die aktiewe laag volgens die laag daaronder, of hef dit op as dit reeds geknip is; 'n geknipte laag verskyn net waar sy basis pixels bevat.
command.layer.cut_to_new.title = Laag via knip
command.layer.cut_to_new.description = Skuif die geselekteerde pixels uit die aktiewe laag na 'n nuwe laag daarbo.
command.layer.cut_to_new.layer_name = Laag via knip
command.layer.add_mask.title = Voeg laagmasker by
command.layer.add_mask.description = Voeg 'n laagmasker by die aktiewe laag wat slegs die seleksie wys wanneer daar een is.
command.layer.flatten.title = Plat beeld af
command.layer.flatten.description = Stel alles wat sigbaar is in een ondeursigtige Agtergrond-laag saam en verwerp versteekte lae.
command.layer.merge_down.title = Voeg afwaarts saam
command.layer.merge_down.description = Stel die aktiewe laag met die laag daaronder saam.
command.layer.merge_down.msg.no_layer_below = Geen laag daaronder om mee saam te voeg nie
command.layer.merge_visible.title = Voeg sigbare lae saam
command.layer.merge_visible.description = Stel elke sigbare laag in een laag saam en laat versteekte lae onaangeraak.

