# Puppet Warp
tool.puppet_warp.name = Murɗawar 'Yar Tsana
tool.puppet_warp.description = Danna don kafa shimfiɗa da fil a wurare kaɗan, sannan ja ɗaya: ragar tana tanƙwara kewaye da fil ɗin, da tauri ko sassauci kamar yadda zaɓin Tauri ya nuna. Tabbatarwa tana aiwatar da shi.
tool.puppet_warp.option.stiffness = Tauri
tool.puppet_warp.history.puppet_warp = Murɗawar 'Yar Tsana

# Vanishing Point
tool.vanishing_point.name = Wurin Ɓacewa
tool.vanishing_point.description = Ja wani fili a kan abin da ke da hangen nesa, sannan sauya yanayin zuwa Kwafi ka yi fenti: pixels da aka kwafa suna bin filin, suna ƙanƙanta da nisa.
tool.vanishing_point.choice.edit_plane = Gyara Fili
tool.vanishing_point.choice.clone = Kwafi
tool.vanishing_point.history.vanishing_point = Wurin Ɓacewa
