tool.spot_heal.name = Burushin Warkar da Tabo
tool.spot_heal.description = Burushin Warkar da Tabo: yi fenti a kan aibi sai a maye gurbinsa da fasalin da aka ɗauko daga kewaye—ba sai an saita wurin tushe ba.
tool.spot_heal.history.stroke = Burushin Warkar da Tabo

# Burushin tarihi
tool.history_brush.name = Burushin Tarihi
tool.history_brush.description = Mayar da pixels daga hoton tarihin takardar, yana warware ayyukan baya shaci bayan shaci.
