# Kayan aikin fenti.

# Buroshi
tool.brush.name = Buroshi
tool.brush.description = Zana shaci mai laushin gefe da launin gaba, gwargwadon girman buroshi, tauri da rashin bayyanawa na editan.
tool.brush.history.stroke = Buroshi

# Fensir
tool.pencil.name = Fensir
tool.pencil.description = Zana shaci mai kaifin gefe ba tare da sulɓanta gefuna ba da launin gaba.
tool.pencil.history.stroke = Fensir

# Gogewa
tool.eraser.name = Gogewa
tool.eraser.description = Goge a kan shacin, yana mayar da shimfiɗar ta zama mai bayyanawa.
tool.eraser.history.stroke = Gogewa

# Hatimin kwafi
tool.clone.name = Hatimin Kwafi
tool.clone.description = Hatimin Kwafi: danna tare da alt don saita wurin tushe, sannan yi fenti da pixels da aka kwafa daga wurin a wannan tazara.
tool.clone.history.stroke = Hatimin Kwafi

