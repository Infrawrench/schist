# Lens profiles.
lens_profiles.invalid = Zaɓi ingantaccen bayanan Lensfun v1/v2 XML (har zuwa 8 MiB) tare da goyan bayan bayanan kamara ko ruwan tabarau.
lens_profiles.calibration = Gyaran ruwan tabarau
lens_profiles.no_calibration = Babu daidaitawa da ke rufe waɗannan saitunan. Bincika tsawon focal da ƙimar yanke hoton kamara; gyara da hannu ya wanzu.
lens_profiles.import = Shigo Lensfun XML…
lens_profiles.imported = Lensfun bayanan bayanai da aka shigo da su don wannan zama. Zaɓi bayanin martaba ko daidaita metadata na hoto.
lens_profiles.manual = Gyaran hannu kawai
lens_profiles.saved = Ajiye calibration (babu tushen bayanai)
lens_profiles.profile = Bayanan Lens
lens_profiles.aperture = Budewa (0 = ba a sani ba)
lens_profiles.distance = Nisa mai da hankali (0 = ba a sani ba)
lens_profiles.vignette = Duhuwar gefuna da aka daidaita
lens_profiles.color_context = Duhuwar gefuna da aka daidaita tana buƙatar ginanniyar bayanin martabar sRGB. Juya zuwa sRGB don adana bayyanar, sannan sake buɗe Gyaran Lens. Don riga-sRGB pixels mara alama, sanya sRGB ya wadatar. Geometry da gyaran chromatic suna nan.
lens_profiles.vignette_missing = Babu gyare-gyaren vignetting da ke rufe buɗaɗɗen buɗewa da nisa mai da hankali. Shigar da ma'auni don kunna shi; 1000 m yana wakiltar mayar da hankali mai nisa a yawancin bayanan martaba na Lensfun.
lens_profiles.note = Gyaran gyare-gyare yana gudana kafin sarrafawar hannu. Yi amfani da duk ainihin hoton; sannan a datse. Ajiye tarin tacewa a cikin PSD/PSB don riƙe daidaitawar daidaitawa.
lens_profiles.automatic = Daidaita metadata na hoto
lens_profiles.components = Fassara bayanin martaba: murdiya {distortion}; launuka masu launi {tca}; Farashin {vignette}.
