printing.preset_pair = Dalawang larawan
printing.preset_four = Apat na larawan
printing.preset_nine = Siyam na larawan
printing.preset_contact = Lámina ng mga larawan
printing.add_images = Magdagdag ng mga larawan…
printing.add_page = Magdagdag ng pahina
printing.layout_help = I-drag ang larawan para ilipat ito, o i-drag ang asul na sulok nito para baguhin ang laki. Mae-edit pa rin ang mga preset. I-click ang larawan sa listahan para magdagdag ng isa pang kopya sa pahinang ito.
printing.page_position = Pahina {page} sa {pages}
printing.loading_preview = Nilo-load ang mga preview…
printing.selection = Napiling larawan
printing.bring_front = Ilipat sa harapan
