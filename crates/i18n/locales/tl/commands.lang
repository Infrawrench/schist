command.edit.undo.title = I-undo
command.edit.undo.description = Bumalik ng isang entry sa undo history ng dokumento.
command.edit.redo.title = I-redo
command.edit.redo.description = Gawing muli ang huling in-undo na pag-edit.
command.edit.copy.title = Kopyahin
command.edit.copy.description = Kopyahin sa internal clipboard ang mga napiling pixel ng aktibong layer (ang buong layer kapag walang seleksiyon).
command.edit.copy_merged.title = Kopyahin ang Pinagsama
command.edit.copy_merged.description = Kopyahin ang seleksiyon ayon sa pagkakabuo ng lahat ng nakikitang layer, sa halip na mula lang sa aktibong layer.
command.edit.cut.title = Gupitin
command.edit.cut.description = Kopyahin sa clipboard ang mga napiling pixel at burahin ang mga ito sa aktibong layer.
command.edit.paste.title = I-paste
command.edit.paste.description = I-paste ang clipboard sa bagong layer sa ibabaw ng aktibo, na nakasentro sa canvas.
command.edit.paste.layer_name = Na-paste na Layer
command.edit.paste_in_place.title = I-paste sa Orihinal na Puwesto
command.edit.paste_in_place.description = I-paste ang clipboard sa bagong layer sa mga koordinat kung saan ito kinopya.
command.edit.fill_foreground.title = Punan ng Kulay sa Harapan
command.edit.fill_foreground.description = Punan ng kulay sa harapan ang seleksiyon (o buong canvas kapag walang seleksiyon).
command.edit.fill_background.title = Punan ng Kulay sa Likuran
command.edit.fill_background.description = Punan ng kulay sa likuran ang seleksiyon (o buong canvas kapag walang seleksiyon).
command.select.all.title = Piliin Lahat
command.select.all.description = Piliin ang buong canvas.
command.select.deselect.title = Alisin ang Seleksiyon
command.select.deselect.description = Alisin ang seleksiyon upang muling malapat ang mga pag-edit sa buong layer.
command.select.inverse.title = Baligtarin ang Seleksiyon
command.select.inverse.description = Pagpalitin ang napili at hindi napiling mga bahagi.
command.select.reselect.title = Piliing Muli
command.select.reselect.description = Ibalik ang huling inalis na seleksiyon.
command.select.reselect.msg.nothing_to_reselect = Walang muling mapipili
command.select.feather.title = Palambutin ang Gilid ng Seleksiyon
command.select.feather.description = Palambutin ang gilid ng seleksiyon gamit ang dalawang-pixel na paglabo upang unti-unting mawala roon ang susunod na pag-edit.
command.select.grow.title = Palawakin
command.select.grow.description = Palawakin ang seleksiyon sa mga nakadikit na pixel na kahawig ng napili na at pasok sa tolerance ng magic wand.
command.select.similar.title = Kahawig
command.select.similar.description = Piliin ang bawat pixel sa layer na kahawig ng seleksiyon, nakadikit man o hindi, at pasok sa tolerance ng magic wand.
command.select.save.title = I-save ang Seleksiyon
command.select.save.description = Itago sa dokumento ang kasalukuyang seleksiyon bilang pinangalanang alpha channel.
command.select.save.channel_name = Alpha {n}
command.select.load.title = I-load ang Seleksiyon
command.select.load.description = Ibalik ang pinakahuling na-save na seleksiyon.
command.layer.new.title = Bagong Layer
command.layer.new.description = Magdagdag ng walang-lamang raster layer sa ibabaw ng aktibong layer at gawin itong aktibo.
command.layer.duplicate.title = Kopyahin ang Layer
command.layer.duplicate.description = Kopyahin ang aktibong layer kasama ang buong nilalaman nito sa bagong layer sa ibabaw.
command.layer.smart_object.title = I-convert sa Smart Object
command.layer.smart_object.description = Ibalot sa smart object ang mga pixel ng aktibong raster layer upang mag-resample ang mga susunod na transform at filter mula sa hindi nabagong pinagmulan.
command.layer.rasterize.title = I-rasterize ang Layer
command.layer.rasterize.description = Gawing karaniwang mga pixel ang shape, text, o smart-object layer.
command.layer.delete.title = Burahin ang Layer
command.layer.delete.description = Burahin ang mga napiling layer.
command.layer.group.title = Igrupo ang mga Layer
command.layer.group.description = Ibalot ang mga napiling layer sa isang bagong grupo sa kasalukuyan nilang puwesto.
command.layer.raise.title = Ilapit
command.layer.raise.description = Ilipat ang aktibong layer nang isang puwesto pataas sa stack ng grupo nito.
command.layer.lower.title = Ilayo
command.layer.lower.description = Ilipat ang aktibong layer nang isang puwesto pababa sa stack ng grupo nito.
command.layer.to_front.title = Dalhin sa Harapan
command.layer.to_front.description = Ilipat ang aktibong layer sa pinakataas ng grupo nito.
command.layer.to_back.title = Dalhin sa Likuran
command.layer.to_back.description = Ilipat ang aktibong layer sa pinakailalim ng grupo nito.
command.layer.clipping_mask.title = Gumawa/Alisin ang Clipping Mask
command.layer.clipping_mask.description = I-clip ang aktibong layer sa nasa ilalim nito, o alisin kung naka-clip na; nakikita lamang ang naka-clip na layer kung saan may pixel ang base nito.
command.layer.cut_to_new.title = Layer sa Pamamagitan ng Pag-cut
command.layer.cut_to_new.description = Ilipat ang mga napiling pixel mula sa aktibong layer papunta sa bagong layer sa ibabaw nito.
command.layer.cut_to_new.layer_name = Layer sa Pamamagitan ng Pag-cut
command.layer.add_mask.title = Magdagdag ng Layer Mask
command.layer.add_mask.description = Magdagdag ng layer mask sa aktibong layer, na seleksiyon lamang ang ipinapakita kapag mayroon nito.
command.layer.flatten.title = Patagin ang Larawan
command.layer.flatten.description = Pagsamahin ang lahat ng nakikita sa isang opaque na layer na Likuran at itapon ang mga nakatagong layer.
command.layer.merge_down.title = Pagsamahin Pababa
command.layer.merge_down.description = Pagsamahin ang aktibong layer sa layer sa ilalim nito.
command.layer.merge_down.msg.no_layer_below = Walang layer sa ilalim na mapagsasamahan
command.layer.merge_visible.title = Pagsamahin ang Nakikita
command.layer.merge_visible.description = Pagsamahin ang lahat ng nakikitang layer sa isa at huwag galawin ang mga nakatagong layer.
command.msg.nothing_to_copy = Pumili ng pixel layer na kokopyahan
command.msg.clipboard_empty = Walang laman ang clipboard
