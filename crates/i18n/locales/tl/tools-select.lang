tool.select.mode.subtract = Ibawas
tool.select.mode.intersect = Intersection
tool.marquee.rect.name = Parihabang Marquee
tool.marquee.rect.description = I-drag ang isang parihabang seleksiyon. Ang Shift sa simula ng pag-drag ay nagdaragdag sa seleksiyon, ang Alt ay nagbabawas, at parehong key ang kumukuha ng intersection; pinapaparisukat ito ng Shift habang nagda-drag. Inaalis ng click na walang drag ang seleksiyon.
tool.marquee.ellipse.name = Eliptikong Marquee
tool.marquee.ellipse.description = I-drag ang isang eliptikong seleksiyon, gamit ang parehong pagsasama ng Shift/Alt gaya ng parihabang marquee.
tool.lasso.name = Lasso
tool.lasso.description = Mag-drag ng malayang balangkas; nagdurugtong ang mga dulo ng seleksiyon kapag natapos ang pag-drag. Nagdaragdag ang Shift at nagbabawas ang Alt.
tool.lasso.history.select = Seleksiyon gamit ang Lasso
tool.lasso.polygonal.name = Polygonal Lasso
tool.lasso.polygonal.description = Mag-click sa bawat sulok upang bumuo ng seleksiyong may mga tuwid na gilid, at mag-click malapit sa unang punto upang isara ito.
tool.lasso.polygonal.history.select = Seleksiyon gamit ang Polygonal Lasso
tool.lasso.magnetic.name = Magnetic Lasso
tool.lasso.magnetic.description = Sundan nang pahapyaw ang isang gilid at didikit ang balangkas sa pinakamalakas na contrast na malapit sa path.
tool.lasso.magnetic.history.select = Seleksiyon gamit ang Magnetic Lasso
tool.lasso.magnetic.option.frequency = Frequency
tool.wand.name = Magic Wand
tool.wand.description = Mag-click upang piliin ang magkakadugtong na bahagi sa ilalim ng pointer na may kahawig na kulay at pasok sa tolerance — ang parehong tolerance na binabasa ng Grow, Similar, at Saklaw ng Kulay.
tool.wand.option.contiguous = Magkadikit
tool.wand.history.select = Magic Wand
tool.quick_select.name = Mabilis na Seleksiyon
tool.quick_select.description = Pintahan ang isang bahagi at lalawak ang seleksiyon sa magkakahawig na pixel na dinaraanan ng brush.
tool.quick_select.history.select = Mabilis na Seleksiyon
tool.object_select.name = Seleksiyon ng Bagay
tool.object_select.description = Mag-drag ng box sa paligid ng isang bagay at didikit ang seleksiyon sa bagay na nakita sa loob nito.
tool.object_select.history.select = Seleksiyon ng Bagay
