# Native layered formats.
codec.pdn.name = Paint.NET
codec.xcf.name = GIMP XCF
codec.layered.invalid = ባለንብርብሩ የምስል ፋይል ተበላሽቷል ወይም ያልተሟላ ነው።
codec.layered.too_large = ባለንብርብሩ ምስል የሚደገፈውን መጠን ወይም የንብርብር ብዛት አልፏል።
codec.layered.unsupported = ይህ ፋይል የማይደገፍ ባህሪ ይጠቀማል፦ {feature}።
codec.layered.export_layer = “{name}” ንብርብር ይህ ቅርጸት ሊጠብቃቸው የማይችላቸው ባህሪያት አሉት። ወደ ራስተር ይቀይሩት ወይም በPSD ቅርጸት ያስቀምጡ።
codec.layered.export_depth = ወደ Paint.NET ለመላክ 8-ቢት RGB ሰነድ ያስፈልጋል። መጀመሪያ ሰነዱን ወደ 8-ቢት RGB ይቀይሩ።
codec.layered.export_mode = ለመላክ RGB ሰነድ ያስፈልጋል። መጀመሪያ ሰነዱን ወደ RGB ይቀይሩ።

