command.edit.undo.title = Anulare
command.edit.undo.description = Reveniți cu o intrare în istoricul de anulare al documentului.
command.edit.redo.title = Refacere
command.edit.redo.description = Refaceți ultima editare anulată.
command.edit.copy.title = Copiere
command.edit.copy.description = Copiați pixelii selectați ai stratului activ în clipboardul intern (sau întregul strat dacă nu este selectat nimic).
command.edit.copy_merged.title = Copiere îmbinată
command.edit.copy_merged.description = Copiați selecția așa cum este compusă de toate straturile vizibile, nu doar din stratul activ.
command.edit.cut.title = Decupare
command.edit.cut.description = Copiați pixelii selectați în clipboard și ștergeți-i din stratul activ.
command.edit.paste.title = Lipire
command.edit.paste.description = Lipiți clipboardul într-un strat nou deasupra celui activ, centrat pe pânză.
command.edit.paste.layer_name = Strat lipit
command.edit.paste_in_place.title = Lipire în poziție
command.edit.paste_in_place.description = Lipiți clipboardul într-un strat nou la coordonatele de unde a fost copiat.
command.edit.fill_foreground.title = Umplere cu prim-planul
command.edit.fill_foreground.description = Umpleți selecția (sau întreaga pânză dacă nu este selectat nimic) cu culoarea de prim-plan.
command.edit.fill_background.title = Umplere cu fundalul
command.edit.fill_background.description = Umpleți selecția (sau întreaga pânză dacă nu este selectat nimic) cu culoarea de fundal.
command.select.all.title = Selectare totală
command.select.all.description = Selectați întreaga pânză.
command.select.deselect.title = Deselectare
command.select.deselect.description = Eliminați selecția pentru ca editările să se aplice din nou întregului strat.
command.select.inverse.title = Inversare selecție
command.select.inverse.description = Interschimbați zonele selectate cu cele neselectate.
command.select.reselect.title = Reselectare
command.select.reselect.description = Restabiliți ultima selecție eliminată.
command.select.reselect.msg.nothing_to_reselect = Nimic de reselectat
command.select.feather.title = Estompare margine selecție
command.select.feather.description = Neteziți marginea selecției cu o estompare de doi pixeli, astfel încât următoarea editare să se atenueze treptat.
command.select.grow.title = Extindere
command.select.grow.description = Extindeți selecția la pixelii adiacenți asemănători celor deja selectați, în limita toleranței baghetei magice.
command.select.similar.title = Similar
command.select.similar.description = Selectați toți pixelii din strat asemănători selecției, adiacenți sau nu, în limita toleranței baghetei magice.
command.select.save.title = Salvare selecție
command.select.save.description = Salvați selecția curentă în document ca un canal alfa denumit.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Încărcare selecție
command.select.load.description = Restabiliți cea mai recentă selecție salvată.
command.layer.new.title = Strat nou
command.layer.new.description = Adăugați un strat raster gol deasupra celui activ și activați-l.
command.layer.duplicate.title = Duplicare strat
command.layer.duplicate.description = Copiați stratul activ, cu tot conținutul, într-un strat nou deasupra lui.
command.layer.smart_object.title = Conversie în obiect inteligent
command.layer.smart_object.description = Încapsulați pixelii stratului raster activ într-un obiect inteligent, astfel încât transformările și filtrele ulterioare să reeșantioneze sursa neatinsă.
command.layer.rasterize.title = Rasterizare strat
command.layer.rasterize.description = Convertiți un strat de formă, text sau obiect inteligent în pixeli obișnuiți.
command.layer.delete.title = Ștergere strat
command.layer.delete.description = Ștergeți straturile selectate.
command.layer.group.title = Grupare straturi
command.layer.group.description = Încadrați straturile selectate într-un grup nou, în aceeași poziție.
command.layer.raise.title = Aducere înainte
command.layer.raise.description = Mutați stratul activ cu o poziție în sus în stiva grupului său.
command.layer.lower.title = Trimitere înapoi
command.layer.lower.description = Mutați stratul activ cu o poziție în jos în stiva grupului său.
command.layer.to_front.title = Aducere în față
command.layer.to_front.description = Mutați stratul activ în partea de sus a grupului său.
command.layer.to_back.title = Trimitere în spate
command.layer.to_back.description = Mutați stratul activ în partea de jos a grupului său.
command.layer.clipping_mask.title = Creare/eliberare mască de tăiere
command.layer.clipping_mask.description = Tăiați stratul activ după cel de dedesubt sau eliberați-l dacă este deja tăiat; un strat tăiat apare numai acolo unde baza sa are pixeli.
command.layer.cut_to_new.title = Strat prin decupare
command.layer.cut_to_new.description = Mutați pixelii selectați din stratul activ într-un strat nou deasupra lui.
command.layer.cut_to_new.layer_name = Strat prin decupare
command.layer.add_mask.title = Adăugare mască de strat
command.layer.add_mask.description = Adăugați o mască stratului activ, dezvăluind numai selecția, dacă există.
command.layer.flatten.title = Aplatizare imagine
command.layer.flatten.description = Compuneți tot ce este vizibil într-un singur strat Fundal opac și eliminați straturile ascunse.
command.layer.merge_down.title = Îmbinare în jos
command.layer.merge_down.description = Compuneți stratul activ în stratul de dedesubt.
command.layer.merge_down.msg.no_layer_below = Nu există un strat dedesubt cu care să se îmbine
command.layer.merge_visible.title = Îmbinare vizibile
command.layer.merge_visible.description = Compuneți toate straturile vizibile într-unul singur, fără a modifica straturile ascunse.
command.msg.nothing_to_copy = Selectați un strat de pixeli din care să copiați
command.msg.clipboard_empty = Clipboardul este gol
