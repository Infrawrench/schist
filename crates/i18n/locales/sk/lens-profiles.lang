lens_profiles.invalid = Vyberte platnú databázu Lensfun v1/v2 XML (do 8 MiB) s podporovanými údajmi o fotoaparáte alebo objektíve.
lens_profiles.calibration = Kalibrácia objektívu
lens_profiles.no_calibration = Pre tieto nastavenia nie je dostupná kalibrácia. Skontrolujte ohniskovú vzdialenosť a faktor orezania fotoaparátu; ručná korekcia je naďalej dostupná.
lens_profiles.import = Importovať Lensfun XML…
lens_profiles.imported = Databáza Lensfun bola importovaná pre túto reláciu. Vyberte profil alebo ho priraďte podľa metadát fotografie.
lens_profiles.manual = Iba ručná korekcia
lens_profiles.saved = Uložená kalibrácia (databáza nie je dostupná)
lens_profiles.profile = Profil objektívu
lens_profiles.aperture = Clona (0 = neznáma)
lens_profiles.distance = Zaostrovacia vzdialenosť (0 = neznáma)
lens_profiles.vignette = Kalibrovaná vinetácia
lens_profiles.color_context = Kalibrovaná vinetácia vyžaduje vstavaný profil sRGB. Preveďte obrázok do sRGB, aby sa zachoval jeho vzhľad, a potom znova otvorte Korekciu objektívu. Ak sú pixely už v sRGB, ale nemajú priradený profil, stačí priradiť sRGB. Geometrická a chromatická korekcia zostávajú dostupné.
lens_profiles.vignette_missing = Pre túto clonu a zaostrovaciu vzdialenosť nie je dostupná kalibrácia vinetácie. Zadajte namerané hodnoty, aby ste ju povolili; v mnohých profiloch Lensfun znamená 1000 m zaostrenie do diaľky.
lens_profiles.note = Kalibrovaná korekcia sa vykoná pred ručnými nastaveniami. Použite celý pôvodný záber; orežte ho až potom. Uložte sadu filtrov vo formáte PSD/PSB, aby kalibrácia zostala upraviteľná.
lens_profiles.automatic = Priradiť podľa metadát fotografie
lens_profiles.components = Úprava podľa profilu: skreslenie {distortion}; farebné okraje {tca}; vinetácia {vignette}.
