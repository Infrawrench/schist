command.layer.clipping_mask.title = Tạo/Gỡ mặt nạ cắt
command.layer.clipping_mask.description = Cắt lớp đang hoạt động theo lớp bên dưới hoặc gỡ nếu đã cắt; lớp bị cắt chỉ hiển thị nơi lớp nền có điểm ảnh.
command.layer.cut_to_new.title = Tạo lớp bằng cách cắt
command.layer.cut_to_new.description = Chuyển các điểm ảnh đã chọn khỏi lớp đang hoạt động sang lớp mới phía trên.
