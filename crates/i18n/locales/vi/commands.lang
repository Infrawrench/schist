command.edit.undo.title = Hoàn tác
command.edit.undo.description = Lùi một mục trong lịch sử hoàn tác của tài liệu.
command.edit.redo.title = Làm lại
command.edit.redo.description = Thực hiện lại chỉnh sửa vừa hoàn tác gần nhất.
command.edit.copy.title = Sao chép
command.edit.copy.description = Sao chép các điểm ảnh đã chọn của lớp đang hoạt động vào bảng nhớ tạm nội bộ (toàn bộ lớp nếu không có vùng chọn).
command.edit.copy_merged.title = Sao chép hợp nhất
command.edit.copy_merged.description = Sao chép vùng chọn theo hình ảnh tổng hợp của mọi lớp hiển thị, thay vì chỉ từ lớp đang hoạt động.
command.edit.cut.title = Cắt
command.edit.cut.description = Sao chép các điểm ảnh đã chọn vào bảng nhớ tạm rồi xóa chúng khỏi lớp đang hoạt động.
command.edit.paste.title = Dán
command.edit.paste.description = Dán bảng nhớ tạm vào lớp mới phía trên lớp đang hoạt động, căn giữa trên canvas.
command.edit.paste.layer_name = Lớp đã dán
command.edit.paste_in_place.title = Dán tại chỗ
command.edit.paste_in_place.description = Dán bảng nhớ tạm vào lớp mới tại tọa độ đã sao chép.
command.edit.fill_foreground.title = Tô bằng tiền cảnh
command.edit.fill_foreground.description = Tô vùng chọn (hoặc toàn bộ canvas khi không có vùng chọn) bằng màu tiền cảnh.
command.edit.fill_background.title = Tô bằng nền
command.edit.fill_background.description = Tô vùng chọn (hoặc toàn bộ canvas khi không có vùng chọn) bằng màu nền.
command.select.all.title = Chọn tất cả
command.select.all.description = Chọn toàn bộ canvas.
command.select.deselect.title = Bỏ chọn
command.select.deselect.description = Bỏ vùng chọn để các chỉnh sửa lại áp dụng cho toàn bộ lớp.
command.select.inverse.title = Đảo vùng chọn
command.select.inverse.description = Hoán đổi vùng đã chọn và chưa chọn.
command.select.reselect.title = Chọn lại
command.select.reselect.description = Khôi phục vùng chọn vừa bị bỏ gần nhất.
command.select.reselect.msg.nothing_to_reselect = Không có gì để chọn lại
command.select.feather.title = Làm mềm vùng chọn
command.select.feather.description = Làm mềm cạnh vùng chọn bằng độ nhòe hai điểm ảnh để chỉnh sửa tiếp theo mờ dần qua cạnh.
command.select.grow.title = Mở rộng
command.select.grow.description = Mở rộng vùng chọn sang các điểm ảnh liền kề giống vùng đã chọn, trong dung sai của đũa thần.
command.select.similar.title = Tương tự
command.select.similar.description = Chọn mọi điểm ảnh trong lớp giống vùng chọn, dù có liền kề hay không, trong dung sai của đũa thần.
command.select.save.title = Lưu vùng chọn
command.select.save.description = Lưu vùng chọn hiện tại trong tài liệu dưới dạng kênh alpha có tên.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Tải vùng chọn
command.select.load.description = Khôi phục vùng chọn được lưu gần nhất.
command.layer.new.title = Lớp mới
