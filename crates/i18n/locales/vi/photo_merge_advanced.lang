# Translation draft; review by a native speaker.
photo_merge_advanced.projective = Căn chỉnh phối cảnh (bao gồm xoay)
photo_merge_advanced.cylindrical = Ảnh toàn cảnh hình trụ
photo_merge_advanced.deghost = Loại bỏ bóng mờ của chủ thể chuyển động (lấy ảnh đầu làm mốc)
photo_merge_advanced.focal = Tiêu cự (px) / chiều rộng ảnh (px)
photo_merge_advanced.masks = Kết quả ghép nét dùng mặt nạ lớp có thể chỉnh sửa. Chọn mặt nạ trong bảng Lớp rồi tô để tinh chỉnh.
photo_merge_advanced.no_match = Không tìm thấy cách căn chỉnh đáng tin cậy. Hãy dùng các ảnh có nhiều chi tiết, chồng lấn đáng kể và góc chụp chỉ thay đổi ít.
photo_merge_advanced.invalid = Ảnh nguồn hoặc thiết lập ghép không hợp lệ.
