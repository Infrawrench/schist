# Piktutensili.
tool.brush.name = Pinselo
tool.brush.description = Piktez traco kun mola bordi per la avanplana koloro, grandigita segun la pinselgrando, hardeso e opakeso dil redaktilo.
tool.brush.history.stroke = Pinselo
tool.pencil.name = Kreyono
tool.pencil.description = Piktez traco kun harda bordi, sen glatigo, per la avanplana koloro.
tool.pencil.history.stroke = Kreyono
tool.eraser.name = Efacilo
tool.eraser.description = Efacez along la traco, retroportante la strato a transparenteso.
tool.eraser.history.stroke = Efacilo
tool.clone.name = Klonstamplilo
tool.clone.description = Klonstamplilo: Alt-klikez por fixigar la fontopunto, pose piktez pixeli kopiita de ol ye ta deplaso.
tool.clone.history.stroke = Klonstamplilo
tool.dodge.name = Esklarigilo
tool.dodge.description = Klarigez la pixeli tra qui la traco pasas.
tool.dodge.history.stroke = Esklarigilo
tool.burn.name = Bruligilo
tool.burn.description = Obskurigez la pixeli tra qui la traco pasas.
tool.burn.history.stroke = Bruligilo
tool.sponge.name = Sponjo
tool.sponge.description = Saturez, o desaturez, la pixeli tra qui la traco pasas.
tool.sponge.history.stroke = Sponjo
tool.blur.name = Desfokusigilo
tool.blur.description = Desfokusigez la pixeli tra qui la traco pasas.
tool.blur.history.stroke = Desfokusigo
tool.sharpen.name = Akutigilo
tool.sharpen.description = Akutigez la pixeli tra qui la traco pasas.
tool.sharpen.history.stroke = Akutigo
tool.smudge.name = Smacilo
tool.smudge.description = Trenez koloro along la traco, quale pusante malseka pikturo.
tool.smudge.history.stroke = Smaco
tool.heal.name = Reparpinselo
tool.heal.description = Reparpinselo: Alt-klikez por fixigar la fonteno, pose piktez; la texturo dil fonteno mixesas kun la propra koloro e lumizo dil destino.
tool.heal.history.stroke = Reparpinselo
tool.spot_heal.name = Punkta reparpinselo
tool.spot_heal.description = Punkta reparpinselo: piktez sur makulo e ol remplasesas per texturo prenita de lua cirkumajo -- sen fontopunto fixigenda.
tool.spot_heal.history.stroke = Punkta reparpinselo
tool.history_brush.name = Historiopinselo
tool.history_brush.description = Ripiktez pixeli de la historia instantajo dil dokumento, desfacante plu tarda laboro traco po traco.
tool.history_brush.history.stroke = Historiopinselo
tool.background_eraser.name = Dopplana efacilo
tool.background_eraser.description = Efacez la koloro specimenita sub la centro dil pinselo e lasez diferanta pixeli netushita, por separar subjekto de lua dopplano.
tool.background_eraser.history.stroke = Dopplana efacilo
tool.gradient.name = Gradiento
tool.gradient.description = Trenez por plenigar la strato -- tra la selekto se un existas -- per lineara gradiento de la avanplana koloro a la dopplana koloro along la treno.
tool.gradient.radial.name = Radiala gradiento
tool.gradient.radial.description = Trenez de la centro adextere por plenigar per radiala gradiento inter la avanplana e dopplana kolori.
tool.gradient.option.gradient = Gradiento
tool.gradient.option.reverse = Inversa
tool.gradient.option.dither = Difuza bruido
tool.gradient.choice.foreground_to_background = Avanplano a dopplano
tool.gradient.choice.foreground_to_transparent = Avanplano a transparenteso
tool.gradient.choice.linear = Lineara
tool.gradient.choice.radial = Radiala
tool.gradient.choice.angle = Angulo
tool.gradient.choice.reflected = Reflektita
tool.gradient.choice.diamond = Diamanto
tool.gradient.history.gradient = Gradiento
tool.bucket.name = Pikturbalyo
tool.bucket.description = Kliktez por inundar la konektita areo di simila koloro sub la indikilo per la avanplana koloro, segun la tolero dil utensilo.
tool.bucket.option.contiguous = Kontigua
tool.bucket.option.all_layers = Omna strati
tool.bucket.history.fill = Pikturbalyo
