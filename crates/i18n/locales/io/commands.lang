# Komandi por redakto, selekto e strati.
command.edit.undo.title = Desfacar
command.edit.undo.description = Retroirez un elemento en la desfachistorio dil dokumento.
command.edit.redo.title = Rifacar
command.edit.redo.description = Rifacar la redakto lasta desfacita.
command.edit.copy.title = Kopiar
command.edit.copy.description = Kopiar la selektita pixeli dil aktiva strato a la interna klipuyo (la tota strato se nulo esas selektita).
command.edit.copy_merged.title = Kopiar fusionita
command.edit.copy_merged.description = Kopiar la selekto quale omna videbla strati kompozas ol, vice sole de la aktiva strato.
command.edit.cut.title = Ektranchar
command.edit.cut.description = Kopiar la selektita pixeli a la klipuyo e efacar li de la aktiva strato.
command.edit.paste.title = Gluar
command.edit.paste.description = Gluar la klipuyo en nova strato super la aktiva, centrigita sur la kanvaso.
command.edit.paste.layer_name = Gluita strato
command.edit.paste_in_place.title = Gluar samloke
command.edit.paste_in_place.description = Gluar la klipuyo en nova strato ye la koordinati de qui ol esis kopiita.
command.edit.fill_foreground.title = Plenigar per avanplano
command.edit.fill_foreground.description = Plenigar la selekto (o la tota kanvaso se nulo esas selektita) per la avanplana koloro.
command.edit.fill_background.title = Plenigar per dopplano
command.edit.fill_background.description = Plenigar la selekto (o la tota kanvaso se nulo esas selektita) per la dopplana koloro.
command.select.all.title = Selektar omni
command.select.all.description = Selektar la tota kanvaso.
command.select.deselect.title = Deselektar
command.select.deselect.description = Abandonar la selekto, por ke redakti aplikesas itere a la tota strato.
command.select.inverse.title = Inversigar selekto
command.select.inverse.description = Permutar selektita e neselektita arei.
command.select.reselect.title = Riselektar
command.select.reselect.description = Restaurar la selekto laste abandonita.
command.select.reselect.msg.nothing_to_reselect = Nulo riselektebla
command.select.feather.title = Moligar selektobordo
command.select.feather.description = Moligar la bordo dil selekto per dupixela desfokusigo, por ke la sequanta redakto grade desaparas tra ol.
command.select.grow.title = Kreskigar
command.select.grow.description = Extendar la selekto en tushanta pixeli simila a la ja selektita, segun la tolero dil magika vergo.
command.select.similar.title = Simila
command.select.similar.description = Selektar omna pixelo en la strato simila a la selekto, sive tushanta ol sive ne, segun la tolero dil magika vergo.
command.select.save.title = Konservar selekto
command.select.save.description = Konservar la nuna selekto en la dokumento kom nomizita alfa-kanalo.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Kargar selekto
command.select.load.description = Restaurar la maxim recente konservita selekto.
command.layer.new.title = Nova strato
command.layer.new.description = Adjuntar vakua rasterstrato super la aktiva e aktivigar ol.
command.layer.duplicate.title = Duplikatar strato
command.layer.duplicate.description = Kopiar la aktiva strato, kun omna kontenajo, en nova strato super ol.
command.layer.smart_object.title = Konvertar a intelijenta objekto
command.layer.smart_object.description = Envelopar la pixeli dil aktiva rasterstrato en intelijenta objekto, por ke plu tarda transformi e filtrili rispecimenas la netushita fonteno.
command.layer.rasterize.title = Rasterigar strato
command.layer.rasterize.description = Transformar formo-, texto- o intelijenta-objekto-strato a ordinara pixeli.
command.layer.delete.title = Efacar strato
command.layer.delete.description = Efacar la selektita strati.
command.layer.group.title = Grupigar strati
command.layer.group.description = Envelopar la selektita strati en nova grupo, samloke.
command.layer.raise.title = Avanigar
command.layer.raise.description = Movar la aktiva strato un loko adsupre en la staplo di lua grupo.
command.layer.lower.title = Dopigar
command.layer.lower.description = Movar la aktiva strato un loko adinfre en la staplo di lua grupo.
command.layer.to_front.title = Pozar maxim avane
command.layer.to_front.description = Movar la aktiva strato a la supro di lua grupo.
command.layer.to_back.title = Pozar maxim dope
command.layer.to_back.description = Movar la aktiva strato a la infro di lua grupo.
command.layer.clipping_mask.title = Krear/Liberigar ektondomasko
command.layer.clipping_mask.description = Ektondar la aktiva strato segun ta sub ol, o liberigar ol se ja tala; ektondita strato montras nur ube lua bazo havas pixeli.
command.layer.cut_to_new.title = Strato per ektrancho
command.layer.cut_to_new.description = Movar la selektita pixeli ek la aktiva strato a nova strato super ol.
command.layer.cut_to_new.layer_name = Strato per ektrancho
command.layer.add_mask.title = Adjuntar stratomasko
command.layer.add_mask.description = Adjuntar stratomasko a la aktiva strato, montrante nur la selekto se un existas.
command.layer.flatten.title = Platigar imajo
command.layer.flatten.description = Kompozar omno videbla en un opaka Dopplano-strato, forjetante celita strati.
command.layer.merge_down.title = Fusionar adinfre
command.layer.merge_down.description = Kompozar la aktiva strato en la strato sub ol.
command.layer.merge_down.msg.no_layer_below = Nula strato suba por fusionar
command.layer.merge_visible.title = Fusionar videbla
command.layer.merge_visible.description = Kompozar omna videbla strati en un, lasante celita strati netushita.
command.msg.nothing_to_copy = Selektez pixelstrato de qua kopiar
command.msg.clipboard_empty = Nulo en la klipuyo
