# AI-assisted translation; native-speaker review pending.
tethered.title = Fotografo per konektita kamero
tethered.capture = Fotografez
tethered.invalid_name = Selektez nomo de 1–120 byte, sen oblikva streki, duopunti, procentosigni o komencanta punto.
tethered.install = La sistemala kamerobiblioteko ne esas disponebla. Instalez la kamerofunkciala medio di la platformo e riiniciez Schist.
tethered.timeout = La tempo por la kamerodemando expiradis. Kontrolez la kamero e rikonektez ol ante nova provo.
tethered.failed = La kamerodemando faliis: {detail}
tethered.unsupported = Ca kamero ne indikas ke ol suportas distala fotografado.
tethered.no_download = La kamero ne liveris kompleta imajo. La originali restas sur la kamero.
tethered.session_help = Selektez kamero, pose Fotografez. Ye la unesma fotografuro, selektez destinoloko e prefixo por la filonomi; la fotografuri recevas sequonumero e la filextenso dil kamero. Konservar kom… chanjas la destinoloko e la prefixo.
tethered.preview_failed = La fotografuro konservesis e importesis, ma lua avana montro ne povis esar dekodita. Apertez ol en la redaktilo por examinar la filio.
tethered.partial = Kelka fotografurofili konservesis e importesis; la restant fili ne povis esar konservita: {error}
tethered.camera_permission = Permisez aceso a la kamero en Sistemala ajusti → Privateso e sekureso → Kamero, pose probez Fotografez itere. Se Schist startesis de terminalo, kontrolez anke la kameropermiso di ta terminalo.
tethered.camera_usage_missing = Ca konstrukturo ne havas sua kameropermisa deskripto. Rikonstrukturez Schist per make o uzez la pakizita apliko.
tethered.select_camera = Selektez kamero por fotografar.
tethered.choose_destination = Fotografez demandos ube konservar vua fotografuri.
tethered.preview_empty = Fotografez por vidar la fotografuro hike.
tethered.save_local = Konservez lokale
tethered.save_cloud = Konservez en la nubo
tethered.cloud_help = La fotografuri esas sendata al selektita destino en Schist Cloud. Nula kopio restas en la lokala galerio.
tethered.cloud_pending = La sendi qui ankore ne finisis konservesas che {path}.
