tool.transform.name = རང་དབང་བསྒྱུར་བ།
tool.transform.description = རང་དབང་བསྒྱུར་བ། དེ་སྤར་སྐབས་ལས་ཀ་བྱེད་བཞིན་པའི་རིམ་པའི་མཐའ་ལ་བསྒྱུར་སྒྲོམ་ཞིག་འབྱེད། ཟུར་ཞིག་འདྲུད་ན་ཆེ་ཆུང་སྒྱུར། ཟུར་གྱི་ཕྱི་རུ་འདྲུད་ན་འཁོར། མཐའ་ཞིག་འདྲུད་ན་གསེག་ཏུ་སྒྱུར། ངེས་གཏན་ (Enter) མ་བྱས་བར་ཅི་ཡང་མི་འབྲི། རྩིས་མེད་ (Escape) བྱས་ན་རིམ་པ་སྔར་གྱི་གནས་ལ་ལོག
