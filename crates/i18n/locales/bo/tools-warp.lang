tool.liquify.name = གཤེར་འགྱུར།
tool.liquify.description = པིར་ཆེན་པོའི་འོག་གི་པིག་སེལ་རྣམས་འབུད་པ། འཁྱིལ་བ། བསྐུམ་པའམ་སྦོས་པར་བྱེད། རྣམ་པའི་གདམ་ཁས་གང་བྱེད་མིན་འདེམས། འཁྱོག་པ་དྲ་མིག་ནང་རིམ་བཞིན་བསགས་ཏེ་ངེས་གཏན་བྱེད་སྐབས་རིམ་པར་སྦྱོར།
tool.liquify.option.tool = ལག་ཆ།
tool.liquify.choice.forward_warp = མདུན་ཕྱོགས་འཁྱོག་པ།
tool.liquify.choice.reconstruct = བསྐྱར་བཟོ།
tool.liquify.choice.twirl_cw = གཡས་འཁོར་དུ་འཁྱིལ་བ།
tool.liquify.choice.twirl_ccw = གཡོན་འཁོར་དུ་འཁྱིལ་བ།
tool.liquify.choice.pucker = བསྐུམ་པ།
tool.liquify.choice.bloat = སྦོས་པ།
tool.liquify.choice.push_left = གཡོན་དུ་འབུད་པ།
tool.liquify.history.liquify = གཤེར་འགྱུར།
tool.puppet_warp.name = འཁྲབ་གཟུགས་འཁྱོག་པ།
tool.puppet_warp.description = མནན་ནས་རིམ་པའི་ཚེག་འགའ་གཟེར་རྗེས། གཅིག་འདྲུད། དྲ་མིག་དེ་གཟེར་རྣམས་ཀྱི་མཐའ་རུ་འཁྱོག་ཅིང་། མཁྲེགས་ཚད་ཀྱི་གདམ་ཁ་ལྟར་དམ་པོའམ་ལྷོད་པོ་ཡིན། ངེས་གཏན་བྱས་ན་སྦྱོར།
