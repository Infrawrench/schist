tool.burn.history.stroke = Υποέκθεση
tool.sponge.name = Σφουγγάρι
tool.sponge.description = Αυξήστε ή μειώστε τον κορεσμό των εικονοστοιχείων από τα οποία περνά η πινελιά.
tool.sponge.history.stroke = Σφουγγάρι
tool.blur.name = Θόλωση
