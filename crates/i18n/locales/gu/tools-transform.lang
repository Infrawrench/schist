# Free transform
tool.transform.name = મુક્ત રૂપાંતરણ
tool.transform.description = મુક્ત રૂપાંતરણ. તેને સક્રિય કરતાં સક્રિય લેયરની આસપાસ રૂપાંતરણ બૉક્સ ખૂલે છે: માપ બદલવા ખૂણો ખેંચો, ફેરવવા ખૂણાની બહારથી ખેંચો અને ત્રાંસું કરવા ધાર ખેંચો. કમિટ (Enter) ન કરો ત્યાં સુધી કોઈ ફેરફાર લખાતો નથી, અને રદ કરવાથી (Escape) લેયર પાછું મૂળ સ્થિતિમાં આવે છે.
tool.transform.option.interpolation = ઇન્ટરપોલેશન
tool.transform.history.transform = મુક્ત રૂપાંતરણ
tool.transform.history.image_size = છબીનું કદ
tool.transform.history.canvas_size = કેનવાસનું કદ

