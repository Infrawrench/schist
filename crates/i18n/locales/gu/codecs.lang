# Affinity
codec.affinity.import_title = Affinity ઇમ્પોર્ટ
codec.affinity.flattened_preview_layer = સપાટ કરેલું પૂર્વાવલોકન
codec.affinity.msg.no_preview = ઉપયોગ કરી શકાય એવું કોઈ અંદર સમાયેલું પૂર્વાવલોકન નથી. Affinityનું લેયરવાળું ફોર્મેટ માલિકીનું છે; Schist ફાઇલમાં રહેલું સપાટ કરેલું પૂર્વાવલોકન ઇમ્પોર્ટ કરે છે. આ ફાઇલમાં એવું પૂર્વાવલોકન નથી — તેને Affinityમાં ફરી સાચવો અથવા બધા લેયર સહિત ઇમ્પોર્ટ કરવા PSD તરીકે એક્સપોર્ટ કરો.

# HEIF
codec.heif.msg.no_library = libheif ઉપલબ્ધ નથી ({details}). HEIC ખોલવા libheif લાઇબ્રેરી જરૂરી છે (Linux: libheif1 ઇન્સ્ટૉલ કરો; macOS: brew install libheif).
codec.heif.msg.no_decoder = {what}: {message} — આ libheif બિલ્ડમાં કદાચ HEVC ડિકોડર નથી (Debian/Ubuntu પર libheif-plugin-libde265 ઇન્સ્ટૉલ કરો)
codec.heif.msg.unknown_error = અજ્ઞાત ભૂલ
codec.heif.msg.initialising = libheif આરંભ કરવામાં
codec.heif.msg.reading_container = HEIF કન્ટેનર વાંચવામાં
codec.heif.msg.finding_primary_image = મુખ્ય છબી શોધવામાં
codec.heif.msg.reading_icc_profile = ICC પ્રોફાઇલ વાંચવામાં
codec.heif.msg.decoding_image = છબી ડિકોડ કરવામાં
codec.heif.msg.checksum_mismatch = {name} માટે ચેકસમ મેળ ખાતો નથી: {expected} અપેક્ષિત હતો, {got} મળ્યો
codec.heif.msg.imageio_cannot_read = ImageIO HEIF કન્ટેનર વાંચી શક્યું નહીં
codec.heif.msg.container_empty = HEIF કન્ટેનરમાં કોઈ છબી નથી
codec.heif.msg.imageio_cannot_decode = ImageIO મુખ્ય છબી ડિકોડ કરી શક્યું નહીં

# Native layered formats.
codec.pdn.name = Paint.NET
codec.xcf.name = GIMP XCF
codec.layered.invalid = લેયરવાળી ઇમેજની ફાઇલ નુકસાનગ્રસ્ત અથવા અધૂરી છે.
codec.layered.too_large = લેયરવાળી ઇમેજનું કદ અથવા લેયરની સંખ્યા સમર્થિત મર્યાદાથી વધુ છે.
codec.layered.unsupported = આ ફાઇલ અસમર્થિત સુવિધાનો ઉપયોગ કરે છે: {feature}.
codec.layered.export_layer = “{name}” લેયરમાં એવી સુવિધાઓ છે જે આ ફોર્મેટ જાળવી શકતું નથી. તેને રાસ્ટરાઇઝ કરો અથવા PSD તરીકે સાચવો.
codec.layered.export_depth = Paint.NET એક્સપોર્ટ માટે 8-બિટ RGB દસ્તાવેજ જરૂરી છે. પહેલાં દસ્તાવેજને 8-બિટ RGBમાં રૂપાંતરિત કરો.
codec.layered.export_mode = એક્સપોર્ટ માટે RGB દસ્તાવેજ જરૂરી છે. પહેલાં દસ્તાવેજને RGBમાં રૂપાંતરિત કરો.

