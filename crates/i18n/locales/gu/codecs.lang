# Affinity
codec.affinity.import_title = Affinity ઇમ્પોર્ટ
codec.affinity.flattened_preview_layer = સપાટ કરેલું પૂર્વાવલોકન
codec.affinity.msg.no_preview = ઉપયોગ કરી શકાય એવું કોઈ અંદર સમાયેલું પૂર્વાવલોકન નથી. Affinityનું લેયરવાળું ફોર્મેટ માલિકીનું છે; Schist ફાઇલમાં રહેલું સપાટ કરેલું પૂર્વાવલોકન ઇમ્પોર્ટ કરે છે. આ ફાઇલમાં એવું પૂર્વાવલોકન નથી — તેને Affinityમાં ફરી સાચવો અથવા બધા લેયર સહિત ઇમ્પોર્ટ કરવા PSD તરીકે એક્સપોર્ટ કરો.

# HEIF
codec.heif.msg.no_library = libheif ઉપલબ્ધ નથી ({details}). HEIC ખોલવા libheif લાઇબ્રેરી જરૂરી છે (Linux: libheif1 ઇન્સ્ટૉલ કરો; macOS: brew install libheif).
codec.heif.msg.no_decoder = {what}: {message} — આ libheif બિલ્ડમાં કદાચ HEVC ડિકોડર નથી (Debian/Ubuntu પર libheif-plugin-libde265 ઇન્સ્ટૉલ કરો)
codec.heif.msg.unknown_error = અજ્ઞાત ભૂલ
codec.heif.msg.initialising = libheif આરંભ કરવામાં
