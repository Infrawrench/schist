# Edit
command.edit.undo.title = પૂર્વવત્ કરો
command.edit.undo.description = દસ્તાવેજના પૂર્વવત્ ઇતિહાસમાં એક પગલું પાછળ જાઓ.
command.edit.redo.title = ફરી કરો
command.edit.redo.description = છેલ્લે પૂર્વવત્ કરેલું સંપાદન ફરી કરો.
command.edit.copy.title = કૉપી કરો
command.edit.copy.description = સક્રિય લેયરના પસંદ કરેલા પિક્સેલ આંતરિક ક્લિપબોર્ડમાં કૉપી કરો (કંઈ પસંદ ન હોય ત્યારે આખું લેયર).
command.edit.copy_merged.title = મર્જ કરેલું કૉપી કરો
command.edit.copy_merged.description = માત્ર સક્રિય લેયરમાંથી લેવાને બદલે, બધા દૃશ્યમાન લેયર જે રીતે સંયોજિત કરે છે તે રીતે પસંદગી કૉપી કરો.
command.edit.cut.title = કાપો
command.edit.cut.description = પસંદ કરેલા પિક્સેલ ક્લિપબોર્ડમાં કૉપી કરીને સક્રિય લેયરમાંથી ભૂંસી નાખો.
command.edit.paste.title = પેસ્ટ કરો
command.edit.paste.description = ક્લિપબોર્ડને સક્રિય લેયરની ઉપર નવા લેયરમાં, કેનવાસની મધ્યમાં પેસ્ટ કરો.
command.edit.paste.layer_name = પેસ્ટ કરેલું લેયર
command.edit.paste_in_place.title = એ જ જગ્યાએ પેસ્ટ કરો
command.edit.paste_in_place.description = ક્લિપબોર્ડને જ્યાંથી કૉપી કર્યું હતું એ જ યામો પર નવા લેયરમાં પેસ્ટ કરો.
command.edit.fill_foreground.title = અગ્રભૂમિથી ભરો
command.edit.fill_foreground.description = પસંદગીને (અથવા કંઈ પસંદ ન હોય ત્યારે આખા કેનવાસને) અગ્રભૂમિના રંગથી ભરો.
command.edit.fill_background.title = પૃષ્ઠભૂમિથી ભરો
command.edit.fill_background.description = પસંદગીને (અથવા કંઈ પસંદ ન હોય ત્યારે આખા કેનવાસને) પૃષ્ઠભૂમિના રંગથી ભરો.

# Select
command.select.all.title = બધું પસંદ કરો
command.select.all.description = આખું કેનવાસ પસંદ કરો.
command.select.deselect.title = પસંદગી દૂર કરો
command.select.deselect.description = પસંદગી દૂર કરો, જેથી સંપાદનો ફરીથી આખા લેયર પર લાગુ થાય.
command.select.inverse.title = પસંદગી ઉલટાવો
command.select.inverse.description = પસંદ કરેલા અને પસંદ ન કરેલા વિસ્તારોની અદલાબદલી કરો.
command.select.reselect.title = ફરી પસંદ કરો
command.select.reselect.description = છેલ્લે દૂર કરેલી પસંદગી પાછી લાવો.
command.select.reselect.msg.nothing_to_reselect = ફરી પસંદ કરવા માટે કંઈ નથી
command.select.feather.title = પસંદગીને ફેધર કરો
command.select.feather.description = પસંદગીની ધારને બે પિક્સેલના બ્લરથી નરમ કરો, જેથી આગળનું સંપાદન તેની ધાર પર ધીમે ધીમે ઝાંખું થાય.
command.select.grow.title = વધારો
command.select.grow.description = મેજિક વૉન્ડની સહનશીલતાની મર્યાદામાં, પહેલાંથી પસંદ કરેલા પિક્સેલ જેવા લાગતા સ્પર્શતા પિક્સેલ સુધી પસંદગી વધારો.
command.select.similar.title = સમાન
command.select.similar.description = મેજિક વૉન્ડની સહનશીલતાની મર્યાદામાં, લેયરના પસંદગી જેવા દરેક પિક્સેલને પસંદ કરો, તે પસંદગીને સ્પર્શતા હોય કે નહીં.
command.select.save.title = પસંદગી સાચવો
command.select.save.description = વર્તમાન પસંદગીને દસ્તાવેજમાં નામવાળી આલ્ફા ચેનલ તરીકે સાચવી રાખો.
command.select.save.channel_name = આલ્ફા {n}
command.select.load.title = પસંદગી લોડ કરો
command.select.load.description = સૌથી તાજેતરમાં સાચવેલી પસંદગી પાછી લાવો.

# Layer
command.layer.new.title = નવું લેયર
command.layer.new.description = સક્રિય લેયરની ઉપર ખાલી રાસ્ટર લેયર ઉમેરીને તેને સક્રિય બનાવો.
command.layer.duplicate.title = લેયરની નકલ બનાવો
command.layer.duplicate.description = સક્રિય લેયરની તમામ સામગ્રી સહિત કૉપી કરીને તેની ઉપર નવું લેયર બનાવો.
command.layer.smart_object.title = સ્માર્ટ ઑબ્જેક્ટમાં રૂપાંતરિત કરો
command.layer.smart_object.description = સક્રિય રાસ્ટર લેયરના પિક્સેલને સ્માર્ટ ઑબ્જેક્ટમાં લપેટો, જેથી પછીનાં રૂપાંતરણ અને ફિલ્ટર અસ્પર્શિત સ્રોતમાંથી ફરી નમૂના લે.
command.layer.rasterize.title = લેયર રાસ્ટરાઇઝ કરો
command.layer.rasterize.description = આકાર, ટેક્સ્ટ અથવા સ્માર્ટ-ઑબ્જેક્ટ લેયરને સાદા પિક્સેલમાં ફેરવો.
command.layer.delete.title = લેયર કાઢી નાખો
command.layer.delete.description = પસંદ કરેલા લેયર કાઢી નાખો.
command.layer.group.title = લેયરનું ગ્રૂપ બનાવો
command.layer.group.description = પસંદ કરેલા લેયરને તેમની એ જ જગ્યાએ નવા ગ્રૂપમાં મૂકો.
command.layer.raise.title = આગળ લાવો
command.layer.raise.description = સક્રિય લેયરને તેના ગ્રૂપના સ્ટૅકમાં એક સ્થાન ઉપર ખસેડો.
command.layer.lower.title = પાછળ મોકલો
command.layer.lower.description = સક્રિય લેયરને તેના ગ્રૂપના સ્ટૅકમાં એક સ્થાન નીચે ખસેડો.
command.layer.to_front.title = સૌથી આગળ લાવો
command.layer.to_front.description = સક્રિય લેયરને તેના ગ્રૂપમાં સૌથી ઉપર ખસેડો.
command.layer.to_back.title = સૌથી પાછળ મોકલો
command.layer.to_back.description = સક્રિય લેયરને તેના ગ્રૂપમાં સૌથી નીચે ખસેડો.
command.layer.clipping_mask.title = ક્લિપિંગ માસ્ક બનાવો/છોડો
command.layer.clipping_mask.description = સક્રિય લેયરને તેની નીચેના લેયર સાથે ક્લિપ કરો, અથવા પહેલેથી ક્લિપ હોય તો છોડો; ક્લિપ કરેલું લેયર તેના આધાર લેયરમાં પિક્સેલ હોય ત્યાં જ દેખાય છે.
command.layer.cut_to_new.title = કાપીને નવું લેયર
command.layer.cut_to_new.description = પસંદ કરેલા પિક્સેલને સક્રિય લેયરમાંથી કાઢીને તેની ઉપરના નવા લેયરમાં ખસેડો.
command.layer.cut_to_new.layer_name = કાપીને બનાવેલું લેયર
command.layer.add_mask.title = લેયર માસ્ક ઉમેરો
command.layer.add_mask.description = સક્રિય લેયરમાં લેયર માસ્ક ઉમેરો; પસંદગી હોય ત્યારે માત્ર પસંદ કરેલો ભાગ દેખાશે.
command.layer.flatten.title = છબી સપાટ કરો
command.layer.flatten.description = દેખાતી દરેક વસ્તુને એક અપારદર્શક પૃષ્ઠભૂમિ લેયરમાં સંયોજિત કરીને છુપાયેલા લેયર કાઢી નાખો.
command.layer.merge_down.title = નીચે મર્જ કરો
command.layer.merge_down.description = સક્રિય લેયરને તેની નીચેના લેયરમાં સંયોજિત કરો.
command.layer.merge_down.msg.no_layer_below = મર્જ કરવા માટે નીચે કોઈ લેયર નથી
command.layer.merge_visible.title = દૃશ્યમાન લેયર મર્જ કરો
command.layer.merge_visible.description = દરેક દૃશ્યમાન લેયરને એકમાં સંયોજિત કરો અને છુપાયેલા લેયરને એમ જ રહેવા દો.

command.msg.nothing_to_copy = કૉપી કરવા માટે પિક્સેલ લેયર પસંદ કરો
command.msg.clipboard_empty = ક્લિપબોર્ડ પર કંઈ નથી

