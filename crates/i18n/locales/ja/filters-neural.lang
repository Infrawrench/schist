# Neural Filters、Camera Raw、ぼかしギャラリー、レンズ系フィルター
# （plugins/filters-core：neural.rs、camera_raw.rs、blurgallery.rs、
# lens.rs）。キーはプラグインが登録する id に従って
# filter.<id>.name、filter.<id>.param.<key>、filter.<id>.choice.<value>、
# filter.<id>.msg.<what> となります。これらのフィルターが共有するラベルは
# filter.neural.param.<label> です。モデル名（"Depth (Depth Blur)"）は
# ［モデルを管理］に表示されるものなので、そのままにします。
# 名称は日本語版 Photoshop に合わせています。

# 複数のフィルターが共有するラベル
filter.neural.param.center_x = 中心 X
filter.neural.param.center_y = 中心 Y
filter.neural.param.direction = 方向
filter.neural.param.transition = 境界のぼかし
filter.neural.param.detail = ディテール
filter.neural.param.eyes = 目

# モデルを使うフィルターがダイアログに表示する説明
filter.neural.msg.using_model = {model} · {license} を使用しています。
filter.neural.msg.get_model = 「フィルター ▸ Neural Filters ▸ モデルを管理」から入手できます。

