tool.brush.name = Четка
tool.brush.description = Насликајте потег со меки рабови во бојата на предниот план, со големината, тврдоста и непроѕирноста на четката поставени во уредувачот.
tool.brush.history.stroke = Четка
tool.pencil.name = Молив
tool.pencil.description = Насликајте потег со остри рабови и без измазнување во бојата на предниот план.
tool.pencil.history.stroke = Молив
tool.eraser.name = Гума
tool.eraser.description = Бришете по потегот, враќајќи го слојот во проѕирна состојба.
tool.eraser.history.stroke = Гума
tool.clone.name = Печат за клонирање
tool.clone.description = Печат за клонирање: кликнете со Alt за да ја поставите изворната точка, па сликајте со пикселите копирани од неа на истото поместување.
tool.clone.history.stroke = Печат за клонирање
tool.dodge.name = Осветлување
tool.dodge.description = Ги осветлува пикселите преку кои минува потегот.
tool.dodge.history.stroke = Осветлување
tool.burn.name = Потемнување
tool.burn.description = Ги затемнува пикселите преку кои минува потегот.
tool.burn.history.stroke = Потемнување
tool.sponge.name = Сунѓер
tool.sponge.description = Ја зголемува или намалува заситеноста на пикселите преку кои минува потегот.
tool.sponge.history.stroke = Сунѓер
tool.blur.name = Заматување
tool.blur.description = Ги заматува пикселите преку кои минува потегот.
tool.blur.history.stroke = Заматување
tool.sharpen.name = Изострување
tool.sharpen.description = Ги изострува пикселите преку кои минува потегот.
tool.sharpen.history.stroke = Изострување
tool.smudge.name = Размачкување
tool.smudge.description = Ја влече бојата по потегот, како да туркате влажна боја.
tool.smudge.history.stroke = Размачкување
tool.heal.name = Корективна четка
tool.heal.description = Корективна четка: кликнете со Alt за да го поставите изворот, па сликајте; текстурата од изворот се меша со сопствената боја и осветлување на одредиштето.
tool.heal.history.stroke = Корективна четка
tool.spot_heal.name = Точкеста корективна четка
tool.spot_heal.description = Точкеста корективна четка: сликајте врз недостаток и тој ќе се замени со текстура земена од околината — не треба да поставувате изворна точка.
tool.spot_heal.history.stroke = Точкеста корективна четка
tool.history_brush.name = Четка за историја
tool.history_brush.description = Враќајте пиксели од снимката на историјата на документот, поништувајќи ја подоцнежната работа потег по потег.
tool.history_brush.history.stroke = Четка за историја
tool.background_eraser.name = Гума за заднина
tool.background_eraser.description = Ја брише бојата земена под средината на четката, а ги остава различните пиксели недопрени, за да се одвои предмет од неговата заднина.
tool.background_eraser.history.stroke = Гума за заднина
tool.gradient.name = Градиент
tool.gradient.description = Повлечете за да го пополните слојот — низ изборот, ако го има — со линеарен градиент што се протега во насоката на влечење од бојата на предниот план кон бојата на заднината.
tool.gradient.radial.name = Радијален градиент
tool.gradient.radial.description = Повлечете од средината нанадвор за да пополните со радијален градиент меѓу боите на предниот план и заднината.
tool.gradient.option.gradient = Градиент
tool.gradient.option.reverse = Обратно
tool.gradient.option.dither = Дитерирање
tool.gradient.choice.foreground_to_background = Од преден план кон заднина
tool.gradient.choice.foreground_to_transparent = Од преден план кон проѕирно
tool.gradient.choice.linear = Линеарен
tool.gradient.choice.radial = Радијален
tool.gradient.choice.angle = Аголен
tool.gradient.choice.reflected = Одразен
tool.gradient.choice.diamond = Ромб
tool.gradient.history.gradient = Градиент
tool.bucket.name = Кофа со боја
tool.bucket.description = Кликнете за поврзаната област со слична боја под покажувачот да ја преплавите со бојата на предниот план, во рамките на толеранцијата на алатката.
tool.bucket.option.contiguous = Поврзано
tool.bucket.option.all_layers = Сите слоеви
tool.bucket.history.fill = Кофа со боја
