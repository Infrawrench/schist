model3d.error.limit = இந்த 3D மாதிரி ஆதரிக்கப்படும் அளவை மீறுகிறது.
model3d.error.render_limit = 16 மெகாபிக்சல்களுக்குக் குறைவான பரப்பை வரைவிக்க மாதிரியின் அளவைக் குறைக்கவும்.
model3d.error.invalid = 3D மாதிரியில் செல்லாத அல்லது ஆதரிக்கப்படாத வடிவியல் உள்ளது.
model3d.error.embedded = உட்பொதிக்கப்பட்ட வடிவியலும் இழையமைப்புகளும் உள்ள GLB கோப்பைப் பயன்படுத்தவும்.
model3d.error.triangles = இறக்குமதி செய்வதற்கு முன் இந்த மாதிரியின் அடிப்படை வடிவங்களை முக்கோணங்களாக மாற்றவும்.
model3d.error.python = Python ஐத் தொடங்க முடியவில்லை. Python 3.10 அல்லது அதற்குப் பிந்தைய பதிப்பை நிறுவி மீண்டும் முயலவும்.
model3d.error.install = முதலில் உள்ளக மறுகட்டமைப்பு மாதிரியை நிறுவவும்.
model3d.error.reconstruction = உள்ளக 3D மறுகட்டமைப்பு தோல்வியடைந்தது.
model3d.error.cancelled = 3D மறுகட்டமைப்பு ரத்துசெய்யப்பட்டது அல்லது அதன் நேர வரம்பை மீறியது.
model3d.error.source = முதலில் காலியாக இல்லாத பட அடுக்கைத் தேர்ந்தெடுக்கவும்.
model3d.error.closed = மறுகட்டமைப்பு முடிவதற்கு முன் மூல ஆவணம் மூடப்பட்டது.
model3d.reconstruct.title = படத்திலிருந்து 3D
model3d.reconstruct.description = இந்தக் கணினியில் TripoSR ஐப் பயன்படுத்தித் தேர்ந்தெடுத்த பட அடுக்கைத் திருத்தக்கூடிய 3D பொருளாக மறுகட்டமைக்கவும். ஏற்கெனவே உள்ள ஒளிபுகுதன்மை பேணப்படும். பின்னணி அகற்றப்படாது.
model3d.reconstruct.install_info = உள்ளக மாதிரியையும் அதன் Python இயக்கச் சூழல் சார்புகளையும் பதிவிறக்கவும். நிறுவலுக்கு வட்டில் பல ஜிகாபைட்டுகள் காலியிடமும் இணைய இணைப்பும் தேவை. அதன் பிறகு மறுகட்டமைப்பு இணையமின்றி இயங்கும்; CUDA கிடைத்தால் அதையும் இல்லையெனில் CPU வையும் பயன்படுத்தும்.
model3d.reconstruct.install = உள்ளக மாதிரியை நிறுவு
model3d.reconstruct.generate = மறுகட்டமை
model3d.reconstruct.installing = உள்ளக மறுகட்டமைப்பு மாதிரி நிறுவப்படுகிறது…
model3d.reconstruct.running = 3D வடிவியல் மறுகட்டமைக்கப்படுகிறது…
model3d.reconstruct.ready = உள்ளக மாதிரி நிறுவப்பட்டது
