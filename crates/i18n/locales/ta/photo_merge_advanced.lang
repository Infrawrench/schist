photo_merge_advanced.projective = கண்ணோட்டச் சீரமைப்பு (சுழற்சியும் அடங்கும்)
photo_merge_advanced.cylindrical = உருளை வடிவப் பரந்த காட்சி
photo_merge_advanced.deghost = நகரும் பொருட்களின் பேய் உருவங்களை அகற்று (முதல் படம் குறிப்பு)
photo_merge_advanced.focal = குவியத் தூரம் (px) / பட அகலம் (px)
photo_merge_advanced.masks = குவிப்பு வெளியீடு திருத்தக்கூடிய அடுக்கு முகமூடிகளைப் பயன்படுத்துகிறது. அடுக்குகளில் ஒரு முகமூடியைத் தேர்ந்தெடுத்து செம்மைப்படுத்த வரையவும்.
photo_merge_advanced.no_match = நம்பகமான சீரமைப்பு கிடைக்கவில்லை. போதிய அளவு ஒன்றையொன்று மேலிடும், தெளிவான விவரங்களுள்ள படங்களையும் குறைந்த பார்வைக்கோண மாற்றத்தையும் பயன்படுத்தவும்.
photo_merge_advanced.invalid = மூலப் படங்கள் அல்லது இணைப்பு அமைப்புகள் செல்லாதவை.
