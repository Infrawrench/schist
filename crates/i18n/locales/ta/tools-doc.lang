tool.artboard.name = கலைப்பலகை
tool.artboard.description = கலைப்பலகையை இழுத்து உருவாக்கவும்: இது தனியாக ஏற்றுமதி செய்யப்படும், பெயரிடப்பட்ட திரைப்பரப்புப் பகுதி. ஏற்கெனவே உள்ள கலைப்பலகைக்குள் இழுத்தால் அதை நகர்த்தும்.
tool.artboard.default_name = கலைப்பலகை {n}

tool.slice.name = துண்டு
tool.slice.description = ஏற்றுமதித் துண்டை இழுத்து உருவாக்கவும்; இது தனிப் படமாக ஏற்றுமதி செய்யப்படும், திரைப்பரப்பின் பெயரிடப்பட்ட செவ்வகப் பகுதி. ஏற்கெனவே உள்ள துண்டுக்குள் இழுத்தால் அதை நகர்த்தும்.
tool.slice.default_name = துண்டு {n}

tool.frame.name = சட்டகம்
tool.frame.description = சட்டகத்தை இழுத்து உருவாக்கவும்: இது அதனுள் வைக்கப்படும் எதையும் முகமூடியிடும் செவ்வக (அல்லது நீள்வட்ட) அடுக்கு.
tool.frame.default_name = சட்டகம் {n}
tool.frame.choice.rectangle = செவ்வகம்
tool.frame.choice.ellipse = நீள்வட்டம்
tool.frame.history.frame = சட்டகம்

tool.note.name = குறிப்பு
tool.note.description = காலியான திரைப்பரப்பில் சொடுக்கி அங்கே குறிப்பைப் பொருத்தவும்; தொகுப்பி நிலையில் உள்ள ஆசிரியர் பெயரும் வண்ணமும் அதில் பதிக்கப்படும். ஏற்கெனவே உள்ள குறிப்புமுனையைச் சொடுக்கி குறிப்புகள் பலகைக்காக அதைத் தேர்ந்தெடுக்கவும்.
tool.note.history.place = குறிப்பை வை
tool.note.history.move = குறிப்பை நகர்த்து
tool.note.history.delete = குறிப்பை நீக்கு

tool.count.name = எண்ணிக்கை
tool.count.description = திரைப்பரப்பில் எண்ணிடப்பட்ட எண்ணிக்கைக் குறிகளை இடச் சொடுக்கவும்; ஏற்கெனவே உள்ள குறியை நீக்க அதைச் சொடுக்கவும்.
tool.count.default_name = எண்ணிக்கை {n}
