tool.gradient.name = வண்ணச்சரிவு
tool.gradient.description = இழுக்கும் திசையில் முன்புல வண்ணத்திலிருந்து பின்னணி வண்ணம் வரையான நேரியல் வண்ணச்சரிவால் அடுக்கை நிரப்ப இழுக்கவும்; தேர்வு இருந்தால் அதற்குள் மட்டும் நிரப்பும்.
