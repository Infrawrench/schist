tool.pen.name = பேனா
tool.pen.description = ஒரு பாதையை உருவாக்கவும்: மூலைப் புள்ளிக்கு சொடுக்கவும், அதிலிருந்து வளைவுக் கைப்பிடிகளை இழுக்கவும், மூட முதல் புள்ளியைச் சொடுக்கவும். உறுதிசெய்தால் பாதை வடிவ அடுக்காக மாறும்.
tool.pen.option.rubber_band = இழுவைப் பட்டை
tool.pen.history.fill = பாதை நிரப்பு
tool.pen.default_path_name = பாதை {n}
tool.pen.freeform.name = கட்டற்ற பேனா
tool.pen.freeform.description = கட்டற்ற கைக் கோட்டை இழுக்கவும்; பொருத்தம் விருப்பத்தின் அளவுக்கேற்ப அது தளர்வாக ஒரு பாதைக்குப் பொருத்தப்படும்.
tool.pen.freeform.option.fit = பொருத்தம்
tool.pen.curvature.name = வளைவுப் பேனா
tool.pen.curvature.description = தொடர்ச்சியான புள்ளிகளைச் சொடுக்கவும்; அவற்றின் வழியே பாதை மென்மையாக வளைக்கப்படும்.
tool.path_select.name = பாதைத் தேர்வு
tool.path_select.description = பாதையைத் தேர்ந்தெடுக்க அதைச் சொடுக்கவும்; முழுப் பாதையையும் நகர்த்த இழுக்கவும்.
tool.direct_select.name = நேரடித் தேர்வு
tool.direct_select.description = ஒரு நங்கூரப் புள்ளியையோ அதன் கைப்பிடிகளையோ இழுத்து, அதைச் சுற்றிய பாதையின் வடிவத்தை மாற்றவும்.
tool.shape.history.layer = {name} அடுக்கு
tool.shape.rect.name = செவ்வகக் கருவி
tool.shape.rect.label = செவ்வகம்
tool.shape.rect.description = முன்புல வண்ணத்தில் செவ்வக வடிவ அடுக்கை இழுத்து உருவாக்கவும்; அது திசையுருவாகவே இருந்து, அளவு மாறும்போது மீண்டும் படப்புள்ளிகளாக்கப்படும்.
tool.shape.ellipse.name = நீள்வட்டக் கருவி
tool.shape.ellipse.label = நீள்வட்டம்
tool.shape.ellipse.description = முன்புல வண்ணத்தில் நீள்வட்ட வடிவ அடுக்கை இழுத்து உருவாக்கவும்.
tool.shape.line.name = கோட்டுக் கருவி
tool.shape.line.label = கோடு
tool.shape.line.description = முன்புல வண்ணத்தில் நேர்கோட்டு வடிவ அடுக்கை இழுத்து உருவாக்கவும்.
tool.shape.line.option.weight = தடிமன்
tool.shape.line.option.arrow_start = தொடக்கம்
tool.shape.line.option.arrow_end = முடிவு
tool.shape.polygon.name = பலகோணக் கருவி
tool.shape.polygon.label = பலகோணம்
tool.shape.polygon.description = விருப்பங்களில் குறிப்பிட்ட பக்க எண்ணிக்கையுடன், முன்புல வண்ணத்தில் ஒழுங்கான பலகோண வடிவ அடுக்கை இழுத்து உருவாக்கவும்.
tool.shape.polygon.option.sides = பக்கங்கள்
tool.shape.custom.name = தனிப்பயன் வடிவம்
tool.shape.custom.label = தனிப்பயன் வடிவம்
tool.shape.custom.description = வடிவம் விருப்பத்தில் தேர்ந்தெடுத்த உள்ளமைந்த முன்னமைவு வடிவங்களில் ஒன்றை இழுத்து உருவாக்கவும்.
tool.shape.custom.choice.heart = இதயம்
tool.shape.custom.choice.star = விண்மீன்
tool.shape.custom.choice.arrow = அம்பு
tool.shape.custom.choice.lightning = மின்னல்
tool.shape.custom.choice.cross = சிலுவை
tool.shape.custom.choice.speech_bubble = பேச்சுக் குமிழி
