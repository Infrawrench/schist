tool.type.name = உரை
tool.type.description = அந்த இடத்தில் உரை அடுக்கைத் தொடங்கச் சொடுக்கவும்; ஏற்கெனவே உள்ள உரை அடுக்கைத் திருத்த அதைச் சொடுக்கவும். திருத்தம் திறந்திருக்கும்போது கருவி நேரடி விசை உள்ளீட்டை ஏற்கும் (எழுத்துகளை விசை உள்ளீடாக அனுப்பவும்); உறுதிசெய்ததும் அடுக்கு படமாக்கப்பட்டு திருத்தம் மூடப்படும்.

