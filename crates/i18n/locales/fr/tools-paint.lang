tool.gradient.choice.reflected = Réfléchi
tool.gradient.choice.diamond = Losange
tool.gradient.history.gradient = Dégradé
tool.bucket.name = Pot de peinture
tool.bucket.description = Cliquez pour remplir avec la couleur de premier plan la zone contiguë de couleur similaire sous le pointeur, selon la tolérance de l’outil.
