tool.brush.name = Pinceau
tool.brush.description = Peignez un trait aux bords doux dans la couleur de premier plan, avec la taille, la dureté et l’opacité de pinceau définies dans l’éditeur.
tool.brush.history.stroke = Pinceau
tool.pencil.name = Crayon
tool.pencil.description = Peignez un trait aux bords nets, sans anticrénelage, dans la couleur de premier plan.
tool.pencil.history.stroke = Crayon
tool.eraser.name = Gomme
tool.eraser.description = Effacez le long du trait pour rendre le calque transparent.
tool.eraser.history.stroke = Gomme
tool.clone.name = Tampon de duplication
tool.clone.description = Tampon de duplication : cliquez en maintenant Alt pour définir le point source, puis peignez les pixels copiés depuis cette source avec le même décalage.
tool.clone.history.stroke = Tampon de duplication
tool.dodge.name = Densité −
tool.dodge.description = Éclaircissez les pixels parcourus par le trait.
tool.dodge.history.stroke = Densité −
tool.burn.name = Densité +
tool.burn.description = Obscurcissez les pixels parcourus par le trait.
tool.burn.history.stroke = Densité +
tool.sponge.name = Éponge
tool.sponge.description = Saturez ou désaturez les pixels parcourus par le trait.
tool.sponge.history.stroke = Éponge
tool.blur.name = Goutte d’eau
tool.blur.description = Rendez flous les pixels parcourus par le trait.
tool.blur.history.stroke = Flou
tool.sharpen.name = Netteté
tool.sharpen.description = Accentuez la netteté des pixels parcourus par le trait.
tool.sharpen.history.stroke = Netteté
tool.smudge.name = Doigt
tool.smudge.description = Étalez la couleur le long du trait, comme si vous poussiez de la peinture humide.
tool.smudge.history.stroke = Doigt
tool.heal.name = Correcteur
tool.heal.description = Correcteur : cliquez en maintenant Alt pour définir la source, puis peignez ; la texture de la source se fond dans la couleur et l’éclairage de la destination.
tool.heal.history.stroke = Correcteur
tool.spot_heal.name = Correcteur localisé
tool.spot_heal.description = Correcteur localisé : peignez sur un défaut pour le remplacer par une texture prélevée autour de lui, sans avoir à définir de point source.
tool.spot_heal.history.stroke = Correcteur localisé
tool.history_brush.name = Forme d’historique
tool.history_brush.description = Rétablissez au pinceau des pixels provenant de l’instantané d’historique du document afin d’annuler les modifications ultérieures, trait par trait.
tool.history_brush.history.stroke = Forme d’historique
tool.background_eraser.name = Gomme d’arrière-plan
tool.background_eraser.description = Effacez la couleur prélevée au centre du pinceau sans toucher aux pixels différents, afin de détacher un sujet de son arrière-plan.
tool.background_eraser.history.stroke = Gomme d’arrière-plan
tool.gradient.name = Dégradé
tool.gradient.description = Faites glisser pour remplir le calque — à travers la sélection s’il y en a une — d’un dégradé linéaire allant de la couleur de premier plan à celle d’arrière-plan dans le sens du glissement.
tool.gradient.radial.name = Dégradé radial
tool.gradient.radial.description = Faites glisser du centre vers l’extérieur pour appliquer un dégradé radial entre les couleurs de premier plan et d’arrière-plan.
