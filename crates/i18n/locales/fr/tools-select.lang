tool.select.mode.subtract = Soustraire
tool.select.mode.intersect = Intersection
tool.marquee.rect.name = Rectangle de sélection
tool.marquee.rect.description = Faites glisser pour créer une sélection rectangulaire. Maj au début du glissement ajoute à la sélection, Alt en soustrait une partie, et les deux touches créent une intersection ; Maj pendant le glissement impose un carré. Un clic sans glissement désélectionne.
tool.marquee.ellipse.name = Ellipse de sélection
tool.marquee.ellipse.description = Faites glisser pour créer une sélection elliptique ; Maj et Alt combinent les sélections comme pour le rectangle de sélection.
tool.lasso.name = Lasso
tool.lasso.description = Tracez un contour à main levée ; la sélection se referme entre les extrémités à la fin du glissement. Maj ajoute, Alt soustrait.
tool.lasso.history.select = Sélection au lasso
tool.lasso.polygonal.name = Lasso polygonal
tool.lasso.polygonal.description = Cliquez successivement sur chaque sommet pour construire une sélection à segments droits, puis près du premier point pour la fermer.
tool.lasso.polygonal.history.select = Lasso polygonal
tool.lasso.magnetic.name = Lasso magnétique
tool.lasso.magnetic.description = Suivez approximativement un bord : le contour s’accroche au contraste le plus marqué à proximité du tracé.
tool.lasso.magnetic.history.select = Lasso magnétique
tool.lasso.magnetic.option.frequency = Fréquence
tool.wand.name = Baguette magique
tool.wand.description = Cliquez pour sélectionner la zone contiguë de couleur similaire sous le pointeur, selon l’option de tolérance — la même que celle utilisée par Étendre, Similaire et Plage de couleurs.
tool.wand.option.contiguous = Pixels contigus
tool.wand.history.select = Baguette magique
tool.quick_select.name = Sélection rapide
tool.quick_select.description = Peignez sur une zone : la sélection s’étend aux pixels similaires parcourus par le pinceau.
tool.quick_select.history.select = Sélection rapide
tool.object_select.name = Sélection d’objet
tool.object_select.description = Tracez un cadre autour d’un objet : la sélection épouse l’objet détecté à l’intérieur.
tool.object_select.history.select = Sélection d’objet
