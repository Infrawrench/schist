command.edit.undo.title = Annuler
command.edit.undo.description = Revenir d’une étape dans l’historique d’annulation du document.
command.edit.redo.title = Rétablir
command.edit.redo.description = Rétablir la dernière modification annulée.
command.edit.copy.title = Copier
command.edit.copy.description = Copier les pixels sélectionnés du calque actif dans le presse-papiers interne (ou le calque entier en l’absence de sélection).
command.edit.copy_merged.title = Copier avec fusion
command.edit.copy_merged.description = Copier la sélection telle qu’elle résulte de la composition de tous les calques visibles, au lieu de copier uniquement le calque actif.
command.edit.cut.title = Couper
command.edit.cut.description = Copier les pixels sélectionnés dans le presse-papiers et les effacer du calque actif.
command.edit.paste.title = Coller
command.edit.paste.description = Coller le contenu du presse-papiers dans un nouveau calque au-dessus du calque actif, centré sur la zone de travail.
command.edit.paste.layer_name = Calque collé
command.edit.paste_in_place.title = Coller sur place
command.edit.paste_in_place.description = Coller le contenu du presse-papiers dans un nouveau calque aux coordonnées depuis lesquelles il a été copié.
command.edit.fill_foreground.title = Remplir avec la couleur de premier plan
command.edit.fill_foreground.description = Remplir la sélection (ou toute la zone de travail en l’absence de sélection) avec la couleur de premier plan.
command.edit.fill_background.title = Remplir avec la couleur d’arrière-plan
command.edit.fill_background.description = Remplir la sélection (ou toute la zone de travail en l’absence de sélection) avec la couleur d’arrière-plan.
command.select.all.title = Tout sélectionner
command.select.all.description = Sélectionner toute la zone de travail.
command.select.deselect.title = Désélectionner
command.select.deselect.description = Supprimer la sélection afin que les modifications s’appliquent de nouveau à tout le calque.
command.select.inverse.title = Intervertir la sélection
command.select.inverse.description = Intervertir les zones sélectionnées et non sélectionnées.
command.select.reselect.title = Resélectionner
command.select.reselect.description = Rétablir la dernière sélection supprimée.
command.select.reselect.msg.nothing_to_reselect = Aucune sélection à rétablir
command.select.feather.title = Contour progressif de la sélection
command.select.feather.description = Adoucir le bord de la sélection par un flou de deux pixels afin que la prochaine modification s’estompe progressivement à cet endroit.
command.select.grow.title = Étendre
command.select.grow.description = Étendre la sélection aux pixels contigus qui ressemblent à ceux déjà sélectionnés, selon la tolérance de la baguette magique.
command.select.similar.title = Similaire
command.select.similar.description = Sélectionner tous les pixels du calque qui ressemblent à la sélection, qu’ils soient contigus ou non, selon la tolérance de la baguette magique.
command.select.save.title = Mémoriser la sélection
command.select.save.description = Enregistrer la sélection active dans le document sous la forme d’une couche alpha nommée.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Récupérer la sélection
command.select.load.description = Rétablir la sélection enregistrée la plus récente.
command.layer.new.title = Nouveau calque
command.layer.new.description = Ajouter un calque pixellisé vide au-dessus du calque actif et l’activer.
command.layer.duplicate.title = Dupliquer le calque
command.layer.duplicate.description = Copier le calque actif et tout son contenu dans un nouveau calque placé au-dessus.
command.layer.smart_object.title = Convertir en objet dynamique
command.layer.smart_object.description = Placer les pixels du calque pixellisé actif dans un objet dynamique afin que les transformations et filtres ultérieurs rééchantillonnent la source intacte.
command.layer.rasterize.title = Pixelliser le calque
command.layer.rasterize.description = Convertir une forme, un texte ou un objet dynamique en simples pixels.
command.layer.delete.title = Supprimer le calque
command.layer.delete.description = Supprimer les calques sélectionnés.
command.layer.group.title = Grouper les calques
command.layer.group.description = Regrouper sur place les calques sélectionnés dans un nouveau groupe.
command.layer.raise.title = Avancer
command.layer.raise.description = Monter le calque actif d’un niveau dans la pile de son groupe.
command.layer.lower.title = Reculer
command.layer.lower.description = Descendre le calque actif d’un niveau dans la pile de son groupe.
command.layer.to_front.title = Premier plan
command.layer.to_front.description = Placer le calque actif tout en haut de son groupe.
command.layer.to_back.title = Arrière-plan
command.layer.to_back.description = Placer le calque actif tout en bas de son groupe.
command.layer.clipping_mask.title = Créer/Annuler un masque d’écrêtage
command.layer.clipping_mask.description = Écrêter le calque actif sur celui du dessous, ou libérer un calque déjà écrêté ; un calque écrêté n’apparaît qu’aux endroits où son calque de base contient des pixels.
command.layer.cut_to_new.title = Calque par couper
command.layer.cut_to_new.description = Retirer les pixels sélectionnés du calque actif et les placer dans un nouveau calque au-dessus.
command.layer.cut_to_new.layer_name = Calque par couper
command.layer.add_mask.title = Ajouter un masque de fusion
command.layer.add_mask.description = Ajouter un masque au calque actif qui ne révèle que la sélection, s’il y en a une.
command.layer.flatten.title = Aplatir l’image
command.layer.flatten.description = Composer tous les éléments visibles dans un unique calque Arrière-plan opaque et supprimer les calques masqués.
command.layer.merge_down.title = Fusionner avec le calque inférieur
command.layer.merge_down.description = Composer le calque actif dans celui situé immédiatement en dessous.
command.layer.merge_down.msg.no_layer_below = Aucun calque inférieur avec lequel fusionner
command.layer.merge_visible.title = Fusionner les calques visibles
command.layer.merge_visible.description = Composer tous les calques visibles en un seul, sans modifier les calques masqués.
command.msg.nothing_to_copy = Sélectionnez un calque de pixels depuis lequel effectuer la copie
command.msg.clipboard_empty = Le presse-papiers est vide
