tool.patch.name = Correcteur
tool.patch.description = Tracez un contour autour d’un défaut, puis faites glisser cette sélection sur des pixels intacts : leur texture est adaptée au défaut. Le mode Correcteur détermine laquelle des deux zones vous déplacez.
tool.patch.option.patch = Correcteur
tool.patch.choice.source = Source
tool.patch.choice.destination = Destination
tool.patch.history.patch = Correction
tool.content_aware_move.name = Déplacement basé sur le contenu
tool.content_aware_move.description = Déplacez un objet sélectionné : le vide qu’il laisse est rempli à partir de son environnement. En mode Extension, l’objet est étiré au lieu d’être déplacé.
tool.content_aware_move.choice.move = Déplacer
tool.content_aware_move.choice.extend = Étendre
tool.content_aware_move.history.move = Déplacement basé sur le contenu
tool.red_eye.name = Yeux rouges
tool.red_eye.description = Cliquez sur une pupille pour en supprimer la dominante rouge provoquée par le flash.
tool.red_eye.option.pupil_size = Taille de la pupille
tool.red_eye.option.darken = Obscurcissement
tool.red_eye.history.red_eye = Correction des yeux rouges
tool.magic_eraser.name = Gomme magique
tool.magic_eraser.description = Cliquez pour effacer, dans la limite de tolérance de l’outil, la zone de couleur similaire sous le pointeur : uniquement les pixels contigus au point cliqué, ou tous ceux du calque.
tool.magic_eraser.option.contiguous = Pixels contigus
tool.magic_eraser.history.erase = Gomme magique

# Remove
tool.remove.name = Supprimer
tool.remove.description = Peignez sur un objet indésirable en un seul tracé ; lorsque vous relâchez, il est comblé à partir de ce qui l’entoure. Si Supprimer après chaque tracé est désactivé, peignez plusieurs tracés et appuyez sur Entrée pour les supprimer ensemble.
tool.remove.option.sample_all_layers = Échantillonner tous les calques
tool.remove.option.remove_after_each_stroke = Supprimer après chaque tracé
tool.remove.history.remove = Supprimer
tool.remove.layer_name = Supprimé
