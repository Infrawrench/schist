smart.error.too_large = Źródło przekracza limit 32 milionów pikseli, 30,000 pikseli na bok lub 64 MiB.
smart.error.invalid = Osadzone źródło obiektu inteligentnego jest nieprawidłowe.
smart.error.unsupported = Tego formatu źródłowego nie można użyć jako obiektu inteligentnego.
smart.error.locked = Odblokuj wszystkie wystąpienia źródła przed ich aktualizacją.
smart.error.select = Wybierz odblokowaną warstwę obiektu inteligentnego.
smart.error.browser_link = Łącza do systemu plików są dostępne w aplikacji komputerowej. W przeglądarce użyj osadzonego obiektu inteligentnego.
smart.error.changed = Miejsce docelowe zmieniło się podczas edycji lub wczytywania. Otwórz ponownie zawartość albo ponownie wybierz źródło.
smart.error.no_link = Ten obiekt inteligentny nie ma łącza do pliku. Wybierz „Połącz ponownie obiekt inteligentny”, aby wskazać źródło.
smart.error.nesting = Zamknij kartę zawartości przed otwarciem kolejnego zagnieżdżonego źródła.
smart.error.parent_closed = Dokument nadrzędny został zamknięty. Wybierz „Zapisz jako…”, aby zachować ten dokument zawartości.
smart.error.file_changed = Połączony plik zmienił się poza programem Schist. Wybierz „Zapisz jako…”, aby zachować zmiany, a następnie wybierz „Połącz ponownie obiekt inteligentny” lub „Aktualizuj połączone wystąpienia”.
