# Frame animation (plugins/commands-core/src/animation.rs).
command.animation.create.title = Utwórz animację klatkową
command.animation.create.description = Rozpocznij animację klatkową, której pierwszą klatką jest dokument w obecnym stanie.
command.animation.make_frames_from_layers.title = Utwórz klatki z warstw
command.animation.make_frames_from_layers.description = Zastąp klatki jedną klatką na każdą warstwę najwyższego poziomu, z których każda pokazuje tylko tę warstwę.
command.animation.flatten_frames_into_layers.title = Spłaszcz klatki do warstw
command.animation.flatten_frames_into_layers.description = Renderuj każdą klatkę do nowej warstwy na górze, widocznej tylko we własnej klatce.
command.animation.new_frame.title = Nowa klatka
command.animation.new_frame.description = Powiel zaznaczoną klatkę i zaznacz kopię.
command.animation.delete_frame.title = Usuń klatkę
command.animation.delete_frame.description = Usuń zaznaczoną klatkę i zaznacz klatkę przed nią.
command.animation.first_frame.title = Pierwsza klatka
command.animation.first_frame.description = Zaznacz pierwszą klatkę animacji.
command.animation.previous_frame.title = Poprzednia klatka
command.animation.previous_frame.description = Zaznacz poprzednią klatkę, przechodząc od pierwszej do ostatniej.
command.animation.next_frame.title = Następna klatka
command.animation.next_frame.description = Zaznacz następną klatkę, przechodząc od ostatniej do pierwszej.
command.animation.last_frame.title = Ostatnia klatka
command.animation.last_frame.description = Zaznacz ostatnią klatkę animacji.
command.animation.reverse_frames.title = Odwróć klatki
command.animation.reverse_frames.description = Odwróć kolejność klatek.
command.animation.delete_animation.title = Usuń animację
command.animation.delete_animation.description = Usuń animację klatkową i zachowaj warstwy w takim stanie, w jakim pokazuje je zaznaczona klatka.
