command.edit.undo.title = Cofnij
command.edit.undo.description = Cofnij się o jedną pozycję w historii zmian dokumentu.
command.edit.redo.title = Ponów
command.edit.redo.description = Ponów ostatnio cofniętą zmianę.
command.edit.copy.title = Kopiuj
command.edit.copy.description = Skopiuj zaznaczone piksele aktywnej warstwy do wewnętrznego schowka (całą warstwę, gdy nic nie jest zaznaczone).
command.edit.copy_merged.title = Kopiuj scalone
command.edit.copy_merged.description = Skopiuj zaznaczenie w postaci wynikowej kompozycji wszystkich widocznych warstw, a nie tylko z aktywnej warstwy.
command.edit.cut.title = Wytnij
command.edit.cut.description = Skopiuj zaznaczone piksele do schowka i usuń je z aktywnej warstwy.
command.edit.paste.title = Wklej
command.edit.paste.description = Wklej zawartość schowka na nowej warstwie nad aktywną warstwą, wyśrodkowaną na obszarze roboczym.
command.edit.paste.layer_name = Wklejona warstwa
command.edit.paste_in_place.title = Wklej w miejscu
command.edit.paste_in_place.description = Wklej zawartość schowka na nowej warstwie w miejscu, z którego została skopiowana.
command.edit.fill_foreground.title = Wypełnij kolorem narzędzia
command.edit.fill_foreground.description = Wypełnij zaznaczenie (lub cały obszar roboczy, gdy nic nie jest zaznaczone) kolorem narzędzia.
command.edit.fill_background.title = Wypełnij kolorem tła
command.edit.fill_background.description = Wypełnij zaznaczenie (lub cały obszar roboczy, gdy nic nie jest zaznaczone) kolorem tła.
command.select.all.title = Zaznacz wszystko
command.select.all.description = Zaznacz cały obszar roboczy.
command.select.deselect.title = Usuń zaznaczenie
command.select.deselect.description = Usuń zaznaczenie, aby zmiany znów obejmowały całą warstwę.
command.select.inverse.title = Odwróć zaznaczenie
command.select.inverse.description = Zamień miejscami obszary zaznaczone i niezaznaczone.
command.select.reselect.title = Zaznacz ponownie
command.select.reselect.description = Przywróć ostatnio usunięte zaznaczenie.
command.select.reselect.msg.nothing_to_reselect = Brak zaznaczenia do przywrócenia
command.select.feather.title = Wtapianie zaznaczenia
command.select.feather.description = Zmiękcz krawędź zaznaczenia rozmyciem o dwa piksele, aby kolejna zmiana łagodnie zanikała na jego brzegu.
command.select.grow.title = Powiększ
command.select.grow.description = Rozszerz zaznaczenie na sąsiednie piksele podobne do już zaznaczonych, zgodnie z tolerancją różdżki.
command.select.similar.title = Podobne
command.select.similar.description = Zaznacz wszystkie piksele warstwy podobne do zaznaczenia, niezależnie od tego, czy do niego przylegają, zgodnie z tolerancją różdżki.
command.select.save.title = Zapisz zaznaczenie
command.select.save.description = Zachowaj bieżące zaznaczenie w dokumencie jako nazwany kanał alfa.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Wczytaj zaznaczenie
command.select.load.description = Przywróć ostatnio zapisane zaznaczenie.
command.layer.new.title = Nowa warstwa
command.layer.new.description = Dodaj pustą warstwę rastrową nad aktywną warstwą i uaktywnij ją.
command.layer.duplicate.title = Powiel warstwę
command.layer.duplicate.description = Skopiuj aktywną warstwę wraz z całą zawartością na nową warstwę nad nią.
command.layer.smart_object.title = Konwertuj na obiekt inteligentny
command.layer.smart_object.description = Umieść piksele aktywnej warstwy rastrowej w obiekcie inteligentnym, aby późniejsze przekształcenia i filtry ponownie próbkowały nietknięte źródło.
command.layer.rasterize.title = Rasteryzuj warstwę
command.layer.rasterize.description = Zamień warstwę kształtu, tekstową lub obiektu inteligentnego na zwykłe piksele.
command.layer.delete.title = Usuń warstwę
command.layer.delete.description = Usuń zaznaczone warstwy.
command.layer.group.title = Grupuj warstwy
command.layer.group.description = Umieść zaznaczone warstwy w nowej grupie w ich obecnym miejscu.
command.layer.raise.title = Przesuń do przodu
command.layer.raise.description = Przesuń aktywną warstwę o jedno miejsce w górę stosu jej grupy.
command.layer.lower.title = Przesuń do tyłu
command.layer.lower.description = Przesuń aktywną warstwę o jedno miejsce w dół stosu jej grupy.
command.layer.to_front.title = Przenieś na wierzch
command.layer.to_front.description = Przenieś aktywną warstwę na szczyt jej grupy.
command.layer.to_back.title = Przenieś na spód
command.layer.to_back.description = Przenieś aktywną warstwę na spód jej grupy.
command.layer.clipping_mask.title = Utwórz/zwolnij maskę przycinającą
command.layer.clipping_mask.description = Przytnij aktywną warstwę do warstwy poniżej albo zwolnij ją, jeśli jest już przycięta; przycięta warstwa jest widoczna tylko tam, gdzie warstwa bazowa ma piksele.
command.layer.cut_to_new.title = Warstwa przez wycinanie
command.layer.cut_to_new.description = Przenieś zaznaczone piksele z aktywnej warstwy na nową warstwę nad nią.
command.layer.cut_to_new.layer_name = Warstwa przez wycinanie
command.layer.add_mask.title = Dodaj maskę warstwy
command.layer.add_mask.description = Dodaj maskę do aktywnej warstwy, pokazującą tylko zaznaczenie, jeśli istnieje.
command.layer.flatten.title = Spłaszcz obraz
command.layer.flatten.description = Połącz całą widoczną zawartość w jedną nieprzezroczystą warstwę Tło, odrzucając ukryte warstwy.
command.layer.merge_down.title = Scal w dół
command.layer.merge_down.description = Połącz aktywną warstwę z warstwą pod nią.
command.layer.merge_down.msg.no_layer_below = Brak warstwy poniżej do scalenia
command.layer.merge_visible.title = Scal widoczne
command.layer.merge_visible.description = Połącz wszystkie widoczne warstwy w jedną, pozostawiając ukryte bez zmian.
command.msg.nothing_to_copy = Wybierz warstwę pikselową, z której chcesz kopiować
command.msg.clipboard_empty = Schowek jest pusty
