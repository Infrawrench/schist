lens_profiles.invalid = Wybierz prawidłową bazę danych XML Lensfun v1/v2 (do 8 MiB) z obsługiwanymi danymi aparatu lub obiektywu.
lens_profiles.calibration = Kalibracja obiektywu
lens_profiles.no_calibration = Żadna kalibracja nie obejmuje tych ustawień. Sprawdź ogniskową i współczynnik kadrowania aparatu; korekcja ręczna jest nadal dostępna.
lens_profiles.import = Importuj plik XML Lensfun…
lens_profiles.imported = Baza danych Lensfun została zaimportowana na tę sesję. Wybierz profil lub dopasuj go do metadanych zdjęcia.
lens_profiles.manual = Tylko korekcja ręczna
lens_profiles.saved = Zapisana kalibracja (baza danych niedostępna)
lens_profiles.profile = Profil obiektywu
lens_profiles.aperture = Przysłona (0 = nieznana)
lens_profiles.distance = Odległość ostrzenia (0 = nieznana)
lens_profiles.vignette = Skalibrowana korekcja winietowania
lens_profiles.color_context = Skalibrowana korekcja winietowania wymaga wbudowanego profilu sRGB. Przekonwertuj obraz do sRGB, aby zachować jego wygląd, a następnie ponownie otwórz „Korekcja obiektywu”. Pikselom już zapisanym w sRGB, lecz bez oznaczenia profilu, wystarczy przypisać sRGB. Korekcja geometrii i aberracji chromatycznej pozostaje dostępna.
lens_profiles.vignette_missing = Żadna kalibracja winietowania nie obejmuje tej przysłony i odległości ostrzenia. Wprowadź zmierzone wartości, aby ją włączyć; w wielu profilach Lensfun 1000 m oznacza odległe ogniskowanie.
lens_profiles.note = Skalibrowana korekcja działa przed ustawieniami ręcznymi. Użyj pełnego oryginalnego kadru, a potem przytnij obraz. Zapisz stos filtrów w PSD/PSB, aby zachować możliwość edycji kalibracji.
lens_profiles.automatic = Dopasuj do metadanych zdjęcia
lens_profiles.components = Działanie profilu: dystorsja {distortion}; aberracja chromatyczna {tca}; winietowanie {vignette}.
