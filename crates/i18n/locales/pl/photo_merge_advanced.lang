photo_merge_advanced.projective = Wyrównanie perspektywy (z obrotem)
photo_merge_advanced.cylindrical = Panorama cylindryczna
photo_merge_advanced.deghost = Usuń duchy ruchomych obiektów (pierwsze zdjęcie jako odniesienie)
