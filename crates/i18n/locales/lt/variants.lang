# Virtual copies.
variants.create = Sukurti virtualią kopiją…
variants.rename = Pervardyti virtualią kopiją…
variants.delete = Ištrinkite virtualią kopiją
variants.close = Uždarykite šią nuotrauką ir jos virtualias kopijas prieš jas perkeldami arba ištrindami.
variants.saved_hint = Kopija pradedama nuo išsaugoto redagavimo arba originalo, kai jo nėra. Pirmiausia išsaugokite laukiančius pakeitimus.
variants.move_original = Perkelkite originalią nuotrauką, kad perkeltumėte jos virtualias kopijas.
variants.protected_export = Pasirinkite kitą kelionės tikslą. Galerijos eksportavimas negali pakeisti originalo ar jos redagavimo saugyklos.
