tool.marquee.rect.name = Stačiakampis žymėjimas
tool.marquee.rect.description = Vilkdami pažymėkite stačiakampę sritį. Jei pradėdami vilkti laikote „Shift“, sritis pridedama prie pažymėjimo, jei laikote „Alt“ – atimama, o laikant abu klavišus paliekama sankirta; jei „Shift“ laikote vilkdami, sukuriamas kvadratas. Spustelėjus nevelkant žymėjimas panaikinamas.
tool.marquee.ellipse.name = Elipsinis žymėjimas
tool.marquee.ellipse.description = Vilkdami pažymėkite elipsinę sritį; ją su esamu žymėjimu galima jungti tais pačiais „Shift“ ir „Alt“ deriniais kaip stačiakampio žymėjimo įrankiu.

tool.lasso.name = Lasas
