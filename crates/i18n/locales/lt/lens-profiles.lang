# Lens profiles.
lens_profiles.invalid = Pasirinkite galiojančią Lensfun v1/v2 XML duomenų bazę (iki 8 MiB) su palaikomais fotoaparato arba objektyvo duomenimis.
lens_profiles.calibration = Objektyvo kalibravimas
lens_profiles.no_calibration = Joks kalibravimas neapima šių nustatymų. Patikrinkite židinio nuotolį ir fotoaparato apkarpymo koeficientą; rankinis taisymas išlieka.
lens_profiles.import = Importuoti Lensfun XML…
lens_profiles.imported = Šiam seansui importuota Lensfun duomenų bazė. Pasirinkite profilį arba suderinkite nuotraukos metaduomenis.
lens_profiles.manual = Tik rankinis taisymas
lens_profiles.saved = Išsaugotas kalibravimas (duomenų bazė nepasiekiama)
lens_profiles.profile = Objektyvo profilis
lens_profiles.aperture = Diafragma (0 = nežinoma)
lens_profiles.distance = Fokusavimo atstumas (0 = nežinomas)
lens_profiles.vignette = Kalibruotas vinjetavimas
lens_profiles.color_context = Kalibruotam vinjetavimui reikalingas integruotas sRGB profilis. Konvertuokite į sRGB, kad išsaugotumėte išvaizdą, tada vėl atidarykite objektyvo korekciją. Jau sRGB nepažymėtiems pikseliams pakanka priskirti sRGB. Geometrija ir chromatinė korekcija išlieka prieinama.
lens_profiles.vignette_missing = Joks vinjetavimo kalibravimas neapima diafragmos ir fokusavimo atstumo. Įveskite išmatuotas vertes, kad ją įjungtumėte; 1000 m reiškia tolimą židinį daugelyje Lensfun profilių.
lens_profiles.note = Kalibruota korekcija atliekama prieš rankinius valdiklius. Naudokite originalų pilną kadrą; vėliau apkarpykite. Išsaugokite filtrų krūvą PSD/PSB, kad išlaikytumėte redaguojamą kalibravimą.
lens_profiles.automatic = Suderinkite nuotraukos metaduomenis
lens_profiles.components = Profilio korekcija: iškraipymas {distortion}; spalvos pakraščiai {tca}; vinjetavimas {vignette}.
