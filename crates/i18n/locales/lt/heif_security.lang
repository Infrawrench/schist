# HEIC security update.
codec.heif.msg.unsafe_version = „libheif“ {version} naudoti atsisakoma dėl žinomų saugumo spragų; reikia {minimum} arba naujesnės versijos. Atsisiųskite atnaujintą HEIC palaikymą arba atnaujinkite sistemos biblioteką.
codec.heif.msg.unknown_version = „libheif“ naudoti atsisakoma, nes nepavyksta patikrinti jos versijos; reikia {minimum} arba naujesnės versijos. Atsisiųskite atnaujintą HEIC palaikymą arba atnaujinkite sistemos biblioteką.
dialog.open.heic_needs_safe_decoder = Failui „{name}“ atverti reikia „libheif“ {minimum} arba naujesnės versijos su HEVC dekoderiu. Senesnės versijos ir versijos, kurių negalima patikrinti, blokuojamos siekiant apsaugoti nuo žinomų saugumo spragų. Norėdami tęsti, atsisiųskite atnaujintą HEIC palaikymą.
workspace.docs.heic_safe_decoder_needed = Reikia atnaujinto HEIC palaikymo
