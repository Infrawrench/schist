tethered.title = Fotografavimas prijungtu fotoaparatu
tethered.capture = Fotografuoti
tethered.invalid_name = Pasirinkite 1–120 baitų ilgio pavadinimą be pasvirųjų brūkšnių, dvitaškių, procento ženklų ar taško pradžioje.
tethered.install = Sistemos fotoaparato biblioteka nepasiekiama. Įdiekite šiai platformai skirtą fotoaparato vykdymo aplinką ir iš naujo paleiskite Schist.
tethered.timeout = Baigėsi fotoaparato užklausos laikas. Prieš bandydami dar kartą patikrinkite fotoaparatą ir prijunkite jį iš naujo.
tethered.failed = Fotoaparato užklausa nepavyko: {detail}
tethered.unsupported = Šis fotoaparatas nepraneša, kad palaiko nuotolinį fotografavimą.
tethered.no_download = Fotoaparatas neperdavė viso vaizdo. Originalai fotoaparate išsaugomi.
tethered.session_help = Pasirinkite fotoaparatą, tada spustelėkite „Fotografuoti“. Fotografuodami pirmą kartą pasirinkite įrašymo vietą ir failo vardo pradžią; kiekvienai nuotraukai pridedamas eilės numeris ir fotoaparato failo plėtinys. „Įrašyti kaip…“ pakeičia vietą ir failo vardo pradžią.
tethered.preview_failed = Nuotrauka įrašyta ir importuota, tačiau jos peržiūros nepavyko iškoduoti. Atverkite failą redaktoriuje ir patikrinkite.
tethered.partial = Kai kurie nuotraukų failai buvo įrašyti ir importuoti; likusių įrašyti nepavyko: {error}
tethered.camera_permission = Sistemos nuostatose → Privatumas ir sauga → Fotoaparatas leiskite naudoti fotoaparatą, tada vėl bandykite „Fotografuoti“. Jei Schist paleidote iš terminalo, patikrinkite ir to terminalo leidimą naudoti fotoaparatą.
tethered.camera_usage_missing = Šioje programos versijoje nėra fotoaparato leidimo aprašo. Iš naujo sukurkite Schist naudodami make arba naudokite supakuotą programą.
tethered.select_camera = Pasirinkite fotoaparatą nuotraukai padaryti.
tethered.choose_destination = „Fotografuoti“ paprašys pasirinkti, kur įrašyti nuotraukas.
tethered.preview_empty = Nufotografuokite, kad pamatytumėte nuotrauką čia.
tethered.save_local = Įrašyti vietoje
tethered.save_cloud = Įrašyti debesijoje
tethered.cloud_help = Nuotraukos įkeliamos į pasirinktą Schist Cloud vietą. Vietinėje galerijoje jų kopijos nelaikomos.
tethered.cloud_pending = Neužbaigti įkėlimai saugomi adresu {path}.
