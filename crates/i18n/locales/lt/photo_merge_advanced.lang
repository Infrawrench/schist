# Translated photo merge options.
photo_merge_advanced.projective = Perspektyvus lygiavimas (įskaitant pasukimą)
photo_merge_advanced.cylindrical = Cilindrinė panorama
photo_merge_advanced.deghost = Pašalinti judančių objektų dvigubus atvaizdus (pirmoji nuotrauka kaip atskaita)
photo_merge_advanced.focal = Židinio nuotolis (px) / vaizdo plotis (px)
photo_merge_advanced.masks = Fokusavimo išvestis naudoja redaguojamas sluoksnių kaukes. Sluoksniuose pasirinkite kaukę ir pieškite, kad patikslintumėte.
photo_merge_advanced.no_match = Nerasta patikimo derinimo. Naudokite tekstūruotas nuotraukas su dideliu persidengimu ir nedideliais požiūrio pasikeitimais.
photo_merge_advanced.invalid = Netinkami šaltinio vaizdai arba sujungimo nustatymai.
