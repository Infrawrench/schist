tool.type.name = ཡིག་གཟུགས།
tool.type.description = ས་གནས་དེ་ཁར་ཚིག་ཡིག་གི་བང་རིམ་ཅིག་འགོ་བཙུགས་ནིའི་དོན་ལུ་ཨེབ་ ཡང་ན་ཡོད་བཞིན་པའི་བང་རིམ་ཅིག་ཞུན་དག་འབད་ནིའི་དོན་ལུ་ཨེབ། འདི་ཁ་ཕྱེ་སྟེ་ཡོདཔ་ད་ ལག་ཆས་ཀྱིས་ལྡེ་མིག་ཐད་ཀར་ལེནམ་ཨིན་ (ཡིག་འབྲུ་ཚུ་ལྡེ་མིག་ཨིན་པུཊ་སྦེ་གཏང་།) ངོས་ལེན་འབད་བ་ཅིན་ཚིག་ཡིག་དེ་བང་རིམ་གུ་པར་རིས་སྦེ་བཟོ་ཞིནམ་ལས་ཞུན་དག་ཁ་བསྡམས་ཨིན།
