tool.quick_select.name = Fili Vave
tool.quick_select.description = Vali ʻi ha feituʻu pea ʻe tupu ʻa e feituʻu kuo filí ʻi he ngaahi pikisi tatau ʻoku kolosi ai ʻa e polosí.
tool.quick_select.history.select = Fili Vave

tool.object_select.name = Fili Meʻa
tool.object_select.description = Toho ha puha takatakai ʻi ha meʻa pea ʻe piki ʻa e feituʻu kuo filí ki he meʻa ʻoku maʻu ʻi lotó.
tool.object_select.history.select = Fili Meʻa
