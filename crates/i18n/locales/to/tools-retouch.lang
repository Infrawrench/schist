# Ngaahi meʻangāue toe fakalelei feituʻu

tool.patch.name = Fakapipiki
tool.patch.description = Toho ha laine takatakai ʻi ha mele, pea toho ʻa e feituʻu kuo filí ki ha ngaahi pikiseli maʻa: ʻe fakafeʻungaʻi ʻa e anga ʻo e fukahi meʻa ʻi aí ki he melé. ʻOku fili ʻe he founga Fakapipikí ʻa e ngataʻanga ʻo e hoa ʻokú ke tohó.
