tool.puppet_warp.name = Mioʻi Papeti
tool.puppet_warp.description = Lomi ke fakamaʻu ʻa e Layer ʻi ha ngaahi poini, pea toho ha poini ʻe taha: ʻe piʻo ʻa e kupengá takatakai ʻi he ngaahi pine, ʻo fefeka pe molū ʻo hangē ko e meʻa fili Fefeká. ʻE ngāueʻaki ia ʻi hono fakapapauʻí.
tool.puppet_warp.option.stiffness = Fefeka
tool.puppet_warp.history.puppet_warp = Mioʻi Papeti

tool.vanishing_point.name = Poini Pulia
tool.vanishing_point.description = Toho ha fukahi tokalelei ʻi ha meʻa ʻoku ʻi ai ha sio mamaʻo, pea liliu ʻa e foungá ki he Fakatatau mo vali: ʻe muimui ʻa e ngaahi pikiseli kuo hiki tatau ki he fukahi tokaleleí, ʻo fakasiʻisiʻi ʻi he fakaʻau ke mamaʻó.
