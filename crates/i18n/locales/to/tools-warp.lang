# Ngaahi meʻangāue mioʻi

tool.liquify.name = Fakavaia
tool.liquify.description = Teke, takai, fakatahatahaʻi pe fakafufula ʻa e ngaahi pikiseli ʻi lalo ʻi ha polosi lahi—ʻoku fili ʻe he meʻa fili ki he foungá ʻa e ngāue. ʻOku tānaki ʻa e mioʻí ʻi ha kupenga pea ngāueʻaki ki he Layer ʻi hono fakapapauʻí.
