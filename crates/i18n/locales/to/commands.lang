# Ngaahi fekau tefito

command.edit.undo.title = Fakafoki ʻa e Ngāue
command.edit.undo.description = Foki ʻaki ha sitepu ʻe taha ʻi he hisitōlia fakafoki ngāue ʻo e fakamatala.
command.edit.redo.title = Toe Fai
command.edit.redo.description = Toe fai ʻa e fakatonutonu naʻe toki fakafoki.
command.edit.copy.title = Hiki Tatau
command.edit.copy.description = Hiki tatau ʻa e ngaahi pikisi kuo fili ʻo e Layer lolotongá ki he clipboard ʻi lotó (ʻa e Layer kotoa kapau ʻoku ʻikai ha feituʻu kuo fili).
command.edit.copy_merged.title = Hiki Tatau Kuo Fakatahaʻi
command.edit.copy_merged.description = Hiki tatau ʻa e feituʻu kuo filí ʻo hangē ko hono fakatahaʻi ʻe he ngaahi Layer kotoa ʻoku hā maí, kae ʻikai mei he Layer lolotongá pē.
command.edit.cut.title = Kosi
command.edit.cut.description = Hiki tatau ʻa e ngaahi pikisi kuo filí ki he clipboard pea tamateʻi kinautolu mei he Layer lolotongá.
command.edit.paste.title = Fakapipiki
command.edit.paste.description = Fakapipiki ʻa e clipboard ki ha Layer foʻou ʻi ʻolunga ʻi he Layer lolotongá, ʻo fokotuʻu ʻi he lotoloto ʻo e kanivā.
command.edit.paste.layer_name = Layer Kuo Fakapipiki
command.edit.paste_in_place.title = Fakapipiki ʻi Hono Tuʻuʻanga
command.edit.paste_in_place.description = Fakapipiki ʻa e clipboard ki ha Layer foʻou ʻi he ngaahi tuʻunga naʻe hiki tatau mei aí.
command.edit.fill_foreground.title = Fakafonu ʻaki ʻa e Lanu Muʻa
command.edit.fill_foreground.description = Fakafonu ʻa e feituʻu kuo filí (pe kanivā kotoa kapau ʻoku ʻikai ha feituʻu kuo fili) ʻaki ʻa e lanu muʻá.
command.edit.fill_background.title = Fakafonu ʻaki ʻa e Lanu Tuʻa
command.edit.fill_background.description = Fakafonu ʻa e feituʻu kuo filí (pe kanivā kotoa kapau ʻoku ʻikai ha feituʻu kuo fili) ʻaki ʻa e lanu tuʻá.

command.select.all.title = Fili Kotoa
command.select.all.description = Fili ʻa e kanivā kotoa.
command.select.deselect.title = Taʻefili
command.select.deselect.description = Toʻo ʻa e feituʻu kuo filí, ke toe ngāue ʻa e ngaahi fakatonutonú ki he Layer kotoa.
command.select.inverse.title = Fulihi ʻa e Filí
command.select.inverse.description = Fetongi ʻa e ngaahi feituʻu kuo filí mo ia ʻoku teʻeki filí.
command.select.reselect.title = Toe Fili
command.select.reselect.description = Toe ʻomi ʻa e feituʻu naʻe toki taʻefilí.
command.select.reselect.msg.nothing_to_reselect = ʻIkai ha meʻa ke toe fili
command.select.feather.title = Fakamolū Ngataʻanga ʻo e Filí
command.select.feather.description = Fakamolū ʻa e tapa ʻo e feituʻu kuo filí ʻaki ha fakamolū ʻīmisi pikisi ʻe ua, koeʻuhi ke mōlia māmālie ʻa e fakatonutonu hokó ʻi hono tapá.
command.select.grow.title = Fakatupu
command.select.grow.description = Fakalahi ʻa e feituʻu kuo filí ki he ngaahi pikisi ʻoku ala ki ai pea tatau mo e meʻa kuo ʻosi filí, ʻo fakatatau ki he ngofua ʻa e Vaʻakau Mana.
command.select.similar.title = Tatau
command.select.similar.description = Fili ʻa e pikisi kotoa ʻi he Layer ʻoku tatau mo e feituʻu kuo filí, ʻo tatau ai pē pe ʻoku ala ki ai, ʻo fakatatau ki he ngofua ʻa e Vaʻakau Mana.
command.select.save.title = Seivi ʻa e Feituʻu Kuo Fili
command.select.save.description = Tauhi ʻa e feituʻu kuo fili lolotongá ʻi he fakamatala ko ha sēnolo ʻalifa kuo fakahingoa.
command.select.save.channel_name = ʻAlifa {n}
command.select.load.title = Fakaheka ʻa e Feituʻu Kuo Fili
command.select.load.description = Toe ʻomi ʻa e feituʻu naʻe toki seivi.

command.layer.new.title = Layer Foʻou
command.layer.new.description = Tānaki ha Layer raster ʻataʻatā ʻi ʻolunga ʻi he Layer lolotongá pea ʻai ia ko e Layer lolotonga.
command.layer.duplicate.title = Faʻu Tatau ʻo e Layer
command.layer.duplicate.description = Hiki tatau ʻa e Layer lolotongá mo hono kakanó kotoa ki ha Layer foʻou ʻi ʻolunga ai.
command.layer.smart_object.title = Liliu ko e Smart Object
command.layer.smart_object.description = Faʻofaki ʻa e ngaahi pikisi ʻo e Layer raster lolotongá ʻi ha smart object, koeʻuhi ke toe fakafuofua ʻa e ngaahi liliu faʻunga mo e sivi kimui angé mei he tupuʻanga taʻe liliú.
command.layer.rasterize.title = Liliu ʻa e Layer ki he Raster
command.layer.rasterize.description = Liliu fakapapauʻi ha Layer anga, tohi pe smart-object ki he ngaahi pikisi angamaheni.
command.layer.delete.title = Tamateʻi ʻa e Layer
command.layer.delete.description = Tamateʻi ʻa e ngaahi Layer kuo filí.
command.layer.group.title = Fakakulupu ʻa e Ngaahi Layer
command.layer.group.description = Faʻofaki ʻa e ngaahi Layer kuo filí ʻi ha kulupu foʻou ʻi honau tuʻuʻanga pē.
command.layer.raise.title = ʻOmi Ki Muʻa
command.layer.raise.description = ʻUnuʻi ʻa e Layer lolotongá ki ʻolunga ʻaki ha tuʻunga ʻe taha ʻi he fokotuʻunga ʻo hono kulupú.
command.layer.lower.title = ʻAve Ki Mui
command.layer.lower.description = ʻUnuʻi ʻa e Layer lolotongá ki lalo ʻaki ha tuʻunga ʻe taha ʻi he fokotuʻunga ʻo hono kulupú.
command.layer.to_front.title = ʻOmi ki Muʻa Taha
command.layer.to_front.description = ʻUnuʻi ʻa e Layer lolotongá ki ʻolunga taha ʻi hono kulupú.
command.layer.to_back.title = ʻAve ki Mui Taha
command.layer.to_back.description = ʻUnuʻi ʻa e Layer lolotongá ki lalo taha ʻi hono kulupú.
command.layer.clipping_mask.title = Faʻu/Fakaʻatā ʻa e Clipping Mask
command.layer.clipping_mask.description = Kosi fakangatangata ʻa e Layer lolotongá ki he Layer ʻi lalo aí, pe fakaʻatā ia kapau kuo ʻosi fakangatangata; ʻoku hā pē ha Layer kuo fakangatangata ʻi he feituʻu ʻoku ʻi ai ʻa e ngaahi pikisi ʻo hono tuʻungá.
command.layer.cut_to_new.title = Layer ʻi he Kosi
command.layer.cut_to_new.description = ʻUnuʻi ʻa e ngaahi pikisi kuo filí mei he Layer lolotongá ki ha Layer foʻou ʻi ʻolunga ai.
command.layer.cut_to_new.layer_name = Layer ʻi he Kosi
command.layer.add_mask.title = Tānaki ha Mask Layer
command.layer.add_mask.description = Tānaki ha mask Layer ki he Layer lolotongá, ʻo fakahā pē ʻa e feituʻu kuo filí kapau ʻoku ʻi ai.
command.layer.flatten.title = Fakapapatahi ʻa e ʻĪmisi
command.layer.flatten.description = Fakatahaʻi ʻa e meʻa kotoa ʻoku hā maí ki ha Layer Tuʻa ʻe taha ʻoku ʻikai transparent, pea liʻaki ʻa e ngaahi Layer ʻoku fufuú.
command.layer.merge_down.title = Fakatahaʻi Ki Lalo
command.layer.merge_down.description = Fakatahaʻi ʻa e Layer lolotongá ki he Layer ʻi lalo aí.
command.layer.merge_down.msg.no_layer_below = ʻIkai ha Layer ʻi lalo ke fakatahaʻi ki ai
command.layer.merge_visible.title = Fakatahaʻi ʻa e Ngaahi Meʻa ʻOku Hā Mai
command.layer.merge_visible.description = Fakatahaʻi ʻa e ngaahi Layer kotoa ʻoku hā maí ki ha taha, kae tuku ʻa e ngaahi Layer ʻoku fufuú.

command.msg.nothing_to_copy = Fili ha Layer pikisi ke hiki tatau mei ai
command.msg.clipboard_empty = ʻIkai ha meʻa ʻi he clipboard

