# Ngaahi meʻangāue vali

tool.brush.name = Polosi
tool.brush.description = Vali ha laine ngatangata molū ʻaki ʻa e lanu muʻá, ʻo fakatatau hono lahí ki he lahi, fefeka mo e lahi ʻo e ʻufiʻufi ʻo e polosi ʻi he ʻētita.
