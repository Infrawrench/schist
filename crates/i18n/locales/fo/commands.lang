command.edit.copy.title = Avrita
command.edit.copy.description = Avrita valdu myndadeplarnar á virka lagnum til innaru setiborðsgoymsluna (alt lagið, tá einki er valt).
command.edit.copy_merged.title = Avrita samanlagt
command.edit.copy_merged.description = Avrita valið soleiðis, sum øll sjónlig løg verða sett saman, heldur enn bert úr virka lagnum.
command.edit.cut.title = Klipp
command.edit.cut.description = Avrita valdu myndadeplarnar til setiborðsgoymsluna og strika teir úr virka lagnum.
command.edit.paste.title = Set inn
command.edit.paste.description = Set setiborðsgoymsluna inn í eitt nýtt lag oman fyri virka lagið, miðsett á løriftinum.
