# Painting tools.
tool.brush.name = Pensil
tool.brush.description = Mála eina striku við bleytum kanti í forgrundarlitinum; støddin verður ásett av penslastødd, hørðleika og ógjøgnumskygni í ritlinum.
tool.brush.history.stroke = Pensil
tool.pencil.name = Blýantur
tool.pencil.description = Mála eina striku við hørðum kanti og uttan kantjavning í forgrundarlitinum.
tool.pencil.history.stroke = Blýantur
tool.eraser.name = Viskileður
tool.eraser.description = Strika fram við strokuni og ger lagið gjøgnumskygt aftur.
tool.eraser.history.stroke = Viskileður
tool.clone.name = Klonustempul
tool.clone.description = Klonustempul: Alt-klikka fyri at seta keldupunktið, og mála síðani myndadeplar, sum verða avritaðir haðani við somu frástøðu.
tool.clone.history.stroke = Klonustempul
tool.dodge.name = Lýs
tool.dodge.description = Ger myndadeplarnar, sum strokan fer yvir, ljósari.
tool.dodge.history.stroke = Lýs
tool.burn.name = Brenn
tool.burn.description = Ger myndadeplarnar, sum strokan fer yvir, myrkari.
tool.burn.history.stroke = Brenn
tool.sponge.name = Svampur
tool.sponge.description = Øk ella minka litmettnina í myndadeplunum, sum strokan fer yvir.
tool.sponge.history.stroke = Svampur
tool.blur.name = Ger óskarpt
tool.blur.description = Ger myndadeplarnar, sum strokan fer yvir, óskarpari.
tool.blur.history.stroke = Ger óskarpt
tool.sharpen.name = Ger skarpt
tool.sharpen.description = Ger myndadeplarnar, sum strokan fer yvir, skarpari.
tool.sharpen.history.stroke = Ger skarpt
tool.smudge.name = Smyr
tool.smudge.description = Drag lit fram við strokuni, sum hevði tú skumpað váta máling.
tool.smudge.history.stroke = Smyr
tool.heal.name = Bøtipensil
tool.heal.description = Bøtipensil: Alt-klikka fyri at seta kelduna, og mála síðani; yvirflatubygnaðurin frá kelduni verður blandaður saman við litinum og lýsingini á málstaðnum.
tool.heal.history.stroke = Bøtipensil
tool.spot_heal.name = Flekkbøtipensil
tool.spot_heal.description = Flekkbøtipensil: mála yvir eitt lýti, so verður tað skift út við yvirflatubygnað úr økinum rundanum — einki keldupunkt skal setast.
tool.spot_heal.history.stroke = Flekkbøtipensil
tool.history_brush.name = Søgupensil
tool.history_brush.description = Mála myndadeplar aftur úr søgumyndini hjá skjalinum og angra seinni arbeiði stroku fyri stroku.
tool.history_brush.history.stroke = Søgupensil
tool.background_eraser.name = Bakgrundarviskileður
tool.background_eraser.description = Strika litin, sum verður tikin undir miðjuni á penslinum, og lat myndadeplar við øðrum liti vera, so ein lutur kann takast leysur úr bakgrundini.
tool.background_eraser.history.stroke = Bakgrundarviskileður
tool.gradient.name = Stigvísur litur
tool.gradient.description = Drag fyri at fylla lagið — gjøgnum valið, um eitt er — við einum linjurøttum stigvísum liti frá forgrundarlitinum til bakgrundarlitin eftir draginum.
tool.gradient.radial.name = Geislalagaður stigvísur litur
tool.gradient.radial.description = Drag úr miðjuni og úteftir fyri at fylla við einum geislalagaðum stigvísum liti millum forgrundar- og bakgrundarlitin.
tool.gradient.option.gradient = Stigvísur litur
