# Maleverktøy.
tool.brush.name = Pensel
tool.brush.description = Mal et strøk med myke kanter i forgrunnsfargen, dimensjonert etter penselstørrelsen, hardheten og tettheten i redigeringen.
tool.brush.history.stroke = Pensel
tool.pencil.name = Blyant
