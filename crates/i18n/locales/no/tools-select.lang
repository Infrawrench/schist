# Markeringsverktøy.
tool.select.mode.subtract = Trekk fra
tool.select.mode.intersect = Snitt
tool.marquee.rect.name = Rektangulær markering
tool.marquee.rect.description = Dra ut en rektangulær markering. Shift når du begynner å dra, legger til i markeringen, Alt trekker fra, og begge gir snittet. Shift mens du drar, gjør den kvadratisk. Et klikk uten å dra opphever markeringen.
tool.marquee.ellipse.name = Elliptisk markering
tool.marquee.ellipse.description = Dra ut en elliptisk markering, med samme kombinasjon av Shift og Alt som for den rektangulære markeringen.
tool.lasso.name = Lasso
tool.lasso.description = Dra et omriss på frihånd. Markeringen lukkes mellom endepunktene når du slipper. Shift legger til, Alt trekker fra.
tool.lasso.history.select = Lassomarkering
tool.lasso.polygonal.name = Mangekantlasso
tool.lasso.polygonal.description = Klikk på hjørne etter hjørne for å bygge en markering med rette kanter, og klikk nær det første punktet for å lukke den.
tool.lasso.polygonal.history.select = Mangekantlasso
tool.lasso.magnetic.name = Magnetisk lasso
tool.lasso.magnetic.description = Følg en kant omtrentlig, så fester omrisset seg til den sterkeste kontrasten nær banen.
tool.lasso.magnetic.history.select = Magnetisk lasso
tool.lasso.magnetic.option.frequency = Frekvens
tool.wand.name = Tryllestav
tool.wand.description = Klikk for å markere det sammenhengende området med lignende farge under pekeren innenfor toleransen – den samme toleransen som Øk, Lignende og Fargeområde bruker.
tool.wand.option.contiguous = Sammenhengende
tool.wand.history.select = Tryllestav
tool.quick_select.name = Hurtigmarkering
tool.quick_select.description = Mal over et område, så vokser markeringen gjennom lignende bildepunkter som penselen passerer over.
tool.quick_select.history.select = Hurtigmarkering
tool.object_select.name = Objektmarkering
tool.object_select.description = Dra en ramme rundt et objekt, så fester markeringen seg til objektet som finnes inni.
tool.object_select.history.select = Objektmarkering
