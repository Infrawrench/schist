photo_merge_advanced.projective = Perspektivna poravnava (vključuje vrtenje)
photo_merge_advanced.cylindrical = Valjasta panorama
photo_merge_advanced.deghost = Odstrani sledi premikajočih se motivov (prva fotografija je referenca)
photo_merge_advanced.focal = Goriščna razdalja (px) / širina slike (px)
photo_merge_advanced.masks = Rezultat združevanja ostrine uporablja maske plasti, ki jih je mogoče urejati. V Plasteh izberite masko in jo izboljšajte s slikanjem.
photo_merge_advanced.no_match = Zanesljiva poravnava ni bila najdena. Uporabite fotografije z izrazito teksturo, precejšnjim prekrivanjem in majhnimi spremembami zornega kota.
photo_merge_advanced.invalid = Neveljavne izvorne slike ali nastavitve združevanja.
