# Brush
tool.brush.name = Ibhratjhi
tool.brush.description = Penda umuda onomphetho othambileko ngombala wangaphambili, ubukhulu bawo bulawulwa bubukhulu bebhratjhi, ukuqina nokusitheka komhleli.
tool.brush.history.stroke = Ibhratjhi

# Pencil
