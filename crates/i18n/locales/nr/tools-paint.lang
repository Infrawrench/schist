# Eraser
tool.eraser.name = Isisuli
tool.eraser.description = Sula ngokulandela umuda, ubuyisele ileya ekubonakaleni ngale.
tool.eraser.history.stroke = Isisuli

# Clone Stamp
tool.clone.name = Isitembu Sokukopa
tool.clone.description = Isitembu Sokukopa: qhafaza ngo-alt ukubeka iphuzu lomthombo, bese upenda amaphikseli akotjwe kilo ebangeni lelo.
