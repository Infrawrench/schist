# Healing
tool.heal.name = Ibhratjhi Yokulungisa
tool.heal.description = Ibhratjhi Yokulungisa: qhafaza ngo-alt ukubeka umthombo, bese upenda; ukwakheka komthombo kuhlanganiswa nombala nokukhanya kwendawo okuya kiyo.
tool.heal.history.stroke = Ibhratjhi Yokulungisa
tool.spot_heal.name = Ibhratjhi Yokulungisa Amabala
tool.spot_heal.description = Ibhratjhi Yokulungisa Amabala: penda phezu kwesici bese sijanyiselelwa ngokwakheka okuthathwe endaweni esizombelezileko -- akunaphuzu lomthombo ekufanele libekwe.
tool.spot_heal.history.stroke = Ibhratjhi Yokulungisa Amabala

# History Brush
tool.history_brush.name = Ibhratjhi Yomlando
tool.history_brush.description = Penda ubuyise amaphikseli esithombeni esigcinwe emlandweni wedokhumenti, ubuyisela emuva umsebenzi wakamuva umuda ngomuda.
