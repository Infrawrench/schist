# Edit
command.edit.undo.title = Buyisela emuva
command.edit.undo.description = Buyela emuva ngelinyathelo linye emlandweni wedokhumenti.
command.edit.redo.title = Yenza godu
command.edit.redo.description = Yenza godu itjhuguluko eligcine ukubuyiselwa emuva.
command.edit.copy.title = Kopa
command.edit.copy.description = Kopela amaphikseli akhethiweko weleya esebenzako ebhodini lokukopela langaphakathi (ileya yoke nakungakhethwanga litho).
command.edit.copy_merged.title = Kopa Okuhlanganisiweko
command.edit.copy_merged.description = Kopa okukhethiweko ngendlela woke amaleya abonakalako ahlangana ngayo, kunokukopa eleyeni esebenzako kwaphela.
command.edit.cut.title = Sika
command.edit.cut.description = Kopela amaphikseli akhethiweko ebhodini lokukopela bese uwasula eleyeni esebenzako.
command.edit.paste.title = Namathisela
command.edit.paste.description = Namathisela okusebhodini lokukopela eleyeni etja ngaphezu kwesebenzako, phakathi kwekhanvasi.
command.edit.paste.layer_name = Ileya Enamathiselweko
command.edit.paste_in_place.title = Namathisela Endawenayo
command.edit.paste_in_place.description = Namathisela okusebhodini lokukopela eleyeni etja lapho kwakotjwe khona.
command.edit.fill_foreground.title = Zalisa Ngombala Wangaphambili
command.edit.fill_foreground.description = Zalisa okukhethiweko (namkha ikhanvasi yoke nakungakhethwanga litho) ngombala wangaphambili.
command.edit.fill_background.title = Zalisa Ngombala Wangemuva
command.edit.fill_background.description = Zalisa okukhethiweko (namkha ikhanvasi yoke nakungakhethwanga litho) ngombala wangemuva.

# Select
command.select.all.title = Khetha Koke
command.select.all.description = Khetha ikhanvasi yoke.
command.select.deselect.title = Susa Okukhethiweko
command.select.deselect.description = Susa okukhethiweko ukuze amatjhuguluko asebenze eleyeni yoke godu.
command.select.inverse.title = Khetha Okuphambene
command.select.inverse.description = Tjhintjha iindawo ezikhethiweko nezingakakhethwa.
command.select.reselect.title = Khetha Godu
command.select.reselect.description = Buyisa okukhethiweko okugcine ukususwa.
command.select.reselect.msg.nothing_to_reselect = Akukho okungakhethwa godu
command.select.feather.title = Thambisa Okukhethiweko
command.select.feather.description = Thambisa umphetho wokukhethiweko ngokufiphala kwamaphikseli amabili, ukuze itjhuguluko elilandelako liphele kancani phezu kwawo.
command.select.grow.title = Khulisa
command.select.grow.description = Nwebisa okukhethiweko kufake amaphikseli athintanako afana nasele akhethiwe, ngaphakathi kokubekezelela kwentonga yomlingo.
command.select.similar.title = Okufanako
command.select.similar.description = Khetha woke amaphikseli eleyeni afana nokukhethiweko, nanyana ayakuthinta namkha awa, ngaphakathi kokubekezelela kwentonga yomlingo.
command.select.save.title = Bulunga Okukhethiweko
command.select.save.description = Bulunga okukhethiweko kwanje kudokhumenti njengetjhanela le-alfa elinegama.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Layitjha Okukhethiweko
command.select.load.description = Buyisa okukhethiweko okugcinwe muva.

# Layer
command.layer.new.title = Ileya Etja
command.layer.new.description = Engeza ileya yerasta enganalitho ngaphezu kwesebenzako bese uyenza isebenze.
command.layer.duplicate.title = Phinda Kabili Ileya
command.layer.duplicate.description = Kopa ileya esebenzako nakho koke ekumumetheko uyenze ileya etja ngaphezu kwayo.
command.layer.smart_object.title = Tjhugululela Entweni Ehlakaniphileko
command.layer.smart_object.description = Phuthela amaphikseli weleya yerasta esebenzako entweni ehlakaniphileko ukuze amatjhuguluko neenhlungi ezilandelako zisebenzise umthombo ongakathintwa.
command.layer.rasterize.title = Yenza Ileya ibe yiRasta
command.layer.rasterize.description = Tjhugulula ileya yobujamo, yomtlolo namkha yento ehlakaniphileko ibe maphikseli ajayelekileko.
command.layer.delete.title = Sula Ileya
command.layer.delete.description = Sula amaleya akhethiweko.
command.layer.group.title = Hlanganisa Amaleya Ngesiqhema
command.layer.group.description = Faka amaleya akhethiweko esiqhemeni esitja, endawenawo.
command.layer.raise.title = Yisa Phambili
command.layer.raise.description = Khambisa ileya esebenzako iye endaweni eyodwa phezulu esitakini sesiqhema sayo.
command.layer.lower.title = Yisa Emuva
command.layer.lower.description = Khambisa ileya esebenzako iye endaweni eyodwa phasi esitakini sesiqhema sayo.
command.layer.to_front.title = Yisa Phambili Khulu
command.layer.to_front.description = Khambisa ileya esebenzako iye phezulu kwesiqhema sayo.
command.layer.to_back.title = Yisa Emuva Khulu
command.layer.to_back.description = Khambisa ileya esebenzako iye phasi kwesiqhema sayo.
command.layer.clipping_mask.title = Yakha/Susa Isifihli Sokusika
command.layer.clipping_mask.description = Sika ileya esebenzako ngokweleya engaphasi kwayo, namkha uyikhulule nasele isikiwe; ileya esikiweko ibonakala kwaphela lapho isisekelo sayo sinamaphikseli khona.
command.layer.cut_to_new.title = Ileya Ngokuyisika
command.layer.cut_to_new.description = Khupha amaphikseli akhethiweko eleyeni esebenzako uwabeke eleyeni etja ngaphezu kwayo.
command.layer.cut_to_new.layer_name = Ileya Ngokuyisika
command.layer.add_mask.title = Engeza Isifihli Seleya
command.layer.add_mask.description = Engeza isifihli eleyeni esebenzako, siveze okukhethiweko kwaphela nakukhona.
command.layer.flatten.title = Hlanganisa Isithombe Sibe Yileya Yinye
command.layer.flatten.description = Hlanganisa koke okubonakalako kube yileya Yengemuva eyodwa engabonakali ngale, ulahle amaleya afihliweko.
command.layer.merge_down.title = Hlanganisela Phasi
command.layer.merge_down.description = Hlanganisa ileya esebenzako eleyeni engaphasi kwayo.
command.layer.merge_down.msg.no_layer_below = Akukho ileya ngaphasi yokuhlanganisela kiyo
command.layer.merge_visible.title = Hlanganisa Okubonakalako
command.layer.merge_visible.description = Hlanganisa woke amaleya abonakalako abe linye, utjhiye amaleya afihliweko angakatjhugululwa.

command.msg.nothing_to_copy = Khetha ileya yamaphikseli ozokukopa kiyo
command.msg.clipboard_empty = Akunalitho ebhodini lokukopela

