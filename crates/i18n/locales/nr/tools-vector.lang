# Pens
tool.pen.name = Ipeni
tool.pen.description = Yakha indlela: qhafaza ukwenza iphuzu lekhona, dosa ukukhupha iimbambo zejika kilo, bese uqhafaza iphuzu lokuthoma ukuyivala. Ukuqinisekisa kutjhugulula indlela ibe yileya yobujamo.
