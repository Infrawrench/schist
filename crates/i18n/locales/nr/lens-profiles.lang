lens_profiles.invalid = Khetha idathabheyisi ye-XML Lensfun v1/v2 esebenzako (efika ku-8 MiB) enedatha yekhamera nofana yelensi esekelwako.
lens_profiles.calibration = Ukulinganiswa kwelensi
lens_profiles.no_calibration = Akukho kulinganiswa okufanele amasethingi la. Hlola ubude befokhasi nesilinganiso sokusikwa sekhamera; ukulungisa ngesandla kusatholakala.
lens_profiles.import = Ngenisa i-XML ye-Lensfun…
lens_profiles.imported = Idathabheyisi ye-Lensfun ingenisiwe esikhathini lesi. Khetha iprofayili nofana uyimadanise nemethadatha yesithombe.
lens_profiles.manual = Ukulungisa ngesandla kwaphela
lens_profiles.saved = Ukulinganiswa okubulungiweyo (idathabheyisi ayitholakali)
lens_profiles.profile = Iprofayili yelensi
lens_profiles.aperture = Ukuvuleka (0 = akwaziwa)
lens_profiles.distance = Ibanga lefokhasi (0 = akwaziwa)
lens_profiles.vignette = Ukulungiswa kwe-vignetting ngokulinganiswa
lens_profiles.color_context = Ukulungiswa kwe-vignetting ngokulinganiswa kudinga iprofayili ye-sRGB engaphakathi. Guqulela ku-sRGB ukuze ubulunge ukubonakala, bese uvula godu Ukulungisa Ilensi. Kumaphikseli asele aku-sRGB kodwana angenalo ibizo leprofayili, kwanele ukuwabela i-sRGB. Ukulungiswa kwejiyomethri nombala kusatholakala.
lens_profiles.vignette_missing = Akukho kulinganiswa kwe-vignetting okufanele ukuvuleka nebanga lefokhasi. Faka amanani alinganisiweko ukuze kusebenze; kuziprofayili ezinengi ze-Lensfun, 1000 m kutjho ifokhasi ekude.
lens_profiles.note = Ukulungiswa ngokulinganiswa kwenzeka ngaphambi kokulawula ngesandla. Sebenzisa isithombe sokuthoma siphelele bese usisika ngemva kwalokho. Bulunga ilandelano leensefe ku-PSD/PSB ukuze ukulinganiswa kuhlale kungahlelwa.
lens_profiles.automatic = Madanisa nemethadatha yesithombe
lens_profiles.components = Ukusetjenziswa kweprofayili: ukugobeka {distortion}; imiphetho yombala {tca}; i-vignetting {vignette}.
