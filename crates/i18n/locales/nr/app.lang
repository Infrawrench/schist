# Vulkan diagnostics
app.vulkan.no_loader = schist: akunasilayitjhi se-Vulkan ehlelweni leli, ngalokho akunalitho lokudweba ngalo.\n\nI-Schist idweba nge-Vulkan, begodu i-`libvulkan.so.1` ayikafakwa.\nKufuneka kokubili isilayitjhi nesitjhayeli:\n\n    Arch, CachyOS, Omarchy    sudo pacman -S vulkan-icd-loader vulkan-driver\n    Debian, Ubuntu, Mint      sudo apt install libvulkan1 mesa-vulkan-drivers\n    Fedora, RHEL              sudo dnf install vulkan-loader mesa-vulkan-drivers\n
app.vulkan.override_missing = schist: isitjhayeli se-Vulkan esiqondiswe seshini le asikho.\n\nI-{var} isethiwe, begodu ukuyisetha *kujanyiselela* ukufuna kweelayitjhi\niintjhayeli kunokungeza kikho. Ngalokho amafayela la, angekho,\nngiwo woke umrhelo weentjhayeli -- begodu woke amahlelo we-Vulkan\nkileshini awasiboni isitjhayeli, nanyana zingaki ezifakiweko:\n\n{missing}\n    {var}={value}\n\nYiqondise kumanifesti okhona -- iintjhayeli ezifakiweko zibeka wazo ku-\n/usr/share/vulkan/icd.d -- namkha uyisuse uvumele isilayitjhi sizifunele.\nIsesheni esetha lokhu ngefayela lokumisa (`env =` ye-Hyprland, ifayela\nle-systemd environment.d, iphrofayili ye-shell) kufanele itjhugululwe lapho,\nbegodu itjhuguluko litlhoga ukungena okutjha ukuze lifike kokusele kusebenza.\n
app.vulkan.override_note = \nI-{var} isethwe ku-{value}, begodu lokho kujanyiselela ukufuna\nkwesilayitjhi: nangabe akekho kumanifesti la owenzelwe umtjhini lo,\nukuyisusa kuyinto yokuthoma okufanele izanywe.\n
app.vulkan.no_driver = schist: akunasitjhayeli se-Vulkan esifakiweko, ngalokho akunalitho okungadwetjelwa kilo.\n\nI-Schist idweba nge-Vulkan. Isilayitjhi sifakiwe kodwana sibika ukuthi\nakunasitjhayeli -- akukho esitlolise indawo eyodwa kwezimbili okufunwa kizo:\n\n{dirs}\n\nIsilayitjhi sithunyelwa ngokuhlukana neentjhayeli, ngalokho lokhu kuvamise\nukuba yiphakheji elilodwa elingekho.\n\nFaka leso somtjhini lo se-GPU:\n\n    Arch, CachyOS, Omarchy    sudo pacman -S vulkan-driver\n    Debian, Ubuntu, Mint      sudo apt install mesa-vulkan-drivers\n    Fedora, RHEL              sudo dnf install mesa-vulkan-drivers\n\nIsitjhayeli se-NVIDIA siyazithwalela saso (`nvidia-utils` ku-Arch,\n`nvidia-driver` ku-Debian). Emtjhinini olingiswako, namkha kwenye indawo\nenganasitjhayeli se-GPU esingafakwa, isirasterayiza sesofthiwe ngiso esisebenzako:\n`vulkan-swrast` ku-Arch, siyingcenye ye-`mesa-vulkan-drivers` kwenye indawo.\nSiyananya, kodwana siyathoma.\n{overridden}
app.vulkan.no_device = schist: isitjhayeli se-Vulkan sifakiwe kodwana asinikeli idivayisi yokudweba kiyo.\n\nKungenzeka isitjhayeli singayisekeli i-GPU le, namkha singakghoni ukufika kiyo --\nnge-SSH, namkha ngaphakathi kwesitja, ukungabikho kwe-/dev/dri kuvamile.\nI-`vulkaninfo --summary` ibika lokho isilayitjhi esikubonako.\n\nIsirasterayiza sesofthiwe sidweba ngaphandle kwe-GPU, nangabe umtjhini lo\nunjalo: `vulkan-swrast` ku-Arch, siyingcenye ye-`mesa-vulkan-drivers`\nku-Debian ne-Fedora.\n
app.vulkan.skip_hint = Ukuvula i-Schist nanyana kunjalo bese uyiyeka ihluleke ngendlela yayo, setha {var}=1.
