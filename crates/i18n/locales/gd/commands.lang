command.edit.undo.title = Neo-dhèan
command.edit.undo.description = Gabh aon cheum air ais ann an eachdraidh neo-dhèanaidh na sgrìobhainn.
command.edit.redo.title = Ath-dhèan
command.edit.redo.description = Dèan a-rithist an deasachadh a chaidh a neo-dhèanamh mu dheireadh.
command.edit.copy.title = Dèan lethbhreac
command.edit.copy.description = Cuir piogsailean taghte na breatha gnìomhaiche air an stòr-bhòrd a-staigh (a’ bhreath gu lèir mura deach dad a thaghadh).
command.edit.copy_merged.title = Dèan lethbhreac co-aonaichte
command.edit.copy_merged.description = Dèan lethbhreac dhen taghadh mar a cho-dhealbhaicheas gach breath fhaicsinneach e, seach on bhreath ghnìomhach a-mhàin.
command.edit.cut.title = Gearr
command.edit.cut.description = Cuir na piogsailean taghte air an stòr-bhòrd agus suath às iad on bhreath ghnìomhach.
command.edit.paste.title = Cuir ann
command.edit.paste.description = Cuir susbaint an stòr-bhùird ann am breath ùr os cionn na tè gnìomhaiche, ann am meadhan a’ chanabhais.
command.edit.paste.layer_name = Breath a chaidh a chur ann
command.edit.paste_in_place.title = Cuir san dearbh àite
command.edit.paste_in_place.description = Cuir susbaint an stòr-bhùird ann am breath ùr aig na co-chomharran on deach lethbhreac a dhèanamh dheth.
command.edit.fill_foreground.title = Lìon le dath a’ bheulaibh
command.edit.fill_foreground.description = Lìon an taghadh (no an canabhas gu lèir mura deach dad a thaghadh) le dath a’ bheulaibh.
command.edit.fill_background.title = Lìon le dath a’ chùlaibh
command.edit.fill_background.description = Lìon an taghadh (no an canabhas gu lèir mura deach dad a thaghadh) le dath a’ chùlaibh.
command.select.all.title = Tagh na h-uile
command.select.all.description = Tagh an canabhas gu lèir.
command.select.deselect.title = Neo-thagh
command.select.deselect.description = Leig às an taghadh gus an dèid deasachaidhean a chur ris a’ bhreath gu lèir a-rithist.
command.select.inverse.title = Tagh an t-ais-thionndadh
command.select.inverse.description = Suaip na raointean taghte agus neo-thaghte.
command.select.reselect.title = Ath-thagh
command.select.reselect.description = Thoir air ais an taghadh a chaidh a leigeil às mu dheireadh.
command.select.reselect.msg.nothing_to_reselect = Chan eil dad ri ath-thaghadh
command.select.feather.title = Bog oirean an taghaidh
command.select.feather.description = Bog oir an taghaidh le doilleireachadh dà phiogsaid ach an searg an ath dheasachadh thairis air.
command.select.grow.title = Fàs
command.select.grow.description = Leudaich an taghadh a-steach do phiogsailean dlùth a tha coltach ris na chaidh a thaghadh, taobh a-staigh fulangas na slaite-draoidheachd.
command.select.similar.title = Coltach
command.select.similar.description = Tagh gach piogsaid sa bhreath a tha coltach ris an taghadh, dlùth ris no nach eil, taobh a-staigh fulangas na slaite-draoidheachd.
command.select.save.title = Sàbhail an taghadh
command.select.save.description = Glèidh an taghadh làithreach san sgrìobhainn mar sheanal alpha ainmichte.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Luchdaich taghadh
command.select.load.description = Aisig an taghadh a chaidh a shàbhaladh mu dheireadh.
command.layer.new.title = Breath ùr
command.layer.new.description = Cuir breath rastair fhalamh os cionn na tè gnìomhaiche agus dèan gnìomhach i.
command.layer.duplicate.title = Dùblaich a’ bhreath
command.layer.duplicate.description = Dèan lethbhreac dhen bhreath ghnìomhach, leis a h-uile susbaint, ann am breath ùr os a chionn.
command.layer.smart_object.title = Iompaich gu nì glic
command.layer.smart_object.description = Paisg piogsailean a’ bhreatha raster ghnìomhaich ann an nì glic gus an ath-shamplaich cruth-atharraichean is criathragan an tùs ris nach deach beantainn.
command.layer.rasterize.title = Rasteraich a’ bhreath
command.layer.rasterize.description = Tionndaidh breath crutha, teacsa no nì ghlic gu piogsailean lom.
command.layer.delete.title = Sguab às a’ bhreath
command.layer.delete.description = Sguab às na breathan taghte.
command.layer.group.title = Buidhnich na breathan
command.layer.group.description = Paisg na breathan taghte ann am buidheann ùr san dearbh àite.
command.layer.raise.title = Thoir an comhair
command.layer.raise.description = Gluais a’ bhreath ghnìomhach aon àite suas ann an stac a buidhne.
command.layer.lower.title = Cuir an comhair a’ chùil
command.layer.lower.description = Gluais a’ bhreath ghnìomhach aon àite sìos ann an stac a buidhne.
command.layer.to_front.title = Thoir gun bheulaibh
command.layer.to_front.description = Gluais a’ bhreath ghnìomhach gu mullach a buidhne.
command.layer.to_back.title = Cuir gun chùlaibh
command.layer.to_back.description = Gluais a’ bhreath ghnìomhach gu bonn a buidhne.
command.layer.clipping_mask.title = Cruthaich/Sgaoil masg bearraidh
command.layer.clipping_mask.description = Bearr a’ bhreath ghnìomhach ris an tè fodha no sgaoil i ma tha i bearraichte mar-thà; cha nochd breath bhearraichte ach far a bheil piogsailean aig a bunait.
command.layer.cut_to_new.title = Breath tro ghearradh
command.layer.cut_to_new.description = Gluais na piogsailean taghte a-mach às a’ bhreath ghnìomhach gu breath ùr os a chionn.
command.layer.cut_to_new.layer_name = Breath tro ghearradh
command.layer.add_mask.title = Cuir masg breatha ris
command.layer.add_mask.description = Cuir masg ris a’ bhreath ghnìomhach, nach nochd ach an taghadh nuair a bhios fear ann.
command.layer.flatten.title = Rèidhich an dealbh
command.layer.flatten.description = Co-dhealbhaich gach nì faicsinneach ann an aon bhreath cùlaibh trìd-dhoilleir agus tilg na breathan falaichte air falbh.
command.layer.merge_down.title = Co-aonaich sìos
command.layer.merge_down.description = Co-dhealbhaich a’ bhreath ghnìomhach dhan bhreath fodha.
command.layer.merge_down.msg.no_layer_below = Chan eil breath fodha ris an gabh co-aonadh
command.layer.merge_visible.title = Co-aonaich na tha faicsinneach
command.layer.merge_visible.description = Co-dhealbhaich gach breath fhaicsinneach ann an aon agus fàg na breathan falaichte mar a tha iad.
command.msg.nothing_to_copy = Tagh breath phiogsailean on dèanar lethbhreac
command.msg.clipboard_empty = Chan eil dad air an stòr-bhòrd
