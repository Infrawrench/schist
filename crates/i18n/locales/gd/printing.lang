printing.title = Clò-bhuail an sgrìobhainn…
printing.contact_sheet = Duilleag-chonaltraidh on taghadh…
printing.paper = Meud a’ phàipeir
printing.margin = Oirean
printing.columns = Colbhan
printing.rows = Ràghan
printing.dpi = DPI an às-chuir
