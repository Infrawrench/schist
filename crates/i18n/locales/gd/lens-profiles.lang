# Lens profiles.
lens_profiles.invalid = Tagh stòr-dàta dligheach Lensfun v1/v2 XML (suas gu 8 MiB) le dàta camara no lionsa le taic.
lens_profiles.calibration = Calibration lionsa
lens_profiles.no_calibration = Chan eil calabrachadh a’ còmhdach nan roghainnean sin. Thoir sùil air fad fòcas agus factar bàrr camara; ceartachadh làimhe fhathast ri fhaighinn.
lens_profiles.import = Cuir a-steach Lensfun XML…
lens_profiles.imported = Stòr-dàta Lensfun air a thoirt a-steach airson an t-seisein seo. Tagh pròifil no maids ri meata-dàta an dealbh.
lens_profiles.manual = Ceartachadh làimhe a-mhàin
lens_profiles.saved = Calibration air a shàbhaladh (stòr-dàta gun a bhith ri fhaighinn)
lens_profiles.profile = Pròifil lionsa
lens_profiles.aperture = Fosgladh (0 = neo-aithnichte)
lens_profiles.distance = Astar fòcas (0 = neo-aithnichte)
lens_profiles.vignette = Cruth-clò calabraichte
lens_profiles.color_context = Feumaidh vignetting calabraichte am pròifil sRGB a chaidh a thogail a-steach. Tionndaidh gu sRGB gus coltas a ghleidheadh, agus an uairsin fosgail Ceartachadh lionsa. Airson piogsail gun tagadh sRGB mar-thà, tha e gu leòr sRGB a shònrachadh. Tha geoimeatraidh agus ceartachadh chromatic fhathast rim faighinn.
lens_profiles.vignette_missing = Chan eil calabrachadh vignetting a’ còmhdach an fhosglaidh agus an astar fòcas. Cuir a-steach luachan tomhaiste gus a chomasachadh; Tha 1000 m a’ riochdachadh fòcas fad às ann am mòran de phròifil Lensfun.
lens_profiles.note = Bidh ceartachadh calabraichte a’ ruith ro na smachdan làimhe. Cleachd an dealbh tùsail gu lèir; geàrr às dèidh sin. Sàbhail stac sìoltachain ann an PSD/PSB gus calabrachadh deasaichte a chumail.
lens_profiles.automatic = Co-fhreagair meata-dàta dealbh
lens_profiles.components = Pròifil pas: saobhadh {distortion}; iomall dath {tca}; vigneting {vignette}.
