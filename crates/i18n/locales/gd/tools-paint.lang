tool.background_eraser.history.stroke = Suathan cùlaibh
tool.gradient.name = Caisead
tool.gradient.description = Slaod gus a’ bhreath a lìonadh — tron taghadh ma tha fear ann — le caisead loidhneach a ruitheas o dhath a’ bheulaibh gu dath a’ chùlaibh ri taobh na slaodaidh.
