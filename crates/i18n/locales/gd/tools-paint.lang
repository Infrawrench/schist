tool.clone.name = Stampa-clònaidh
tool.clone.description = Stampa-clònaidh: dèan Alt-bhriog gus a’ phuing-thùis a shuidheachadh agus peant an uair sin piogsailean a chaidh a lethbhreacadh bhuaipe aig an aon fhrith-àireamh.
