tool.brush.name = Bruis
tool.brush.description = Peant stròc le oir bhog ann an dath a’ bheulaibh, leis a’ mheud, a’ chruas agus an trìd-dhoilleireachd a chaidh a thaghadh airson bruis an deasaiche.
tool.brush.history.stroke = Bruis
tool.pencil.name = Peansail
