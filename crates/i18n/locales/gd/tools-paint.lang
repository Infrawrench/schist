tool.heal.name = Bruis-slànachaidh
tool.heal.description = Bruis-slànachaidh: dèan Alt-bhriog gus an tùs a shuidheachadh agus peant an uair sin; thèid inneach an tùis a mheasgachadh le dath agus solas a’ chinn-uidhe fhèin.
