tool.spot_heal.name = Bruis-slànachaidh spotan
tool.spot_heal.description = Bruis-slànachaidh spotan: peant thairis air smal agus thèid inneach o na tha mun cuairt air a chur na àite — chan fheumar puing-thùis a shuidheachadh.
