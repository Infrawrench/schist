command.animation.create.title = Dala Opopayi Wamafreyimu
command.animation.create.description = Qala opopayi wamafreyimu ofreyimu yakhe yokuqala ingumbhalo njengoba unjalo manje.
command.animation.make_frames_from_layers.title = Yenza Amafreyimu Ngezendlalelo
command.animation.make_frames_from_layers.description = Faka esikhundleni samafreyimu ifreyimu eyodwa yesendlalelo ngasinye esisezingeni eliphezulu, ngayinye ikhombisa leso sendlalelo kuphela.
command.animation.flatten_frames_into_layers.title = Hlanganisa Amafreyimu Abe Izendlalelo
command.animation.flatten_frames_into_layers.description = Dweba ifreyimu ngayinye esendlalelweni esisha phezulu, ngasinye sibonakala kuphela kufreyimu yaso.
command.animation.new_frame.title = Ifreyimu Entsha
command.animation.new_frame.description = Phinda ifreyimu ekhethiwe bese ukhetha ikhophi.
command.animation.delete_frame.title = Susa Ifreyimu
command.animation.delete_frame.description = Susa ifreyimu ekhethiwe bese ukhetha leyo engaphambi kwayo.
command.animation.first_frame.title = Ifreyimu Yokuqala
command.animation.first_frame.description = Khetha ifreyimu yokuqala kopopayi.
command.animation.previous_frame.title = Ifreyimu Yangaphambilini
command.animation.previous_frame.description = Khetha ifreyimu yangaphambilini; ngemva kweyokuqala, iya kweyokugcina.
command.animation.next_frame.title = Ifreyimu Elandelayo
command.animation.next_frame.description = Khetha ifreyimu elandelayo; ngemva kweyokugcina, iya kweyokuqala.
command.animation.last_frame.title = Ifreyimu Yokugcina
command.animation.last_frame.description = Khetha ifreyimu yokugcina kopopayi.
command.animation.reverse_frames.title = Hlehlisa Amafreyimu
command.animation.reverse_frames.description = Hlehlisa uhlelo lwamafreyimu.
command.animation.delete_animation.title = Susa Opopayi
command.animation.delete_animation.description = Susa opopayi wamafreyimu bese ugcina izendlalelo njengoba ifreyimu ekhethiwe izibonisa.
