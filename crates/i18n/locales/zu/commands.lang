command.edit.undo.title = Hlehlisa
command.edit.undo.description = Buyela emuva ngesinyathelo esisodwa emlandweni wokuhlehlisa wombhalo.
command.edit.redo.title = Phinda
command.edit.redo.description = Phinda ukuhlela okusanda kuhlehliswa.
command.edit.copy.title = Yenza ikhophi
command.edit.copy.description = Kopisha amaphikseli akhethiwe esendlalelo esisebenzayo ebhodini lokunamathisela langaphakathi (sonke isendlalelo uma kungekho okukhethiwe).
command.edit.copy_merged.title = Kopisha Okuhlanganisiwe
command.edit.copy_merged.description = Kopisha okukhethiwe ngendlela zonke izendlalelo ezibonakalayo ezikuhlanganisa ngayo, hhayi okuvela esendlalelweni esisebenzayo kuphela.
command.edit.cut.title = Sika
command.edit.cut.description = Kopisha amaphikseli akhethiwe ebhodini lokunamathisela bese uwasula esendlalelweni esisebenzayo.
command.edit.paste.title = Namathisela
command.edit.paste.description = Namathisela okusebhodini lokunamathisela esendlalelweni esisha ngenhla kwesisebenzayo, kubekwe maphakathi nekhanvasi.
command.edit.paste.layer_name = Isendlalelo Esinamathiselwe
command.edit.paste_in_place.title = Namathisela Endaweni
command.edit.paste_in_place.description = Namathisela okusebhodini lokunamathisela esendlalelweni esisha ezixhumanisini okwakhopishwa kuzo.
command.edit.fill_foreground.title = Gcwalisa Ngombala Ongaphambili
command.edit.fill_foreground.description = Gcwalisa okukhethiwe (noma yonke ikhanvasi uma kungekho okukhethiwe) ngombala ongaphambili.
command.edit.fill_background.title = Gcwalisa Ngombala Wangemuva
command.edit.fill_background.description = Gcwalisa okukhethiwe (noma yonke ikhanvasi uma kungekho okukhethiwe) ngombala wangemuva.
command.select.all.title = Khetha Konke
command.select.all.description = Khetha yonke ikhanvasi.
command.select.deselect.title = Susa Ukukhetha
command.select.deselect.description = Susa ukukhetha, ukuze ukuhlela kuphinde kusebenze kuso sonke isendlalelo.
command.select.inverse.title = Guqula Ukukhetha
command.select.inverse.description = Shintshanisa izindawo ezikhethiwe nezingakhethiwe.
command.select.reselect.title = Khetha Kabusha
command.select.reselect.description = Buyisa ukukhetha okwagcina ukususwa.
command.select.reselect.msg.nothing_to_reselect = Akukho okungakhethwa kabusha
command.select.feather.title = Thambisa Umphetho Wokukhetha
command.select.feather.description = Thambisa unqenqema lokukhetha ngokufiphaza kwamaphikseli amabili, ukuze ukuhlela okulandelayo kunciphe kancane lapho kudlula khona.
command.select.grow.title = Khulisa
command.select.grow.description = Nweba ukukhetha kungene kumaphikseli athintanayo afana nasekhethiwe, ngaphakathi kwenani lokubekezelela lenduku yomlingo.
command.select.similar.title = Okufanayo
command.select.similar.description = Khetha wonke amaphikseli asesendlalelweni afana nokukhethiwe, kungakhathaliseki ukuthi ayakuthinta noma cha, ngaphakathi kwenani lokubekezelela lenduku yomlingo.
command.select.save.title = Londoloza Ukukhetha
command.select.save.description = Gcina ukukhetha kwamanje embhalweni njengesiteshi se-alpha esinegama.
command.select.save.channel_name = I-Alpha {n}
command.select.load.title = Layisha Ukukhetha
command.select.load.description = Buyisela ukukhetha okusanda kulondolozwa.
command.layer.new.title = Isendlalelo Esisha
command.layer.new.description = Engeza isendlalelo samaphikseli esingenalutho ngenhla kwesisebenzayo bese usenza sisebenze.
command.layer.duplicate.title = Phinda Isendlalelo
command.layer.duplicate.description = Kopisha isendlalelo esisebenzayo, nakho konke okuqukethwe, usifake esendlalelweni esisha ngenhla kwaso.
command.layer.smart_object.title = Guqulela Entweni Ehlakaniphile
command.layer.smart_object.description = Faka amaphikseli esendlalelo se-raster esisebenzayo entweni ehlakaniphile, ukuze ukuguqula nezihlungi ezilandelayo kusampule kabusha umthombo ongathintwanga.
command.layer.rasterize.title = Yenza Isendlalelo Sibe Amaphikseli
command.layer.rasterize.description = Guqula isendlalelo somumo, sombhalo noma sento ehlakaniphile sibe amaphikseli avamile.
command.layer.delete.title = Susa Isendlalelo
command.layer.delete.description = Susa izendlalelo ezikhethiwe.
command.layer.group.title = Qoqa Izendlalelo
command.layer.group.description = Faka izendlalelo ezikhethiwe eqoqweni elisha endaweni yazo.
command.layer.raise.title = Yisa Phambili
command.layer.raise.description = Hambisa isendlalelo esisebenzayo indawo eyodwa phezulu esitakini seqoqo laso.
command.layer.lower.title = Yisa Emuva
command.layer.lower.description = Hambisa isendlalelo esisebenzayo indawo eyodwa phansi esitakini seqoqo laso.
command.layer.to_front.title = Yisa Phambili Kakhulu
command.layer.to_front.description = Hambisa isendlalelo esisebenzayo phezulu eqoqweni laso.
command.layer.to_back.title = Yisa Emuva Kakhulu
command.layer.to_back.description = Hambisa isendlalelo esisebenzayo phansi eqoqweni laso.
command.layer.clipping_mask.title = Dala/Khipha Imaski Yokunamathisela
command.layer.clipping_mask.description = Namathisela isendlalelo esisebenzayo kuleso esingaphansi kwaso, noma usikhulule uma sesinamathiselwe; isendlalelo esinamathiselwe sibonakala kuphela lapho isisekelo saso sinamaphikseli khona.
command.layer.cut_to_new.title = Isendlalelo Ngokusika
command.layer.cut_to_new.description = Susa amaphikseli akhethiwe esendlalelweni esisebenzayo uwafake esendlalelweni esisha ngenhla kwaso.
command.layer.cut_to_new.layer_name = Isendlalelo Ngokusika
command.layer.add_mask.title = Engeza Imaski Yesendlalelo
command.layer.add_mask.description = Engeza imaski esendlalelweni esisebenzayo, iveze kuphela okukhethiwe uma kukhona.
command.layer.flatten.title = Yenza Isithombe Sibe Isendlalelo Esisodwa
command.layer.flatten.description = Hlanganisa konke okubonakalayo kube isendlalelo esisodwa Sengemuva esingabonisi ngale, ulahle izendlalelo ezifihliwe.
command.layer.merge_down.title = Hlanganisela Phansi
command.layer.merge_down.description = Hlanganisa isendlalelo esisebenzayo nesingaphansi kwaso.
command.layer.merge_down.msg.no_layer_below = Asikho isendlalelo esingaphansi okungahlanganiselwa kuso
command.layer.merge_visible.title = Hlanganisa Okubonakalayo
command.layer.merge_visible.description = Hlanganisa zonke izendlalelo ezibonakalayo zibe sinye, ushiye ezifihliwe zinjalo.
command.msg.nothing_to_copy = Khetha isendlalelo samaphikseli ozokopisha kuso
command.msg.clipboard_empty = Akukho ebhodini lokunamathisela
