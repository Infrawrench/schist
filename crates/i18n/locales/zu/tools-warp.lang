tool.puppet_warp.name = Ukusonta Kwephaphethi
tool.puppet_warp.description = Chofoza ukuze ubophele ungqimba emaphuzwini ambalwa, bese uhudula elilodwa: imeshi iyagoba izungeze amaphini, iqine noma ixegise njengoba inketho Yokuqina isho. Ukuqinisekisa kusebenzisa ushintsho.
