tool.vanishing_point.name = Iphuzu Lokunyamalala
tool.vanishing_point.description = Hudula udwebe indawo eyisicaba yejiyomethri phezu kwento enombono wokude, bese ushintshela imodi kokuthi Kopisha upende: amaphikseli akopishiwe alandela leyo ndawo, encipha ngokuya ngebanga.
