# Translation draft; review by a native speaker.
lens_profiles.invalid = Khetha isizindalwazi se-Lensfun v1/v2 XML esivumelekile (esingedluli ku-8 MiB) esinedatha yekhamera noma yelensi esekelwayo.
lens_profiles.calibration = Ukulinganisa ilensi
lens_profiles.no_calibration = Akukho ukulinganisa okuhambisana nalezi zilungiselelo. Hlola ibanga lokugxila kanye nesilinganiso sokusika sekhamera; ukulungisa mathupha kusatholakala.
lens_profiles.import = Ngenisa i-Lensfun XML…
lens_profiles.imported = Isizindalwazi se-Lensfun singeniselwe lesi sikhathi. Khetha iphrofayela yelensi noma ufanise imininingwane yesithombe.
lens_profiles.manual = Ukulungisa mathupha kuphela
lens_profiles.saved = Ukulinganisa okulondoloziwe (isizindalwazi asitholakali)
lens_profiles.profile = Iphrofayela yelensi
lens_profiles.aperture = Ukuvuleka kwelensi (0 = akwaziwa)
lens_profiles.distance = Ibanga lokugxila (0 = akwaziwa)
lens_profiles.vignette = Ukulungiswa kokuba mnyama emaphethelweni okulinganisiwe
lens_profiles.color_context = Ukulungiswa kokuba mnyama emaphethelweni okulinganisiwe kudinga iphrofayela ye-sRGB eyakhelwe ngaphakathi. Guqulela isithombe ku-sRGB ukuze ugcine ukubukeka kwaso, bese uvula futhi “Ukulungiswa Kwelensi”. Uma amaphikseli eseyi-sRGB kodwa engenalo ilebula lephrofayela, kwanele ukuwabela iphrofayela ye-sRGB. Ukulungiswa komumo nokuphambuka kombala kusatholakala.
lens_profiles.vignette_missing = Akukho ukulinganisa kokuba mnyama emaphethelweni okuhambisana nalokhu kuvuleka kwelensi nebanga lokugxila. Faka amanani akaliwe ukuze ukusebenzise; kumaphrofayela amaningi e-Lensfun, u-1000 m usho ukugxila entweni ekude.
lens_profiles.note = Ukulungisa ngokulinganisa kwenziwa ngaphambi kwezilawuli zesandla. Sebenzisa uhlaka lokuqala oluphelele; usike kamuva. Londoloza inqwaba yezihlungi ku-PSD/PSB ukuze ukulinganisa kuhlale kuhleleka.
lens_profiles.automatic = Fanisa imininingwane yesithombe
lens_profiles.components = Ukusebenza kwephrofayela: ukuhlanekezela {distortion}; imiphetho enemibala {tca}; ukuba mnyama emaphethelweni {vignette}.
