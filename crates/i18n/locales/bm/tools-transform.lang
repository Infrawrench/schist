# Yɛlɛmali baarakɛminɛnw
tool.transform.name = Yɛlɛmali hɔrɔnya
tool.transform.description = Yɛlɛmali hɔrɔnya. Ni a dalen don, yɛlɛmali kutu bɛ da kaliki min bɛ baara la o lamini: sama kulu dɔ la ka bonya yɛlɛma, sama kulu kɔfɛ ka munumunu, sama dafɛ dɔ la ka a kɔngɔ. Foyi tɛ sɛbɛn fo i ka a sɔn (Enter); ni i bɔra a la (Escape), kaliki bɛ segin a yɔrɔ la.
