# Ja kuruɲɛ baarakɛminɛnw
tool.liquify.name = Jiyalen
tool.liquify.description = Pikisɛliw gɛn, munumunu, dɔgɔya walima funun bɔrɔsi belebele jukɔrɔ; cogoya sugandili bɛ min kɛ olu dɔ ye. Kuruɲɛli bɛ fara ɲɔgɔn kan ja-filɛ kɔnɔ, ka da kaliki la ni i sɔnna a ma.
