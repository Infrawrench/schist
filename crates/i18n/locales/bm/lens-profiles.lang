# Lens profile controls.
lens_profiles.invalid = Lensfun v1/v2 XML kunnafonidilan bɛnnen dɔ sugandi (fo ka se 8 MiB ma) ni kamera walima lensɛri kunnafoniw dɛmɛnen ye.
lens_profiles.calibration = Lensɛri kalibreli
lens_profiles.no_calibration = Jateminɛ si tɛ o sigida ninnu datugu. Aw bɛ focal length ni kamera crop factor lajɛ; bololabaara latilenni bɛ to ka kɛ.
lens_profiles.import = Import Lensfun XML ye...
lens_profiles.imported = Lensfun database min donna nin kalan in kama. Profil dɔ sugandi walima ka foto metadata bɛn.
lens_profiles.manual = Bolo latilenni dɔrɔn
lens_profiles.saved = Calibration maralen (database tɛ sɔrɔ) .
lens_profiles.profile = Lensɛri ka ɲɛfɔli
lens_profiles.aperture = Aperture (0 = dɔnbali) .
lens_profiles.distance = Focus distance (0 = dɔnbali) .
lens_profiles.vignette = Vignetting kalibrelen
lens_profiles.color_context = Vignetting kalibrelen bɛ sRGB profilɛ min sigilen bɛ porogaramu kɔnɔ, o de wajibiya. Aw bɛ ja yɛlɛma sRGB la walasa a yecogo ka to a ko, o kɔ aw bɛ Lantiyɛri labɛnni da wuli kokura. Ni pixelw ye sRGB ye kaban nka taamasiyɛn tɛ u kan, sRGB profilɛ di u ma dɔrɔn ka bɔ. Ja cogoya ni kulɛri labɛnni bɛ to yen.
lens_profiles.vignette_missing = Vignetting calibration si tɛ aperture ni focus distance datugu. Sumanikɛlanw don walasa a ka se ka kɛ; 1000 m bɛ yɔrɔjan sinsincogo jira Lensfun ka profil caman kɔnɔ.
lens_profiles.note = Kalibrelen latilenni bɛ kɛ sani bolo la kontrolw ka kɛ. Baara kɛ ni foto fɔlɔ dafalen ye; o kɔfɛ a tigɛ. Filɛri kulu mara PSD/PSB kɔnɔ walasa kalibreni ka to ka se ka ladilan.
lens_profiles.automatic = Fotow ka metadata bɛ bɛn ɲɔgɔn ma
lens_profiles.components = Profil tɛmɛsira: distorsion {distortion}; kulɛri bɔgɔlanw {tca}; vignetting {vignette} ye.
