# Labɛn
command.edit.undo.title = Kɛlen lasegin
command.edit.undo.description = Segin kɔfɛ sigida kelen sɛbɛn ka laseginni baarakɔrɔ kɔnɔ.
command.edit.redo.title = Kɛ kokura
command.edit.redo.description = Labɛnni min laseginna laban na, o kɛ kokura.
command.edit.copy.title = Kopi
command.edit.copy.description = Kaliki min bɛ baara la, o pikisɛli sugandilenw kopi ka don kɔnɔ klipibɔrɔdi la (ni sugandili tɛ yen, kaliki bɛɛ).
command.edit.copy_merged.title = Ɲagaminen kopi
command.edit.copy_merged.description = Sugandili kopi i n'a fɔ kaliki jiralen bɛɛ b'u ɲagami cogo min, a kana bɔ kaliki min bɛ baara la o kelen dɔrɔn na.
command.edit.cut.title = Tigɛ
command.edit.cut.description = Pikisɛli sugandilenw kopi ka don klipibɔrɔdi la, ka u bɔ kaliki min bɛ baara la o kɔnɔ.
command.edit.paste.title = Kopilen da
command.edit.paste.description = Klipibɔrɔdi kɔnɔko da kaliki kura kɔnɔ kaliki min bɛ baara la o sanfɛ, kanvas cɛmancɛ la.
command.edit.paste.layer_name = Kaliki kopilen
command.edit.paste_in_place.title = Kopilen da a yɔrɔ la
command.edit.paste_in_place.description = Klipibɔrɔdi kɔnɔko da kaliki kura kɔnɔ, a kopi kɛra yɔrɔ min na o hakɛw la.
command.edit.fill_foreground.title = Fa ɲɛfɛ kulɛri la
command.edit.fill_foreground.description = Sugandili fa ɲɛfɛ kulɛri la (walima kanvas bɛɛ ni sugandili tɛ yen).
command.edit.fill_background.title = Fa kɔfɛ kulɛri la
command.edit.fill_background.description = Sugandili fa kɔfɛ kulɛri la (walima kanvas bɛɛ ni sugandili tɛ yen).

# Sugandili
command.select.all.title = Bɛɛ sugandi
command.select.all.description = Kanvas bɛɛ sugandi.
command.select.deselect.title = Sugandili bɔ
command.select.deselect.description = Sugandili bɔ walasa labɛnniw ka kɛ kaliki bɛɛ la tuguni.
command.select.inverse.title = Sugandili kɔrɔcɛma
command.select.inverse.description = Yɔrɔ sugandilenw ni yɔrɔ minnu ma sugandi olu falen.
command.select.reselect.title = Sugandi kokura
command.select.reselect.description = Sugandili min bɔra laban na, o lasegin.
command.select.reselect.msg.nothing_to_reselect = Foyi tɛ yen ka sugandi kokura
command.select.feather.title = Sugandili kɛrɛ nɔgɔnya
command.select.feather.description = Sugandili kɛrɛ nɔgɔnya ni pikisɛli fila flou ye, walasa labɛnni nata ka tunun dɔɔnin-dɔɔnin ka tɛmɛ o fɛ.
command.select.grow.title = Bonya
command.select.grow.description = Sugandili bonya ka don pikisɛli dafalenw na minnu bɛ ɲɔgɔn ni sugandilenw ye, Kabako bere ka se hakɛ kɔnɔ.
command.select.similar.title = Ɲɔgɔnna
command.select.similar.description = Kaliki pikisɛli bɛɛ minnu bɛ ɲɔgɔn ni sugandili ye, olu sugandi Kabako bere ka se hakɛ kɔnɔ, u dafalen b'a la walima ayi.
command.select.save.title = Sugandili mara
command.select.save.description = Sisan sugandili dogo sɛbɛn kɔnɔ i n'a fɔ alfa kanala tɔgɔlaminen.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Sugandili lasegin
command.select.load.description = Sugandili maralen laban lasegin.

# Kaliki
command.layer.new.title = Kaliki kura
command.layer.new.description = Raster kaliki lankolon fara kaliki min bɛ baara la o sanfɛ, ka kura kɛ baarakɛta ye.
command.layer.duplicate.title = Kaliki filanan dilan
command.layer.duplicate.description = Kaliki min bɛ baara la o kopi, a kɔnɔko bɛɛ ni a ye, ka kɛ kaliki kura ye a sanfɛ.
command.layer.smart_object.title = Yɛlɛma ka kɛ Smart Object ye
command.layer.smart_object.description = Kaliki raster min bɛ baara la o pikisɛliw datugu smart object kɔnɔ, walasa yɛlɛmali ni sɛgɛsɛgɛli nataw ka pikisɛliw bɔ kokura ka bɔ bɔyɔrɔ ma min ma yɛlɛma.
command.layer.rasterize.title = Kaliki rasterize
command.layer.rasterize.description = Siyali, sɛbɛn walima smart-object kaliki yɛlɛma ka kɛ pikisɛli kɛrɛnkɛrɛnnenw ye.
command.layer.delete.title = Kaliki bɔ
command.layer.delete.description = Kaliki sugandilenw bɔ.
command.layer.group.title = Kalikiw gurupula
command.layer.group.description = Kaliki sugandilenw datugu gurupu kura kɔnɔ, u yɔrɔ yɛrɛ la.
command.layer.raise.title = Taa ɲɛfɛ
command.layer.raise.description = Kaliki min bɛ baara la o lamaga sigida kelen sanfɛ a gurupu stack kɔnɔ.
command.layer.lower.title = Taa kɔfɛ
command.layer.lower.description = Kaliki min bɛ baara la o lamaga sigida kelen duguma a gurupu stack kɔnɔ.
command.layer.to_front.title = Bila ɲɛfɛ bɛɛ la
command.layer.to_front.description = Kaliki min bɛ baara la o lamaga ka taa a gurupu sanfɛ bɛɛ la.
command.layer.to_back.title = Bila kɔfɛ bɛɛ la
command.layer.to_back.description = Kaliki min bɛ baara la o lamaga ka taa a gurupu duguma bɛɛ la.
command.layer.clipping_mask.title = Tigɛli datugulan dilan/bɔ
command.layer.clipping_mask.description = Kaliki min bɛ baara la o tigɛ ka bɛn a duguma kaliki ma, walima a bɔ ni a tigɛlen don kaban; kaliki tigɛlen bɛ jira yɔrɔ minnu dɔrɔn na a jukɔrɔ kaliki pikisɛliw bɛ yen.
command.layer.cut_to_new.title = Kaliki kɛ tigɛli fɛ
command.layer.cut_to_new.description = Pikisɛli sugandilenw bɔ kaliki min bɛ baara la o kɔnɔ, ka u bila kaliki kura kɔnɔ a sanfɛ.
command.layer.cut_to_new.layer_name = Kaliki kɛ tigɛli fɛ
command.layer.add_mask.title = Kaliki datugulan fara
command.layer.add_mask.description = Kaliki datugulan fara kaliki min bɛ baara la o kan; ni sugandili bɛ yen, o dɔrɔn bɛ jira.
command.layer.flatten.title = Ja kɛ kaliki kelen ye
command.layer.flatten.description = Fɛn jiralen bɛɛ ɲagami ka kɛ Kɔfɛ kaliki kelen datugulen ye, ka kaliki dogolenw bila.
command.layer.merge_down.title = Ɲagami ka taa duguma
command.layer.merge_down.description = Kaliki min bɛ baara la o ɲagami ni a jukɔrɔ kaliki ye.
command.layer.merge_down.msg.no_layer_below = Kaliki tɛ duguma ka ɲagami a la
command.layer.merge_visible.title = Jiralenw ɲagami
command.layer.merge_visible.description = Kaliki jiralen bɛɛ ɲagami ka kɛ kelen ye, ka kaliki dogolenw to u cogo la.

command.msg.nothing_to_copy = Pikisɛli kaliki dɔ sugandi ka kopi bɔ a la
command.msg.clipboard_empty = Foyi tɛ klipibɔrɔdi kan

