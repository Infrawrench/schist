tool.select.mode.subtract = אַראָפּנעמען
tool.select.mode.intersect = איבערשנײַדן
tool.marquee.rect.name = רעכטעקיקער אויסוואַל־ראַם
tool.marquee.rect.description = שלעפּט אַרויס אַ רעכטעקיקן אויסוואַל. Shift בײַם אָנהייב פֿונעם שלעפּן גיט צו צום אויסוואַל, alt נעמט אַראָפּ, און ביידע מאַכן אַן איבערשניט; Shift בעתן שלעפּן מאַכט אים קוואַדראַטיש. אַ קליק אָן שלעפּן נעמט אַוועק דעם אויסוואַל.
tool.marquee.ellipse.name = עליפּטישער אויסוואַל־ראַם
tool.marquee.ellipse.description = שלעפּט אַרויס אַן עליפּטישן אויסוואַל, מיט די זעלבע Shift/alt־קאָמבינאַציעס ווי בײַם רעכטעקיקן אויסוואַל־ראַם.
tool.lasso.name = לאַסאָ
tool.lasso.description = שלעפּט אַ פֿרײַהאַנטיקן קאָנטור; דער אויסוואַל שליסט זיך צווישן די עקן ווען דאָס שלעפּן ענדיקט זיך. Shift גיט צו, alt נעמט אַראָפּ.
tool.lasso.history.select = לאַסאָ־אויסוואַל
tool.lasso.polygonal.name = פּאָליגאָנאַלער לאַסאָ
tool.lasso.polygonal.description = דריקט ווינקל נאָך ווינקל כּדי צו בויען אַן אויסוואַל מיט גלײַכע ראַנדן, און דריקט לעבן דעם ערשטן פּונקט כּדי אים צו פֿאַרמאַכן.
tool.lasso.polygonal.history.select = פּאָליגאָנאַלער לאַסאָ
tool.lasso.magnetic.name = מאַגנעטישער לאַסאָ
tool.lasso.magnetic.description = פֿירט דעם ווײַזער אומגעפֿער לענגאויס אַ ראַנד, און דער קאָנטור קלעפּט זיך צו דעם שטאַרקסטן קאָנטראַסט לעבן דעם דרך.
tool.lasso.magnetic.history.select = מאַגנעטישער לאַסאָ
tool.lasso.magnetic.option.frequency = אָפֿטקייט
tool.wand.name = כּישוף־שטעקן
tool.wand.description = דריקט כּדי אויסצוקלײַבן דעם צוזאַמענהענגיקן ראַיאָן מיט ענלעכן קאָליר אונטערן ווײַזער, לויט דער טאָלעראַנץ־אָפּציע — די זעלבע טאָלעראַנץ וואָס פֿאַרברייטערן, ענלעך און קאָליר־ראַיאָן ניצן.
tool.wand.option.contiguous = צוזאַמענהענגיק
tool.wand.history.select = כּישוף־שטעקן
tool.quick_select.name = שנעלער אויסוואַל
tool.quick_select.description = מאָלט איבער אַ ראַיאָן, און דער אויסוואַל וואַקסט דורך די ענלעכע פּיקסלען איבער וועלכע דער באַרשט גייט.
tool.quick_select.history.select = שנעלער אויסוואַל
tool.object_select.name = אָביעקט־אויסוואַל
tool.object_select.description = שלעפּט אַ קעסטל אַרום אַן אָביעקט, און דער אויסוואַל קלעפּט זיך צו דעם אָביעקט וואָס ווערט געפֿונען אינעווייניק.
tool.object_select.history.select = אָביעקט־אויסוואַל
