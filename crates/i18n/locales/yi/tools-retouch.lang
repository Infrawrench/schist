tool.patch.name = לאַטע
tool.patch.description = שלעפּ אַן אויסליניע אַרום אַ פֿעלער, דערנאָך שלעפּ די אויסוואַל אויף ריינע פּיקסלען: די דאָרטיקע טעקסטור ווערט צוגעפּאַסט אינעם פֿעלער. דער לאַטע־מאָדוס באַשטימט וועלכן עק פֿונעם פּאָר מע שלעפּט.
tool.patch.option.patch = לאַטע
tool.patch.choice.source = מקור
tool.patch.choice.destination = ציל
tool.patch.history.patch = לאַטע
tool.content_aware_move.name = אינהאַלט־באַוווּסט רירן
tool.content_aware_move.description = שלעפּ אַן אויסגעקליבענעם אָביעקט ערגעץ אַנדערש, און דאָס לאָך וואָס בלײַבט ווערט אויסגעפֿילט פֿון זײַן סבֿיבֿה. אין פֿאַרלענגערן־מאָדוס ציט מען אויס דעם אָביעקט אַנשטאָט אים צו רירן.
tool.content_aware_move.choice.move = רירן
tool.content_aware_move.choice.extend = פֿאַרלענגערן
tool.content_aware_move.history.move = אינהאַלט־באַוווּסט רירן
tool.red_eye.name = רויט אויג
tool.red_eye.description = דריק אויף אַ שוואַרצאַפּל כּדי אַרויסצונעמען דערפֿון דאָס רויט פֿון בליץ־ליכט.
tool.red_eye.option.pupil_size = שוואַרצאַפּל־גרייס
tool.red_eye.option.darken = פֿינצטערער מאַכן
tool.red_eye.history.red_eye = רויט אויג
tool.magic_eraser.name = מאַגישער מעקער
tool.magic_eraser.description = דריק כּדי אויסצומעקן דעם שטח מיט ענלעכער קאָליר אונטערן ווײַזער, אינעם טאָלעראַנץ פֿונעם געצײַג — נאָר דעם צוזאַמענהענגיקן שטח בײַם דריק, אָדער איבער דער גאַנצער שיכט.
tool.magic_eraser.option.contiguous = צוזאַמענהענגיק
tool.magic_eraser.history.erase = מאַגישער מעקער

# Remove
tool.remove.name = אַוועקנעמען
tool.remove.description = מאָלט איבער אַן אומגעוואונטשן אָביעקט מיט איין שטריך; ווען איר לאָזט אָפּ, ווערט ער אָנגעפֿילט פֿון זײַן אַרומיקייט. ווען „אַוועקנעמען נאָך יעדן שטריך“ איז אויסגעשאַלטן, מאָלט עטלעכע שטריכן און דריקט Enter כּדי זיי צוזאַמען אַוועקצונעמען.
tool.remove.option.sample_all_layers = מוסטער פֿון אַלע שיכטן
tool.remove.option.remove_after_each_stroke = אַוועקנעמען נאָך יעדן שטריך
tool.remove.history.remove = אַוועקנעמען
tool.remove.layer_name = אַוועקגענומען
