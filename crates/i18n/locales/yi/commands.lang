command.edit.undo.title = צוריקמאַכן
command.edit.undo.description = גייט איין טריט צוריק אין דער צוריקמאַך־געשיכטע פֿונעם דאָקומענט.
command.edit.redo.title = איבערמאַכן
command.edit.redo.description = מאַכט ווידער די ענדערונג וואָס מען האָט לעצטנס צוריקגעמאַכט.
command.edit.copy.title = קאָפּירן
command.edit.copy.description = קאָפּירט די אויסגעקליבענע פּיקסלען פֿון דער אַקטיווער שיכט אינעם אינערלעכן קליפּבאָרד (די גאַנצע שיכט ווען גאָרנישט איז אויסגעקליבן).
command.edit.copy_merged.title = קאָפּירן צונויפֿגעגאָסן
command.edit.copy_merged.description = קאָפּירט דעם אויסוואַל ווי אַלע זעעוודיקע שיכטן שטעלן אים צונויף, אַנשטאָט בלויז פֿון דער אַקטיווער שיכט.
command.edit.cut.title = אויסשנײַדן
command.edit.cut.description = קאָפּירט די אויסגעקליבענע פּיקסלען אינעם קליפּבאָרד און מעקט זיי אויס פֿון דער אַקטיווער שיכט.
command.edit.paste.title = אַרײַנקלעפּן
command.edit.paste.description = קלעפּט דעם קליפּבאָרד אַרײַן אין אַ נײַער שיכט איבער דער אַקטיווער, צענטרירט אויפֿן לײַוונט.
command.edit.paste.layer_name = אַרײַנגעקלעפּטע שיכט
command.edit.paste_in_place.title = אַרײַנקלעפּן אויפֿן זעלבן אָרט
command.edit.paste_in_place.description = קלעפּט דעם קליפּבאָרד אַרײַן אין אַ נײַער שיכט בײַ די קאָאָרדינאַטן פֿון וועלכע ער איז קאָפּירט געוואָרן.
command.edit.fill_foreground.title = אויספֿילן מיט פֿאָרגרונט
command.edit.fill_foreground.description = פֿילט דעם אויסוואַל (אָדער דעם גאַנצן לײַוונט ווען גאָרנישט איז אויסגעקליבן) מיטן פֿאָרגרונט־קאָליר.
command.edit.fill_background.title = אויספֿילן מיט הינטערגרונט
command.edit.fill_background.description = פֿילט דעם אויסוואַל (אָדער דעם גאַנצן לײַוונט ווען גאָרנישט איז אויסגעקליבן) מיטן הינטערגרונט־קאָליר.
command.select.all.title = אַלץ אויסקלײַבן
command.select.all.description = קלײַבט אויס דעם גאַנצן לײַוונט.
command.select.deselect.title = אָפּקלײַבן
command.select.deselect.description = נעמט אַוועק דעם אויסוואַל, אַזוי אַז ענדערונגען גילטן ווידער פֿאַר דער גאַנצער שיכט.
command.select.inverse.title = איבערקערן אויסוואַל
command.select.inverse.description = פֿאַרבײַט די אויסגעקליבענע און נישט־אויסגעקליבענע ראַיאָנען.
command.select.reselect.title = ווידער אויסקלײַבן
command.select.reselect.description = ברענגט צוריק דעם אויסוואַל וואָס מען האָט לעצטנס אַוועקגענומען.
command.select.reselect.msg.nothing_to_reselect = גאָרנישט ווידער אויסצוקלײַבן
command.select.feather.title = פֿאַרווייכערן אויסוואַל־ראַנד
command.select.feather.description = פֿאַרווייכערט דעם ראַנד פֿונעם אויסוואַל מיט אַ צוויי־פּיקסלדיקער פֿאַרווייכערונג, אַזוי אַז די קומענדיקע ענדערונג פֿאַרבלאַסט איבער אים.
command.select.grow.title = פֿאַרברייטערן
command.select.grow.description = פֿאַרברייטערט דעם אויסוואַל אין אָנרירנדיקע פּיקסלען וואָס זענען ענלעך צו די שוין אויסגעקליבענע, לויט דער טאָלעראַנץ פֿונעם כּישוף־שטעקן.
command.select.similar.title = ענלעך
command.select.similar.description = קלײַבט אויס יעדן פּיקסל אין דער שיכט וואָס איז ענלעך צום אויסוואַל, צי ער רירט אים אָן צי נישט, לויט דער טאָלעראַנץ פֿונעם כּישוף־שטעקן.
command.select.save.title = היטן אויסוואַל
command.select.save.description = היט דעם איצטיקן אויסוואַל אינעם דאָקומענט ווי אַ באַנומענעם אַלפֿאַ־קאַנאַל.
command.select.save.channel_name = אַלפֿאַ {n}
command.select.load.title = לאָדן אויסוואַל
command.select.load.description = שטעלט צוריק דעם לעצטנס געהיטן אויסוואַל.
command.layer.new.title = נײַע שיכט
command.layer.new.description = גיט צו אַ ליידיקע ראַסטער־שיכט איבער דער אַקטיווער און מאַכט זי אַקטיוו.
command.layer.duplicate.title = דופּליקירן שיכט
command.layer.duplicate.description = קאָפּירט די אַקטיווע שיכט מיט איר גאַנצן אינהאַלט אין אַ נײַער שיכט איבער איר.
command.layer.smart_object.title = איבערמאַכן צו קלוגן אָביעקט
command.layer.smart_object.description = פּאַקט די פּיקסלען פֿון דער אַקטיווער ראַסטער־שיכט אין אַ קלוגן אָביעקט, אַזוי אַז שפּעטערע טראַנספֿאָרמאַציעס און פֿילטערס נעמען נײַע מוסטערן פֿונעם אומבאַרירטן מקור.
command.layer.rasterize.title = ראַסטעריזירן שיכט
command.layer.rasterize.description = מאַכט אַ פֿאָרעם־, טעקסט־ אָדער קלוגער־אָביעקט־שיכט פֿאַר פּשוטע פּיקסלען.
command.layer.delete.title = אויסמעקן שיכט
command.layer.delete.description = מעקט אויס די אויסגעקליבענע שיכטן.
command.layer.group.title = גרופּירן שיכטן
command.layer.group.description = לייגט די אויסגעקליבענע שיכטן אין אַ נײַער גרופּע אויפֿן זעלבן אָרט.
command.layer.raise.title = ברענגען פֿאָרויס
command.layer.raise.description = רירט די אַקטיווע שיכט איין אָרט אַרויף אינעם שיכט־סדר פֿון איר גרופּע.
command.layer.lower.title = שיקן צוריק
command.layer.lower.description = רירט די אַקטיווע שיכט איין אָרט אַראָפּ אינעם שיכט־סדר פֿון איר גרופּע.
command.layer.to_front.title = ברענגען גאַנץ פֿאָרויס
command.layer.to_front.description = רירט די אַקטיווע שיכט גאַנץ אויבן אין איר גרופּע.
command.layer.to_back.title = שיקן גאַנץ צוריק
command.layer.to_back.description = רירט די אַקטיווע שיכט גאַנץ אונטן אין איר גרופּע.
command.layer.clipping_mask.title = שאַפֿן/באַפֿרײַען אָפּשניט־מאַסקע
command.layer.clipping_mask.description = שנײַדט די אַקטיווע שיכט לויט דער שיכט אונטער איר, אָדער באַפֿרײַט זי אויב זי איז שוין אָפּגעשניטן; אַן אָפּגעשניטענע שיכט ווײַזט זיך נאָר וווּ איר באַזע האָט פּיקסלען.
command.layer.cut_to_new.title = שיכט דורכן אויסשנײַדן
command.layer.cut_to_new.description = רירט די אויסגעקליבענע פּיקסלען פֿון דער אַקטיווער שיכט אין אַ נײַער שיכט איבער איר.
command.layer.cut_to_new.layer_name = שיכט דורכן אויסשנײַדן
command.layer.add_mask.title = צוגעבן שיכט־מאַסקע
command.layer.add_mask.description = גיט צו אַ שיכט־מאַסקע צו דער אַקטיווער שיכט, וואָס ווײַזט בלויז דעם אויסוואַל ווען ס׳איז דאָ איינער.
command.layer.flatten.title = פֿלאַך מאַכן בילד
command.layer.flatten.description = שטעלט צונויף אַלץ זעעוודיקס אין איין אומדורכזעיקער הינטערגרונט־שיכט און וואַרפֿט אַוועק באַהאַלטענע שיכטן.
command.layer.merge_down.title = צונויפֿגיסן אַראָפּ
command.layer.merge_down.description = שטעלט צונויף די אַקטיווע שיכט מיט דער שיכט אונטער איר.
command.layer.merge_down.msg.no_layer_below = קיין שיכט אונטן מיט וועלכער צונויפֿצוגיסן
command.layer.merge_visible.title = צונויפֿגיסן זעעוודיקע
command.layer.merge_visible.description = שטעלט צונויף אַלע זעעוודיקע שיכטן אין איינעם און לאָזט באַהאַלטענע שיכטן אומבאַרירט.
