# Lens profile controls.
lens_profiles.invalid = Dəstəklənən kamera və ya obyektiv datası ilə etibarlı Lensfun v1/v2 XML verilənlər bazası (8 MiB-a qədər) seçin.
lens_profiles.calibration = Lensin kalibrlənməsi
lens_profiles.no_calibration = Heç bir kalibrləmə bu parametrləri əhatə etmir. Fokus uzunluğunu və kamera kəsmə faktorunu yoxlayın; əl ilə düzəliş mövcud olaraq qalır.
lens_profiles.import = Lensfun XML-i idxal edin...
lens_profiles.imported = Bu sessiya üçün Lensfun verilənlər bazası idxal edildi. Profil seçin və ya foto metadatasını uyğunlaşdırın.
lens_profiles.manual = Yalnız əl ilə düzəliş
lens_profiles.saved = Saxlanmış kalibrləmə (verilənlər bazası mövcud deyil)
lens_profiles.profile = Lens profili
lens_profiles.aperture = Diyafram (0 = naməlum)
lens_profiles.distance = Fokus məsafəsi (0 = naməlum)
lens_profiles.vignette = Kalibrlənmiş vinyetləmə
lens_profiles.color_context = Kalibrlənmiş vinyetləmə daxili sRGB profilini tələb edir. Görünüşü qorumaq üçün sRGB-ə çevirin, sonra Lens Korreksiyasını yenidən açın. Artıq sRGB etiketlənməmiş piksellər üçün sRGB təyin etmək kifayətdir. Həndəsə və xromatik korreksiya mövcud olaraq qalır.
lens_profiles.vignette_missing = Heç bir vinyetləmə kalibrləməsi bu diafraqma və fokus məsafəsini əhatə etmir. Aktivləşdirmək üçün ölçülmüş dəyərləri daxil edin; bir çox Lensfun profilində 1000 m uzaq məsafəyə fokuslanmanı bildirir.
lens_profiles.note = Kalibrlənmiş düzəliş əl ilə idarəetmədən əvvəl tətbiq olunur. Orijinal tam kadrdan istifadə edin; sonra kadrı kəsin. Redaktə edilə bilən kalibrləməni saxlamaq üçün filtr yığınını PSD/PSB-də saxlayın.
lens_profiles.automatic = Foto metadatasını uyğunlaşdırın
lens_profiles.components = Profil keçidi: təhrif {distortion}; rəngli saçaqlar {tca}; vinyetləmə {vignette}.
