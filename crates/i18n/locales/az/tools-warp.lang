# Əymə alətləri: Mayeləşdirmə, Kukla əyməsi və Perspektiv nöqtəsi.

# Mayeləşdirmə
tool.liquify.name = Mayeləşdirmə
tool.liquify.description = Böyük fırçanın altındakı pikselləri itələyin, burun, büzün və ya şişirdin; əməliyyatı rejim seçimi müəyyən edir. Əymə torda toplanır və təsdiqləndikdə qata tətbiq olunur.
tool.liquify.option.tool = Alət
tool.liquify.choice.forward_warp = İrəli əymə
