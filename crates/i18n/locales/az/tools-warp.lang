tool.liquify.choice.bloat = Şişirt
tool.liquify.choice.push_left = Sola itələ
tool.liquify.history.liquify = Mayeləşdirmə

# Kukla əyməsi
tool.puppet_warp.name = Kukla əyməsi
tool.puppet_warp.description = Qatı bir neçə nöqtədə bərkitmək üçün klikləyin, sonra nöqtələrdən birini sürükləyin: tor Sərtlik seçiminə uyğun olaraq bərkitmə nöqtələrinin ətrafında sərt və ya elastik şəkildə əyilir. Təsdiqləmə nəticəni tətbiq edir.
tool.puppet_warp.option.stiffness = Sərtlik
tool.puppet_warp.history.puppet_warp = Kukla əyməsi

# Perspektiv nöqtəsi
tool.vanishing_point.name = Perspektiv nöqtəsi
tool.vanishing_point.description = Perspektivli obyektin üzərində müstəvi çəkin, sonra rejimi Klonlama olaraq dəyişib rəngləyin: kopyalanmış piksellər müstəvini izləyir və məsafə artdıqca kiçilir.
tool.vanishing_point.choice.edit_plane = Müstəvini redaktə et
tool.vanishing_point.choice.clone = Klonlama
