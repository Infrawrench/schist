# Advanced photo merge.
photo_merge_advanced.projective = Perspektiv düzülüşü (fırlanma daxildir)
photo_merge_advanced.cylindrical = Silindrik panorama
photo_merge_advanced.deghost = Hərəkət edən obyektlərin təkrarlanan təsvirlərini silin (birinci foto istinaddır)
photo_merge_advanced.focal = Fokus uzunluğu (px) / şəkil eni (px)
photo_merge_advanced.masks = Fokus çıxışı redaktə edilə bilən təbəqə maskalarından istifadə edir. Qatlarda maska ​​seçin və dəqiqləşdirmək üçün rəngləyin.
photo_merge_advanced.no_match = Etibarlı düzülüş tapılmadı. Böyük ölçüdə üst-üstə düşən və baxış bucağı az dəyişən, detallı fotolardan istifadə edin.
photo_merge_advanced.invalid = Mənbə şəkilləri və ya birləşdirmə parametrləri etibarsızdır.
