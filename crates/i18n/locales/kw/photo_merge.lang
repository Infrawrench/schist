# Photographic merging. Direct translation; native review welcome.
photo_merge.title = Kesunya skeusennow…
photo_merge.align = Unlina awtomatek
photo_merge.focus = Kesunya skeusennow gans pellderow fokus dihaval
photo_merge.hdr = HDR a eksposyansow dihaval
photo_merge.panorama = Kesunya skeusennow yn panorama
photo_merge.translation = Gwayansow a-dreus hag a-bann hepken (X/Y); troans ha perspektiv nyns yns ewnhys.
photo_merge.crop = Treghi dhe'n aren kemmyn
photo_merge.exposure_note = Gorra eksposyans kemmysyek pub skeusen: +1 EV = diwweyth an golow. Difuna mappya tonyow rag gwitha HDR 32-bit.
photo_merge.tone_map = Mappya tonyow
