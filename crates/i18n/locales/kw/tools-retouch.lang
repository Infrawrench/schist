tool.patch.history.patch = Palyas

tool.content_aware_move.name = Gwaya Omwodhog a Gontent
tool.content_aware_move.description = Tenna tra dewisys dhe le aral ha'n toll a wra ev gasa a vydh leunys dhyworth y kerghynnedh. Yn fordh Estenna, an tra a vydh estennys yn le bos sewys.
