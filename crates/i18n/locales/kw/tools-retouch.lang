tool.content_aware_move.choice.extend = Estenna
tool.content_aware_move.history.move = Gwaya Omwodhog a Gontent

tool.red_eye.name = Lagas Rudh
tool.red_eye.description = Klyckya kannwyll an lagas rag remova'n rudhder dhyworth an flamm.
