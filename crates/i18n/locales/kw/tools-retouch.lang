tool.magic_eraser.name = Diler Hud
tool.magic_eraser.description = Klyckya rag dilea an ran a liw hevel yn-dann an poyntyer, a-ji dhe odhomyans an tool — keskelmys orth an klyck, po ymhob le y'n gwisk.
tool.magic_eraser.option.contiguous = Keskelmys
tool.magic_eraser.history.erase = Diler Hud

