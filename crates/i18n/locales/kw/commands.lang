command.edit.undo.title = Digelmi
command.edit.undo.description = Mos war-dhelergh unn kamm yn istori digelmi an skrifen.
command.edit.redo.title = Daswul
command.edit.redo.description = Daswul an golygyans diwettha a veu digelmys.
command.edit.copy.title = Kopia
command.edit.copy.description = Kopia piksellow dewisys an gwisk oberiethek dhe'n astel glyppya diabarh (an gwisk dien pan nyns eus dewis).
command.edit.copy_merged.title = Kopia Kesunys
command.edit.copy_merged.description = Kopia an dewis avel ma pub gwisk gweladow yn y gespos, yn le dhyworth an gwisk oberiethek yn unn.
command.edit.cut.title = Treghy
command.edit.cut.description = Kopia an piksellow dewisys dhe'n astel glyppya ha'ga dilea dhyworth an gwisk oberiethek.
command.edit.paste.title = Glusa
command.edit.paste.description = Glusa an astel glyppya yn gwisk nowydh a-ugh an hini oberiethek, kresys war an lien.
command.edit.paste.layer_name = Gwisk Glusys
command.edit.paste_in_place.title = Glusa yn y Le
command.edit.paste_in_place.description = Glusa an astel glyppya yn gwisk nowydh orth an ko-ordinednow may feu kopyes dhywortans.
command.edit.fill_foreground.title = Leunhe gans Ragdir
