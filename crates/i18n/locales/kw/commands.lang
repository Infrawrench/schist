command.edit.fill_background.title = Leunhe gans Kilndir
command.edit.fill_background.description = Leunhe an dewis (po'n lien dien pan nyns eus dewis) gans an liw kilndir.
command.select.all.title = Dewis Oll
command.select.all.description = Dewis an lien dien.
