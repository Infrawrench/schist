command.select.feather.title = Medhelhe Dewis
command.select.feather.description = Mollhe amal an dewis gans blur dew biksel, may fo an golygyans nessa ow tewlel yn-mes dresto.
command.select.grow.title = Tewhe
command.select.grow.description = Estenna an dewis yn piksellow ow tochya hag owth omheveli orth pyth usi dewisys seulabrys, a-ji dhe odhomyans an gwelen hud.
command.select.similar.title = Hevel
command.select.similar.description = Dewis pub piksel y'n gwisk usi owth omheveli orth an dewis, ow tochya orto po na wra, a-ji dhe odhomyans an gwelen hud.
command.select.save.title = Sawya Dewis
command.select.save.description = Gwitha an dewis a-lemmyn y'n skrifen avel kanol alpha henwys.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Karga Dewis
command.select.load.description = Daskarga an dewis sawys diwettha.
command.layer.new.title = Gwisk Nowydh
command.layer.new.description = Keworra gwisk raster gwag a-ugh an hini oberiethek ha'y wul oberiethek.
