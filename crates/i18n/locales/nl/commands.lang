# Kernopdrachten voor Bewerken, Selecteren en Laag.
command.edit.undo.title = Ongedaan maken
command.edit.undo.description = Ga één item terug in de historie voor Ongedaan maken van het document.
command.edit.redo.title = Opnieuw
command.edit.redo.description = Voer de bewerking die als laatste ongedaan is gemaakt opnieuw uit.
command.edit.copy.title = Kopiëren
command.edit.copy.description = Kopieer de geselecteerde pixels van de actieve laag naar het interne klembord (de hele laag als niets is geselecteerd).
command.edit.copy_merged.title = Verenigd kopiëren
command.edit.copy_merged.description = Kopieer de selectie zoals alle zichtbare lagen deze samenstellen, in plaats van alleen vanaf de actieve laag.
command.edit.cut.title = Knippen
command.edit.cut.description = Kopieer de geselecteerde pixels naar het klembord en wis ze uit de actieve laag.
command.edit.paste.title = Plakken
command.edit.paste.description = Plak de inhoud van het klembord gecentreerd op het canvas in een nieuwe laag boven de actieve laag.
command.edit.paste.layer_name = Geplakte laag
command.edit.paste_in_place.title = Op plaats plakken
command.edit.paste_in_place.description = Plak de inhoud van het klembord in een nieuwe laag op de coördinaten waarvan deze is gekopieerd.
command.edit.fill_foreground.title = Vullen met voorgrondkleur
command.edit.fill_foreground.description = Vul de selectie (of het hele canvas als niets is geselecteerd) met de voorgrondkleur.
command.edit.fill_background.title = Vullen met achtergrondkleur
command.edit.fill_background.description = Vul de selectie (of het hele canvas als niets is geselecteerd) met de achtergrondkleur.

command.select.all.title = Alles selecteren
command.select.all.description = Selecteer het hele canvas.
command.select.deselect.title = Deselecteren
command.select.deselect.description = Hef de selectie op, zodat bewerkingen weer op de hele laag worden toegepast.
command.select.inverse.title = Selectie omkeren
command.select.inverse.description = Verwissel de geselecteerde en niet-geselecteerde gebieden.
command.select.reselect.title = Opnieuw selecteren
command.select.reselect.description = Herstel de selectie die als laatste is opgeheven.
command.select.reselect.msg.nothing_to_reselect = Niets om opnieuw te selecteren
command.select.feather.title = Selectie doezelen
command.select.feather.description = Maak de rand van de selectie zachter met een vervaging van twee pixels, zodat de volgende bewerking langs de rand geleidelijk verdwijnt.
command.select.grow.title = Vergroten
command.select.grow.description = Breid de selectie binnen de tolerantie van de toverstaf uit naar aangrenzende pixels die lijken op de al geselecteerde pixels.
command.select.similar.title = Gelijkend
command.select.similar.description = Selecteer binnen de tolerantie van de toverstaf elke pixel in de laag die op de selectie lijkt, ongeacht of deze eraan grenst.
command.select.save.title = Selectie opslaan
command.select.save.description = Sla de huidige selectie als benoemd alfakanaal in het document op.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Selectie laden
command.select.load.description = Herstel de meest recent opgeslagen selectie.

command.layer.new.title = Nieuwe laag
command.layer.new.description = Voeg boven de actieve laag een lege rasterlaag toe en maak deze actief.
command.layer.duplicate.title = Laag dupliceren
command.layer.duplicate.description = Kopieer de actieve laag met de volledige inhoud naar een nieuwe laag erboven.
command.layer.smart_object.title = Omzetten in slim object
command.layer.smart_object.description = Plaats de pixels van de actieve rasterlaag in een slim object, zodat latere transformaties en filters de onaangetaste bron opnieuw samplen.
command.layer.rasterize.title = Laag rasteren
command.layer.rasterize.description = Zet een vorm-, tekst- of slim-objectlaag definitief om in gewone pixels.
command.layer.delete.title = Laag verwijderen
command.layer.delete.description = Verwijder de geselecteerde lagen.
command.layer.group.title = Lagen groeperen
command.layer.group.description = Plaats de geselecteerde lagen op hun huidige positie in een nieuwe groep.
command.layer.raise.title = Naar voren
command.layer.raise.description = Verplaats de actieve laag één positie omhoog in de stapel van de groep.
command.layer.lower.title = Naar achteren
command.layer.lower.description = Verplaats de actieve laag één positie omlaag in de stapel van de groep.
command.layer.to_front.title = Helemaal naar voren
command.layer.to_front.description = Verplaats de actieve laag naar de bovenkant van de groep.
command.layer.to_back.title = Helemaal naar achteren
command.layer.to_back.description = Verplaats de actieve laag naar de onderkant van de groep.
command.layer.clipping_mask.title = Uitknipmasker maken/vrijgeven
command.layer.clipping_mask.description = Knip de actieve laag uit op de laag eronder, of geef deze vrij als dat al het geval is. Een uitgeknipte laag is alleen zichtbaar waar de basislaag pixels bevat.
command.layer.cut_to_new.title = Laag via knippen
command.layer.cut_to_new.description = Verplaats de geselecteerde pixels uit de actieve laag naar een nieuwe laag erboven.
command.layer.cut_to_new.layer_name = Laag via knippen
command.layer.add_mask.title = Laagmasker toevoegen
command.layer.add_mask.description = Voeg een laagmasker toe aan de actieve laag dat alleen de selectie onthult als er een selectie is.
command.layer.flatten.title = Eén laag maken
command.layer.flatten.description = Stel al het zichtbare samen in één dekkende achtergrondlaag en verwijder de verborgen lagen.
command.layer.merge_down.title = Verenigen; omlaag
command.layer.merge_down.description = Stel de actieve laag samen met de laag eronder.
command.layer.merge_down.msg.no_layer_below = Geen laag eronder om mee te verenigen
command.layer.merge_visible.title = Zichtbare lagen verenigen
command.layer.merge_visible.description = Stel alle zichtbare lagen samen in één laag en laat de verborgen lagen ongemoeid.

command.msg.nothing_to_copy = Selecteer een pixellaag om van te kopiëren
command.msg.clipboard_empty = Het klembord is leeg

