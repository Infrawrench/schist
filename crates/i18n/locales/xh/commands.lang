command.edit.undo.title = Rhoxisa
command.edit.undo.description = Buyela umva inyathelo elinye kwimbali yokurhoxisa yoxwebhu.
command.edit.redo.title = Phinda
command.edit.redo.description = Phinda uhlengahlengiso olwalusandul' ukurhoxiswa.
command.edit.copy.title = Khuphela
command.edit.copy.description = Khuphela iipikseli ezikhethiweyo zomaleko osebenzayo kwibhodi eqhotyoshwayo yangaphakathi (umaleko wonke xa kungekho nto ikhethiweyo).
command.edit.copy_merged.title = Khuphela Okudityanisiweyo
command.edit.copy_merged.description = Khuphela ukhetho njengoko yonke imaleko ebonakalayo iludibanisa, endaweni yokuluthatha kumaleko osebenzayo kuphela.
command.edit.cut.title = Sika
command.edit.cut.description = Khuphela iipikseli ezikhethiweyo kwibhodi eqhotyoshwayo uze uzicime kumaleko osebenzayo.
command.edit.paste.title = Ncamathelisa
command.edit.paste.description = Ncamathelisa okusebhodini eqhotyoshwayo kumaleko omtsha ongentla kosebenzayo, embindini wekhanvasi.
command.edit.paste.layer_name = Umaleko Oncamathelisiweyo
command.edit.paste_in_place.title = Ncamathelisa Endaweni
command.edit.paste_in_place.description = Ncamathelisa okusebhodini eqhotyoshwayo kumaleko omtsha kwiindawo ezalathayo apho kwakukhutshelwe khona.
command.edit.fill_foreground.title = Gcwalisa Ngombala Wangaphambili
command.edit.fill_foreground.description = Gcwalisa ukhetho (okanye ikhanvasi yonke xa kungekho nto ikhethiweyo) ngombala wangaphambili.
command.edit.fill_background.title = Gcwalisa Ngombala Wasemva
command.edit.fill_background.description = Gcwalisa ukhetho (okanye ikhanvasi yonke xa kungekho nto ikhethiweyo) ngombala wasemva.
command.select.all.title = Khetha Konke
command.select.all.description = Khetha ikhanvasi yonke.
command.select.deselect.title = Susa Ukhetho
command.select.deselect.description = Susa ukhetho, ukuze uhlengahlengiso luphinde lusebenze kumaleko wonke.
command.select.inverse.title = Guqula Ukhetho
command.select.inverse.description = Tshintshisa iindawo ezikhethiweyo nezingakhethwanga.
command.select.reselect.title = Khetha Kwakhona
command.select.reselect.description = Buyisa ukhetho olwalusandul' ukususwa.
command.select.reselect.msg.nothing_to_reselect = Akukho nto inokukhethwa kwakhona
command.select.feather.title = Thambisa Umphetho Wokhetho
command.select.feather.description = Thambisa umphetho wokhetho ngokuwufiphalisa ngeepikseli ezimbini, ukuze uhlengahlengiso olulandelayo luphele kancinane kuwo.
command.select.grow.title = Yandisa
command.select.grow.description = Yandisa ukhetho lungene kwiipikseli eziluchukumisayo nezifana noko sele kukhethiwe, ngaphakathi komda wokunyamezela wentonga yomlingo.
command.select.similar.title = Okufanayo
command.select.similar.description = Khetha yonke ipikseli kumaleko efana nokhetho, nokuba iyaluchukumisa okanye hayi, ngaphakathi komda wokunyamezela wentonga yomlingo.
command.select.save.title = Gcina Ukhetho
command.select.save.description = Gcina ukhetho lwangoku kuxwebhu njengetshaneli ye-alpha enegama.
command.select.save.channel_name = I-Alpha {n}
command.select.load.title = Layisha Ukhetho
command.select.load.description = Buyisela ukhetho olwalusandul' ukugcinwa.
command.layer.new.title = Umaleko Omtsha
command.layer.new.description = Yongeza umaleko werasta ongenanto ngaphezu kosebenzayo uze uwenze usebenze.
command.layer.duplicate.title = Phinda Umaleko
command.layer.duplicate.description = Khuphela umaleko osebenzayo, uquka konke okukuwo, kumaleko omtsha ongentla kwawo.
command.layer.smart_object.title = Guqulela Kwinto Ekrelekrele
command.layer.smart_object.description = Songela iipikseli zomaleko werasta osebenzayo kwinto ekrelekrele, ukuze iinguqu nezihluzi zamva ziphinde zisampule umthombo ongachukunyiswanga.
command.layer.rasterize.title = Yenza Umaleko Ube Yirasta
command.layer.rasterize.description = Guqula umaleko wemilo, wokubhaliweyo okanye wento ekrelekrele ube ziipikseli eziqhelekileyo.
command.layer.delete.title = Cima Umaleko
command.layer.delete.description = Cima imaleko ekhethiweyo.
command.layer.group.title = Yenza Iqela Lemaleko
command.layer.group.description = Songela imaleko ekhethiweyo kwiqela elitsha, kuloo ndawo ikuyo.
command.layer.raise.title = Zisa Phambili
command.layer.raise.description = Nyusa umaleko osebenzayo indawo enye kwimfumba yeqela lawo.
command.layer.lower.title = Thumela Ngasemva
command.layer.lower.description = Hlisa umaleko osebenzayo indawo enye kwimfumba yeqela lawo.
command.layer.to_front.title = Zisa Ngaphambili Kunazo Zonke
command.layer.to_front.description = Hambisa umaleko osebenzayo uye phezulu kwiqela lawo.
command.layer.to_back.title = Thumela Ngasemva Kunazo Zonke
command.layer.to_back.description = Hambisa umaleko osebenzayo uye ezantsi kwiqela lawo.
command.layer.clipping_mask.title = Yenza/Susa Isigqubuthelo Sokusika
command.layer.clipping_mask.description = Sika umaleko osebenzayo ngokomsebenzi walowo ungaphantsi kwawo, okanye uwukhulule ukuba sele usikiwe; umaleko osikiweyo ubonakala kuphela apho isiseko sawo sineepikseli.
command.layer.cut_to_new.title = Umaleko Ngokusebenzisa Ukusika
command.layer.cut_to_new.description = Hambisa iipikseli ezikhethiweyo uzikhuphe kumaleko osebenzayo uzise kumaleko omtsha ongentla kwawo.
command.layer.cut_to_new.layer_name = Umaleko Ngokusebenzisa Ukusika
command.layer.add_mask.title = Yongeza Isigqubuthelo Somaleko
command.layer.add_mask.description = Yongeza isigqubuthelo kumaleko osebenzayo, esibonisa kuphela ukhetho xa lukhona.
command.layer.flatten.title = Tyaba Umfanekiso
command.layer.flatten.description = Dibanisa yonke into ebonakalayo kumaleko omnye weMvelaphi ongabonakalisi ngaphaya, ulahle imaleko efihliweyo.
command.layer.merge_down.title = Dibanisa Nongaphantsi
command.layer.merge_down.description = Dibanisa umaleko osebenzayo kumaleko ongaphantsi kwawo.
command.layer.merge_down.msg.no_layer_below = Akukho maleko ungaphantsi wokudibanisa kuwo
command.layer.merge_visible.title = Dibanisa Okubonakalayo
command.layer.merge_visible.description = Dibanisa yonke imaleko ebonakalayo ibe mnye, ushiye efihliweyo injalo.
command.msg.nothing_to_copy = Khetha umaleko weepikseli oza kukhuphela kuwo
command.msg.clipboard_empty = Akukho nto kwibhodi eqhotyoshwayo
