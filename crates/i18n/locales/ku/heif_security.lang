# HEIC security update.
codec.heif.msg.unsafe_version = Ji ber lawaziyên ewlehiyê yên naskirî, bikaranîna libheif {version} tê redkirin; guhertoya {minimum} an nûtir pêwîst e. Piştgiriya HEIC ya rojanekirî daxe an pirtûkxaneya pergalê rojane bike.
codec.heif.msg.unknown_version = Ji ber ku guhertoya wê nikare were piştrastkirin, bikaranîna libheif tê redkirin; guhertoya {minimum} an nûtir pêwîst e. Piştgiriya HEIC ya rojanekirî daxe an pirtûkxaneya pergalê rojane bike.
dialog.open.heic_needs_safe_decoder = Ji bo vekirina “{name}”, libheif {minimum} an guhertoyeke nûtir bi kodvekerê HEVC pêwîst e. Guhertoyên kevn an yên ku nikarin bên piştrastkirin tên astengkirin da ku li hember lawaziyên ewlehiyê yên naskirî parastin hebe. Ji bo berdewamkirinê, piştgiriya HEIC ya rojanekirî daxe.
workspace.docs.heic_safe_decoder_needed = Piştgiriya HEIC ya rojanekirî pêwîst e
