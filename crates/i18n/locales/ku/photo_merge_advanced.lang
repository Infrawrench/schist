# Translated photo merge options.
photo_merge_advanced.projective = Rêzkirina perspektîfê (zivirandinê tê de)
photo_merge_advanced.cylindrical = Panorama cylindrical
photo_merge_advanced.deghost = Wêneyên dubare yên tiştên di hereketê de rakin (wêneya yekem wekî bingeh)
photo_merge_advanced.focal = Dirêjahiya navendê (px) / firehiya wêneyê (px)
