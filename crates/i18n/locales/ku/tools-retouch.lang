# Jêbera Sêhrîn
tool.magic_eraser.name = Jêbera Sêhrîn
tool.magic_eraser.description = Bitikîne da ku herêma rengê wê di bin nîşankerê de di nav toleransa amûrê de ye jê bibî — ya bi cihê tikandinê ve girêdayî, an jî li her derê layerê.
