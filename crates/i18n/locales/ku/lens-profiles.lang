# Lens profiles.
lens_profiles.invalid = Bi daneya kamera an lensê ya piştgirîkirî re databasek Lensfun v1/v2 XML ya derbasdar (heta 8 MiB) hilbijêrin.
lens_profiles.calibration = Kalibrasyona lensê
lens_profiles.no_calibration = Tu kalibrasyon van mîhengan nagire. Dirêjahiya fokal û faktora hilanîna kamerayê kontrol bikin; rastkirina manual berdest dimîne.
lens_profiles.import = Lensfun XML têxe…
lens_profiles.imported = Databasa Lensfun ji bo vê danişînê hate import kirin. Profîlek hilbijêrin an jî metadata wêneyê li hev bikin.
lens_profiles.manual = Tenê rastkirina manual
lens_profiles.saved = Kalibrasyona tomarkirî (base dane ne berdest e)
lens_profiles.profile = Profîla lensê
lens_profiles.aperture = Aperture (0 = nenas)
lens_profiles.distance = Dûrahiya balê (0 = nenas)
lens_profiles.vignette = Vignetting calibrated
lens_profiles.color_context = Vigneting kalibrated profîla sRGB ya çêkirî hewce dike. Veguhezînin sRGB da ku xuyangê biparêzin, dûv re Sererastkirina Lensê ji nû ve vekin. Ji bo pîxelên ku jixwe-sRGB ne-tagkirî ne, danîna sRGB bes e. Geometrî û rastkirina kromatîkî berdest in.
lens_profiles.vignette_missing = Tu kalibrasyonek vignetting dûrahiya aperture û fokusê vedigire. Nirxên pîvandî binivîsin da ku wê çalak bikin; 1000 m di gelek profîlên Lensfun de baldariya dûr nîşan dide.
lens_profiles.note = Serrastkirina kalibrated berî kontrolên destan dimeşe. Çarçoveya tevahî ya orîjînal bikar bînin; paşê bibirin. Parzûnek parzûnê di PSD/PSB de hilînin da ku kalibrasyona guhêrbar biparêzin.
lens_profiles.automatic = Metadata wêneyan li hev bikin
lens_profiles.components = Derbasbûna profîlê: distortion {distortion}; perçikên rengîn {tca}; vignetting {vignette}.
