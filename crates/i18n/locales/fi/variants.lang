# Virtual copies.
variants.create = Luo virtuaalinen kopio…
variants.rename = Nimeä virtuaalinen kopio uudelleen…
variants.delete = Poista virtuaalinen kopio
variants.close = Sulje tämä valokuva ja sen virtuaaliset kopiot ennen niiden siirtämistä tai poistamista.
variants.saved_hint = Kopiointi alkaa tallennetusta muokkauksesta tai alkuperäisestä, kun muokkausta ei ole. Tallenna odottavat muutokset ensin.
variants.move_original = Siirrä alkuperäinen valokuva siirtääksesi sen virtuaaliset kopiot.
variants.protected_export = Valitse toinen kohde. Gallerian vienti ei voi korvata alkuperäistä tai sen muokkaustilaa.
