# Tekoälysivupalkin työtilapuoli (crates/app/src/workspace/ai.rs) ja sen
# taustalla olevat agenttikehykset (crates/app/src/ai/): tilarivit,
# keskustelun huomautukset ja käyttäjälle näytettävät virheet. Mallille
# lähetettävät järjestelmäkehotteet, MCP-työkaluluettelo ja JSON-RPC-vastaukset
# pysyvät englanniksi eivätkä ole tässä tiedostossa. ”Claude Code”, ”Codex” ja
# mallien nimet ovat tuotenimiä ja säilyvät ennallaan; alla oleva `{backend}`
# on yksi niistä.

# Tilarivi
ai.status.panel_shown = Tekoälypaneeli näkyvissä
ai.status.panel_hidden = Tekoälypaneeli kätketty — Näytä ▸ Tekoälypaneeli ({shortcut}) tuo sen takaisin
ai.status.tool = Tekoäly: {name}

# Himmeät rivit keskustelussa
ai.info.connected = {backend} yhdistetty
ai.info.now_in_gallery = Nyt galleriassa.
ai.info.now_in_editor = Nyt editorissa.
ai.tool.shell_command = komentotulkkikomento

