# Lens profiles.
lens_profiles.invalid = Valitse kelvollinen Lensfun v1/v2 XML -tietokanta (jopa 8 MiB), jossa on tuetut kamera- tai objektiivitiedot.
lens_profiles.calibration = Linssin kalibrointi
lens_profiles.no_calibration = Mikään kalibrointi ei kata näitä asetuksia. Tarkista polttoväli ja kameran rajauskerroin; manuaalinen korjaus on edelleen käytettävissä.
lens_profiles.import = Tuo Lensfun XML…
lens_profiles.imported = Lensfun-tietokanta tuotu tätä istuntoa varten. Valitse profiili tai täsmää kuvan metatiedot.
lens_profiles.manual = Vain manuaalinen korjaus
lens_profiles.saved = Tallennettu kalibrointi (tietokanta ei ole käytettävissä)
lens_profiles.profile = Linssin profiili
lens_profiles.aperture = Aukko (0 = tuntematon)
lens_profiles.distance = Tarkennusetäisyys (0 = tuntematon)
lens_profiles.vignette = Kalibroitu vinjetointi
lens_profiles.color_context = Kalibroitu vinjetointi vaatii sisäänrakennetun sRGB-profiilin. Muunna muotoon sRGB säilyttääksesi ulkonäön, ja avaa sitten uudelleen Linssikorjaus. Jo-sRGB merkitsemättömille pikseleille riittää sRGB:n määrittäminen. Geometria ja kromaattinen korjaus ovat edelleen käytettävissä.
lens_profiles.vignette_missing = Mikään vinjetointikalibrointi ei kata aukkoa ja tarkennusetäisyyttä. Syötä mitatut arvot ottaaksesi sen käyttöön; 1000 m edustaa etätarkennusta monissa Lensfun-profiileissa.
lens_profiles.note = Kalibroitu korjaus suoritetaan ennen manuaalisia ohjaimia. Käytä koko alkuperäistä kuvaa; rajaa vasta sen jälkeen. Tallenna suodatinpino PSD/PSB:hen muokattavan kalibroinnin säilyttämiseksi.
lens_profiles.automatic = Yhdistä valokuvan metatiedot
lens_profiles.components = Profiilipassi: vääristymä {distortion}; väri hapsut {tca}; vinjetointi {vignette}.
