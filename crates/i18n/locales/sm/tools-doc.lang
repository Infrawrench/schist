tool.artboard.name = Laupapa Ata
tool.artboard.description = Toso e fai ai se laupapa ata: o se vaega ua faaigoaina o le tapoleni e auina ese na o ia. O le toso i totonu o se laupapa ua iai e faaseʻe ai.
