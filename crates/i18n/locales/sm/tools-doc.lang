tool.slice.name = Vaega Tipi
tool.slice.description = Toso e fai ai se vaega tipi mo le auina ese, o se tafafā ua faaigoaina o le tapoleni e auina ese o sona lava ata. O le toso i totonu o se vaega ua iai e faaseʻe ai.
tool.slice.default_name = Vaega Tipi {n}
tool.frame.name = Faavaa
tool.frame.description = Toso e fai ai se faavaa: o se vaega faatafafā (po o se liʻo) e pupuni ai mea uma e tuu i totonu.
