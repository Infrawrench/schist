tool.frame.choice.ellipse = Liʻo Faaloaloa
tool.frame.history.frame = Faavaa
tool.note.name = Faamatalaga
tool.note.description = Kiliki se mea avanoa o le tapoleni e faamau ai se faamatalaga, faatasi ma le igoa o le tusitala ma le lanu mai le tulaga o le faatonu; kiliki se pine ua iai e filifili ai mo le vaega o Faamatalaga.
