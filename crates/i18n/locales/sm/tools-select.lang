tool.marquee.rect.name = Filifiliga Tafafā
tool.marquee.rect.description = Toso se filifiliga tafafā. O le Shift i le amataga o le toso e faaopoopo i le filifiliga, e toese e le alt, ae e fetaulaʻi pe a oomi uma; o le Shift a o toso e fai ai se sikuea. O le kiliki e aunoa ma se toso e aveese ai le filifiliga.
tool.marquee.ellipse.name = Filifiliga Liʻo Faaloaloa
tool.marquee.ellipse.description = Toso se filifiliga liʻo faaloaloa, ma faaaogā le tuufaatasiga Shift/alt lava e tasi e pei o le filifiliga tafafā.
tool.lasso.name = Maea Filifili
tool.lasso.description = Toso se tuaoi e tusi saʻoloto; e tapuni le filifiliga i le va o pito pe a uma le toso. E faaopoopo e Shift, ae toese e alt.
tool.lasso.history.select = Filifiliga i le Maea
tool.lasso.polygonal.name = Maea Filifili Tulimanu
tool.lasso.polygonal.description = Kiliki tulimanu taʻi tasi e fai ai se filifiliga e saʻo ona pito, ona kiliki lea e latalata i le mataʻitusi muamua e tapuni ai.
tool.lasso.polygonal.history.select = Filifiliga i le Maea Tulimanu
tool.lasso.magnetic.name = Maea Filifili Maneta
tool.lasso.magnetic.description = Mulimuli faalatalata i se pito, ona pipii lea o le tuaoi i le eseesega sili ona malosi e latalata i le ala.
tool.lasso.magnetic.history.select = Filifiliga i le Maea Maneta
tool.lasso.magnetic.option.frequency = Faafia
tool.wand.name = Tootoo Faamaneta
tool.wand.description = Kiliki e filifili le vaega fesootaʻi e tutusa lona lanu i lalo o le faasino, i totonu o le filifiliga faapalepale — o le faapalepale lava lea e faitau e Faalautele, Tutusa ma Vaega o Lanu.
tool.wand.option.contiguous = Fesootaʻi
tool.wand.history.select = Tootoo Faamaneta
tool.quick_select.name = Filifiliga Vave
tool.quick_select.description = Vali i luga o se vaega, ona faalautele lea o le filifiliga i pika tutusa e ui ai le pulumu.
tool.quick_select.history.select = Filifiliga Vave
tool.object_select.name = Filifiliga o Mea
tool.object_select.description = Toso se pusa faataamilo i se mea, ona pipii lea o le filifiliga i le mea ua maua i totonu.
