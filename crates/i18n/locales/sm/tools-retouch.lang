tool.red_eye.name = Mata Mūmū
tool.red_eye.description = Kiliki le tamaʻi mata e aveese ai le mūmū o le emo o le meapueata.
tool.red_eye.option.pupil_size = Telē o le Tamaʻi Mata
tool.red_eye.option.darken = Faapouliuli
tool.red_eye.history.red_eye = Mata Mūmū
tool.magic_eraser.name = Solo Faamaneta
tool.magic_eraser.description = Kiliki e tape ai le vaega e tutusa lona lanu i lalo o le faasino, i totonu o le faapalepale a le meafaigaluega—pe na o le vaega e sosoo ma le mea na kiliki, po o vaega uma o le lanu i le vaega.
