tool.vanishing_point.name = Mataʻitusi Mou
tool.vanishing_point.description = Toso se laugatasi i luga o se mea e iai le vaaiga mamao, ona sui lea o le faiga i le Kopi ma vali: e mulimuli pika ua kopiina i le laugatasi ma faaitiitia a o mamao atu.
