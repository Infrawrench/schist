tool.liquify.name = Faasuavai
tool.liquify.description = Tulei, mimilo, faapipiʻi pe faafefete pika i lalo o se pulumu telē—e filifili e le filifiliga faiga le gaoioiga. E faaputu le faapiʻo i se upega ma faaaogā i le vaega pe a faamaonia.
