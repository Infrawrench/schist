tool.puppet_warp.name = Faapiʻo Papeti
tool.puppet_warp.description = Kiliki e faamau le vaega i ni nai mea, ona toso lea o se tasi: e piʻo le upega faataamilo i pine, pe malō pe vaivai e tusa ma le filifiliga Maʻaʻa. O le faamaonia e faaaogā ai le suiga.
