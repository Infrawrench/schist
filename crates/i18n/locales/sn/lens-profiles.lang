lens_profiles.invalid = Sarudza dhatabhesi reLensfun v1/v2 XML rinoshanda (kusvika 8 MiB) rine ruzivo rwekamera kana lenzi runotsigirwa.
lens_profiles.calibration = Kuyera lenzi
lens_profiles.no_calibration = Hapana kuyerwa kunoenderana nezvirongwa izvi. Tarisa kureba kwefokasi nechinhu chekukura kwekuchekwa kwekamera; kugadzirisa nemaoko kuchiri kuwanikwa.
lens_profiles.import = Pinza Lensfun XML…
lens_profiles.imported = Dhatabhesi reLensfun rapinzwa pachikamu chino. Sarudza chimiro chelenzi kana chifananidze neruzivo rwemufoto.
lens_profiles.manual = Kugadzirisa nemaoko chete
lens_profiles.saved = Kuyerwa kwakachengetwa (dhatabhesi harisi kuwanikwa)
lens_profiles.profile = Chimiro chelenzi
lens_profiles.aperture = Kuvhurika kwe lenzi (0 = hazvizivikanwi)
lens_profiles.distance = Chinhambwe chekutarisa (0 = hazvizivikanwi)
lens_profiles.vignette = Kusviba kwemakona kwakayerwa
lens_profiles.color_context = Kusviba kwemakona kwakayerwa kunoda chimiro chemavara che sRGB chakavakirwa mukati. Shandura mufananidzo uende ku sRGB kuti urambe uchitaridzika zvakafanana, wobva wavhurazve Kugadzirisa Lenzi. Kana mapikisi atova mu sRGB asi asina chiratidzo chechimiro chemavara, kupa sRGB chete kwakakwana. Kugadzirisa maumbirwo nemiganhu yemavara kuchiri kuwanikwa.
lens_profiles.vignette_missing = Hapana kuyerwa kwekusviba kwemakona kunoenderana nekuvhurika kwe lenzi nechinhambwe chekutarisa izvi. Isa zviyero zvakayerwa kuti zvikwanisike; muzvimiro zvakawanda zveLensfun, 1000 m zvinoreva kutarisa kure.
lens_profiles.note = Kugadzirisa kwakayerwa kunoitwa zvisati zvaitwa zvigadziriso zvemaoko. Shandisa furemu yose yepakutanga; cheka mushure mezvo. Chengeta murwi wemafirita mu PSD/PSB kuti kuyerwa kurambe kuchigadzirisika.
lens_profiles.automatic = Fananidza neruzivo rwemufoto
lens_profiles.components = Kugadzirisa nechimiro: kukanganisika {distortion}; mipendero yemavara {tca}; kusviba kwemakona {vignette}.
