photo_merge_advanced.projective = Kuenzanisa maonero (kusanganisira kutenderedza)
photo_merge_advanced.cylindrical = Panorama yakaita humburumbira
photo_merge_advanced.deghost = Bvisa mimvuri yezvinhu zvinofamba (foto yokutanga ndiyo inotaridzirwa)
photo_merge_advanced.focal = Kureba kwefokasi (px) / kufara kwemufananidzo (px)
photo_merge_advanced.masks = Mhedzisiro yekubatanidza zvakatariswa inoshandisa masiki ezvikamu anogona kugadziriswa. Sarudza masiki muZvikamu wopenda kuti unatsiridze.
photo_merge_advanced.no_match = Hapana kuenzanisa kwakavimbika kwawanikwa. Shandisa mafoto ane mamiriro anooneka, anopindirana zvakakwana uye ane shanduko diki pamaonero.
photo_merge_advanced.invalid = Mifananidzo yekutanga kana zvirongwa zvekubatanidza hazvishandi.
