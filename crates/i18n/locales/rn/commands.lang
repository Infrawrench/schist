# Edit
command.edit.undo.title = Gusubiza inyuma
command.edit.undo.description = Subira inyuma intambwe imwe muri kahise ko gusubiza inyuma kw'inyandiko.
command.edit.redo.title = Gusubira gukora
command.edit.redo.description = Subira ukore ihinduka ryaheruka gusubizwa inyuma.
command.edit.copy.title = Gukopa
command.edit.copy.description = Kopa amapikisele yatoranijwe yo ku rwego rukora uyashire mu bubiko bw'imfatakibanza (urwego rwose iyo ata vyatoranijwe).
command.edit.copy_merged.title = Gukopa ivyahujwe
command.edit.copy_merged.description = Kopa ivyatoranijwe nk'uko inzego zose ziboneka zibihuriza hamwe, aho kubikopa ku rwego rukora gusa.
command.edit.cut.title = Gukata
command.edit.cut.description = Kopa amapikisele yatoranijwe uyashire mu bubiko bw'imfatakibanza maze uyahanagure ku rwego rukora.
command.edit.paste.title = Komeka
command.edit.paste.description = Meka ibiri mu bubiko bw'imfatakibanza ku rwego rushasha hejuru y'urukora, hagati ku kibaho.
command.edit.paste.layer_name = Urwego rwomekwako
command.edit.paste_in_place.title = Komeka mu kibanza
command.edit.paste_in_place.description = Meka ibiri mu bubiko bw'imfatakibanza ku rwego rushasha ku bipimo vy'aho vyakopiwe.
command.edit.fill_foreground.title = Kwuzuza ibara ry'imbere
command.edit.fill_foreground.description = Uzuza ivyatoranijwe (canke ikibaho cose iyo ata vyatoranijwe) ibara ry'imbere.
command.edit.fill_background.title = Kwuzuza ibara ry'inyuma
command.edit.fill_background.description = Uzuza ivyatoranijwe (canke ikibaho cose iyo ata vyatoranijwe) ibara ry'inyuma.

# Select
command.select.all.title = Guhitamwo vyose
command.select.all.description = Hitamwo ikibaho cose.
command.select.deselect.title = Gukuraho itoranya
command.select.deselect.description = Kura itoranya kugira amahinduka yongere akore ku rwego rwose.
command.select.inverse.title = Guhindukiza itoranya
command.select.inverse.description = Kabisha uturere twatoranijwe n'ututaratoranijwe.
command.select.reselect.title = Gusubira gutoranya
command.select.reselect.description = Garukana itoranya riheruka gukurwaho.
command.select.reselect.msg.nothing_to_reselect = Nta co gusubira gutoranya
command.select.feather.title = Kworosha inkombe z'itoranya
command.select.feather.description = Orosha urubibe rw'itoranya ukoresheje igipfungu ca pikisele zibiri, kugira ihinduka rikurikira rigende rigabanuka kuri rwo.
command.select.grow.title = Kwagura
command.select.grow.description = Agura itoranya mu mapikisele arikora kandi asa n'ayatoranijwe, mu rugero rwemewe rw'Inkoni y'amageza.
command.select.similar.title = Ibisa
command.select.similar.description = Hitamwo pikisele yose yo ku rwego isa n'ivyatoranijwe, yaba ibikora canke itabikora, mu rugero rwemewe rw'Inkoni y'amageza.
command.select.save.title = Kubika itoranya
command.select.save.description = Bika itoranya ry'ubu mu nyandiko nk'umuyoboro alpha ufise izina.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Gushiramwo itoranya
command.select.load.description = Garukana itoranya riheruka kubikwa.

# Layer
command.layer.new.title = Urwego rushasha
command.layer.new.description = Ongerako urwego rwa raster rugaragara hejuru y'urukora maze urukoreshe.
command.layer.duplicate.title = Gukopa urwego
command.layer.duplicate.description = Kopa urwego rukora n'ibirimwo vyose ku rwego rushasha hejuru yarwo.
command.layer.smart_object.title = Guhindura ikintu c'ubwenge
command.layer.smart_object.description = Shira amapikisele y'urwego rwa raster rukora mu kintu c'ubwenge, kugira amahinduka n'utuyunguruzo vyo hanyuma bisubire gupima inkomoko itarakorwako.
command.layer.rasterize.title = Guhindura urwego raster
command.layer.rasterize.description = Hindura urwego rw'ishusho, igisomwa canke ikintu c'ubwenge rube amapikisele asanzwe.
command.layer.delete.title = Gufuta urwego
command.layer.delete.description = Futa inzego zatoranijwe.
command.layer.group.title = Gushira inzego mu mugwi
command.layer.group.description = Shira inzego zatoranijwe mu mugwi mushasha aho ziri.
command.layer.raise.title = Kuzana imbere
command.layer.raise.description = Duga urwego rukora ikibanza kimwe mu rutonde rw'umugwi warwo.
command.layer.lower.title = Gusubiza inyuma
command.layer.lower.description = Manura urwego rukora ikibanza kimwe mu rutonde rw'umugwi warwo.
command.layer.to_front.title = Kuzana imbere cane
command.layer.to_front.description = Jana urwego rukora hejuru y'umugwi warwo.
command.layer.to_back.title = Gusubiza inyuma cane
command.layer.to_back.description = Jana urwego rukora hasi y'umugwi warwo.
command.layer.clipping_mask.title = Gukora/Gukuraho masike ikata
command.layer.clipping_mask.description = Kata urwego rukora ukoresheje ururi munsi yarwo, canke ururekure nimba rusanzwe rukaswe; urwego rukaswe ruboneka gusa aho urwego shingiro rufise amapikisele.
command.layer.cut_to_new.title = Urwego ruvuye mu gukata
command.layer.cut_to_new.description = Kura amapikisele yatoranijwe ku rwego rukora uyashire ku rwego rushasha hejuru yarwo.
command.layer.cut_to_new.layer_name = Urwego ruvuye mu gukata
command.layer.add_mask.title = Kwongerako masike y'urwego
command.layer.add_mask.description = Ongerako masike ku rwego rukora, yerekana gusa ivyatoranijwe iyo bihari.
command.layer.flatten.title = Guhuza ishusho yose
command.layer.flatten.description = Huriza hamwe ibiboneka vyose mu rwego rumwe rw'Inyuma rutabonerana, uhebe inzego zihishijwe.
command.layer.merge_down.title = Guhuza n'ivyo hasi
command.layer.merge_down.description = Huriza urwego rukora mu rwego ruri munsi yarwo.
command.layer.merge_down.msg.no_layer_below = Nta rwego rwo munsi rwo guhurizamwo
command.layer.merge_visible.title = Guhuza ibiboneka
command.layer.merge_visible.description = Huriza inzego zose ziboneka muri rumwe, usige izihishijwe uko ziri.

