# Rediģēšana
command.edit.undo.title = Atsaukt
command.edit.undo.description = Atgriezties par vienu ierakstu dokumenta atsaukšanas vēsturē.
command.edit.redo.title = Atkārtot
command.edit.redo.description = Atkārtot pēdējo atsaukto labojumu.
command.edit.copy.title = Kopēt
command.edit.copy.description = Kopēt aktīvā slāņa atlasītos pikseļus iekšējā starpliktuvē (visu slāni, ja nekas nav atlasīts).
