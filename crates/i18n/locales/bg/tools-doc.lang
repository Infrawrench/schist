# Инструменти за монтажни полета, отрязъци, рамки, бележки и броячи.
tool.artboard.name = Монтажно поле
tool.artboard.description = Очертайте с плъзгане монтажно поле: наименувана област от платното, която се експортира самостоятелно. Плъзгането в съществуващо поле го премества.
tool.artboard.default_name = Монтажно поле {n}

tool.slice.name = Отрязък
tool.slice.description = Очертайте с плъзгане отрязък за експортиране — наименуван правоъгълник от платното, който се експортира като отделно изображение. Плъзгането в съществуващ отрязък го премества.
tool.slice.default_name = Отрязък {n}

tool.frame.name = Рамка
tool.frame.description = Очертайте с плъзгане рамка: правоъгълен (или елипсовиден) слой, който маскира всичко поставено в него.
tool.frame.default_name = Рамка {n}
tool.frame.choice.rectangle = Правоъгълник
tool.frame.choice.ellipse = Елипса
tool.frame.history.frame = Рамка

tool.note.name = Бележка
tool.note.description = Щракнете върху празно място от платното, за да закачите там бележка, означена с автора и цвета от състоянието на редактора; щракнете върху съществуваща отметка, за да я изберете в панела „Бележки“.
tool.note.history.place = Поставяне на бележка
tool.note.history.move = Преместване на бележка
tool.note.history.delete = Изтриване на бележка

tool.count.name = Брояч
tool.count.description = Щракнете, за да поставите номерирани маркери за броене върху платното, а върху съществуващ маркер — за да го премахнете.
tool.count.default_name = Брояч {n}
