# Utensiles de pictura.
tool.brush.name = Pincel
tool.brush.description = Picte un tracie con suavi bordes in li color de avan-plan, dimensionat per li grandore, duritá e opacitá del pincel del editor.
tool.brush.history.stroke = Pincel
tool.pencil.name = Crayon
tool.pencil.description = Picte un tracie con dur bordes, sin antialiasing, in li color de avan-plan.
tool.pencil.history.stroke = Crayon
tool.eraser.name = Gomme
tool.eraser.description = Effacia along li tracie e retorna li strate a transparentie.
tool.eraser.history.stroke = Gomme
tool.clone.name = Clon-tampon
tool.clone.description = Clon-tampon: clicca con Alt por definir li punctu fonte, poy picte pixeles copiat de it al sam deplazzament.
tool.clone.history.stroke = Clon-tampon
tool.dodge.name = Superexponer
tool.dodge.description = Aclara li pixeles trans quel passa li tracie.
tool.dodge.history.stroke = Superexponer
tool.burn.name = Subexponer
tool.burn.description = Obscura li pixeles trans quel passa li tracie.
tool.burn.history.stroke = Subexponer
tool.sponge.name = Spongie
tool.sponge.description = Satura, o desatura, li pixeles trans quel passa li tracie.
tool.sponge.history.stroke = Spongie
tool.blur.name = Desfocalisar
tool.blur.description = Reducte li acutitá del pixeles trans quel passa li tracie.
tool.blur.history.stroke = Desfocalisar
tool.sharpen.name = Acutisar
tool.sharpen.description = Augmenta li acutitá del pixeles trans quel passa li tracie.
tool.sharpen.history.stroke = Acutisar
tool.smudge.name = Smussar
tool.smudge.description = Trena color along li tracie, quam si on press vell pictura.
tool.smudge.history.stroke = Smussar
tool.heal.name = Reparant pincel
tool.heal.description = Reparant pincel: clicca con Alt por definir li fonte, poy picte; li textura del fonte es mixtet con li propri color e illumination del destination.
tool.heal.history.stroke = Reparant pincel
tool.spot_heal.name = Punctal reparant pincel
tool.spot_heal.description = Punctal reparant pincel: picte sur un defecte e it es substituet per textura prendet ex su circumité — sin punctu fonte a definir.
tool.spot_heal.history.stroke = Punctal reparant pincel
tool.history_brush.name = Pincel de historie
tool.history_brush.description = Repicte pixeles ex li instantanee del historie del document, desfante plu tard labore tracie pos tracie.
tool.history_brush.history.stroke = Pincel de historie
tool.background_eraser.name = Gomme de fund
tool.background_eraser.description = Effacia li color prendet sub li centre del pincel e lassa diferent pixeles intact, por separar un subjecte de su fund.
tool.background_eraser.history.stroke = Gomme de fund
tool.gradient.name = Gradiente
tool.gradient.description = Trena por plenar li strate — tra li selection si un existe — per un lineari gradiente del color de avan-plan al color de fund along li trenada.
tool.gradient.radial.name = Radial gradiente
tool.gradient.radial.description = Trena ex li centre adextra por plenar per un radial gradiente inter li colores de avan-plan e fund.
tool.gradient.option.gradient = Gradiente
tool.gradient.option.reverse = Inverter
tool.gradient.option.dither = Tramage
tool.gradient.choice.foreground_to_background = Avan-plan a fund
tool.gradient.choice.foreground_to_transparent = Avan-plan a transparent
tool.gradient.choice.linear = Lineari
tool.gradient.choice.radial = Radial
tool.gradient.choice.angle = Angulari
tool.gradient.choice.reflected = Reflectet
tool.gradient.choice.diamond = Diamant
tool.gradient.history.gradient = Gradiente
tool.bucket.name = Situl de pictura
tool.bucket.description = Clicca por plenar li conex area de simil color sub li apuntator per li color de avan-plan, intra li tolerantie del utensile.
tool.bucket.option.contiguous = Contigui
tool.bucket.option.all_layers = Omni strates
tool.bucket.history.fill = Situl de pictura

tool.brush.symmetry = Simetrie
tool.brush.seamless_preview = Prevision del motive sin junturas
