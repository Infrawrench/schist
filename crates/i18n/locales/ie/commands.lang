# Comandes de redaction, selection e strates.
command.edit.undo.title = Defar
command.edit.undo.description = Retornar un passu in li historie de desfabil actiones del document.
command.edit.redo.title = Refar
command.edit.redo.description = Refar li ultim redaction quel esset defat.
command.edit.copy.title = Copiar
command.edit.copy.description = Copiar li selectet pixeles del activ strate al intern area de transferte (li tot strate si nequó es selectet).
command.edit.copy_merged.title = Copiar mixet
command.edit.copy_merged.description = Copiar li selection quam omni visibil strates composi it, vice solmen ex li activ strate.
command.edit.cut.title = Exciser
command.edit.cut.description = Copiar li selectet pixeles al area de transferte e effaciar les ex li activ strate.
command.edit.paste.title = Collar
command.edit.paste.description = Collar li area de transferte in un nov strate supra li activ un, centrat sur li canevas.
command.edit.paste.layer_name = Collat strate
command.edit.paste_in_place.title = Collar in situ
command.edit.paste_in_place.description = Collar li area de transferte in un nov strate al coordinatas ex quel it esset copiat.
command.edit.fill_foreground.title = Plenar per avan-plan
command.edit.fill_foreground.description = Plenar li selection (o li tot canevas si nequó es selectet) per li color de avan-plan.
command.edit.fill_background.title = Plenar per fund
command.edit.fill_background.description = Plenar li selection (o li tot canevas si nequó es selectet) per li color de fund.
command.select.all.title = Selecter omnicos
command.select.all.description = Selecter li tot canevas.
command.select.deselect.title = Deselecter
command.select.deselect.description = Abandonar li selection, por que redactiones denov aplica al tot strate.
command.select.inverse.title = Inverter selection
command.select.inverse.description = Permutar selectet e ínselectet areas.
command.select.reselect.title = Reselecter
command.select.reselect.description = Restituer li selection abandonat maxim recentmen.
command.select.reselect.msg.nothing_to_reselect = Nequó a reselecter
command.select.feather.title = Sfumar selection
command.select.feather.description = Suavificar li borde del selection per un desfocalisation de du pixeles, por que li proxim redaction gradualmen desapari tra it.
command.select.grow.title = Crescer
command.select.grow.description = Extender li selection in contigui pixeles simil a to ja selectet, intra li tolerantie del magic verge.
command.select.similar.title = Simil
command.select.similar.description = Selecter omni pixel in li strate simil al selection, contigui o ne, intra li tolerantie del magic verge.
command.select.save.title = Gardar selection
command.select.save.description = Magasinar li actual selection in li document quam un nominat canal alpha.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Chargar selection
command.select.load.description = Restituer li maxim recentmen gardat selection.
command.layer.new.title = Nov strate
command.layer.new.description = Adjunter un vacui raster-strate supra li activ un e activar it.
command.layer.duplicate.title = Duplicar strate
command.layer.duplicate.description = Copiar li activ strate con omni su contenete in un nov strate supra it.
command.layer.smart_object.title = Converter a inteligent object
command.layer.smart_object.description = Invelopar li pixeles del activ raster-strate in un inteligent object, por que plu tard transformationes e filtres re-sampla li intact fonte.
command.layer.rasterize.title = Rasterisar strate
command.layer.rasterize.description = Permanentmen converter un strate de forme, textu o inteligent object a simplic pixeles.
command.layer.delete.title = Deleter strate
command.layer.delete.description = Deleter li selectet strates.
command.layer.group.title = Gruppar strates
command.layer.group.description = Invelopar li selectet strates in un nov gruppe, in lor actual loc.
command.layer.raise.title = Portar adavan
command.layer.raise.description = Mover li activ strate un loc ad-supra in li staple de su gruppe.
command.layer.lower.title = Misser retro
command.layer.lower.description = Mover li activ strate un loc ad-infra in li staple de su gruppe.
command.layer.to_front.title = Portar al fronte
command.layer.to_front.description = Mover li activ strate al cim de su gruppe.
command.layer.to_back.title = Misser al fund
command.layer.to_back.description = Mover li activ strate al fund de su gruppe.
command.layer.clipping_mask.title = Crear/Liberar decupa-masca
command.layer.clipping_mask.description = Limitar li activ strate al un sub it, o liberar it si it ja es limitat; un decupat strate monstra se solmen u su base have pixeles.
command.layer.cut_to_new.title = Strate per excision
command.layer.cut_to_new.description = Mover li selectet pixeles ex li activ strate a un nov strate supra it.
command.layer.cut_to_new.layer_name = Strate per excision
command.layer.add_mask.title = Adjunter masca de strate
command.layer.add_mask.description = Adjunter un masca al activ strate, revelante solmen li selection si un existe.
command.layer.flatten.title = Aplanar image
command.layer.flatten.description = Composir omnicos visibil in un opac strate Fund e eliminar celat strates.
command.layer.merge_down.title = Mixer ad-infra
command.layer.merge_down.description = Composir li activ strate in li strate sub it.
command.layer.merge_down.msg.no_layer_below = Null strate sub it por mixer
command.layer.merge_visible.title = Mixer visibiles
command.layer.merge_visible.description = Composir omni visibil strates in un e lassar celat strates intact.
command.msg.nothing_to_copy = Selecte un strate de pixeles ex quel copiar
command.msg.clipboard_empty = Nequó in li area de transferte
