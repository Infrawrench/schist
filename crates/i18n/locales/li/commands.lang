command.select.save.description = Slaon de hujige selectie in 't document op es alfakanaal mit 'ne naam.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Selectie laje
command.select.load.description = Herstel de meis recènt opgeslage selectie.

