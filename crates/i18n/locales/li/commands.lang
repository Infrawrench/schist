command.edit.copy.description = Kopieer de geselecteerde pixels van de actieve laog nao 't interne klembord (de ganse laog es niks geselecteerd is).
command.edit.copy_merged.title = Samegevoeg kopiëre
command.edit.copy_merged.description = Kopieer de selectie zoe-es alle zichbare laoge die same weergaeve, in plaats van allein oet de actieve laog.
command.edit.cut.title = Knippe
command.edit.cut.description = Kopieer de geselecteerde pixels nao 't klembord en gum ze oet de actieve laog.
