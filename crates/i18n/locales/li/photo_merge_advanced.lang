# Translated photo merge options.
photo_merge_advanced.projective = Perspectief-aoflijning (inclusief rotatie)
photo_merge_advanced.cylindrical = Cilindrisch panorama
photo_merge_advanced.deghost = Verwieder dobbelbeelde van bewegende oonderwerpe (ierste foto es referentie)
photo_merge_advanced.focal = Brandpuntlengte (px) / beeldbreidte (px)
photo_merge_advanced.masks = Focus-oetvoer gebruuk bewerkbare laogmaskers. Kies un masker in Lage en sjilder um te verfijne.
photo_merge_advanced.no_match = Gein betrokke aanpassing gevoonde. Gebruuk getextureerde foto’s mit substantieel euverlapping en besjeie veranderinge in gezichspunt.
photo_merge_advanced.invalid = Ongeldige bronbeelde of samevogingsinstellinge.
