# Основные команды редактирования, выделения и слоёв.
command.edit.undo.title = Отменить
command.edit.undo.description = Вернуться на одно действие назад в истории документа.
command.edit.redo.title = Повторить
command.edit.redo.description = Повторить последнее отменённое действие.
command.edit.copy.title = Копировать
command.edit.copy.description = Скопировать выделенные пиксели активного слоя во внутренний буфер обмена; если выделения нет, копируется весь слой.
command.edit.copy_merged.title = Скопировать совмещённые данные
command.edit.copy_merged.description = Скопировать выделенную область в том виде, в котором её образуют все видимые слои, а не только активный слой.
command.edit.cut.title = Вырезать
command.edit.cut.description = Скопировать выделенные пиксели в буфер обмена и удалить их из активного слоя.
command.edit.paste.title = Вставить
command.edit.paste.description = Вставить содержимое буфера обмена в новый слой над активным и расположить его по центру холста.
command.edit.paste.layer_name = Вставленный слой
command.edit.paste_in_place.title = Вставить вместо
command.edit.paste_in_place.description = Вставить содержимое буфера обмена в новый слой с исходными координатами копирования.
command.edit.fill_foreground.title = Выполнить заливку основным цветом
command.edit.fill_foreground.description = Залить выделенную область основным цветом; если выделения нет, залить весь холст.
command.edit.fill_background.title = Выполнить заливку фоновым цветом
command.edit.fill_background.description = Залить выделенную область фоновым цветом; если выделения нет, залить весь холст.
command.select.all.title = Выделить всё
command.select.all.description = Выделить весь холст.
command.select.deselect.title = Отменить выделение
command.select.deselect.description = Снять выделение, чтобы дальнейшие изменения снова применялись ко всему слою.
command.select.inverse.title = Инверсия выделенной области
command.select.inverse.description = Поменять местами выделенные и невыделенные области.
command.select.reselect.title = Выделить снова
command.select.reselect.description = Восстановить последнее снятое выделение.
command.select.reselect.msg.nothing_to_reselect = Нет выделенной области для восстановления
command.select.feather.title = Растушёвка выделенной области
command.select.feather.description = Смягчить край выделения размытием в два пикселя, чтобы следующее изменение плавно ослабевало у края.
command.select.grow.title = Расширить
command.select.grow.description = Расширить выделение на смежные пиксели, похожие на уже выделенные, в пределах допуска волшебной палочки.
command.select.similar.title = Подобные оттенки
command.select.similar.description = Выделить все похожие на текущую область пиксели слоя, смежные или несмежные, в пределах допуска волшебной палочки.
command.select.save.title = Сохранить выделенную область
command.select.save.description = Сохранить текущее выделение в документе как именованный альфа-канал.
command.select.save.channel_name = Альфа {n}
command.select.load.title = Загрузить выделенную область
command.select.load.description = Восстановить последнее сохранённое выделение.
command.layer.new.title = Новый слой
command.layer.new.description = Добавить пустой растровый слой над активным и сделать его активным.
command.layer.duplicate.title = Создать дубликат слоя
command.layer.duplicate.description = Создать над активным слоем его полную копию со всем содержимым.
command.layer.smart_object.title = Преобразовать в смарт-объект
command.layer.smart_object.description = Поместить пиксели активного растрового слоя в смарт-объект, чтобы последующие трансформирования и фильтры использовали неизменённый оригинал.
command.layer.rasterize.title = Растрировать слой
command.layer.rasterize.description = Преобразовать фигуру, текст или смарт-объект в обычные пиксели.
command.layer.delete.title = Удалить слой
command.layer.delete.description = Удалить выбранные слои.
command.layer.group.title = Сгруппировать слои
command.layer.group.description = Поместить выбранные слои в новую группу, сохранив их положение.
command.layer.raise.title = Переложить вперёд
command.layer.raise.description = Переместить активный слой на одну позицию вверх в группе.
command.layer.lower.title = Переложить назад
command.layer.lower.description = Переместить активный слой на одну позицию вниз в группе.
command.layer.to_front.title = На передний план
command.layer.to_front.description = Переместить активный слой на самый верх группы.
command.layer.to_back.title = На задний план
command.layer.to_back.description = Переместить активный слой в самый низ группы.
command.layer.clipping_mask.title = Создать/освободить обтравочную маску
command.layer.clipping_mask.description = Обрезать активный слой по нижележащему или освободить его, если маска уже действует; обтравочный слой виден только там, где базовый слой содержит пиксели.
command.layer.cut_to_new.title = Вырезать на новый слой
command.layer.cut_to_new.description = Удалить выделенные пиксели из активного слоя и поместить их на новый слой выше.
command.layer.cut_to_new.layer_name = Слой через вырезание
command.layer.add_mask.title = Добавить слой-маску
command.layer.add_mask.description = Добавить маску к активному слою; при наличии выделения маска оставит видимой только выделенную область.
command.layer.flatten.title = Выполнить сведение
command.layer.flatten.description = Объединить всё видимое содержимое в один непрозрачный фоновый слой и удалить скрытые слои.
command.layer.merge_down.title = Объединить с предыдущим
command.layer.merge_down.description = Объединить активный слой с расположенным под ним.
command.layer.merge_down.msg.no_layer_below = Ниже нет слоя для объединения
command.layer.merge_visible.title = Объединить видимые
command.layer.merge_visible.description = Объединить все видимые слои в один, не изменяя скрытые слои.
command.msg.nothing_to_copy = Выберите пиксельный слой, из которого нужно копировать
command.msg.clipboard_empty = Буфер обмена пуст
command.history.grow = Расширение
command.history.similar = Подобные оттенки
command.history.clear = Очистка
command.history.merge_down = Объединение с предыдущим
command.history.flatten_image = Сведение изображения
command.history.merge_visible = Объединение видимых слоёв
command.history.paste = Вставка
command.history.fill = Заливка
command.history.select_all = Выделение всего
command.history.deselect = Отмена выделения
command.history.select_inverse = Инверсия выделенной области
command.history.new_layer = Новый слой
command.history.duplicate_layer = Создание дубликата слоя
command.history.convert_to_smart_object = Преобразование в смарт-объект
command.history.rasterize_layer = Растрирование слоя
command.history.delete_layer = Удаление слоя
command.history.delete_layers = Удаление слоёв
command.history.group_layer = Группировка слоя
command.history.group_layers = Группировка слоёв
command.history.reselect = Повторное выделение
command.history.feather = Растушёвка
command.history.load_selection = Загрузка выделенной области
command.history.bring_forward = Перемещение вперёд
command.history.send_backward = Перемещение назад
command.history.bring_to_front = На передний план
command.history.send_to_back = На задний план
command.history.clipping_mask = Обтравочная маска
command.history.layer_via_cut = Слой через вырезание
command.history.add_layer_mask = Добавление слой-маски
