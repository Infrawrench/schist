# Инструменты для монтажных областей, фрагментов, рамок, заметок и счётчиков.

# Монтажная область
tool.artboard.name = Монтажная область
tool.artboard.description = Перетащите указатель, чтобы создать монтажную область — именованную часть холста, которую можно экспортировать отдельно. Перетаскивание внутри существующей области перемещает её.
tool.artboard.default_name = Монтажная область {n}

# Фрагмент
tool.slice.name = Фрагмент
tool.slice.description = Перетащите указатель, чтобы создать фрагмент для экспорта — именованную прямоугольную часть холста, экспортируемую как отдельное изображение. Перетаскивание внутри существующего фрагмента перемещает его.
tool.slice.default_name = Фрагмент {n}

# Рамка
tool.frame.name = Рамка
tool.frame.description = Перетащите указатель, чтобы создать рамку — прямоугольный или эллиптический слой, маскирующий всё помещённое в него содержимое.
tool.frame.default_name = Рамка {n}
tool.frame.choice.rectangle = Прямоугольник
tool.frame.choice.ellipse = Эллипс
tool.frame.history.frame = Рамка

# Заметка
tool.note.name = Заметка
tool.note.description = Щёлкните пустое место холста, чтобы закрепить там заметку с автором и цветом из состояния редактора. Щёлкните существующую метку, чтобы выбрать её на панели «Заметки».
tool.note.history.place = Добавление заметки
tool.note.history.move = Перемещение заметки
tool.note.history.delete = Удаление заметки

# Счётчик
tool.count.name = Счётчик
tool.count.description = Щёлкните, чтобы поставить на холсте нумерованную метку счётчика; щелчок по существующей метке удаляет её.
tool.count.default_name = Счётчик {n}
