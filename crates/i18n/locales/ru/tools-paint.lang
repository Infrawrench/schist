# Инструменты рисования.
tool.brush.name = Кисть
tool.brush.description = Рисует штрих основным цветом с мягкими краями, используя заданные в редакторе размер, жёсткость и непрозрачность кисти.
tool.brush.history.stroke = Кисть
tool.pencil.name = Карандаш
tool.pencil.description = Рисует штрих основным цветом с жёсткими краями без сглаживания.
tool.pencil.history.stroke = Карандаш
tool.eraser.name = Ластик
tool.eraser.description = Стирает пиксели вдоль штриха, возвращая прозрачность слоя.
tool.eraser.history.stroke = Ластик
tool.clone.name = Штамп
tool.clone.description = Штамп: щёлкните с Alt, чтобы задать источник, затем рисуйте скопированными из него пикселями с тем же смещением.
tool.clone.history.stroke = Штамп
tool.dodge.name = Осветлитель
tool.dodge.description = Осветляет пиксели, по которым проходит штрих.
tool.dodge.history.stroke = Осветлитель
tool.burn.name = Затемнитель
tool.burn.description = Затемняет пиксели, по которым проходит штрих.
tool.burn.history.stroke = Затемнитель
tool.sponge.name = Губка
tool.sponge.description = Повышает или понижает насыщенность пикселей, по которым проходит штрих.
tool.sponge.history.stroke = Губка
tool.blur.name = Размытие
tool.blur.description = Размывает пиксели, по которым проходит штрих.
tool.blur.history.stroke = Размытие
tool.sharpen.name = Резкость
tool.sharpen.description = Повышает резкость пикселей, по которым проходит штрих.
tool.sharpen.history.stroke = Резкость
tool.smudge.name = Палец
tool.smudge.description = Растягивает цвет вдоль штриха, словно мокрую краску.
tool.smudge.history.stroke = Палец
tool.heal.name = Восстанавливающая кисть
tool.heal.description = Восстанавливающая кисть: щёлкните с Alt, чтобы задать источник, затем рисуйте; текстура источника смешивается с цветом и освещением области назначения.
tool.heal.history.stroke = Восстанавливающая кисть
tool.spot_heal.name = Точечная восстанавливающая кисть
tool.spot_heal.description = Проведите по дефекту, и он будет заменён текстурой из окружающей области без предварительного выбора источника.
tool.spot_heal.history.stroke = Точечная восстанавливающая кисть
tool.history_brush.name = Архивная кисть
tool.history_brush.description = Восстанавливает пиксели из снимка истории документа, отменяя последующие изменения штрих за штрихом.
tool.history_brush.history.stroke = Архивная кисть
tool.background_eraser.name = Фоновый ластик
tool.background_eraser.description = Стирает цвет, взятый в центре кисти, и сохраняет отличающиеся пиксели, позволяя отделить объект от фона.
tool.background_eraser.history.stroke = Фоновый ластик
tool.gradient.name = Градиент
tool.gradient.description = Перетащите указатель, чтобы залить слой линейным градиентом от основного цвета к фоновому вдоль направления перетаскивания; если есть выделение, заливка применяется внутри него.
tool.gradient.radial.name = Радиальный градиент
tool.gradient.radial.description = Перетащите указатель от центра наружу, чтобы выполнить заливку радиальным градиентом между основным и фоновым цветами.
tool.gradient.option.gradient = Градиент
tool.gradient.option.reverse = Инверсия
tool.gradient.option.dither = Дизеринг
tool.gradient.choice.foreground_to_background = От основного к фоновому
tool.gradient.choice.foreground_to_transparent = От основного к прозрачному
tool.gradient.choice.linear = Линейный
tool.gradient.choice.radial = Радиальный
tool.gradient.choice.angle = Угловой
tool.gradient.choice.reflected = Зеркальный
tool.gradient.choice.diamond = Ромбовидный
tool.gradient.history.gradient = Градиент
tool.bucket.name = Заливка
tool.bucket.description = Щёлкните, чтобы залить основным цветом связанную область похожего цвета под указателем в пределах допуска инструмента.
tool.bucket.option.contiguous = Смежные пиксели
tool.bucket.option.all_layers = Все слои
tool.bucket.history.fill = Заливка

tool.brush.symmetry = Симметрия
tool.brush.seamless_preview = Просмотр бесшовного узора
