command.edit.undo.title = واگرد
command.edit.undo.description = در تاریخچهٔ واگرد سند یک گام به عقب بروید.
command.edit.redo.title = ازنو
command.edit.redo.description = آخرین ویرایش واگردشده را دوباره انجام دهید.
command.edit.copy.title = کپی
command.edit.copy.description = پیکسل‌های انتخاب‌شدهٔ لایهٔ فعال را در بریده‌دان داخلی کپی کنید (اگر چیزی انتخاب نشده باشد، کل لایه).
command.edit.copy_merged.title = کپی ادغام‌شده
command.edit.copy_merged.description = ناحیهٔ انتخاب را به‌شکلی که همهٔ لایه‌های نمایان با هم ترکیب می‌کنند کپی کنید، نه فقط از لایهٔ فعال.
command.edit.cut.title = برش
command.edit.cut.description = پیکسل‌های انتخاب‌شده را در بریده‌دان کپی و از لایهٔ فعال پاک کنید.
command.edit.paste.title = جای‌گذاری
command.edit.paste.description = محتوای بریده‌دان را در لایه‌ای جدید بالای لایهٔ فعال و در مرکز بوم جای‌گذاری کنید.
command.edit.paste.layer_name = لایهٔ جای‌گذاری‌شده
command.edit.paste_in_place.title = جای‌گذاری در محل
command.edit.paste_in_place.description = محتوای بریده‌دان را در لایه‌ای جدید و در مختصاتی که از آن کپی شده جای‌گذاری کنید.
command.edit.fill_foreground.title = پُرکردن با پیش‌زمینه
command.edit.fill_foreground.description = ناحیهٔ انتخاب (یا اگر چیزی انتخاب نشده، کل بوم) را با رنگ پیش‌زمینه پر کنید.
command.edit.fill_background.title = پُرکردن با پس‌زمینه
command.edit.fill_background.description = ناحیهٔ انتخاب (یا اگر چیزی انتخاب نشده، کل بوم) را با رنگ پس‌زمینه پر کنید.
command.select.all.title = انتخاب همه
command.select.all.description = کل بوم را انتخاب کنید.
command.select.deselect.title = لغو انتخاب
command.select.deselect.description = ناحیهٔ انتخاب را کنار بگذارید تا ویرایش‌ها دوباره روی کل لایه اعمال شوند.
command.select.inverse.title = وارونه‌کردن انتخاب
command.select.inverse.description = ناحیه‌های انتخاب‌شده و انتخاب‌نشده را با هم عوض کنید.
command.select.reselect.title = انتخاب دوباره
command.select.reselect.description = آخرین ناحیهٔ انتخاب کنارگذاشته‌شده را بازگردانید.
command.select.reselect.msg.nothing_to_reselect = چیزی برای انتخاب دوباره وجود ندارد
command.select.feather.title = محوکردن لبهٔ انتخاب
command.select.feather.description = لبهٔ انتخاب را با محوشدگی دوپیکسلی نرم کنید تا ویرایش بعدی به‌تدریج در آن محو شود.
command.select.grow.title = گسترش
command.select.grow.description = انتخاب را در پیکسل‌های متصل و مشابه آنچه اکنون انتخاب شده، در محدودهٔ تلورانس عصای جادویی، گسترش دهید.
command.select.similar.title = مشابه
command.select.similar.description = همهٔ پیکسل‌های لایه را که در محدودهٔ تلورانس عصای جادویی شبیه انتخاب‌اند، چه متصل باشند چه نه، انتخاب کنید.
command.select.save.title = ذخیرهٔ ناحیهٔ انتخاب
command.select.save.description = ناحیهٔ انتخاب کنونی را به‌صورت کانال آلفای نام‌دار در سند نگه دارید.
command.select.save.channel_name = آلفا {n}
command.select.load.title = بارگذاری ناحیهٔ انتخاب
command.select.load.description = آخرین ناحیهٔ انتخاب ذخیره‌شده را بازگردانید.
command.layer.new.title = لایهٔ جدید
command.layer.new.description = لایهٔ رستری خالی بالای لایهٔ فعال بیفزایید و آن را فعال کنید.
command.layer.duplicate.title = تکثیر لایه
command.layer.duplicate.description = لایهٔ فعال را با تمام محتوایش در لایه‌ای جدید بالای آن کپی کنید.
command.layer.smart_object.title = تبدیل به شیء هوشمند
command.layer.smart_object.description = پیکسل‌های لایهٔ رستری فعال را در شیء هوشمند قرار دهید تا تبدیل‌ها و فیلترهای بعدی از مبدأ دست‌نخورده نمونه‌برداری کنند.
command.layer.rasterize.title = رستری‌کردن لایه
command.layer.rasterize.description = لایهٔ شکل، متن یا شیء هوشمند را به پیکسل‌های ساده تبدیل کنید.
command.layer.delete.title = حذف لایه
command.layer.delete.description = لایه‌های انتخاب‌شده را حذف کنید.
command.layer.group.title = گروه‌بندی لایه‌ها
command.layer.group.description = لایه‌های انتخاب‌شده را در همان محل در گروهی جدید قرار دهید.
command.layer.raise.title = آوردن به جلو
command.layer.raise.description = لایهٔ فعال را در پشتهٔ گروهش یک جایگاه بالا ببرید.
command.layer.lower.title = فرستادن به عقب
command.layer.lower.description = لایهٔ فعال را در پشتهٔ گروهش یک جایگاه پایین ببرید.
command.layer.to_front.title = آوردن به روی همه
command.layer.to_front.description = لایهٔ فعال را به بالای گروهش ببرید.
command.layer.to_back.title = فرستادن به پشت همه
command.layer.to_back.description = لایهٔ فعال را به پایین گروهش ببرید.
command.layer.clipping_mask.title = ایجاد/آزادکردن ماسک برشی
command.layer.clipping_mask.description = لایهٔ فعال را به لایهٔ زیر آن برش دهید یا اگر از پیش برش خورده آزادش کنید؛ لایهٔ برش‌خورده فقط جایی دیده می‌شود که لایهٔ پایه پیکسل دارد.
command.layer.cut_to_new.title = لایه از راه برش
command.layer.cut_to_new.description = پیکسل‌های انتخاب‌شده را از لایهٔ فعال بیرون ببرید و در لایه‌ای جدید بالای آن قرار دهید.
command.layer.cut_to_new.layer_name = لایه از راه برش
command.layer.add_mask.title = افزودن ماسک لایه
command.layer.add_mask.description = ماسک لایه‌ای به لایهٔ فعال بیفزایید که در صورت وجود انتخاب، فقط همان را نمایان کند.
command.layer.flatten.title = تخت‌کردن تصویر
command.layer.flatten.description = هرچه نمایان است در یک لایهٔ پس‌زمینهٔ مات ترکیب کنید و لایه‌های پنهان را دور بریزید.
command.layer.merge_down.title = ادغام با پایینی
command.layer.merge_down.description = لایهٔ فعال را با لایهٔ زیر آن ترکیب کنید.
command.layer.merge_down.msg.no_layer_below = لایه‌ای در پایین برای ادغام وجود ندارد
command.layer.merge_visible.title = ادغام لایه‌های نمایان
command.layer.merge_visible.description = همهٔ لایه‌های نمایان را در یک لایه ترکیب کنید و لایه‌های پنهان را دست‌نخورده بگذارید.
command.msg.nothing_to_copy = لایه‌ای پیکسلی برای کپی انتخاب کنید
command.msg.clipboard_empty = بریده‌دان خالی است
