tool.shape.custom.choice.star = Estrela
tool.shape.custom.choice.arrow = Flecha
tool.shape.custom.choice.lightning = Relampau
tool.shape.custom.choice.cross = Cruz
tool.shape.custom.choice.speech_bubble = Bafolla de dialogo
