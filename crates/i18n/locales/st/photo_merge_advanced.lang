photo_merge_advanced.projective = Ho nyalanya ka pono (ho kenyeletsa ho potoloha)
photo_merge_advanced.cylindrical = Panorama ea selindara
photo_merge_advanced.deghost = Tlosa meriti ea lintho tse sisinyehang (setšoantšo sa pele e le motheo)
photo_merge_advanced.focal = Bolelele ba tsepamiso (px) / bophara ba setšoantšo (px)
photo_merge_advanced.masks = Sephetho sa ho tsepamisa se sebelisa limaske tsa likarolo tse ka hlophisoang. Khetha maske ho Likarolo, ebe u penta ho lokisa.
photo_merge_advanced.no_match = Ha ho nyalanyo e tšepahalang e fumanoeng. Sebelisa linepe tse nang le lintlha tse hlakileng, tse kopanang haholo, le liphetoho tse nyenyane tsa pono.
photo_merge_advanced.invalid = Litšoantšo tsa mohloli kapa litlhophiso tsa ho kopanya ha lia nepahala.
