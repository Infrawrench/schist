lens_profiles.invalid = Khetha polokelo e nepahetseng ea Lensfun v1/v2 XML (ho fihlela 8 MiB) e nang le lintlha tsa khamera kapa lense tse tšehetsoeng.
lens_profiles.calibration = Tekanyo ea lense
lens_profiles.no_calibration = Ha ho tekanyo e lumellanang le litlhophiso tsena. Hlahloba bolelele ba ho tsepamisa le sekhahla sa ho seha sa khamera; tokiso ea letsoho e ntse e le teng.
lens_profiles.import = Kenya Lensfun XML…
lens_profiles.imported = Polokelo ea Lensfun e kentsoe bakeng sa nako ena ea tšebeliso. Khetha profil ea lense kapa u e bapise le lintlha tsa setšoantšo.
lens_profiles.manual = Tokiso ea letsoho feela
lens_profiles.saved = Tekanyo e bolokiloeng (polokelo ha e fumanehe)
lens_profiles.profile = Profil ea lense
lens_profiles.aperture = Lesoba la lense (0 = ha le tsejoe)
lens_profiles.distance = Sebaka sa ho tsepamisa (0 = ha se tsejoe)
lens_profiles.vignette = Ho fifala ha mathōko ho lekantsoeng
lens_profiles.color_context = Ho lokisa ho fifala ha mathōko ka tekanyo ho hloka profil ea sRGB e ahiloeng kahare. Fetolela setšoantšo ho sRGB ho boloka chebahalo, ebe u bula Tokiso ea Lense hape. Bakeng sa lipikselse tse seng li le sRGB empa li se na letšoao, ho li abela profil ea sRGB ho lekane. Tokiso ea sebopeho le ea mathōko a mebala e ntse e fumaneha.
lens_profiles.vignette_missing = Ha ho tekanyo ea ho fifala ha mathōko e lumellanang le lesoba la lense le sebaka sa ho tsepamisa. Kenya litekanyo tse lekantsoeng ho e nolofalletsa; 1000 m e bolela ho tsepamisa hōle liprofileng tse ngata tsa Lensfun.
lens_profiles.note = Tokiso e lekantsoeng e sebetsa pele ho litaolo tsa letsoho. Sebelisa foreimi eohle ea pele; seha setšoantšo ka mor’a moo. Boloka pokello ea lifilthara ho PSD/PSB ho boloka tekanyo e ka hlophisoang.
lens_profiles.automatic = Bapisa lintlha tsa setšoantšo
lens_profiles.components = Mohato oa profil: ho sotha {distortion}; mathōko a mebala {tca}; ho fifala ha mathōko {vignette}.
