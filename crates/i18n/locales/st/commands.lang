# Litaelo tsa Ho Hlophisa, Khetha le Mokhahlelo.
command.edit.undo.title = Etsolla
command.edit.undo.description = Khutlela morao ka ketso e le 'ngoe nalaneng ea liketso tse ka etsolloang tsa tokomane.
command.edit.redo.title = Etsa Hape
command.edit.redo.description = Etsa hape phetoho e qetetseng ho etsolloa.
command.edit.copy.title = Kopitsa
command.edit.copy.description = Kopitsa lipiksele tse khethiloeng tsa mokhahlelo o sebetsang ho clipboard ea ka hare (mokhahlelo oohle haeba ho se letho le khethiloeng).
command.edit.copy_merged.title = Kopitsa Tse Kopantsoeng
command.edit.copy_merged.description = Kopitsa khetho kamoo mekhahlelo eohle e bonahalang e e kopanyang kateng, eseng ho tsoa mokhahlelong o sebetsang feela.
command.edit.cut.title = Seha
command.edit.cut.description = Kopitsa lipiksele tse khethiloeng ho clipboard 'me u li hlakole mokhahlelong o sebetsang.
command.edit.paste.title = Manamisa
command.edit.paste.description = Manamisa se ho clipboard mokhahlelong o mocha ka holimo ho o sebetsang, bohareng ba seile.
command.edit.paste.layer_name = Mokhahlelo o Manamisitsoeng
command.edit.paste_in_place.title = Manamisa Sebakeng sa Pele
command.edit.paste_in_place.description = Manamisa se ho clipboard mokhahlelong o mocha sebakeng sona sa X le Y seo se kopilitsoeng ho sona.
command.edit.fill_foreground.title = Tlatsa ka 'Mala oa Bokapele
command.edit.fill_foreground.description = Tlatsa khetho (kapa seile eohle haeba ho se letho le khethiloeng) ka 'mala oa bokapele.
command.edit.fill_background.title = Tlatsa ka 'Mala oa Bokamorao
command.edit.fill_background.description = Tlatsa khetho (kapa seile eohle haeba ho se letho le khethiloeng) ka 'mala oa bokamorao.

command.select.all.title = Khetha Tsohle
command.select.all.description = Khetha seile eohle.
command.select.deselect.title = Tlosa Khetho
command.select.deselect.description = Tlosa khetho e le hore liphetoho li boele li sebetse mokhahlelong oohle.
command.select.inverse.title = Fapanyetsana Khetho
command.select.inverse.description = Fapanyetsana libaka tse khethiloeng le tse sa khethoang.
command.select.reselect.title = Khetha Hape
command.select.reselect.description = Khutlisa khetho e qetetseng ho tlosoa.
command.select.reselect.msg.nothing_to_reselect = Ha ho khetho e ka khutlisoang
command.select.feather.title = Nolofatsa Moeli oa Khetho
command.select.feather.description = Nolofatsa moeli oa khetho ka ho fokotsa ho hlaka ka lipiksele tse peli, e le hore phetoho e latelang e nyamele butle ho parola moeli.
command.select.grow.title = Holisa
command.select.grow.description = Atolosa khetho ho kena lipikseleng tse e amang tse tšoanang le tse seng li khethiloe, ho latela mamello ea Thupa ea Boselamose.
command.select.similar.title = Tse Tšoanang
command.select.similar.description = Khetha piksele e 'ngoe le e 'ngoe mokhahlelong e tšoanang le khetho, ebang ea e ama kapa che, ho latela mamello ea Thupa ea Boselamose.
command.select.save.title = Boloka Khetho
command.select.save.description = Boloka khetho ea hona joale tokomaneng e le kanale ea alpha e reheletsoeng.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Laela Khetho
command.select.load.description = Khutlisa khetho e bolokiloeng haufinyane ka ho fetisisa.

command.layer.new.title = Mokhahlelo o Mocha
command.layer.new.description = Kenya mokhahlelo oa raster o se nang letho ka holimo ho o sebetsang 'me u etse o mocha hore o sebetse.
command.layer.duplicate.title = Etsa Kopi ea Mokhahlelo
command.layer.duplicate.description = Kopitsa mokhahlelo o sebetsang le litaba tsohle tsa oona mokhahlelong o mocha ka holimo ho oona.
command.layer.smart_object.title = Fetolela ho Smart Object
command.layer.smart_object.description = Phuthela lipiksele tsa mokhahlelo oa raster o sebetsang ka smart object, e le hore liphetoho tsa boholo le disefo tsa hamorao li bale sampole bocha ho tsoa mohloling o sa fetoloang.
command.layer.rasterize.title = Fetola Mokhahlelo ho ba Lipiksele
command.layer.rasterize.description = Fetolela mokhahlelo oa sebopeho, mongolo kapa smart object hore e be lipiksele tse tloaelehileng.
command.layer.delete.title = Hlakola Mokhahlelo
command.layer.delete.description = Hlakola mekhahlelo e khethiloeng.
command.layer.group.title = Hlophisa Mekhahlelo e le Sehlopha
command.layer.group.description = Kenya mekhahlelo e khethiloeng sehlopheng se secha hona sebakeng seo.
command.layer.raise.title = Tlisa Pele
command.layer.raise.description = Nyollela mokhahlelo o sebetsang sebaka se le seng mokgobong oa sehlopha sa oona.
command.layer.lower.title = Romela Morao
command.layer.lower.description = Theolela mokhahlelo o sebetsang sebaka se le seng mokgobong oa sehlopha sa oona.
command.layer.to_front.title = Tlisa ka Pele-pele
command.layer.to_front.description = Isa mokhahlelo o sebetsang holimo-limo sehlopheng sa oona.
command.layer.to_back.title = Romela ka Morao-rao
command.layer.to_back.description = Isa mokhahlelo o sebetsang tlase-tlase sehlopheng sa oona.
command.layer.clipping_mask.title = Etsa/Lokolla Maske ea ho Lekanyetsa
command.layer.clipping_mask.description = Lekanyetsa mokhahlelo o sebetsang ka mokhahlelo o ka tlase ho oona, kapa u o lokolle haeba o se o lekanyelitsoe; mokhahlelo o lekanyelitsoeng o bonahala feela moo mokhahlelo oa motheo o nang le lipiksele.
command.layer.cut_to_new.title = Mokhahlelo ka ho Seha
command.layer.cut_to_new.description = Ntša lipiksele tse khethiloeng mokhahlelong o sebetsang 'me u li ise mokhahlelong o mocha ka holimo ho oona.
command.layer.cut_to_new.layer_name = Mokhahlelo ka ho Seha
command.layer.add_mask.title = Kenya Maske ea Mokhahlelo
command.layer.add_mask.description = Kenya maske mokhahlelong o sebetsang, e bontšang khetho feela haeba e le teng.
command.layer.flatten.title = Batalatsa Setšoantšo
command.layer.flatten.description = Kopanya tsohle tse bonahalang mokhahlelong o le mong oa Bokamorao o sa bonaletseng, u lahle mekhahlelo e patiloeng.
command.layer.merge_down.title = Kopanya le o ka Tlase
command.layer.merge_down.description = Kopanya mokhahlelo o sebetsang le mokhahlelo o ka tlase ho oona.
command.layer.merge_down.msg.no_layer_below = Ha ho mokhahlelo o ka tlase oo ho ka kopanngoang le oona
command.layer.merge_visible.title = Kopanya Tse Bonahalang
command.layer.merge_visible.description = Kopanya mekhahlelo eohle e bonahalang hore e be o le mong, u siee e patiloeng e sa fetoloa.

