# Lisebelisoa tsa ho sotha: Liquify, Puppet Warp le Vanishing Point.

tool.liquify.name = Liquify
tool.liquify.description = Sututsa, bilikisa, sosobanya kapa kokomosa lipiksele tse tlas'a borashe bo boholo—khetho ea mokhoa e khetha ketso. Ho sotha ho bokellana letlooeng, ebe ho sebelisoa mokhahlelong ha ho tiisoa.
