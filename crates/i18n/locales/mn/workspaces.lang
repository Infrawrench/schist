workspaces.retouching = Зураг засварлах
workspaces.current = Одоогийн байрлал
workspaces.help = Өөрөөр хадгалах нь одоогийн байрлалын нэртэй хуулбарыг үүсгэнэ. Хадгалсан байрлалыг сонгоод хэрэглэх, шинэчлэх, нэрийг нь өөрчлөх эсвэл устгах боломжтой. Байрлалд хийсэн өөрчлөлт шууд үйлчилнэ.
workspaces.show_panels = Хажуугийн самбаруудыг харуулах
workspaces.automatic = Автомат
workspaces.reset_help = Дахин тохируулах нь зөвхөн самбаруудын анхдагч байрлалыг сэргээнэ. Хадгалсан ажлын орчин, баримт бичиг болон бусад тохиргоо хэвээр үлдэнэ.
workspaces.save_error = Ажлын орчны тохиргоог хадгалж чадсангүй. Өөрчлөлт хэрэгжээгүй.
workspaces.invalid_name = Удирдлагын тэмдэгт агуулаагүй 1–80 тэмдэгттэй нэр оруулна уу.
workspaces.duplicate = Ийм нэртэй ажлын орчин аль хэдийн байна.
workspaces.limit = Та 64 хүртэл ажлын орчин хадгалж болно.
workspaces.keyboard = Гар: Alt+↑/↓ байрлалыг сонгоно. Ctrl/Cmd+N нэрийг нь засна; +S хуулбарыг хадгална; +Enter хэрэглэнэ; +U шинэчилнэ; +R нэрийг нь өөрчилнө; +D устгана; +0 дахин тохируулна.
