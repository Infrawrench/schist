# Pebyll
tool.marquee.rect.name = Pabell Betryalog
tool.marquee.rect.description = Llusgwch i greu detholiad petryalog. Mae Shift ar ddechrau'r llusgiad yn ychwanegu at y detholiad, mae Alt yn tynnu ohono, ac mae'r ddau'n croestorri; mae Shift yn ystod y llusgiad yn ei wneud yn sgwâr. Mae clic heb lusgo'n dad-ddewis.
