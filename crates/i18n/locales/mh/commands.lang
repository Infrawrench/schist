command.edit.undo.title = Ukot jebāāk
command.edit.undo.description = Jebāāk juon wāween ilo bwebwenato in undo an document eo.
command.edit.redo.title = Bar kōṃṃane
command.edit.redo.description = Bar kōṃṃan ukot eo āliktata eṃōj undo.
command.edit.copy.title = Kōpi
command.edit.copy.description = Kōpi pixel ko eṃōj kālet ilo layer eo ej jerbal ñan clipboard iloan (layer eo aolep ñe ejelọk selection).
command.edit.copy_merged.title = Kōpi men ko eṃōj koba
command.edit.copy_merged.description = Kōpi selection eo āinwōt aolep layer ko rej walok rej kobaiki, jab jen layer eo ej jerbal wōt.
command.edit.cut.title = Kōṃōttan
command.edit.cut.description = Kōpi pixel ko eṃōj kālet ñan clipboard im joļọki jen layer eo ej jerbal.
command.edit.paste.title = Likūt kōpi
command.edit.paste.description = Likūt clipboard eo ilo juon layer ekāāl ioon eo ej jerbal, ilo center in canvas eo.
command.edit.paste.layer_name = Layer in kōpi
command.edit.paste_in_place.title = Likūt kōpi ilo jikin eo
command.edit.paste_in_place.description = Likūt clipboard eo ilo juon layer ekāāl ilo coordinate ko ear kōpi jāni.
command.edit.fill_foreground.title = Kūt kōn kōļar in iṃaan
command.edit.fill_foreground.description = Kūt selection eo (ak canvas eo aolep ñe ejelọk selection) kōn kōļar in iṃaan.
command.edit.fill_background.title = Kūt kōn kōļar in lik
command.edit.fill_background.description = Kūt selection eo (ak canvas eo aolep ñe ejelọk selection) kōn kōļar in lik.
command.select.all.title = Kālet aolep
command.select.all.description = Kālet canvas eo aolep.
command.select.deselect.title = Jolọk selection
command.select.deselect.description = Jolọk selection eo, bwe ukot ko ren bar jerbal ioon layer eo aolep.
command.select.inverse.title = Kālet men ko rejjab eṃōj kālet
command.select.inverse.description = Ukot jikin ko eṃōj kālet im ko rejjañin kālet.
command.select.reselect.title = Bar kālet
command.select.reselect.description = Bar bōktok selection eo eṃōj jolọk āliktata.
command.select.reselect.msg.nothing_to_reselect = Ejelọk men ñan bar kālet
command.select.feather.title = Kōṃṃan edge in selection bwe en dikdikļọk
command.select.feather.description = Feather edge in selection kōn blur in pixel ruo, bwe ukot eo tok juon en jakoļọk jidikdik ilo e.
command.select.grow.title = Kōļapļọk
command.select.grow.description = Kōļapļọk selection ñan pixel ko rej jibwe doon im rej āinwōt ko eṃōj kālet, ilo tolerance in Magic Wand.
command.select.similar.title = Men ko rej āinwōt
command.select.similar.description = Kālet aolep pixel ilo layer eo rej āinwōt selection eo, ñe rej jibwe doon ak jab, ilo tolerance in Magic Wand.
command.select.save.title = Kōjparok selection
command.select.save.description = Kōjparok selection eo kio ilo document eo āinwōt alpha channel eo ewōr etan.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Load selection
command.select.load.description = Bar kōṃṃan selection eo eṃōj kōjparok āliktata.
command.layer.new.title = Layer ekāāl
command.layer.new.description = Kobaik juon raster layer ejelọk kobban ioon layer eo ej jerbal im kōṃṃane bwe en jerbal.
command.layer.duplicate.title = Kōpi layer
command.layer.duplicate.description = Kōpi layer eo ej jerbal, kobban im men otemjej, ñan juon layer ekāāl ioon.
command.layer.smart_object.title = Ukot ñan Smart Object
command.layer.smart_object.description = Kallib pixel ko an raster layer eo ej jerbal ilo smart object, bwe transform im filter ko tok ālik ren resample source eo ejjañin ukot.
command.layer.rasterize.title = Rasterize layer
command.layer.rasterize.description = Ukot layer in shape, text ak smart-object ñan pixel ko wōt.
command.layer.delete.title = Jolọk layer
command.layer.delete.description = Jolọk layer ko eṃōj kālet.
command.layer.group.title = Koba layer ko ilo group
command.layer.group.description = Kallib layer ko eṃōj kālet ilo juon group ekāāl, ilo jikin eo wōt.
command.layer.raise.title = Bōktok ñan iṃaan
command.layer.raise.description = Kōṃakūt layer eo ej jerbal juon jikin ñan lōñ ilo kōlaajrak an group eo.
command.layer.lower.title = Jilkinļọk ñan lik
command.layer.lower.description = Kōṃakūt layer eo ej jerbal juon jikin ñan lal ilo kōlaajrak an group eo.
