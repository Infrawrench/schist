command.layer.to_back.title = Jilkin ñan lik tata
command.layer.to_back.description = Kōṃakūt layer eo ej jerbal ñan lal tata ilo group eo.
command.layer.clipping_mask.title = Kōṃṃan/Jolọk Clipping Mask
command.layer.clipping_mask.description = Clip layer eo ej jerbal ñan eo ium̧win, ak jolọke ñe eṃōj; layer eo eṃōj clip ej walok wōt ijo base eo an ewōr pixel.
command.layer.cut_to_new.title = Layer jen Kōṃōttan
command.layer.cut_to_new.description = Kōṃakūt pixel ko eṃōj kālet jen layer eo ej jerbal ñan juon layer ekāāl ioon.
command.layer.cut_to_new.layer_name = Layer jen Kōṃōttan
command.layer.add_mask.title = Kobaik Layer Mask
command.layer.add_mask.description = Kobaik juon layer mask ñan layer eo ej jerbal, im kwaļọk selection eo wōt ñe ewōr.
command.layer.flatten.title = Kōkoba pija
command.layer.flatten.description = Kōkoba men otemjej rej walok ilo juon Background layer eo ejjab transparent, im jolọk layer ko rejako.
command.layer.merge_down.title = Koba ñan lal
