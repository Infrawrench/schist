command.layer.merge_down.msg.no_layer_below = Ejelọk layer ium̧win ñan kobaiki
command.layer.merge_visible.title = Koba layer ko rej walok
command.layer.merge_visible.description = Kōkoba aolep layer ko rej walok ilo juon, im jab ukot layer ko rejako.
