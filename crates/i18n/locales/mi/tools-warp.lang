tool.vanishing_point.name = Ira Ngaro
tool.vanishing_point.description = Tōia he papa papatahi ki runga i tētahi mea whai tirohanga hōhonu, kātahi ka huri i te aratau ki Tārua, ka peita: ka whai ngā pika tārua i te papa, ka iti haere i te tawhiti.
