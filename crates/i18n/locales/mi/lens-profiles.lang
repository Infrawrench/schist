lens_profiles.invalid = Kōwhirihia he pātengi raraunga XML Lensfun v1/v2 whaimana (tae atu ki te 8 MiB) me nga raraunga kamera, arotahi ranei.
lens_profiles.calibration = Te whakatikatika o te arotahi
lens_profiles.no_calibration = Karekau he whakatikatika e kapi ana i enei tautuhinga. Tirohia te roa o te arotahi me te huanga hua o te kamera; kei te waatea tonu te whakatikatika a-ringa.
lens_profiles.import = Kawemai Lensfun XML…
lens_profiles.imported = I kawemai te papaunga raraunga Lensfun mo tenei wahanga. Tīpakohia he kōtaha, whakaōrite rānei i te raraunga meta whakaahua.
lens_profiles.manual = Whakatikatika ā-ringa anake
lens_profiles.saved = Kua tiakina (karekau he papaunga raraunga)
lens_profiles.profile = Kōtaha arotahi
lens_profiles.aperture = Tuwhera o te arotahi (0 = tē mōhiotia)
lens_profiles.distance = Tawhiti arotahi (0 = tē mōhiotia)
lens_profiles.vignette = Vignetting whakatika
lens_profiles.color_context = Ko te whakakitenga kua oti te whakarite me te kōtaha sRGB kua hangaia. Hurihia ki te sRGB hei pupuri i te ahua, katahi ka whakatuwhera i te Whakatika Arotahi. Mo nga pika kaore ano kia tohungia, ko te tautapa i te sRGB he rawaka. Kei te waatea tonu te Geometry me te whakatikatika chromatic.
lens_profiles.vignette_missing = Karekau he whakatikatika whakaata e kapi ana i te tuwhera me te tawhiti arotahi. Whakauruhia nga uara ine kia taea ai; Ko te 1000 m e tohu ana i te arotahi tawhiti ki te maha o nga korero a Lensfun.
lens_profiles.note = Ka mahia te whakatikatika kua whakaritea i mua i ngā mana ā-ringa. Whakamahia te anga katoa o te whakaahua taketake; katohia ā muri ake. Tiakina he tāpae tātari ki PSD/PSB kia mau ai te whakatikatika ka taea te whakarerekē.
lens_profiles.automatic = Whakatauritehia nga metadata whakaahua
lens_profiles.components = Tuhinga o mua: korikori {distortion}; taniko tae {tca}; whakakitenga {vignette}.
