# دستاویز سے متعلق ٹولز
tool.artboard.name = آرٹ بورڈ
tool.artboard.description = آرٹ بورڈ بنانے کے لیے گھسیٹیں: کینوس کا ایک نام زد خطہ جو الگ برآمد ہوتا ہے۔ موجودہ آرٹ بورڈ کے اندر گھسیٹنے سے وہ منتقل ہوتا ہے۔
