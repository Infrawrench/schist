tool.frame.choice.rectangle = مستطیل
tool.frame.choice.ellipse = بیضوی
tool.frame.history.frame = فریم

tool.note.name = نوٹ
tool.note.description = خالی کینوس پر کلک کرکے وہاں نوٹ ثبت کریں، جس پر تدوینی حالت میں مصنف اور رنگ کی مہر لگتی ہے؛ موجودہ پن پر کلک کرکے اسے نوٹس پینل کے لیے منتخب کریں۔
tool.note.history.place = نوٹ رکھیں
tool.note.history.move = نوٹ منتقل کریں
tool.note.history.delete = نوٹ حذف کریں

tool.count.name = شمار
tool.count.description = کینوس پر نمبر والے شمار کے نشانات رکھنے کے لیے کلک کریں، اور موجودہ نشان ہٹانے کے لیے اس پر کلک کریں۔
tool.count.default_name = شمار {n}
