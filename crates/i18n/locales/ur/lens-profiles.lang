lens_profiles.invalid = معاونت یافتہ کیمرے یا عدسے کا ڈیٹا رکھنے والا درست Lensfun v1/v2 XML ڈیٹابیس منتخب کریں (زیادہ سے زیادہ 8 MiB)۔
lens_profiles.calibration = عدسے کی کیلیبریشن
lens_profiles.no_calibration = ان ترتیبات کے لیے کیلیبریشن موجود نہیں۔ فوکل لمبائی اور کیمرے کا کراپ فیکٹر چیک کریں؛ دستی اصلاح اب بھی دستیاب ہے۔
lens_profiles.import = Lensfun XML درآمد کریں…
lens_profiles.imported = اس نشست کے لیے Lensfun ڈیٹابیس درآمد ہو گیا ہے۔ عدسے کا پروفائل منتخب کریں یا تصویر کے میٹا ڈیٹا سے مطابقت پیدا کریں۔
lens_profiles.manual = صرف دستی اصلاح
lens_profiles.saved = محفوظ شدہ کیلیبریشن (ڈیٹابیس دستیاب نہیں)
lens_profiles.profile = عدسے کا پروفائل
lens_profiles.aperture = اپرچر (0 = نامعلوم)
lens_profiles.distance = فوکس کا فاصلہ (0 = نامعلوم)
lens_profiles.vignette = کیلیبریٹ شدہ ونیٹنگ
lens_profiles.color_context = کیلیبریٹ شدہ ونیٹنگ کی اصلاح کے لیے اندرونی sRGB پروفائل ضروری ہے۔ ظاہری شکل برقرار رکھنے کے لیے تصویر کو sRGB میں تبدیل کریں، پھر ”عدسے کی اصلاح“ دوبارہ کھولیں۔ اگر پکسل پہلے ہی sRGB میں ہوں مگر پروفائل نشان زد نہ ہو تو sRGB پروفائل تفویض کرنا کافی ہے۔ جیومیٹری اور رنگوں کے کناروں کی اصلاح دستیاب رہے گی۔
lens_profiles.vignette_missing = اس اپرچر اور فوکس کے فاصلے کے لیے ونیٹنگ کی کیلیبریشن موجود نہیں۔ اسے فعال کرنے کے لیے ناپی ہوئی قدریں درج کریں؛ Lensfun کے کئی پروفائلوں میں 1000 m دور کی فوکس کو ظاہر کرتا ہے۔
lens_profiles.note = کیلیبریٹ شدہ اصلاح دستی کنٹرولز سے پہلے لاگو ہوتی ہے۔ اصل مکمل فریم استعمال کریں، پھر بعد میں اسے کاٹیں۔ قابل تدوین کیلیبریشن برقرار رکھنے کے لیے فلٹر اسٹیک PSD/PSB میں محفوظ کریں۔
lens_profiles.automatic = تصویر کے میٹا ڈیٹا سے مطابقت پیدا کریں
lens_profiles.components = پروفائل کی اصلاح: بگاڑ {distortion}؛ رنگین کنارے {tca}؛ ونیٹنگ {vignette}۔
