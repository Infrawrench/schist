tool.bucket.description = Incarca pro prènnere cun su colore de primu pianu s'àrea ligada de colore sìmile suta de su puntadore, intro de sa toleràntzia de s'aina.
tool.bucket.option.contiguous = Sighidu
tool.bucket.option.all_layers = Totu is istratos
