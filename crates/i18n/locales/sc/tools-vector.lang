# Pinnas
tool.pen.name = Pinna
tool.pen.description = Crea unu percursu: incarca pro unu puntu angulare, tràghe pro nche bogare is manìgias de sa curva, e incarca su primu puntu pro serrare. Cunfirmende, su percursu est cunvertidu in un'istratu de forma.
tool.pen.option.rubber_band = Elàsticu
tool.pen.history.fill = Prentura de su percursu
tool.pen.default_path_name = Percursu {n}
tool.pen.freeform.name = Pinna a manu lìbera
tool.pen.freeform.description = Tràghe una lìnia a manu lìbera e dda adatada a unu percursu, cun su livellu de aprossimatzione inditadu dae s'optzione Adatamentu.
tool.pen.freeform.option.fit = Adatamentu
tool.pen.curvature.name = Pinna de curvatura
tool.pen.curvature.description = Incarca una sèrie de puntos e su percursu est curvadu in manera lìscia tràmite issos.

# Frètzias
tool.path_select.name = Seletzione de percursu
tool.path_select.description = Incarca unu percursu pro ddu seletzionare, e tràghe pro tramudare su percursu intreu.
tool.direct_select.name = Seletzione direta
tool.direct_select.description = Tràghe unu puntu de ancoràgiu o is manìgias suas pro torrare a modellare su percursu in giru a issu.

