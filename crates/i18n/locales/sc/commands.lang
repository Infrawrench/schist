# Modìfica
command.edit.undo.title = Annulla
command.edit.undo.description = Torra in segus de una boghe in sa cronologia de annullamentu de su documentu.
command.edit.redo.title = Torra a fàghere
command.edit.redo.description = Torra a fàghere sa modìfica annullada prus de reghente.
command.edit.copy.title = Còpia
command.edit.copy.description = Còpia is pixel seletzionados de s'istratu ativu in is apuntes internos (s'istratu intreu cando no b'at una seletzione).
command.edit.copy_merged.title = Còpia s'unione
command.edit.copy_merged.description = Còpia sa seletzione comente dda cumponint totu is istratos visìbiles, imbetzes de dae s'istratu ativu ebbia.
command.edit.cut.title = Sèca
command.edit.cut.description = Còpia is pixel seletzionados in is apuntes e ddos cantzellat dae s'istratu ativu.
command.edit.paste.title = Incolla
command.edit.paste.description = Incolla is apuntes in un'istratu nou subra de cussu ativu, tzentrau in sa tela.
command.edit.paste.layer_name = Istratu incolladu
command.edit.paste_in_place.title = Incolla in su logu suo
command.edit.paste_in_place.description = Incolla is apuntes in un'istratu nou a is coordenadas dae ue fiant istados copiados.
command.edit.fill_foreground.title = Preni cun su primu pianu
command.edit.fill_foreground.description = Preni sa seletzione (o sa tela intrea cando no b'at una seletzione) cun su colore de primu pianu.
command.edit.fill_background.title = Preni cun su fundu
command.edit.fill_background.description = Preni sa seletzione (o sa tela intrea cando no b'at una seletzione) cun su colore de fundu.

# Seletziona
command.select.all.title = Seletziona totu
command.select.all.description = Seletziona sa tela intrea.
command.select.deselect.title = Deseletziona
command.select.deselect.description = Boga sa seletzione, gasi is modìficas torrant a èssere aplicadas a s'istratu intreu.
command.select.inverse.title = Inverte sa seletzione
command.select.inverse.description = Iscàmbia is àreas seletzionadas cun cussas non seletzionadas.
command.select.reselect.title = Torra a seletzionare
command.select.reselect.description = Recùpera s'ùrtima seletzione bogada.
command.select.reselect.msg.nothing_to_reselect = Nudda de torrare a seletzionare
command.select.feather.title = Isfuma sa seletzione
command.select.feather.description = Ammòddiat su màrgine de sa seletzione cun un'isfocadura de duos pixel, gasi sa modìfica imbeniente si isfumat a su longu suo.
command.select.grow.title = Ismànnia
command.select.grow.description = Istèrrere sa seletzione a is pixel cuntìguos chi s'assimìgiant a su chi est giai seletzionadu, intro de sa toleràntzia de sa bacheta màgica.
command.select.similar.title = Sìmile
command.select.similar.description = Seletziona cada pixel de s'istratu chi s'assimìgiat a sa seletzione, si ddu tocat o nono, intro de sa toleràntzia de sa bacheta màgica.
command.select.save.title = Sarva sa seletzione
command.select.save.description = Cunsèrvat sa seletzione atuale in su documentu comente canale alfa cun nòmine.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Càrriga sa seletzione
command.select.load.description = Riprìstina sa seletzione sarvada prus de reghente.

# Istratu
command.layer.new.title = Istratu nou
command.layer.new.description = Annanghet un'istratu raster bòidu subra de cussu ativu e ddu faghet ativu.
command.layer.duplicate.title = Dùplica s'istratu
command.layer.duplicate.description = Còpiat s'istratu ativu, cun totu su cuntenutu, in un'istratu nou subra de issu.
command.layer.smart_object.title = Cunverte a ogetu inteligente
command.layer.smart_object.description = Imboligat is pixel de s'istratu raster ativu in un'ogetu inteligente, gasi is trasformatziones e is filtros imbenientes ricampionant s'orìgine intata.
command.layer.rasterize.title = Rasteriza s'istratu
command.layer.rasterize.description = Cunvertit in pixel normales un'istratu de forma, testu o ogetu inteligente.
command.layer.delete.title = Cantzella s'istratu
command.layer.delete.description = Cantzellat is istratos seletzionados.
command.layer.group.title = Agrupa is istratos
command.layer.group.description = Pone is istratos seletzionados in unu grupu nou, in su matessi logu.
command.layer.raise.title = Porta in antis
command.layer.raise.description = Tramudat s'istratu ativu unu logu prus a susu in sa pila de su grupu suo.
command.layer.lower.title = Imbia in segus
command.layer.lower.description = Tramudat s'istratu ativu unu logu prus a josso in sa pila de su grupu suo.
command.layer.to_front.title = Porta in primu pianu
command.layer.to_front.description = Tramudat s'istratu ativu a su cugùmene de su grupu suo.
command.layer.to_back.title = Imbia a su fundu
command.layer.to_back.description = Tramudat s'istratu ativu a su fundu de su grupu suo.
command.layer.clipping_mask.title = Crea/Lìbera màschera de retàlliu
command.layer.clipping_mask.description = Retàlliat s'istratu ativu segundu cussu de suta, o ddu lìberat si est giai retalliadu; un'istratu retalliadu si bidet petzi in ue sa base tenet pixel.
command.layer.cut_to_new.title = Istratu tràmite sèchida
command.layer.cut_to_new.description = Tramudat is pixel seletzionados dae s'istratu ativu a un'istratu nou subra de issu.
command.layer.cut_to_new.layer_name = Istratu tràmite sèchida
command.layer.add_mask.title = Annanghe una màschera de istratu
command.layer.add_mask.description = Annanghet una màschera a s'istratu ativu, ammustende petzi sa seletzione cando nde b'at una.
command.layer.flatten.title = Aplana s'immàgine
command.layer.flatten.description = Cumponet totu su chi est visìbile in un'istratu Fundu opacu, cantzellende is istratos cuados.
command.layer.merge_down.title = Unisce in josso
command.layer.merge_down.description = Cumponet s'istratu ativu cun s'istratu suta de issu.
command.layer.merge_down.msg.no_layer_below = Perunu istratu in josso cun chi fàghere s'unione
command.layer.merge_visible.title = Unisce is visìbiles
command.layer.merge_visible.description = Cumponet cada istratu visìbile in unu ebbia, lassende intatos is istratos cuados.

# Messàgios
command.msg.nothing_to_copy = Seletziona un'istratu de pixel dae ue copiare
command.msg.clipboard_empty = Is apuntes sunt bòidos

