# Translation draft; not reviewed by a native speaker.
photo_merge_advanced.projective = Perspektivjustering (inklusive rotation)
photo_merge_advanced.cylindrical = Cylindriskt panorama
photo_merge_advanced.deghost = Ta bort spökbilder av rörliga motiv (första fotot som referens)
photo_merge_advanced.focal = Brännvidd (px) / bildbredd (px)
photo_merge_advanced.masks = Resultatet använder redigerbara lagermasker. Välj en mask i Lager och måla för att förfina den.
photo_merge_advanced.no_match = Ingen tillförlitlig justering hittades. Använd detaljrika foton med stor överlappning och små ändringar av synvinkeln.
photo_merge_advanced.invalid = Ogiltiga källbilder eller sammanslagningsinställningar.
