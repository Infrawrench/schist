printing.pages = Sidor: {count}
printing.color_note = Pixlarna konverteras till sRGB. PDF-visaren och skrivaren hanterar skrivarprofilen.
printing.sizing_note = Anpassningsläget fyller varje ruta utan beskärning. Verklig storlek använder dokumentets DPI; minska rutnätet om bilden inte får plats. Skriv ut PDF-filen i 100 % utan anpassning till sidan.
printing.running = Förbereder PDF…
printing.save_pdf = Spara PDF…
printing.open_print = Spara och öppna PDF för utskrift…
printing.invalid = Ogiltiga utskriftsinställningar eller bildmått.
printing.limit = Utskriftsjobbet överskrider gränsen: 200 bilder, 40 miljoner pixlar / 32768 pixlar per kant och bild eller 256 MiB komprimerade PDF-data.
printing.profile_error = Bilden har en ogiltig, felaktigt kopplad eller icke stödd färgprofil. Ursprunglig CMYK/Lab kräver en giltig inbäddad profil; RGB kräver en RGB-profil.
printing.does_not_fit = Bilden får inte plats i rutan vid dokumentets DPI. Använd anpassningsläget, ett mindre rutnät eller större papper.
printing.caption_limit = En bildtext är för lång för rutnätet. Använd färre rader eller kolumner, förkorta bildtexten eller stäng av bildtexter.
printing.font_error = Inget teckensnitt finns för bildtexten. Installera ett textteckensnitt eller stäng av bildtexter.
printing.no_document = Öppna ett dokument eller välj foton i galleriet innan du skriver ut.
printing.source_error = Ett valt foto, en redigerad sidofil eller en bildtext kunde inte läsas. Ingen PDF sparades.
printing.save_error = Det gick inte att spara PDF-filen. Välj ett nytt filnamn i en skrivbar mapp; befintliga filer ersätts aldrig.
printing.downloaded = PDF-filen har hämtats. Öppna den i en PDF-visare och skriv ut i 100 %.
printing.saved = PDF sparad: {path}
printing.letter = US Letter
printing.a4 = A4
printing.margin_value = {value} mm

