command.edit.paste_in_place.description = Matani za mu clipboard mu layer yatsopano pa ma coordinate omwe zinakopedwa.
command.edit.fill_foreground.title = Dzazani ndi Mtundu Wakutsogolo
command.edit.fill_foreground.description = Dzazani malo osankhidwa (kapena canvas yonse ngati palibe chosankhidwa) ndi mtundu wakutsogolo.
