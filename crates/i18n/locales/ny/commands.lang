command.select.feather.description = Fewetsani m'mphepete mwa malo osankhidwa ndi kusawoneka bwino kwa ma pixel awiri, kuti kusintha kotsatira kuzimiririka modutsa m'mphepetemo.
command.select.grow.title = Kulitsani
command.select.grow.description = Kulitsani malo osankhidwa kulowa mu ma pixel okhudzana omwe amafanana ndi osankhidwa kale, malinga ndi tolerance ya ndodo yamatsenga.
command.select.similar.title = Zofanana
