command.select.save.title = Sungani Chisankho
command.select.save.description = Sungani malo osankhidwa mu chikalata monga alpha channel yotchulidwa dzina.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Tsegulani Chisankho
command.select.load.description = Bwezeretsani malo osankhidwa omwe anasungidwa komaliza.

command.layer.new.title = Layer Yatsopano
command.layer.new.description = Onjezani layer ya raster yopanda kanthu pamwamba pa yogwira ntchito ndipo ikhale yogwira ntchito.
