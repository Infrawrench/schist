command.layer.clipping_mask.description = Dulani layer yogwira ntchito motsatira yomwe ili pansi pake, kapena itulutseni ngati yadulidwa kale; layer yodulidwa imaoneka kokha pamene maziko ake ali ndi ma pixel.
command.layer.cut_to_new.title = Layer Kudzera mu Kudula
