command.select.deselect.description = Chotsani malo osankhidwa kuti zosintha zigwirenso ntchito pa layer yonse.
command.select.inverse.title = Sankhani Mosiyana
command.select.inverse.description = Sinthanitsani malo osankhidwa ndi osasankhidwa.
