command.edit.fill_background.description = Dzazani malo osankhidwa (kapena canvas yonse ngati palibe chosankhidwa) ndi mtundu wakumbuyo.

command.select.all.title = Sankhani Zonse
command.select.all.description = Sankhani canvas yonse.
