lens_profiles.invalid = Sankhani nkhokwe yoyenera ya XML Lensfun v1/v2 (mpaka 8 MiB) yokhala ndi deta ya kamera kapena lens yothandizidwa.
lens_profiles.calibration = Kuyeza kwa lens
lens_profiles.no_calibration = Palibe kuyeza komwe kumakwanira zokonda izi. Onani utali wa focal ndi kuchuluka kodula kwa kamera; kukonza pamanja kulipobe.
lens_profiles.import = Lowetsani XML ya Lensfun…
lens_profiles.imported = Nkhokwe ya Lensfun yalowetsedwa pa nthawi ino. Sankhani profile kapena ifananitseni ndi metadata ya chithunzi.
lens_profiles.manual = Kukonza pamanja kokha
lens_profiles.saved = Kuyeza kosungidwa (nkhokwe sikupezeka)
lens_profiles.profile = Profile ya lens
lens_profiles.aperture = Kutseguka kwa lens (0 = sikudziwika)
lens_profiles.distance = Mtunda wolunjika (0 = sikudziwika)
lens_profiles.vignette = Kukonza mdima wa m’mbali motengera kuyeza
lens_profiles.color_context = Kukonza mdima wa m’mbali motengera kuyeza kumafuna profile ya sRGB yomangidwa m’pulogalamuyi. Sinthani kukhala sRGB kuti maonekedwe asinthe ayi, kenaka tsegulaninso Kukonza Lens. Ngati mapikseli ali kale mu sRGB koma alibe chizindikiro cha profile, kuwagawira sRGB n’kokwanira. Kukonza mawonekedwe ndi mtundu kulipobe.
lens_profiles.vignette_missing = Palibe kuyeza kwa mdima wa m’mbali komwe kumakwanira kutseguka kwa lens ndi mtunda wolunjika. Lowetsani miyeso yeniyeni kuti mugwiritse ntchito; 1000 m imaimira kuyang’ana patali mu ma profile ambiri a Lensfun.
lens_profiles.note = Kukonza motengera kuyeza kumachitika musanakonzere pamanja. Gwiritsani ntchito chithunzi choyambirira chonse, kenaka chiduleni. Sungani mndandanda wa ma filter mu PSD/PSB kuti kuyeza kukhalebe kosinthika.
lens_profiles.automatic = Fananitsani ndi metadata ya chithunzi
lens_profiles.components = Zotsatira za profile: kupindika {distortion}; m’mphepete mwa mitundu {tca}; mdima wa m’mbali {vignette}.
