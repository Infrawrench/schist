tool.heal.name = Furçë restaurimi
tool.heal.description = Furça e restaurimit: klikoni me Alt për të caktuar burimin, pastaj pikturoni; tekstura e burimit përzihet me ngjyrën dhe ndriçimin e vetë destinacionit.
tool.heal.history.stroke = Furçë restaurimi
tool.spot_heal.name = Furçë restaurimi pikësor
tool.spot_heal.description = Furça e restaurimit pikësor: pikturoni mbi një të metë dhe ajo zëvendësohet me teksturë të marrë nga rrethina — pa qenë nevoja të caktoni pikë burimi.
tool.spot_heal.history.stroke = Furçë restaurimi pikësor
tool.history_brush.name = Furçë historiku
tool.history_brush.description = Riktheni pikselët nga çasti i ruajtur në historikun e dokumentit, duke zhbërë punën e mëvonshme vijë pas vije.
