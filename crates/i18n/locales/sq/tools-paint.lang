tool.background_eraser.name = Gomë sfondi
tool.background_eraser.description = Fshini ngjyrën e marrë nën qendrën e furçës dhe lini të paprekur pikselët e ndryshëm, për ta shkëputur subjektin nga sfondi.
tool.background_eraser.history.stroke = Gomë sfondi
tool.gradient.name = Gradient
tool.gradient.description = Tërhiqeni për ta mbushur shtresën — përmes përzgjedhjes, kur ka një të tillë — me një gradient linear që shkon nga ngjyra e planit të parë te ngjyra e sfondit përgjatë tërheqjes.
tool.gradient.radial.name = Gradient radial
tool.gradient.radial.description = Tërhiqeni nga qendra drejt jashtë për ta mbushur me një gradient radial mes ngjyrave të planit të parë dhe sfondit.
