# Veglat e pikturimit.
tool.brush.name = Furçë
tool.brush.description = Pikturoni një vijë me skaje të buta në ngjyrën e planit të parë, me madhësinë, fortësinë dhe opacitetin e furçës të caktuar në redaktues.
tool.brush.history.stroke = Furçë
tool.pencil.name = Laps
tool.pencil.description = Pikturoni një vijë me skaje të forta, pa antialiasing, në ngjyrën e planit të parë.
tool.pencil.history.stroke = Laps
tool.eraser.name = Gomë
tool.eraser.description = Fshini përgjatë vijës, duke e kthyer shtresën në tejdukshmëri.
tool.eraser.history.stroke = Gomë
tool.clone.name = Vulë klonimi
tool.clone.description = Vula e klonimit: klikoni me Alt për të caktuar pikën e burimit, pastaj pikturoni pikselët e kopjuar prej saj me të njëjtën zhvendosje.
tool.clone.history.stroke = Vulë klonimi
tool.dodge.name = Zbehje
