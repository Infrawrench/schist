lens_profiles.invalid = Zgjidhni një bazë të vlefshme të dhënash Lensfun v1/v2 XML (deri në 8 MiB) me të dhëna të mbështetura për kamerën ose objektivin.
lens_profiles.calibration = Kalibrimi i objektivit
lens_profiles.no_calibration = Asnjë kalibrim nuk i mbulon këto cilësime. Kontrolloni gjatësinë fokale dhe faktorin e prerjes së kamerës; korrigjimi manual mbetet i disponueshëm.
lens_profiles.import = Importo Lensfun XML…
lens_profiles.imported = Baza e të dhënave Lensfun u importua për këtë seancë. Zgjidhni një profil ose përputheni me metadatat e fotografisë.
lens_profiles.manual = Vetëm korrigjim manual
lens_profiles.saved = Kalibrim i ruajtur (baza e të dhënave nuk është e disponueshme)
lens_profiles.profile = Profili i objektivit
lens_profiles.aperture = Hapja e diafragmës (0 = e panjohur)
lens_profiles.distance = Distanca e fokusimit (0 = e panjohur)
lens_profiles.vignette = Vinjetim i kalibruar
lens_profiles.color_context = Vinjetimi i kalibruar kërkon profilin e integruar sRGB. Kthejeni figurën në sRGB për të ruajtur pamjen, pastaj rihapni Korrigjimin e objektivit. Nëse pikselët janë tashmë në sRGB, por pa profil të caktuar, mjafton t’u caktoni sRGB. Korrigjimet gjeometrike dhe kromatike mbeten të disponueshme.
lens_profiles.vignette_missing = Nuk ka kalibrim vinjetimi për këtë hapje diafragme dhe distancë fokusimi. Futni vlerat e matura për ta aktivizuar; në shumë profile Lensfun, 1000 m përfaqëson fokusim në largësi.
lens_profiles.note = Korrigjimi i kalibruar zbatohet përpara kontrolleve manuale. Përdorni kuadrin origjinal të plotë; priteni më pas. Ruani grupin e filtrave në PSD/PSB që kalibrimi të mbetet i redaktueshëm.
lens_profiles.automatic = Përputhe me metadatat e fotografisë
lens_profiles.components = Zbatimi i profilit: shtrembërim {distortion}; skaje me ngjyra {tca}; vinjetim {vignette}.
