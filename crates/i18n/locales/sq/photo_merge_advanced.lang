photo_merge_advanced.projective = Rreshtim perspektiv (përfshin rrotullimin)
photo_merge_advanced.cylindrical = Panoramë cilindrike
photo_merge_advanced.deghost = Hiq gjurmët e subjekteve në lëvizje (fotografia e parë si referencë)
photo_merge_advanced.focal = Gjatësia fokale (px) / gjerësia e figurës (px)
photo_merge_advanced.masks = Rezultati i bashkimit të fokusit përdor maska shtresash të redaktueshme. Zgjidhni një maskë te Shtresat dhe pikturojeni për ta përmirësuar.
photo_merge_advanced.no_match = Nuk u gjet rreshtim i besueshëm. Përdorni fotografi me teksturë, me mbivendosje të mjaftueshme dhe ndryshime të vogla të këndvështrimit.
photo_merge_advanced.invalid = Figura burimore ose cilësime bashkimi të pavlefshme.
