# Komandat Redaktimi, Përzgjedhja dhe Shtresa.
command.edit.undo.title = Zhbëj
command.edit.undo.description = Kthehuni një hap pas në historikun e zhbërjes së dokumentit.
command.edit.redo.title = Ribëj
command.edit.redo.description = Ribëni redaktimin e fundit që u zhbë.
command.edit.copy.title = Kopjo
command.edit.copy.description = Kopjoni pikselët e përzgjedhur të shtresës aktive në kujtesën e brendshme (të gjithë shtresën kur nuk ka përzgjedhje).
command.edit.copy_merged.title = Kopjo të bashkuarat
command.edit.copy_merged.description = Kopjojeni përzgjedhjen ashtu siç e kompozojnë të gjitha shtresat e dukshme, jo vetëm nga shtresa aktive.
command.edit.cut.title = Prit
command.edit.cut.description = Kopjoni pikselët e përzgjedhur në kujtesë dhe fshijini nga shtresa aktive.
command.edit.paste.title = Ngjit
command.edit.paste.description = Ngjiteni përmbajtjen e kujtesës në një shtresë të re mbi shtresën aktive, në qendër të kanavacës.
command.edit.paste.layer_name = Shtresë e ngjitur
command.edit.paste_in_place.title = Ngjit në vend
command.edit.paste_in_place.description = Ngjiteni përmbajtjen e kujtesës në një shtresë të re në koordinatat nga të cilat u kopjua.
command.edit.fill_foreground.title = Mbush me planin e parë
command.edit.fill_foreground.description = Mbusheni përzgjedhjen (ose të gjithë kanavacën kur nuk ka përzgjedhje) me ngjyrën e planit të parë.
command.edit.fill_background.title = Mbush me sfondin
command.edit.fill_background.description = Mbusheni përzgjedhjen (ose të gjithë kanavacën kur nuk ka përzgjedhje) me ngjyrën e sfondit.
command.select.all.title = Përzgjidh të gjitha
command.select.all.description = Përzgjidhni të gjithë kanavacën.
command.select.deselect.title = Çpërzgjidh
command.select.deselect.description = Hiqeni përzgjedhjen, që redaktimet të zbatohen sërish në të gjithë shtresën.
command.select.inverse.title = Përmbys përzgjedhjen
command.select.inverse.description = Ndërroni zonat e përzgjedhura me ato të papërzgjedhura.
command.select.reselect.title = Ripërzgjidh
command.select.reselect.description = Riktheni përzgjedhjen që u hoq së fundi.
command.select.reselect.msg.nothing_to_reselect = Nuk ka asgjë për të ripërzgjedhur
command.select.feather.title = Zbut skajet e përzgjedhjes
command.select.feather.description = Zbuteni skajin e përzgjedhjes me turbullim prej dy pikselësh, që redaktimi pasues të zbehet gradualisht përmes tij.
command.select.grow.title = Zmadho
command.select.grow.description = Zgjerojeni përzgjedhjen në pikselët ngjitur që u ngjajnë atyre tashmë të përzgjedhur, brenda tolerancës së shkopit magjik.
command.select.similar.title = Të ngjashmet
command.select.similar.description = Përzgjidhni çdo piksel në shtresë që i ngjan përzgjedhjes, i lidhur me të ose jo, brenda tolerancës së shkopit magjik.
command.select.save.title = Ruaj përzgjedhjen
command.select.save.description = Ruajeni përzgjedhjen aktuale në dokument si kanal alfa të emërtuar.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Ngarko përzgjedhjen
command.select.load.description = Riktheni përzgjedhjen e ruajtur më së fundi.
command.layer.new.title = Shtresë e re
command.layer.new.description = Shtoni një shtresë raster bosh mbi shtresën aktive dhe bëjeni aktive.
command.layer.duplicate.title = Dyfisho shtresën
command.layer.duplicate.description = Kopjojeni shtresën aktive, me gjithë përmbajtjen, në një shtresë të re sipër saj.
command.layer.smart_object.title = Shndërro në objekt inteligjent
command.layer.smart_object.description = Mbështillini pikselët e shtresës raster aktive në një objekt inteligjent, që transformimet dhe filtrat e mëvonshëm të rimostrojnë burimin e paprekur.
command.layer.rasterize.title = Rasterizo shtresën
command.layer.rasterize.description = Kthejeni një shtresë forme, teksti ose objekti inteligjent në pikselë të zakonshëm.
command.layer.delete.title = Fshi shtresën
command.layer.delete.description = Fshini shtresat e përzgjedhura.
command.layer.group.title = Grupo shtresat
command.layer.group.description = Vendosini shtresat e përzgjedhura në një grup të ri, në të njëjtin vend.
command.layer.raise.title = Sill përpara
command.layer.raise.description = Zhvendoseni shtresën aktive një vend më lart në grumbullin e grupit të saj.
command.layer.lower.title = Dërgo prapa
command.layer.lower.description = Zhvendoseni shtresën aktive një vend më poshtë në grumbullin e grupit të saj.
command.layer.to_front.title = Sill në plan të parë
command.layer.to_front.description = Zhvendoseni shtresën aktive në krye të grupit të saj.
command.layer.to_back.title = Dërgo në fund
command.layer.to_back.description = Zhvendoseni shtresën aktive në fund të grupit të saj.
command.layer.clipping_mask.title = Krijo/Liro maskën prerëse
command.layer.clipping_mask.description = Prijeni shtresën aktive sipas asaj poshtë saj ose lirojeni nëse është tashmë e prerë; një shtresë e prerë shfaqet vetëm ku baza e saj ka pikselë.
command.layer.cut_to_new.title = Shtresë nga prerja
command.layer.cut_to_new.description = Zhvendosini pikselët e përzgjedhur nga shtresa aktive në një shtresë të re sipër saj.
command.layer.cut_to_new.layer_name = Shtresë nga prerja
command.layer.add_mask.title = Shto maskë shtrese
command.layer.add_mask.description = Shtojini një maskë shtresës aktive, që shfaq vetëm përzgjedhjen kur ka një të tillë.
command.layer.flatten.title = Rrafsho imazhin
command.layer.flatten.description = Kompozoni gjithçka të dukshme në një shtresë të vetme opake Sfondi, duke hedhur shtresat e fshehura.
command.layer.merge_down.title = Bashko poshtë
command.layer.merge_down.description = Kompozojeni shtresën aktive me shtresën poshtë saj.
command.layer.merge_down.msg.no_layer_below = Nuk ka shtresë poshtë ku të bashkohet
command.layer.merge_visible.title = Bashko të dukshmet
command.layer.merge_visible.description = Kompozoni çdo shtresë të dukshme në një të vetme, pa prekur shtresat e fshehura.
command.msg.nothing_to_copy = Përzgjidhni një shtresë pikselësh për të kopjuar prej saj
command.msg.clipboard_empty = Kujtesa është bosh
