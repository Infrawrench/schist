printing.caption_limit = Një mbishkrim është tepër i gjatë për këtë rrjetë. Përdorni më pak rreshta ose kolona, shkurtoni mbishkrimin ose çaktivizoni mbishkrimet.
printing.font_error = Nuk ka font për mbishkrimin. Instaloni një font teksti ose çaktivizoni mbishkrimet.
printing.no_document = Hapni një dokument ose zgjidhni fotografi të galerisë përpara se të printoni.
printing.source_error = Fotografia e zgjedhur, skedari shoqërues i redaktuar ose mbishkrimi nuk mund të lexoheshin. Nuk u ruajt asnjë PDF.
printing.save_error = PDF-ja nuk u ruajt. Zgjidhni një emër të ri skedari në një dosje të shkrueshme; skedarët ekzistues nuk zëvendësohen kurrë.
