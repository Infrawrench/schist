command.edit.undo.title = Malfari
command.edit.undo.description = Reiri unu paŝon en la malfara historio de la dokumento.
command.edit.redo.title = Refari
command.edit.redo.description = Refari la laste malfaritan redakton.
command.edit.copy.title = Kopii
command.edit.copy.description = Kopii la elektitajn rastrumerojn de la aktiva tavolo al la interna tondujo (la tutan tavolon kiam nenio estas elektita).
command.edit.copy_merged.title = Kopii kunfandite
command.edit.copy_merged.description = Kopii la elekton tiel, kiel ĝin kunmetas ĉiuj videblaj tavoloj, anstataŭ nur el la aktiva tavolo.
command.edit.cut.title = Eltondi
command.edit.cut.description = Kopii la elektitajn rastrumerojn al la tondujo kaj forviŝi ilin el la aktiva tavolo.
command.edit.paste.title = Alglui
command.edit.paste.description = Alglui la tondujan enhavon en novan tavolon super la aktiva, centre de la kanvaso.
command.edit.paste.layer_name = Algluita tavolo
command.edit.paste_in_place.title = Alglui samloke
command.edit.paste_in_place.description = Alglui la tondujan enhavon en novan tavolon ĉe la koordinatoj, de kiuj ĝi estis kopiita.
command.edit.fill_foreground.title = Plenigi per malfono
command.edit.fill_foreground.description = Plenigi la elekton (aŭ la tutan kanvason kiam nenio estas elektita) per la malfona koloro.
command.edit.fill_background.title = Plenigi per fono
command.edit.fill_background.description = Plenigi la elekton (aŭ la tutan kanvason kiam nenio estas elektita) per la fona koloro.
command.select.all.title = Elekti ĉion
command.select.all.description = Elekti la tutan kanvason.
command.select.deselect.title = Malelekti
command.select.deselect.description = Forigi la elekton, por ke redaktoj denove aplikiĝu al la tuta tavolo.
command.select.inverse.title = Inversigi elekton
command.select.inverse.description = Interŝanĝi elektitajn kaj neelektitajn areojn.
command.select.reselect.title = Reelekti
command.select.reselect.description = Restarigi la laste forigitan elekton.
command.select.reselect.msg.nothing_to_reselect = Nenio reelektebla
command.select.feather.title = Moligi elekton
command.select.feather.description = Moligi la randon de la elekto per du-rastrumera malklarigo, por ke la sekva redakto iom post iom paliĝu trans ĝi.
command.select.grow.title = Kreskigi
command.select.grow.description = Etendi la elekton en tuŝantajn rastrumerojn similajn al la jam elektitaj, ene de la toleremo de la magia vergo.
command.select.similar.title = Simila
command.select.similar.description = Elekti ĉiun rastrumeron en la tavolo similan al la elekto, ĉu ĝi tuŝas la elekton aŭ ne, ene de la toleremo de la magia vergo.
command.select.save.title = Konservi elekton
command.select.save.description = Konservi la aktualan elekton en la dokumento kiel nomitan alfa-kanalon.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Ŝargi elekton
command.select.load.description = Restarigi la plej lastatempe konservitan elekton.
command.layer.new.title = Nova tavolo
command.layer.new.description = Aldoni malplenan rastruman tavolon super la aktiva kaj aktivigi ĝin.
command.layer.duplicate.title = Duobligi tavolon
command.layer.duplicate.description = Kopii la aktivan tavolon kun ĝia tuta enhavo al nova tavolo super ĝi.
command.layer.smart_object.title = Konverti al inteligenta objekto
command.layer.smart_object.description = Envolvi la rastrumerojn de la aktiva rastruma tavolo en inteligentan objekton, por ke postaj transformoj kaj filtriloj respecimenu la netuŝitan fonton.
command.layer.rasterize.title = Rastrumi tavolon
command.layer.rasterize.description = Fiksi forman, tekstan aŭ inteligentobjektan tavolon kiel ordinarajn rastrumerojn.
command.layer.delete.title = Forigi tavolon
command.layer.delete.description = Forigi la elektitajn tavolojn.
command.layer.group.title = Grupigi tavolojn
command.layer.group.description = Envolvi la elektitajn tavolojn en novan grupon samloke.
command.layer.raise.title = Porti antaŭen
command.layer.raise.description = Movi la aktivan tavolon unu lokon supren en la stako de ĝia grupo.
command.layer.lower.title = Sendi malantaŭen
command.layer.lower.description = Movi la aktivan tavolon unu lokon malsupren en la stako de ĝia grupo.
command.layer.to_front.title = Porti plej antaŭen
command.layer.to_front.description = Movi la aktivan tavolon al la supro de ĝia grupo.
command.layer.to_back.title = Sendi plej malantaŭen
command.layer.to_back.description = Movi la aktivan tavolon al la fundo de ĝia grupo.
command.layer.clipping_mask.title = Krei/liberigi detondan maskon
command.layer.clipping_mask.description = Limigi la aktivan tavolon laŭ la suba tavolo, aŭ liberigi ĝin se ĝi jam estas limigita; detondita tavolo aperas nur kie ĝia baza tavolo havas rastrumerojn.
command.layer.cut_to_new.title = Tavolo per eltondo
command.layer.cut_to_new.description = Movi la elektitajn rastrumerojn el la aktiva tavolo al nova tavolo super ĝi.
command.layer.cut_to_new.layer_name = Tavolo per eltondo
command.layer.add_mask.title = Aldoni tavolmaskon
command.layer.add_mask.description = Aldoni tavolmaskon al la aktiva tavolo, kiu montras nur la elekton kiam elekto ekzistas.
command.layer.flatten.title = Platigi bildon
command.layer.flatten.description = Kunmeti ĉion videblan en unu opakan Fono-tavolon kaj forĵeti kaŝitajn tavolojn.
command.layer.merge_down.title = Kunfandi malsupren
command.layer.merge_down.description = Kunmeti la aktivan tavolon en la tavolon sub ĝi.
command.layer.merge_down.msg.no_layer_below = Neniu suba tavolo por kunfandi
command.layer.merge_visible.title = Kunfandi videblajn
command.layer.merge_visible.description = Kunmeti ĉiujn videblajn tavolojn en unu kaj lasi kaŝitajn tavolojn netuŝitaj.
command.msg.nothing_to_copy = Elektu rastruman tavolon, el kiu kopii
