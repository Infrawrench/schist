lens_profiles.invalid = Tia Lensfun v1/v2 XML nyatakakadzraɖoƒe si sɔ (si ade 8 MiB) si me fotoɖemɔ̃ alo lens ƒe nyatakaka siwo wodo alɔe le.
lens_profiles.calibration = Lens ƒe dzidzedzekpɔkpɔ
lens_profiles.no_calibration = Dodokpɔ aɖeke meƒoa nu tso ɖoɖo siawo ŋu o. Kpɔ ŋkuléleɖenuŋu ƒe didime kple fotoɖemɔ̃ ƒe nuku ƒe akpa; asi ɖɔɖɔɖo gakpɔtɔ li.
lens_profiles.import = Tsɔ Lensfun XML va eme…
lens_profiles.imported = Wotsɔ Lensfun nyatakakadzraɖoƒe va eme na ɣeyiɣi sia. Tia nɔnɔmetata aɖe alo nàsɔe kple fotoa ƒe metadata.
lens_profiles.manual = Asi ɖɔɖɔɖo ɖeɖeko
lens_profiles.saved = Wodzra calibration ɖo (nyatakakadzraɖoƒea meli o) .
lens_profiles.profile = Lens ƒe nɔnɔmetata
lens_profiles.aperture = Aperture (0 = womenya o) .
lens_profiles.distance = Focus ƒe didime (0 = womenya o) .
lens_profiles.vignette = Vignetting si wodo kpɔ
lens_profiles.color_context = Vignetting si wodo kpɔ hiã sRGB ƒe nɔnɔmetata si wotu ɖe eme. Trɔ ɖe sRGB ŋu be nàkpɔ dzedzeme ta, emegbe nàgaʋu Lens ƒe Dzadzra ake. Le piksel siwo womede dzesii o gake wonye sRGB xoxo la, sRGB dede asi na wo sɔ gbɔ. Geometry kple chromatic correction gakpɔtɔ li.
lens_profiles.vignette_missing = Vignetting calibration aɖeke metsyɔa aperture kple focus ƒe didime dzi o. Ŋlɔ asixɔxɔ siwo wodzidze be wòawɔ dɔ; 1000 m tsi tre ɖi na didiƒe ʋĩ ƒe ŋkuléle ɖe nu ŋu le Lensfun ƒe nɔnɔmetata geɖe me.
lens_profiles.note = Ðɔɖɔɖo si wodo kpɔ la zɔna do ŋgɔ na asidziɖuɖuawo. Zã foto gbãtɔa ƒe fli bliboa; tso akpa aɖe ɖa le ema megbe. Dzra filter stack ɖo ɖe PSD/PSB me be nàlé calibration si woateŋu atrɔ asi le la me ɖe asi.
lens_profiles.automatic = Tsɔ fotowo ƒe metadata sɔ kple wo nɔewo
lens_profiles.components = Nɔnɔmetata ƒe dɔwɔwɔ: tɔtɔ {distortion}; amadede ƒe alɔdzewo {tca}; vignetting {vignette}.
