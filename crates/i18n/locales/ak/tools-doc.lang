# Artboard
tool.artboard.name = Artboard
tool.artboard.description = Twe artboard bi: canvas no fã a wɔato din na wobetumi ayi no afi mu wɔ ne nkutoo mu. Sɛ wotwe artboard bi a ɛwɔ hɔ dedaw no mu a, ɛtu no.
tool.artboard.default_name = Artboard {n}

# Slice
tool.slice.name = Twitwa
tool.slice.description = Twe fã bi a wɔde beyi afi mu; ɛyɛ canvas no ahinanan a wɔato din na woyi no sɛ mfonini soronko. Sɛ wotwe fã a ɛwɔ hɔ dedaw no mu a, ɛtu no.
tool.slice.default_name = Twitwa {n}

# Frame
tool.frame.name = Frame
