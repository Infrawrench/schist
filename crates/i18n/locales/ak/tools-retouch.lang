# Content-Aware Move
tool.content_aware_move.name = Tu a Ɛte Mu Nsɛm Ase
tool.content_aware_move.description = Twe ade a woapaw no kɔ baabi foforo, na wɔde nneɛma a atwa ho ahyia bɛhyɛ tokuru a egyaw no ma. Wɔ Extend mode mu no, wɔtwe ade no mu tenten sen sɛ wobetu no.
tool.content_aware_move.choice.move = Tu
tool.content_aware_move.choice.extend = Tenten Mu
tool.content_aware_move.history.move = Tu a Ɛte Mu Nsɛm Ase

