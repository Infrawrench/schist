# Patch
tool.patch.name = Siesie Beae
tool.patch.description = Twe nsensanee twa mfomso bi ho hyia, na twe nea woapaw no kɔ pixels a asɛm biara nni ho no so; wɔde hɔ texture no besiesie mfomso no. Patch mode no na ɛkyerɛ faako wɔ baanu no mu a wobɛtwe.
tool.patch.option.patch = Siesie Beae
tool.patch.choice.source = Fibea
tool.patch.choice.destination = Beae a Ɛrekɔ
