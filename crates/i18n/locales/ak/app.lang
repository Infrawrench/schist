# Vulkan ho nhwehwɛmu
app.vulkan.no_loader = schist: Vulkan loader biara nni system yi so, enti biribiara nni hɔ a wɔde bɛyɛ mfonini.\n\nSchist nam Vulkan so na ɛyɛ mfonini, na wɔmfa `libvulkan.so.1` ntoo so.\nLoader ne driver no nyinaa ho hia:\n\n    Arch, CachyOS, Omarchy    sudo pacman -S vulkan-icd-loader vulkan-driver\n    Debian, Ubuntu, Mint      sudo apt install libvulkan1 mesa-vulkan-drivers\n    Fedora, RHEL              sudo dnf install vulkan-loader mesa-vulkan-drivers\n
app.vulkan.override_missing = schist: Vulkan driver a session yi kyerɛ no nni hɔ.\n\nWɔahyɛ {var}, na sɛ wɔhyɛ no a, ɛde nea ɛkyerɛ no *si loader no ankasa driver hwehwɛ ananmu* sen sɛ ɛde bɛka ho. Enti fael yi a enni hɔ no nko ara ne driver ahorow no nyinaa — na Vulkan program biara wɔ session yi mu nhu driver biako mpo, ɛmfa ho sɛ wɔde pii ato so:\n\n{missing}\n    {var}={value}\n\nMa ɛnkyerɛ manifest a ɛwɔ hɔ — driver a wɔde ato so de wɔn de gu /usr/share/vulkan/icd.d — anaa yi nhyehyɛe no na ma loader no ankasa nhu ne de.\nSɛ session bi fi config file mu hyɛ eyi (Hyprland `env =`, systemd environment.d drop-in, anaa shell profile) a, ɛsɛ sɛ wosesa wɔ hɔ, na ɛsɛ sɛ wokɔ akontaabu no mu foforo ansa na nsakrae no adu biribi a ɛreyɛ adwuma dedaw ho.\n
app.vulkan.override_note = \nWɔde {var} ahyɛ {value}, na eyi si loader no ankasa hwehwɛ ananmu: sɛ manifest ahorow no mu biara nyɛ mfiri yi dea a, ade a edi kan a ɛsɛ sɛ wosɔ hwɛ ne sɛ wubeyi nhyehyɛe no.\n
app.vulkan.no_driver = schist: wɔmfa Vulkan driver biara ntoo so, enti biribiara nni hɔ a wɔde bɛyɛ mfonini.\n\nSchist nam Vulkan so na ɛyɛ mfonini. Wɔde loader no ato so, nanso ɛka sɛ driver biara nni hɔ — driver biara ankyerɛw ne din wɔ mmeae abien a wɔhwehwɛ mu no mu:\n\n{dirs}\n\nWɔde loader no ne driver ahorow no ba soronko, enti mpɛn pii no package baako na ɛnni hɔ.\n\nFa nea ɛyɛ mfiri yi GPU no dea no to so:\n\n    Arch, CachyOS, Omarchy    sudo pacman -S vulkan-driver\n    Debian, Ubuntu, Mint      sudo apt install mesa-vulkan-drivers\n    Fedora, RHEL              sudo dnf install mesa-vulkan-drivers\n\nNVIDIA proprietary driver no kura ne de (`nvidia-utils` wɔ Arch, `nvidia-driver` wɔ Debian). Wɔ virtual machine mu, anaa baabi a GPU driver biara nni hɔ a wobetumi de ato so no, software rasteriser no na ɛyɛ adwuma: `vulkan-swrast` wɔ Arch, na ɛyɛ `mesa-vulkan-drivers` fã wɔ mmeae foforo. Ɛyɛ nyaa, nanso efi ase.\n{overridden}
app.vulkan.no_device = schist: wɔde Vulkan driver bi ato so, nanso enni device biara a wɔde bɛyɛ mfonini.\n\nEbia driver no mmoa GPU yi, anaa entumi nnya ho kwan — wɔ SSH so anaa container mu no, /dev/dri taa yɛ nea ɛnni hɔ. `vulkaninfo --summary` kyerɛ nea loader no hu.\n\nSɛ mfiri yi nni GPU koraa a, software rasteriser no tumi yɛ mfonini: `vulkan-swrast` wɔ Arch, na ɛyɛ `mesa-vulkan-drivers` fã wɔ Debian ne Fedora.\n
app.vulkan.skip_hint = Sɛ wopɛ sɛ wufi Schist ase ara na woma no di ne ho nkogu wɔ n'ankasa kwan so a, hyɛ {var}=1.
