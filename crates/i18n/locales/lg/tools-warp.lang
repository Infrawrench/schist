# Puppet Warp
tool.puppet_warp.name = Kyusa ng'akazannyo
tool.puppet_warp.description = Nyiga okusimba layer ku bubonero butono, oluvannyuma walula kamu: akatimba kefunya okwetooloola obubonero obwo, nga kakaluba oba kagonda okusinziira ku kirondebwa mu Bukaluba. Okukakasa kuteeka enkyukakyuka ku layer.
