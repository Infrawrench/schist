# Okuwonya
tool.heal.name = Bbulashi ewonya
tool.heal.description = Bbulashi ewonya: nyiga alt n'onyiga okuteekawo ensibuko, oluvannyuma osiige; obutonde bw'ensibuko butabulwa mu langi n'ekitangaala eby'ekigendererwa.
