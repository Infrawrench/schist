# Kyusa
command.edit.undo.title = Sazaamu ekikoleddwa
command.edit.undo.description = Ddayo omutendera gumu mu byafaayo by'ebisazibwamu eby'ekiwandiiko.
command.edit.redo.title = Ddamu okole
command.edit.redo.description = Ddamu okole enkyukakyuka eyasembayo okusazibwamu.
command.edit.copy.title = Koppa
command.edit.copy.description = Koppa pixels ezirondeddwa ku layer ekola mu tterekero ly'okukopperamu ery'omunda (layer yonna bwe wataba kirondeddwa).
command.edit.copy_merged.title = Koppa ebigattiddwa
command.edit.copy_merged.description = Koppa ekirondeddwa nga layers zonna ezirabika bwe zikigatta, so si okuva ku layer ekola yokka.
command.edit.cut.title = Salako
command.edit.cut.description = Koppa pixels ezirondeddwa mu tterekero ly'okukopperamu era ozisangule ku layer ekola.
command.edit.paste.title = Paatiika
command.edit.paste.description = Paatiika ebiri mu tterekero ly'okukopperamu ku layer empya waggulu w'ekola, wakati ku canvas.
command.edit.paste.layer_name = Layer epaatikiddwa
command.edit.paste_in_place.title = Paatiika mu kifo kyayo
command.edit.paste_in_place.description = Paatiika ebiri mu tterekero ly'okukopperamu ku layer empya ku coordinates gye byakoppeddwa.
command.edit.fill_foreground.title = Jjuza langi ey'omu maaso
command.edit.fill_foreground.description = Jjuza ekirondeddwa (oba canvas yonna bwe wataba kirondeddwa) ne langi ey'omu maaso.
command.edit.fill_background.title = Jjuza langi ey'emabega
command.edit.fill_background.description = Jjuza ekirondeddwa (oba canvas yonna bwe wataba kirondeddwa) ne langi ey'emabega.

# Londa
command.select.all.title = Londa byonna
command.select.all.description = Londa canvas yonna.
command.select.deselect.title = Ggyako okulonda
command.select.deselect.description = Ggyawo ekirondeddwa, enkyukakyuka ziddemu okukola ku layer yonna.
command.select.inverse.title = Londa ebitali birondeddwa
command.select.inverse.description = Waanyisa ebitundu ebirondeddwa n'ebitali birondeddwa.
command.select.reselect.title = Ddamu olonde
command.select.reselect.description = Zzaawo ekirondeddwa ekyasembayo okuggyibwawo.
command.select.reselect.msg.nothing_to_reselect = Tewali kya kuddamu kulonda
command.select.feather.title = Gonvuya embalama z'ekirondeddwa
command.select.feather.description = Gonvuya embalama z'ekirondeddwa n'okufuukuuka kwa pixels bbiri, enkyukakyuka eddako ekendeere mpolampola ng'eyitamu.
command.select.grow.title = Gaziya
command.select.grow.description = Gaziya ekirondeddwa okuyingira mu pixels ezikikwatako era ezifaanagana n'ezirondeddwa, okusinziira ku kigero ky'akati k'amagezi eky'okukkiriza enjawulo.
command.select.similar.title = Ebyefaananyiriza
command.select.similar.description = Londa buli pixel ku layer efaanagana n'ekirondeddwa, k'eba ng'ekikwatako oba nedda, okusinziira ku kigero ky'akati k'amagezi eky'okukkiriza enjawulo.
command.select.save.title = Tereka ekirondeddwa
command.select.save.description = Tereka ekirondeddwa ekiriwo mu kiwandiiko ng'omukutu gwa alpha ogulina erinnya.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Tikka ekirondeddwa
command.select.load.description = Zzaawo ekirondeddwa ekyasembayo okuterekebwa.

# Layer
command.layer.new.title = Layer empya
command.layer.new.description = Gattako layer ya raster enjereere waggulu w'ekola era ogifuule ekola.
command.layer.duplicate.title = Koppolola Layer
command.layer.duplicate.description = Koppa layer ekola n'ebigirimu byonna ku layer empya waggulu waayo.
command.layer.smart_object.title = Fuula Smart Object
command.layer.smart_object.description = Teeka pixels za layer ya raster ekola mu smart object, enkyukakyuka n'obusengejja ebiddako biddemu okupima ensibuko etakyusiddwa.
command.layer.rasterize.title = Fuula Layer Raster
command.layer.rasterize.description = Fuula layer y'enkula, ebiwandiiko oba smart-object ebeere pixels eza bulijjo.
command.layer.delete.title = Sangula Layer
command.layer.delete.description = Sangula layers ezirondeddwa.
command.layer.group.title = Gatta Layers mu Group
command.layer.group.description = Teeka layers ezirondeddwa mu group empya mu kifo kye zimu.
command.layer.raise.title = Leeta mu maaso
command.layer.raise.description = Tambuza layer ekola ekifo kimu waggulu mu ntuumu ya group yaayo.
command.layer.lower.title = Tuma emabega
command.layer.lower.description = Tambuza layer ekola ekifo kimu wansi mu ntuumu ya group yaayo.
command.layer.to_front.title = Leeta ddala mu maaso
command.layer.to_front.description = Tambuza layer ekola ku ntikko ya group yaayo.
command.layer.to_back.title = Tuma ddala emabega
command.layer.to_back.description = Tambuza layer ekola wansi ddala mu group yaayo.
command.layer.clipping_mask.title = Kola/Ggyawo Clipping Mask
command.layer.clipping_mask.description = Salira layer ekola ku layer eri wansi waayo, oba ogisumulule bwe kiba nga yakasalirwako; layer esaliddwa erabika awo wokka omusingi gwayo we gulina pixels.
command.layer.cut_to_new.title = Layer okuva mu kusalako
command.layer.cut_to_new.description = Ggyayo pixels ezirondeddwa ku layer ekola oziteeke ku layer empya waggulu waayo.
command.layer.cut_to_new.layer_name = Layer okuva mu kusalako
command.layer.add_mask.title = Gattako Mask ya Layer
command.layer.add_mask.description = Gattako mask ya layer ku layer ekola, ng'eraga ekirondeddwa kyokka bwe kibaawo.
command.layer.flatten.title = Gatta ekifaananyi
command.layer.flatten.description = Gatta byonna ebirabika mu layer emu etalabikaamu eya Emabega, osule layers ezikwekeddwa.
command.layer.merge_down.title = Gatta n'eri wansi
command.layer.merge_down.description = Gatta layer ekola mu layer eri wansi waayo.
command.layer.merge_down.msg.no_layer_below = Tewali layer wansi ya kugattamu
command.layer.merge_visible.title = Gatta ezirabika
command.layer.merge_visible.description = Gatta buli layer erabika mu emu, oleke ezikwekeddwa nga bwe ziri.
command.msg.nothing_to_copy = Londa layer ya pixels gy'onookoppamu
command.msg.clipboard_empty = Tewali kiri mu tterekero ly'okukopperamu

