# Translated photo merge options.
photo_merge_advanced.projective = Okukwatagana kw’endowooza (muli n’okukyusakyusa) .
photo_merge_advanced.cylindrical = Ekifaananyi ekirabika obulungi (cylindrical panorama).
photo_merge_advanced.deghost = Ggyawo ebifaananyi ebiddiddwamu eby’ebintu ebitambula (ekifaananyi ekisooka nga kye ky’okugeraageranya)
photo_merge_advanced.focal = Obuwanvu bw’ekifo (px) / obugazi bw’ekifaananyi (px) .
photo_merge_advanced.masks = Ekifaananyi ekiva mu kugatta okussa essira kikozesa masiki za layeri ezisobola okukyusibwa. Londa masiki mu Layers ogisiige langi okugitereeza.
photo_merge_advanced.no_match = Tewali alignment eyesigika ezuuliddwa. Kozesa ebifaananyi ebiriko ebiwandiiko nga bikwatagana nnyo n’enkyukakyuka entonotono mu kulaba.
photo_merge_advanced.invalid = Ebifaananyi by'ensibuko ebitali bituufu oba ensengeka z'okugatta.
