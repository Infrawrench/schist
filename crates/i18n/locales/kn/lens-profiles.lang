# Lens profiles.
lens_profiles.invalid = ಬೆಂಬಲಿತ ಕ್ಯಾಮರಾ ಅಥವಾ ಲೆನ್ಸ್ ಡೇಟಾದೊಂದಿಗೆ ಮಾನ್ಯವಾದ Lensfun v1/v2 XML ಡೇಟಾಬೇಸ್ (8 MiB ವರೆಗೆ) ಆಯ್ಕೆಮಾಡಿ.
lens_profiles.calibration = ಲೆನ್ಸ್ ಮಾಪನಾಂಕ ನಿರ್ಣಯ
lens_profiles.no_calibration = ಯಾವುದೇ ಮಾಪನಾಂಕ ನಿರ್ಣಯವು ಈ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಒಳಗೊಳ್ಳುವುದಿಲ್ಲ. ಫೋಕಲ್ ಲೆಂತ್ ಮತ್ತು ಕ್ಯಾಮರಾ ಕ್ರಾಪ್ ಫ್ಯಾಕ್ಟರ್ ಪರಿಶೀಲಿಸಿ; ಹಸ್ತಚಾಲಿತ ತಿದ್ದುಪಡಿ ಲಭ್ಯವಿದೆ.
lens_profiles.import = Lensfun XML ಆಮದು ಮಾಡಿ...
lens_profiles.imported = ಈ ಸೆಶನ್‌ಗಾಗಿ Lensfun ಡೇಟಾಬೇಸ್ ಅನ್ನು ಆಮದು ಮಾಡಲಾಗಿದೆ. ಪ್ರೊಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ಫೋಟೋ ಮೆಟಾಡೇಟಾವನ್ನು ಹೊಂದಿಸಿ.
lens_profiles.manual = ಹಸ್ತಚಾಲಿತ ತಿದ್ದುಪಡಿ ಮಾತ್ರ
lens_profiles.saved = ಉಳಿಸಿದ ಮಾಪನಾಂಕ ನಿರ್ಣಯ (ಡೇಟಾಬೇಸ್ ಲಭ್ಯವಿಲ್ಲ)
lens_profiles.profile = ಲೆನ್ಸ್ ಪ್ರೊಫೈಲ್
lens_profiles.aperture = ದ್ಯುತಿರಂಧ್ರ (0 = ಅಜ್ಞಾತ)
lens_profiles.distance = ಫೋಕಸ್ ದೂರ (0 = ಅಜ್ಞಾತ)
lens_profiles.vignette = ಕ್ಯಾಲಿಬ್ರೇಟೆಡ್ ವಿಗ್ನೆಟಿಂಗ್
lens_profiles.color_context = ಮಾಪನಾಂಕ ನಿರ್ಣಯಕ್ಕೆ ಅಂತರ್ನಿರ್ಮಿತ sRGB ಪ್ರೊಫೈಲ್ ಅಗತ್ಯವಿದೆ. ನೋಟವನ್ನು ಕಾಪಾಡಲು sRGB ಗೆ ಪರಿವರ್ತಿಸಿ, ನಂತರ ಲೆನ್ಸ್ ತಿದ್ದುಪಡಿಯನ್ನು ಪುನಃ ತೆರೆಯಿರಿ. ಈಗಾಗಲೇ-sRGB ಟ್ಯಾಗ್ ಮಾಡದ ಪಿಕ್ಸೆಲ್‌ಗಳಿಗೆ, sRGB ಅನ್ನು ನಿಯೋಜಿಸುವುದು ಸಾಕು. ಜ್ಯಾಮಿತಿ ಮತ್ತು ಕ್ರೊಮ್ಯಾಟಿಕ್ ತಿದ್ದುಪಡಿಗಳು ಲಭ್ಯವಿವೆ.
lens_profiles.vignette_missing = ಯಾವುದೇ ವಿಗ್ನೆಟಿಂಗ್ ಮಾಪನಾಂಕ ನಿರ್ಣಯವು ದ್ಯುತಿರಂಧ್ರ ಮತ್ತು ಫೋಕಸ್ ದೂರವನ್ನು ಒಳಗೊಳ್ಳುವುದಿಲ್ಲ. ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಅಳತೆ ಮೌಲ್ಯಗಳನ್ನು ನಮೂದಿಸಿ; 1000 m ಅನೇಕ Lensfun ಪ್ರೊಫೈಲ್‌ಗಳಲ್ಲಿ ದೂರದ ಫೋಕಸ್ ಅನ್ನು ಸೂಚಿಸುತ್ತದೆ.
lens_profiles.note = ಹಸ್ತಚಾಲಿತ ನಿಯಂತ್ರಣಗಳ ಮೊದಲು ಮಾಪನಾಂಕ ತಿದ್ದುಪಡಿಯು ಚಲಿಸುತ್ತದೆ. ಮೂಲ ಪೂರ್ಣ ಚೌಕಟ್ಟನ್ನು ಬಳಸಿ; ನಂತರ ಚಿತ್ರವನ್ನು ಕ್ರಾಪ್ ಮಾಡಿ. ಸಂಪಾದಿಸಬಹುದಾದ ಮಾಪನಾಂಕ ನಿರ್ಣಯವನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲು PSD/PSB ನಲ್ಲಿ ಫಿಲ್ಟರ್ ಸ್ಟಾಕ್ ಅನ್ನು ಉಳಿಸಿ.
lens_profiles.automatic = ಫೋಟೋ ಮೆಟಾಡೇಟಾವನ್ನು ಹೊಂದಿಸಿ
lens_profiles.components = ಪ್ರೊಫೈಲ್ ಪಾಸ್: ಅಸ್ಪಷ್ಟತೆ {distortion}; ಬಣ್ಣದ ಅಂಚುಗಳು {tca}; ವಿಗ್ನೆಟಿಂಗ್ {vignette}.
