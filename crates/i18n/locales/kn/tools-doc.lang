# ಆರ್ಟ್‌ಬೋರ್ಡ್, ಸ್ಲೈಸ್, ಫ್ರೇಮ್, ಟಿಪ್ಪಣಿ ಮತ್ತು ಎಣಿಕೆ ಪರಿಕರಗಳು.

# ಆರ್ಟ್‌ಬೋರ್ಡ್
tool.artboard.name = ಆರ್ಟ್‌ಬೋರ್ಡ್
tool.artboard.description = ಆರ್ಟ್‌ಬೋರ್ಡ್ ಅನ್ನು ಎಳೆದು ರಚಿಸಿ: ಇದು ಕ್ಯಾನ್ವಾಸ್‌ನ ಹೆಸರಿರುವ ಪ್ರದೇಶವಾಗಿದ್ದು, ಪ್ರತ್ಯೇಕವಾಗಿ ರಫ್ತಾಗುತ್ತದೆ. ಈಗಿರುವ ಆರ್ಟ್‌ಬೋರ್ಡ್‌ನ ಒಳಗೆ ಎಳೆದರೆ ಅದು ಸರಿಯುತ್ತದೆ.
tool.artboard.default_name = ಆರ್ಟ್‌ಬೋರ್ಡ್ {n}

# ಸ್ಲೈಸ್
tool.slice.name = ಸ್ಲೈಸ್
tool.slice.description = ರಫ್ತು ಸ್ಲೈಸ್ ಅನ್ನು ಎಳೆದು ರಚಿಸಿ; ಇದು ಕ್ಯಾನ್ವಾಸ್‌ನ ಹೆಸರಿರುವ ಆಯತವಾಗಿದ್ದು, ಪ್ರತ್ಯೇಕ ಚಿತ್ರವಾಗಿ ರಫ್ತಾಗುತ್ತದೆ. ಈಗಿರುವ ಸ್ಲೈಸ್‌ನ ಒಳಗೆ ಎಳೆದರೆ ಅದು ಸರಿಯುತ್ತದೆ.
tool.slice.default_name = ಸ್ಲೈಸ್ {n}

# ಫ್ರೇಮ್
tool.frame.name = ಫ್ರೇಮ್
tool.frame.description = ಫ್ರೇಮ್ ಅನ್ನು ಎಳೆದು ರಚಿಸಿ: ಇದು ತನ್ನೊಳಗೆ ಇರಿಸುವ ಯಾವುದನ್ನಾದರೂ ಮರೆಹಾಕುವ ಆಯತಾಕಾರದ (ಅಥವಾ ಅಂಡಾಕಾರದ) ಲೇಯರ್.
tool.frame.default_name = ಫ್ರೇಮ್ {n}
tool.frame.choice.rectangle = ಆಯತ
tool.frame.choice.ellipse = ಅಂಡಾಕಾರ
tool.frame.history.frame = ಫ್ರೇಮ್

# ಟಿಪ್ಪಣಿ
tool.note.name = ಟಿಪ್ಪಣಿ
tool.note.description = ಖಾಲಿ ಕ್ಯಾನ್ವಾಸ್‌ನಲ್ಲಿ ಕ್ಲಿಕ್ ಮಾಡಿ ಅಲ್ಲಿ ಟಿಪ್ಪಣಿಯನ್ನು ಪಿನ್ ಮಾಡಿ; ಸಂಪಾದಕದ ಸ್ಥಿತಿಯಲ್ಲಿರುವ ಲೇಖಕರ ಹೆಸರು ಮತ್ತು ಬಣ್ಣ ಅದರ ಮೇಲೆ ಗುರುತಾಗುತ್ತದೆ. ಈಗಿರುವ ಪಿನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿದರೆ, ಟಿಪ್ಪಣಿಗಳ ಫಲಕದಲ್ಲಿ ಅದನ್ನು ಆಯ್ಕೆಮಾಡುತ್ತದೆ.
tool.note.history.place = ಟಿಪ್ಪಣಿ ಇರಿಸಿ
tool.note.history.move = ಟಿಪ್ಪಣಿ ಸರಿಸಿ
tool.note.history.delete = ಟಿಪ್ಪಣಿ ಅಳಿಸಿ

# ಎಣಿಕೆ
tool.count.name = ಎಣಿಕೆ
tool.count.description = ಕ್ಯಾನ್ವಾಸ್‌ನಲ್ಲಿ ಸಂಖ್ಯೆಯಿರುವ ಎಣಿಕೆ ಗುರುತುಗಳನ್ನು ಇರಿಸಲು ಕ್ಲಿಕ್ ಮಾಡಿ; ಈಗಿರುವ ಗುರುತನ್ನು ತೆಗೆದುಹಾಕಲು ಅದರ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ.
tool.count.default_name = ಎಣಿಕೆ {n}
