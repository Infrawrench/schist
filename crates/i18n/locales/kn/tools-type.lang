# ಪಠ್ಯ ಪರಿಕರ.
tool.type.name = ಪಠ್ಯ
tool.type.description = ಅಲ್ಲಿ ಪಠ್ಯ ಲೇಯರ್ ಆರಂಭಿಸಲು ಕ್ಲಿಕ್ ಮಾಡಿ, ಅಥವಾ ಈಗಿರುವ ಪಠ್ಯ ಲೇಯರ್ ಅನ್ನು ಸಂಪಾದಿಸಲು ಅದರ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ. ಅದು ತೆರೆದಿರುವಾಗ ಪರಿಕರವು ನೇರ ಕೀಲಿಗಳನ್ನು ಸ್ವೀಕರಿಸುತ್ತದೆ (ಅಕ್ಷರಗಳನ್ನು ಕೀಲಿಯ ಇನ್‌ಪುಟ್ ಆಗಿ ಕಳುಹಿಸಿ); ದೃಢೀಕರಿಸಿದಾಗ ಲೇಯರ್ ಅನ್ನು ರೆಂಡರ್ ಮಾಡಿ ಸಂಪಾದನೆಯನ್ನು ಮುಚ್ಚುತ್ತದೆ.

