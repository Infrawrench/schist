# Native layered formats.
codec.pdn.name = Paint.NET
codec.xcf.name = GIMP XCF
codec.layered.invalid = ସ୍ତରଯୁକ୍ତ ଛବି ଫାଇଲ୍‌ଟି କ୍ଷତିଗ୍ରସ୍ତ କିମ୍ବା ଅସମ୍ପୂର୍ଣ୍ଣ।
