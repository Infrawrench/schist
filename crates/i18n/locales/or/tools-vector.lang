tool.pen.name = ପେନ୍
tool.pen.description = ଏକ ପଥ ତିଆରି କରନ୍ତୁ: କୋଣ ବିନ୍ଦୁ ପାଇଁ କ୍ଲିକ୍ କରନ୍ତୁ, ସେଠାରୁ ବକ୍ର ହ୍ୟାଣ୍ଡଲ୍ ବାହାର କରିବାକୁ ଟାଣନ୍ତୁ ଏବଂ ବନ୍ଦ କରିବାକୁ ପ୍ରଥମ ବିନ୍ଦୁରେ କ୍ଲିକ୍ କରନ୍ତୁ। ନିଶ୍ଚିତ କଲେ ପଥଟି ଏକ ଆକୃତି ସ୍ତରରେ ପରିଣତ ହୁଏ।
