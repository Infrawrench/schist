# Lens profiles.
lens_profiles.invalid = Roghnaigh bunachar sonraí bailí Lensfun v1/v2 XML (suas go 8 MiB) le sonraí ceamara nó lionsaí tacaithe.
lens_profiles.calibration = Calabrú lionsa
lens_profiles.no_calibration = Ní chlúdaíonn aon chalabrú na socruithe seo. Seiceáil fad fócasach agus fachtóir barr ceamara; ceartúchán láimhe fós ar fáil.
lens_profiles.import = Iompórtáil Lensfun XML…
lens_profiles.imported = Iompórtáladh bunachar sonraí Lensfun don seisiún seo. Roghnaigh próifíl nó meaitseáil na meiteashonraí grianghraf.
lens_profiles.manual = Ceartú láimhe amháin
lens_profiles.saved = Calabrú sábháilte (níl bunachar sonraí ar fáil)
lens_profiles.profile = Próifíl lionsa
lens_profiles.aperture = Cró (0 = anaithnid)
lens_profiles.distance = Fad fócas (0 = anaithnid)
lens_profiles.vignette = Vignetting calabraithe
lens_profiles.color_context = Éilíonn vignetting calabraithe an phróifíl sRGB ionsuite. Tiontaigh go sRGB chun an chuma a chaomhnú, ansin Ceartú Lionsa a oscailt arís. I gcás picteilíní gan chlibeáil sRGB cheana féin, is leor sRGB a shannadh. Tá céimseata agus ceartúchán crómatach fós ar fáil.
lens_profiles.vignette_missing = Ní chlúdaíonn aon chalabrú vignettála an cró ná an fad fócais. Cuir isteach luachanna tomhaiste chun é a chumasú; Léiríonn 1000 m fócas i bhfad i gcéin i go leor próifílí Lensfun.
lens_profiles.note = Ritheann ceartú calabraithe roimh na rialuithe láimhe. Úsáid an íomhá bhunaidh iomlán; bearr ina dhiaidh sin. Sábháil cruach scagairí in PSD/PSB chun calabrú inathraithe a choinneáil.
lens_profiles.automatic = Meaitseáil meiteashonraí grianghraf
lens_profiles.components = Pas próifíl: saobhadh {distortion}; imill dath {tca}; vigneting {vignette}.
