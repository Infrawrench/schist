command.edit.undo.title = Cealaigh
command.edit.undo.description = Téigh céim amháin siar i stair chealaithe na cáipéise.
command.edit.redo.title = Athdhéan
command.edit.redo.description = Déan arís an eagarthóireacht a cealaíodh go deireanach.
command.edit.copy.title = Cóipeáil
command.edit.copy.description = Cóipeáil picteilíní roghnaithe na sraithe gníomhaí chuig an ngearrthaisce inmheánach (an tsraith iomlán mura bhfuil rud ar bith roghnaithe).
command.edit.copy_merged.title = Cóipeáil Cumaiscthe
command.edit.copy_merged.description = Cóipeáil an roghnúchán mar a chumascann gach sraith infheicthe é, seachas ón tsraith ghníomhach amháin.
command.edit.cut.title = Gearr
command.edit.cut.description = Cóipeáil na picteilíní roghnaithe chuig an ngearrthaisce agus scrios ón tsraith ghníomhach iad.
command.edit.paste.title = Greamaigh
command.edit.paste.description = Greamaigh an ghearrthaisce i sraith nua os cionn na sraithe gníomhaí, agus í láraithe ar an gcanbhás.
command.edit.paste.layer_name = Sraith Ghreamaithe
command.edit.paste_in_place.title = Greamaigh san Áit
command.edit.paste_in_place.description = Greamaigh an ghearrthaisce i sraith nua ag na comhordanáidí ónar cóipeáladh í.
command.edit.fill_foreground.title = Líon leis an Tulra
command.edit.fill_foreground.description = Líon an roghnúchán (nó an canbhás iomlán mura bhfuil rud ar bith roghnaithe) leis an dath tulra.
command.edit.fill_background.title = Líon leis an gCúlra
command.edit.fill_background.description = Líon an roghnúchán (nó an canbhás iomlán mura bhfuil rud ar bith roghnaithe) leis an dath cúlra.
command.select.all.title = Roghnaigh Uile
command.select.all.description = Roghnaigh an canbhás iomlán.
command.select.deselect.title = Díroghnaigh
command.select.deselect.description = Scaoil an roghnúchán, ionas go gcuirfear eagarthóireacht i bhfeidhm ar an tsraith iomlán arís.
command.select.inverse.title = Roghnaigh a Mhalairt
command.select.inverse.description = Babhtáil na limistéir roghnaithe agus neamhroghnaithe.
command.select.reselect.title = Athroghnaigh
command.select.reselect.description = Tabhair ar ais an roghnúchán a scaoileadh go deireanach.
command.select.reselect.msg.nothing_to_reselect = Níl aon rud le hathroghnú
command.select.feather.title = Cleitigh Roghnúchán
command.select.feather.description = Bog imill an roghnúcháin le doiléiriú dhá phicteilín, ionas go gcéimneoidh an chéad eagarthóireacht eile amach trasna orthu.
command.select.grow.title = Fás
command.select.grow.description = Leathnaigh an roghnúchán isteach i bpicteilíní tadhlacha atá cosúil lena bhfuil roghnaithe cheana, laistigh de lamháltas na slaite draíochta.
command.select.similar.title = Cosúil
command.select.similar.description = Roghnaigh gach picteilín sa tsraith atá cosúil leis an roghnúchán, bíodh sé tadhlach leis nó ná bíodh, laistigh de lamháltas na slaite draíochta.
command.select.save.title = Sábháil Roghnúchán
command.select.save.description = Cuir an roghnúchán reatha i dtaisce sa cháipéis mar chainéal alfa ainmnithe.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Lódáil Roghnúchán
command.select.load.description = Athchóirigh an roghnúchán is déanaí a sábháladh.
command.layer.new.title = Sraith Nua
command.layer.new.description = Cuir sraith raster fholamh os cionn na sraithe gníomhaí agus déan gníomhach í.
command.layer.duplicate.title = Dúblaigh Sraith
command.layer.duplicate.description = Cóipeáil an tsraith ghníomhach, lena hinneachar uile, chuig sraith nua os a cionn.
command.layer.smart_object.title = Tiontaigh go Réad Cliste
command.layer.smart_object.description = Cuir picteilíní na sraithe raster gníomhaí i réad cliste, ionas go ndéanfaidh claochluithe agus scagairí níos déanaí an fhoinse gan athrú a athshampláil.
command.layer.rasterize.title = Rastaraigh Sraith
command.layer.rasterize.description = Comhréitigh sraith chrutha, téacs nó réada chliste ina gnáthphicteilíní.
command.layer.delete.title = Scrios Sraith
command.layer.delete.description = Scrios na sraitheanna roghnaithe.
command.layer.group.title = Grúpáil Sraitheanna
command.layer.group.description = Cuir na sraitheanna roghnaithe i ngrúpa nua san áit chéanna.
command.layer.raise.title = Tabhair Chun Tosaigh
command.layer.raise.description = Bog an tsraith ghníomhach áit amháin suas i gcruach a grúpa.
command.layer.lower.title = Seol Siar
command.layer.lower.description = Bog an tsraith ghníomhach áit amháin síos i gcruach a grúpa.
command.layer.to_front.title = Tabhair go dtí an Tosach
command.layer.to_front.description = Bog an tsraith ghníomhach go barr a grúpa.
command.layer.to_back.title = Seol go dtí an Cúl
command.layer.to_back.description = Bog an tsraith ghníomhach go bun a grúpa.
command.layer.clipping_mask.title = Cruthaigh/Scaoil Masc Gearrtha
command.layer.clipping_mask.description = Gearr an tsraith ghníomhach de réir na sraithe faoina bun, nó scaoil í má tá sí gearrtha cheana; ní thaispeántar sraith ghearrtha ach san áit a bhfuil picteilíní ina bonn.
command.layer.cut_to_new.title = Sraith trí Ghearradh
command.layer.cut_to_new.description = Bog na picteilíní roghnaithe amach as an tsraith ghníomhach agus chuig sraith nua os a cionn.
command.layer.cut_to_new.layer_name = Sraith trí Ghearradh
command.layer.add_mask.title = Cuir Masc Sraithe Leis
command.layer.add_mask.description = Cuir masc sraithe leis an tsraith ghníomhach, nach nochtann ach an roghnúchán nuair atá ceann ann.
command.layer.flatten.title = Leacaigh Íomhá
command.layer.flatten.description = Cumaisc gach rud infheicthe in aon sraith Chúlra theimhneach amháin, agus caith na sraitheanna folaithe uait.
command.layer.merge_down.title = Cumaisc Síos
command.layer.merge_down.description = Cumaisc an tsraith ghníomhach isteach sa tsraith faoina bun.
command.layer.merge_down.msg.no_layer_below = Níl aon sraith faoina bun le cumasc inti
command.layer.merge_visible.title = Cumaisc Infheicthe
command.layer.merge_visible.description = Cumaisc gach sraith infheicthe in aon cheann amháin, agus fág na sraitheanna folaithe gan athrú.
command.msg.nothing_to_copy = Roghnaigh sraith picteilíní le cóipeáil uaithi
command.msg.clipboard_empty = Níl aon rud ar an ngearrthaisce
