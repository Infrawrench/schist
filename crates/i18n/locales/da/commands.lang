# Grundkommandoer til Rediger, Vælg og Lag.
command.edit.undo.title = Fortryd
command.edit.undo.description = Gå ét element tilbage i dokumentets fortrydelseshistorik.
command.edit.redo.title = Annuller fortryd
command.edit.redo.description = Udfør den senest fortrudte redigering igen.
command.edit.copy.title = Kopier
command.edit.copy.description = Kopier det aktive lags markerede pixels til den interne udklipsholder (hele laget, når intet er markeret).
command.edit.copy_merged.title = Kopier samlet
command.edit.copy_merged.description = Kopier markeringen, sådan som alle synlige lag sammensætter den, i stedet for kun fra det aktive lag.
command.edit.cut.title = Klip
command.edit.cut.description = Kopier de markerede pixels til udklipsholderen, og slet dem fra det aktive lag.
command.edit.paste.title = Sæt ind
command.edit.paste.description = Sæt udklipsholderens indhold ind i et nyt lag over det aktive lag, centreret på lærredet.
command.edit.paste.layer_name = Indsat lag
command.edit.paste_in_place.title = Sæt ind på samme sted
command.edit.paste_in_place.description = Sæt udklipsholderens indhold ind i et nyt lag på de koordinater, det blev kopieret fra.
command.edit.fill_foreground.title = Udfyld med forgrundsfarve
command.edit.fill_foreground.description = Udfyld markeringen (eller hele lærredet, når intet er markeret) med forgrundsfarven.
command.edit.fill_background.title = Udfyld med baggrundsfarve
command.edit.fill_background.description = Udfyld markeringen (eller hele lærredet, når intet er markeret) med baggrundsfarven.

command.select.all.title = Vælg alt
command.select.all.description = Markér hele lærredet.
command.select.deselect.title = Fravælg
command.select.deselect.description = Fjern markeringen, så redigeringer igen anvendes på hele laget.
command.select.inverse.title = Inverter markering
command.select.inverse.description = Ombyt markerede og umarkerede områder.
command.select.reselect.title = Vælg igen
command.select.reselect.description = Gendan den senest fjernede markering.
command.select.reselect.msg.nothing_to_reselect = Intet at vælge igen
command.select.feather.title = Udtynd markering
command.select.feather.description = Blødgør markeringens kant med en sløring på to pixels, så den næste redigering tones ud hen over den.
command.select.grow.title = Forøg
command.select.grow.description = Udvid inden for tryllestavens tolerance markeringen til tilstødende pixels, der ligner dem, som allerede er markeret.
command.select.similar.title = Lignende
command.select.similar.description = Markér alle pixels i laget, der inden for tryllestavens tolerance ligner markeringen, uanset om de støder op til den.
command.select.save.title = Gem markering
command.select.save.description = Gem den aktuelle markering i dokumentet som en navngivet alfakanal.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Indlæs markering
command.select.load.description = Gendan den senest gemte markering.

command.layer.new.title = Nyt lag
command.layer.new.description = Tilføj et tomt rasterlag over det aktive lag, og gør det aktivt.
command.layer.duplicate.title = Dubler lag
command.layer.duplicate.description = Kopier det aktive lag med hele dets indhold til et nyt lag ovenover.
command.layer.smart_object.title = Konverter til Smart Object
command.layer.smart_object.description = Pak pixels fra det aktive rasterlag ind i et Smart Object, så senere transformeringer og filtre resampler den urørte kilde.
command.layer.rasterize.title = Rasteriser lag
command.layer.rasterize.description = Konverter et form-, tekst- eller Smart Object-lag permanent til almindelige pixels.
command.layer.delete.title = Slet lag
command.layer.delete.description = Slet de valgte lag.
command.layer.group.title = Gruppér lag
command.layer.group.description = Saml de valgte lag i en ny gruppe på samme sted.
command.layer.raise.title = Flyt fremad
command.layer.raise.description = Flyt det aktive lag én plads op i gruppens stak.
command.layer.lower.title = Flyt bagud
command.layer.lower.description = Flyt det aktive lag én plads ned i gruppens stak.
command.layer.to_front.title = Placer forrest
command.layer.to_front.description = Flyt det aktive lag øverst i gruppen.
command.layer.to_back.title = Placer bagest
command.layer.to_back.description = Flyt det aktive lag nederst i gruppen.
command.layer.clipping_mask.title = Opret/frigiv udsnitsmaske
command.layer.clipping_mask.description = Klip det aktive lag til laget nedenunder, eller frigiv det, hvis det allerede er klippet. Et klippet lag vises kun, hvor grundlaget har pixels.
command.layer.cut_to_new.title = Lag via klipning
command.layer.cut_to_new.description = Flyt de markerede pixels ud af det aktive lag og til et nyt lag ovenover.
command.layer.cut_to_new.layer_name = Lag via klipning
command.layer.add_mask.title = Tilføj lagmaske
command.layer.add_mask.description = Føj en lagmaske til det aktive lag, som kun viser markeringen, hvis der er en.
command.layer.flatten.title = Sammenkopier billede
command.layer.flatten.description = Sammensæt alt synligt til ét uigennemsigtigt baggrundslag, og kassér skjulte lag.
command.layer.merge_down.title = Flet ned
command.layer.merge_down.description = Sammensæt det aktive lag med laget nedenunder.
command.layer.merge_down.msg.no_layer_below = Intet lag nedenunder at flette med
command.layer.merge_visible.title = Flet synlige
command.layer.merge_visible.description = Sammensæt alle synlige lag til ét, og lad skjulte lag være urørte.
command.msg.nothing_to_copy = Vælg et pixellag at kopiere fra
command.msg.clipboard_empty = Intet på udklipsholderen
