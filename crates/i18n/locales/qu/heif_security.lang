# HEIC security update.
codec.heif.msg.unsafe_version = libheif {version} mana chaskisqachu, riqsisqa waqaychay pantayninkuna kasqanrayku; versión {minimum} utaq aswan musuqmi kanan tiyan. Musuqyachisqa HEIC yanapayninta uraykachiy utaq sistemap bibliotecanta musuqyachiy.
codec.heif.msg.unknown_version = libheif mana chaskisqachu, versiónnin mana chiqaqchasqa kayta atisqanrayku; versión {minimum} utaq aswan musuqmi kanan tiyan. Musuqyachisqa HEIC yanapayninta uraykachiy utaq sistemap bibliotecanta musuqyachiy.
dialog.open.heic_needs_safe_decoder = “{name}” kichanapaqqa libheif {minimum} utaq aswan musuq, HEVC decodificaqniyuq kanan tiyan. Aswan mawk'a utaq mana chiqaqchay atina versionkuna hark'asqam kanku, riqsisqa waqaychay pantaykunamanta amachanapaq. Qatipanapaq musuqyachisqa HEIC yanapayninta uraykachiy.
workspace.docs.heic_safe_decoder_needed = Musuqyachisqa HEIC yanapaynin kanan tiyan
