# Muñeka waq'uchiy
tool.puppet_warp.name = Muñeka waq'uchiy
tool.puppet_warp.description = Patata wakin ch'ikukunapi t'ipanapaq ñit'iy, chaymanta hukninta aysay: malla t'ipanakuna muyuriqninpi k'umukun, Rigidez akllana nisqanman hina sinchita utaq llamp'uta. Takyachispa churakun.
tool.puppet_warp.option.stiffness = Rigidez
tool.puppet_warp.history.puppet_warp = Muñeka waq'uchiy

# Chinkana ch'iku
tool.vanishing_point.name = Chinkana ch'iku
tool.vanishing_point.description = Perspectivayuq imap hawanman pampa geométricata aysaspa ruray, chaymanta imayna kasqanta Clonar nisqaman tikray, pintaytaq: mirachisqa pixelkuna pampaman hina purinku, karuman rispa huch'uyaspa.
tool.vanishing_point.choice.edit_plane = Pampa geométricata allichay
tool.vanishing_point.choice.clone = Clonar
