# Unuyachiy
tool.liquify.name = Unuyachiy
tool.liquify.description = Hatun pincelpa uranpi pixelkunata tanqay, muyuchiy, k'ichkiy utaq punkichiy; imayna kasqan akllanaqa mayqin ruwanata akllan. Waq'uchisqaqa malla ukhupi huñukun, takyachispa pataman churakun.
