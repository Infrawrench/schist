command.edit.copy_merged.title = Nakili Zilizounganishwa
command.edit.copy_merged.description = Nakili uteuzi kama unavyoonekana baada ya kuunganisha safu zote zinazoonekana, badala ya safu inayotumika pekee.
command.edit.cut.title = Kata
command.edit.cut.description = Nakili pikseli zilizochaguliwa kwenye ubao wa kunakili na uzifute kwenye safu inayotumika.
