command.edit.fill_foreground.description = Jaza uteuzi (au turubai nzima ikiwa hakuna uteuzi) kwa rangi ya mbele.
command.edit.fill_background.title = Jaza kwa Rangi ya Mandharinyuma
command.edit.fill_background.description = Jaza uteuzi (au turubai nzima ikiwa hakuna uteuzi) kwa rangi ya mandharinyuma.
command.select.all.title = Chagua Zote
command.select.all.description = Chagua turubai nzima.
