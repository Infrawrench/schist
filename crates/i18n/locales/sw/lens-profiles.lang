lens_profiles.invalid = Chagua hifadhidata halali ya XML ya Lensfun v1/v2 (hadi 8 MiB) yenye data za kamera au lenzi zinazotumika.
lens_profiles.calibration = Urekebishaji wa lenzi
lens_profiles.no_calibration = Hakuna urekebishaji unaolingana na mipangilio hii. Angalia urefu wa fokasi na kipengele cha ukataji cha kamera; urekebishaji wa mikono bado unapatikana.
lens_profiles.import = Leta XML ya Lensfun…
lens_profiles.imported = Hifadhidata ya Lensfun imeletwa kwa kipindi hiki. Chagua profaili au ilinganishe na metadata ya picha.
lens_profiles.manual = Urekebishaji wa mikono pekee
lens_profiles.saved = Urekebishaji uliohifadhiwa (hifadhidata haipatikani)
lens_profiles.profile = Profaili ya lenzi
lens_profiles.aperture = Tundu la lenzi (0 = halijulikani)
lens_profiles.distance = Umbali wa fokasi (0 = haujulikani)
lens_profiles.vignette = Kufifia kwa kingo kulikorekebishwa
lens_profiles.color_context = Kufifia kwa kingo kulikorekebishwa kunahitaji profaili ya sRGB iliyojengewa ndani. Badilisha kuwa sRGB ili kuhifadhi mwonekano, kisha ufungue tena Urekebishaji wa Lenzi. Kwa pikseli ambazo tayari ni sRGB lakini hazina lebo, kupachika profaili ya sRGB kunatosha. Urekebishaji wa jiometri na wa kingo za rangi bado unapatikana.
lens_profiles.vignette_missing = Hakuna urekebishaji wa kufifia kwa kingo unaofunika tundu na umbali wa fokasi huu. Weka vipimo vilivyopimwa ili kuuwezesha; 1000 m huwakilisha fokasi ya mbali katika profaili nyingi za Lensfun.
lens_profiles.note = Urekebishaji uliopimwa hutekelezwa kabla ya vidhibiti vya mikono. Tumia fremu asili nzima; kata picha baadaye. Hifadhi mkusanyiko wa vichujio katika PSD/PSB ili urekebishaji uendelee kuharirika.
lens_profiles.automatic = Linganisha metadata ya picha
lens_profiles.components = Hatua ya profaili: upotoshaji {distortion}; kingo za rangi {tca}; kufifia kwa kingo {vignette}.
