# Lens profiles.
lens_profiles.invalid = Yan ibi ìpamọ́ dátà Lensfun v1/v2 XML tó péye (títí dé 8 MiB) tí ó ní dátà kamẹ́rà tàbí lẹ́ńsì tí a ń gbà.
lens_profiles.calibration = Ìwọ̀n àtúnṣe lẹ́ńsì
lens_profiles.no_calibration = Kò sí ìwọ̀n àtúnṣe tó bá àwọn ààtò wọ̀nyí mu. Ṣàyẹ̀wò gígùn fóókù àti ìwọ̀n ìgégé kamẹ́rà; àtúnṣe afọwọ́wọ́ ṣì wà.
lens_profiles.import = Gbé Lensfun XML wọlé…
lens_profiles.imported = A ti gbé ibi ìpamọ́ dátà Lensfun wọlé fún ìgbà yìí. Yan àkọsílẹ̀ kan tàbí fi wé àlàyé fọ́tò náà.
lens_profiles.manual = Àtúnṣe afọwọ́wọ́ nìkan
lens_profiles.saved = Ìwọ̀n àtúnṣe tí a fipamọ́ (ibi ìpamọ́ dátà kò sí)
lens_profiles.profile = Àkọsílẹ̀ lẹ́ńsì
lens_profiles.aperture = Ìṣí lẹ́ńsì (0 = a kò mọ̀)
lens_profiles.distance = Ìjìnnà fóókù (0 = a kò mọ̀)
lens_profiles.vignette = Òjìji etí tí a ti wọ̀n
lens_profiles.color_context = Òjìji etí tí a ti wọ̀n nílò àkọsílẹ̀ sRGB inú ètò. Yí padà sí sRGB kí ìrísí má bàa yí, lẹ́yìn náà tún ṣí Àtúnṣe lẹ́ńsì. Bí píksẹ́lì bá ti wà ní sRGB ṣùgbọ́n kò ní àmì àkọsílẹ̀, fífi sRGB fún wọn ti tó. Àtúnṣe ìrísí àti àwọ̀ ṣì wà.
lens_profiles.vignette_missing = Kò sí ìwọ̀n àtúnṣe òjìji etí tó bá ìṣí lẹ́ńsì àti ìjìnnà fóókù mu. Tẹ àwọn iye tí a wọ̀n láti mú un ṣiṣẹ́; 1000 m túmọ̀ sí fóókù jíjìn nínú ọ̀pọ̀ àkọsílẹ̀ Lensfun.
lens_profiles.note = Àtúnṣe tí a ti wọ̀n ń ṣiṣẹ́ ṣáájú àwọn ìṣàkóso afọwọ́wọ́. Lo gbogbo àwòrán àkọ́kọ́; gée lẹ́yìn náà. Fi àkójọpọ̀ àlẹ̀mọ́ pamọ́ nínú PSD/PSB kí a lè ṣàtúnṣe ìwọ̀n náà lọ́jọ́ iwájú.
lens_profiles.automatic = Fi wé àlàyé fọ́tò
lens_profiles.components = Ìlò àkọsílẹ̀: ìdàrúdàpọ̀ ìrísí {distortion}; àwọ̀ tó yọ ní etí {tca}; òjìji etí {vignette}.
