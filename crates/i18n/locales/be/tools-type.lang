# Інструмент тэксту.

tool.type.name = Тэкст
tool.type.description = Пстрыкніце, каб пачаць тэкставы пласт у гэтым месцы, або пстрыкніце па існым, каб яго рэдагаваць. Пакуль пласт адкрыты, інструмент прымае непасрэдныя націскі клавіш (перадавайце сімвалы як клавіятурны ўвод), а пацвярджэнне адмалёўвае пласт і закрывае рэдагаванне.

