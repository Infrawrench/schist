# Інструменты дэфармацыі: пластыка, марыянеткавая дэфармацыя і кропка сходу.

# Пластыка
tool.liquify.name = Пластыка
tool.liquify.description = Зрушвайце, закручвайце, сціскайце або раздзімайце пікселі пад вялікім пэндзлем — патрэбнае дзеянне задаецца рэжымам. Дэфармацыя назапашваецца ў сетцы і прымяняецца да пласта пасля пацвярджэння.
