# Lens profile controls.
lens_profiles.invalid = Выберыце сапраўдную XML-базу даных Lensfun v1/v2 (да 8 MiB) з падтрымоўванымі данымі камеры або аб'ектыва.
lens_profiles.calibration = Каліброўка аб'ектыва
lens_profiles.no_calibration = Ніякая каліброўка не распаўсюджваецца на гэтыя параметры. Праверце фокусную адлегласць і кроп-фактар ​​камеры; ручная карэкцыя застаецца даступнай.
lens_profiles.import = Імпартаваць Lensfun XML…
lens_profiles.imported = Для гэтага сеансу імпартавана база дадзеных Lensfun. Выберыце профіль або супастаўце метаданыя фота.
lens_profiles.manual = Толькі ручная карэкцыя
lens_profiles.saved = Захаваная каліброўка (база даных недаступная)
lens_profiles.profile = Профіль аб'ектыва
lens_profiles.aperture = Дыяфрагма (0 = невядома)
lens_profiles.distance = Фокусная адлегласць (0 = невядома)
lens_profiles.vignette = Калібраванае віньеткаванне
lens_profiles.color_context = Калібраванае віньеткаванне патрабуе ўбудаванага профілю sRGB. Пераўтварыце выяву ў sRGB, каб захаваць яе выгляд, затым зноў адкрыйце карэкцыю аб’ектыва. Калі пікселі ўжо ў sRGB, але не маюць пазнакі, дастаткова прызначыць ім профіль sRGB. Геаметрычная і храматычная карэкцыі застаюцца даступнымі.
lens_profiles.vignette_missing = Ніякая каліброўка віньеткавання не ахоплівае дыяфрагму і адлегласць фокусу. Увядзіце вымераныя значэнні, каб уключыць яго; 1000 м уяўляе сабой далёкі фокус у многіх профілях Lensfun.
lens_profiles.note = Адкалібраваная карэкцыя выконваецца перад ручнымі элементамі кіравання. Выкарыстоўвайце арыгінальны поўны кадр; пасля абрэжце яго. Захавайце стэк фільтраў у PSD/PSB, каб каліброўку можна было рэдагаваць.
lens_profiles.automatic = Супадзенне метаданых фота
lens_profiles.components = Карэкцыя па профілі: скажэнне {distortion}; каляровыя аблямоўкі {tca}; віньеткаванне {vignette}.
