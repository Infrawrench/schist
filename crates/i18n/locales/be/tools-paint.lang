tool.burn.history.stroke = Зацямняльнік
tool.sponge.name = Губка
tool.sponge.description = Павялічвае або памяншае насычанасць пікселяў, праз якія праходзіць штрых.
tool.sponge.history.stroke = Губка
tool.blur.name = Размыццё
