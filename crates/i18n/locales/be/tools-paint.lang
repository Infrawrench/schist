tool.brush.name = Пэндзаль
tool.brush.description = Малюе мяккі штрых колерам пярэдняга плана; яго памер, жорсткасць і непразрыстасць задаюцца параметрамі пэндзля ў рэдактары.
tool.brush.history.stroke = Пэндзаль
tool.pencil.name = Аловак
tool.pencil.description = Малюе штрых з цвёрдым краем без згладжвання колерам пярэдняга плана.
tool.pencil.history.stroke = Аловак
tool.eraser.name = Гумка
