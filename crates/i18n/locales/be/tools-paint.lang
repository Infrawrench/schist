tool.smudge.history.stroke = Размазванне
tool.heal.name = Аднаўляльны пэндзаль
tool.heal.description = Аднаўляльны пэндзаль: пстрыкніце з Alt, каб задаць крыніцу, а затым малюйце; тэкстура крыніцы змешваецца з уласным колерам і асвятленнем месца прызначэння.
tool.heal.history.stroke = Аднаўляльны пэндзаль
