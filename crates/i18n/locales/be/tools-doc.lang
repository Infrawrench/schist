# Інструменты афармлення дакумента: мантажныя вобласці, фрагменты,
# рамкі, нататкі і лічыльнікі.

# Мантажная вобласць
tool.artboard.name = Мантажная вобласць
tool.artboard.description = Перацягваннем стварыце мантажную вобласць — найменаваную частку палатна, якая экспартуецца асобна. Перацягванне ўнутры існай вобласці перамяшчае яе.
tool.artboard.default_name = Мантажная вобласць {n}

# Фрагмент
tool.slice.name = Фрагмент
tool.slice.description = Перацягваннем стварыце фрагмент для экспарту — найменаваны прамавугольнік палатна, які экспартуецца як асобны відарыс. Перацягванне ўнутры існага фрагмента перамяшчае яго.
tool.slice.default_name = Фрагмент {n}

# Рамка
tool.frame.name = Рамка
tool.frame.description = Перацягваннем стварыце рамку — прамавугольны (або эліптычны) пласт, які маскіруе ўсё змешчанае ў ім.
tool.frame.default_name = Рамка {n}
tool.frame.choice.rectangle = Прамавугольнік
tool.frame.choice.ellipse = Эліпс
tool.frame.history.frame = Рамка

# Нататка
tool.note.name = Нататка
tool.note.description = Пстрыкніце па пустым месцы палатна, каб замацаваць там нататку з пазначанымі аўтарам і колерам са стану рэдактара; пстрыкніце па існай пазнацы, каб выбраць яе на панэлі нататак.
tool.note.history.place = Размяшчэнне нататкі
tool.note.history.move = Перамяшчэнне нататкі
tool.note.history.delete = Выдаленне нататкі

# Лічыльнік
tool.count.name = Лічыльнік
tool.count.description = Пстрыкніце, каб паставіць на палатне пранумараваную пазнаку; пстрыкніце па існай пазнацы, каб выдаліць яе.
tool.count.default_name = Лічыльнік {n}
