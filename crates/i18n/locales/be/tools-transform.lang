tool.transform.resample.bilinear = Білінейная
tool.transform.resample.bicubic = Бікубічная

# Кадраванне
tool.crop.name = Кадраванне
tool.crop.description = Перацягваннем пазначце вобласць, якую трэба пакінуць, і адрэгулюйце яе маркеры; пацвярджэнне (Enter) абразае дакумент да гэтай вобласці, а скасаванне (Escape) пакідае яго без змен.
