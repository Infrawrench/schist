# Advanced photo merge.
photo_merge_advanced.projective = Perspektiiva mielde heiveheapmi (maiddái jorahallan)
photo_merge_advanced.cylindrical = Sylindárhámát panorama
photo_merge_advanced.deghost = Váldde eret lihkadeaddji áššiid duppal govvaid (vuosttaš govva lea čujuhus)
photo_merge_advanced.focal = Fokusgaska (px) / govva govdodat (px)
photo_merge_advanced.masks = Fokusboađus geavaha rievdadhahtti geardemáskkaid. Vállje Máskka Gearddiin ja mále vai sáhtát buoridit.
photo_merge_advanced.no_match = Luohtehahtti heiveheapmi ii gávdnon. Geavat govvaid main leat olu detáljat, stuorra oktasaš oassi ja dušše unnán rievdan govvenčiegus.
photo_merge_advanced.invalid = Gáldogovat dahje ovttastahttima heivehusat eai gusto.
