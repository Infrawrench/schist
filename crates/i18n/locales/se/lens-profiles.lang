# Lens profile controls.
lens_profiles.invalid = Vállje gustojeaddji Lensfun v1/v2 XML diehtovuođu (eanemusat 8 MiB), mas leat doarjjuvvojuvvon govvenapparáhta dahje leanssa dieđut.
lens_profiles.calibration = Leanssa kalibreren
lens_profiles.no_calibration = Dáid heivehusaid várás ii leat kalibreren. Dárkkis fokusgaskka ja govvenapparáhta čuohppanfaktora; gieđain sáhttá ain divodit.
lens_profiles.import = Buvtte sisa Lensfun XML…
lens_profiles.imported = Lensfun diehtovuođđu lea buktojuvvon sisa dán bargobottus. Vállje profiilla dahje heive govva metadieđuide.
lens_profiles.manual = Dušše gieđain divodeapmi
lens_profiles.saved = Vurkejuvvon kalibreren (diehtovuođđu ii leat olámuttus)
lens_profiles.profile = Leanssa profiila
lens_profiles.aperture = Leanssa rahpan (0 = amas)
lens_profiles.distance = Fokusgaska (0 = amas)
lens_profiles.vignette = Kalibrerejuvvon vignehta
lens_profiles.color_context = Kalibrerejuvvon vignehta gáibida sisahuksejuvvon sRGB profiilla. Rievdat sRGB:i vai govva báhcá seamma ládje, ja rabas Leansadivodeami ođđasit. Jus govvapiksilat leat juo sRGB:s muhto eai leat merkejuvvon, de lea doarvái addit sidjiide sRGB profiilla. Geometriija- ja ivdnekantadivodeapmi leat ain olámuttus.
lens_profiles.vignette_missing = Ii leat vignehta kalibreren mii heive leanssa rahpamii ja fokusgaskii. Čále mihtiduvvon árvvuid vai dat doaibmá; 1000 m mearkkaša guhkkin fokusereami máŋgga Lensfun profiillas.
lens_profiles.note = Kalibrerejuvvon divodeapmi dahkko ovdal gieđain heivehusaid. Geavat olles álgoálgosaš govvarámma; čuohpa dan maŋŋá. Vurke filtarčohkiid PSD/PSB:s vai kalibrerema sáhttá ain rievdadit.
lens_profiles.automatic = Heive govva metadieđuide
lens_profiles.components = Profiilla divodeapmi: botnjama {distortion}; ivdneravddat {tca}; vignehta {vignette}.
