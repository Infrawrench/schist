lens_profiles.invalid = Qo‘llab-quvvatlanadigan kamera yoki obyektiv maʼlumotlariga ega yaroqli Lensfun v1/v2 XML bazasini tanlang (8 MiB gacha).
lens_profiles.calibration = Obyektivni kalibrlash
lens_profiles.no_calibration = Bu sozlamalarga mos kalibrlash topilmadi. Fokus masofasi va kameraning krop koeffitsiyentini tekshiring; qo‘lda tuzatish ham mavjud.
lens_profiles.import = Lensfun XML faylini import qilish…
lens_profiles.imported = Lensfun bazasi ushbu seans uchun import qilindi. Obyektiv profilini tanlang yoki surat metamaʼlumotlariga moslang.
lens_profiles.manual = Faqat qo‘lda tuzatish
lens_profiles.saved = Saqlangan kalibrlash (baza mavjud emas)
lens_profiles.profile = Obyektiv profili
lens_profiles.aperture = Diafragma (0 = nomaʼlum)
lens_profiles.distance = Fokuslash masofasi (0 = nomaʼlum)
lens_profiles.vignette = Kalibrlangan vinyetkalash
lens_profiles.color_context = Kalibrlangan vinyetkalashni tuzatish uchun ichki sRGB profili kerak. Ko‘rinishni saqlash uchun rasmni sRGB ga aylantiring, so‘ng “Obyektivni tuzatish”ni qayta oching. Piksel maʼlumotlari allaqachon sRGB bo‘lib, faqat profil belgisi bo‘lmasa, sRGB profilini tayinlash kifoya. Geometriya va xromatik xatolarni tuzatish mavjud bo‘lib qoladi.
lens_profiles.vignette_missing = Ushbu diafragma va fokuslash masofasi uchun vinyetkalash kalibrlashi yo‘q. Uni yoqish uchun o‘lchangan qiymatlarni kiriting; ko‘p Lensfun profillarida 1000 m uzoqdagi obyektga fokuslashni bildiradi.
lens_profiles.note = Kalibrlangan tuzatish qo‘lda boshqarishdan oldin qo‘llanadi. Asl to‘liq kadrdan foydalaning, keyin qirqing. Kalibrlashni tahrirlash imkoniyatini saqlash uchun filtrlar to‘plamini PSD/PSB formatida saqlang.
lens_profiles.automatic = Surat metamaʼlumotlariga moslash
lens_profiles.components = Profil bo‘yicha tuzatish: buzilish {distortion}; rangli hoshiyalar {tca}; vinyetkalash {vignette}.
