tool.bucket.name = Saani ya pentire
tool.bucket.description = Finá mpo na kotondisa etando oyo ekangani mpe ezali na langi ekokani na oyo ezali na nse ya elembo, na langi ya liboso mpe na kati ya toleransi ya esaleli.
tool.bucket.option.contiguous = Oyo ekangani
