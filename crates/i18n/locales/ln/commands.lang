command.edit.undo.title = Kozongisa nsima
command.edit.undo.description = Zongá litambe moko nsima na lisolo ya kozongisa misala ya dokima.
command.edit.redo.title = Kozongela
command.edit.redo.description = Salá lisusu mbongwana oyo eutaki kozongisama nsima.
command.edit.copy.title = Kokopia
command.edit.copy.description = Kopia bapiksele oyo eponami na kalke oyo ezali kosalelama mpe tyá yango na presse-papiers ya kati (kalke mobimba soki eloko moko te eponami).
command.edit.copy_merged.title = Kokopia oyo esangisami
command.edit.copy_merged.description = Kopia eteni eponami ndenge ba kalke nyonso oyo emonani esangisi yango, kasi uta kaka na kalke oyo ezali kosalelama te.
command.edit.cut.title = Kokata
command.edit.cut.description = Kopia bapiksele oyo eponami na presse-papiers mpe pangusá yango na kalke oyo ezali kosalelama.
command.edit.paste.title = Kokangisa
command.edit.paste.description = Kangisá makambo ya presse-papiers na kalke ya sika likoló ya oyo ezali kosalelama, na katikati ya kanvasi.
command.edit.paste.layer_name = Kalke oyo ekangisami
command.edit.paste_in_place.title = Kokangisa na esika na yango
command.edit.paste_in_place.description = Kangisá makambo ya presse-papiers na kalke ya sika na bakordonɛ oyo ekopiaki uta na yango.
command.edit.fill_foreground.title = Kotondisa na langi ya liboso
command.edit.fill_foreground.description = Tondisá eteni eponami (to kanvasi mobimba soki eloko moko te eponami) na langi ya liboso.
command.edit.fill_background.title = Kotondisa na langi ya nsima
command.edit.fill_background.description = Tondisá eteni eponami (to kanvasi mobimba soki eloko moko te eponami) na langi ya nsima.

command.select.all.title = Kopona nyonso
command.select.all.description = Poná kanvasi mobimba.
command.select.deselect.title = Kolongola boponi
command.select.deselect.description = Longolá boponi mpo mbongwana esalelama lisusu na kalke mobimba.
command.select.inverse.title = Kozongola boponi
command.select.inverse.description = Bongolá bisika ya etando eponami mpe oyo eponami te.
command.select.reselect.title = Kopona lisusu
command.select.reselect.description = Zongisá eteni eponami oyo elongolamaki mbala ya nsuka.
command.select.reselect.msg.nothing_to_reselect = Eloko ya kopona lisusu ezali te
command.select.feather.title = Koyeisa ndelo ya boponi pɛtɛɛ
command.select.feather.description = Yeisá ndelo ya boponi pɛtɛɛ na flou ya bapiksele mibale, mpo mbongwana oyo elandi esila mokemoke na ndelo yango.
command.select.grow.title = Kokólisa
command.select.grow.description = Panolá boponi na bapiksele oyo esimbani mpe ekokani na oyo esilá koponama, na kati ya toleransi ya lingenda ya maji.
command.select.similar.title = Oyo ekokani
command.select.similar.description = Poná piksele nyonso na kalke oyo ekokani na eteni eponami, ezala esimbani na yango to te, na kati ya toleransi ya lingenda ya maji.
command.select.save.title = Kobomba boponi
command.select.save.description = Bombá boponi ya sikoyo na dokima lokola shenɛ alfa oyo ezali na nkombo.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Kokɔtisa boponi
command.select.load.description = Zongisá boponi oyo ebombamaki mbala ya nsuka.

command.layer.new.title = Kalke ya sika
command.layer.new.description = Bakisá kalke raster ya mpamba likoló ya kalke oyo ezali kosalelama mpe salá ete yango nde esalelama.
command.layer.duplicate.title = Kosala kopi ya kalke
command.layer.duplicate.description = Kopia kalke oyo ezali kosalelama, ná makambo na yango nyonso, na kalke ya sika likoló na yango.
command.layer.smart_object.title = Kobongola na eloko ya mayele
command.layer.smart_object.description = Kangá bapiksele ya kalke raster oyo ezali kosalelama na kati ya eloko ya mayele, mpo mbongwana mpe ba filtre oyo ekosalema na nsima ezwa lisusu ndakisa ya liziba oyo esimbami te.
command.layer.rasterize.title = Kosala kalke raster
command.layer.rasterize.description = Bongolá kalke ya lolenge, makomi to eloko ya mayele mpo ekóma bapiksele mpamba.
command.layer.delete.title = Kolongola kalke
command.layer.delete.description = Longolá ba kalke oyo eponami.
command.layer.group.title = Kosangisa ba kalke
command.layer.group.description = Tyá ba kalke oyo eponami na etuluku ya sika, na esika na yango.
command.layer.raise.title = Komema liboso
command.layer.raise.description = Tombolá kalke oyo ezali kosalelama esika moko na molɔngɔ ya etuluku na yango.
command.layer.lower.title = Kozongisa nsima
command.layer.lower.description = Kitisá kalke oyo ezali kosalelama esika moko na molɔngɔ ya etuluku na yango.
command.layer.to_front.title = Komema mpenza liboso
command.layer.to_front.description = Memá kalke oyo ezali kosalelama na likoló ya etuluku na yango.
command.layer.to_back.title = Kotinda mpenza nsima
command.layer.to_back.description = Memá kalke oyo ezali kosalelama na nse ya etuluku na yango.
command.layer.clipping_mask.title = Kosala/Kolongola maske ya kokata
command.layer.clipping_mask.description = Katá kalke oyo ezali kosalelama na kalke ya nse na yango, to longolá yango soki esilá kokatama; kalke oyo ekatami emonanaka kaka esika liziba na yango ezali na bapiksele.
command.layer.cut_to_new.title = Kalke na nzela ya kokata
command.layer.cut_to_new.description = Longolá bapiksele oyo eponami na kalke oyo ezali kosalelama mpe tyá yango na kalke ya sika likoló na yango.
command.layer.cut_to_new.layer_name = Kalke na nzela ya kokata
command.layer.add_mask.title = Kobakisa maske ya kalke
command.layer.add_mask.description = Bakisá maske ya kalke na kalke oyo ezali kosalelama, oyo ekomonisa kaka eteni eponami soki ezali.
command.layer.flatten.title = Kosangisa elilingi
command.layer.flatten.description = Sangisá makambo nyonso oyo emonani na kalke moko ya Nsima oyo emonisaka oyo ezali na nsima te, mpe bwaká ba kalke oyo ebombami.
command.layer.merge_down.title = Kosangisa na nse
command.layer.merge_down.description = Sangisá kalke oyo ezali kosalelama na kalke ya nse na yango.
command.layer.merge_down.msg.no_layer_below = Kalke ya nse mpo na kosangisa ezali te
command.layer.merge_visible.title = Kosangisa oyo emonani
command.layer.merge_visible.description = Sangisá ba kalke nyonso oyo emonani na moko, mpe tiká ba kalke oyo ebombami ndenge ezali.

command.msg.nothing_to_copy = Poná kalke ya bapiksele oyo okopia uta na yango
command.msg.clipboard_empty = Eloko ezali na presse-papiers te

