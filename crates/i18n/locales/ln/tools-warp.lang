tool.puppet_warp.history.puppet_warp = Kopengolisa lokola pupɛ

tool.vanishing_point.name = Pwɛ ya kolimwa
tool.vanishing_point.description = Benda etando ya patatalu likoló ya eloko oyo ezali na perspektive, na nsima bongolá mode na Klonɛ mpe pakolá: bapiksele oyo ekopiami elandaka etando yango mpe ekómaka mike ntango ntaka ezali kobakisama.
