tool.eyedropper.name = Pipɛti
tool.eyedropper.description = Zwá ndakisa ya langi oyo ezali na nse ya elembo mpe tyá yango na langi ya liboso, to na langi ya nsima soki osimbi alt. Soki ozali kobenda, ndakisa ya langi ekobaka kozwama.
