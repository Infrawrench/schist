tool.move.name = Kotambolisa
tool.move.description = Benda makambo ya kalke oyo eponami mpe ezali kosalelama mpo na komema yango na esika ya sika. Soki Opona-Yango-Moko efungwami, esika ofini eponaka liboso kalke moko boye — to etuluku mobimba — oyo ezali na nse ya elembo.
