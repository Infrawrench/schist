# Lens profiles.
lens_profiles.invalid = Valige kehtiv Lensfun v1/v2 XML andmebaas (kuni 8 MiB) koos toetatud kaamera või objektiivi andmetega.
lens_profiles.calibration = Objektiivi kalibreerimine
lens_profiles.no_calibration = Ükski kalibreerimine ei hõlma neid seadistusi. Kontrollige fookuskaugust ja kaamera kärpimistegurit; käsitsi korrigeerimine jääb kättesaadavaks.
lens_profiles.import = Impordi Lensfun XML…
lens_profiles.imported = Selle seansi jaoks imporditud andmebaas Lensfun. Valige profiil või sobitage foto metaandmetega.
lens_profiles.manual = Ainult käsitsi korrigeerimine
lens_profiles.saved = Salvestatud kalibreerimine (andmebaas pole saadaval)
lens_profiles.profile = Objektiivi profiil
lens_profiles.aperture = Ava (0 = teadmata)
lens_profiles.distance = Fookuskaugus (0 = teadmata)
lens_profiles.vignette = Kalibreeritud vinjeteerimine
lens_profiles.color_context = Kalibreeritud vinjeteerimiseks on vaja sisseehitatud sRGB profiili. Välimuse säilitamiseks teisendage vorminguks sRGB, seejärel avage uuesti Objektiivi korrigeerimine. Juba sRGB märgistamata pikslite puhul piisab sRGB määramisest. Geomeetria ja kromaatiline korrektsioon jäävad kättesaadavaks.
lens_profiles.vignette_missing = Ükski vinjeteerimise kalibreerimine ei kata ava ja teravustamiskaugust. Selle lubamiseks sisestage mõõdetud väärtused; 1000 m esindab paljudes Lensfun profiilides kauget fookust.
lens_profiles.note = Kalibreeritud parandus jookseb enne käsitsijuhtimisseadmeid. Kasutage kogu algset pilti; seejärel kärpige. Redigeeritava kalibreerimise säilitamiseks salvestage PSD/PSB filtrivirn.
lens_profiles.automatic = Sobitage foto metaandmed
lens_profiles.components = Profiili pass: moonutus {distortion}; värvi narmad {tca}; vinjeteerimine {vignette}.
