photo_merge.focus = Фотоларны төрле фокус дистанцияләре белән берләштерегез
photo_merge.hdr = Берничә экспозиция дәрәҗәсеннән HDR
photo_merge.panorama = Фотоларны панорамага берләштерегез
photo_merge.translation = Горизонталь һәм вертикаль сурәт хәрәкәте (X / Y); әйләнү яки перспектив коррекция юк.
photo_merge.crop = Уртак мәйданга чәчү
photo_merge.exposure_note = Photoәрбер фотосурәтнең чагыштырмача экспозициясен куегыз: +1 ЕВ ике тапкыр күбрәк яктылык дигәнне аңлата. 32 битлы HDR-ны саклау өчен рәсем тон картасын сүндерегез.
photo_merge.tone_map = Рәсем тоны картасы
