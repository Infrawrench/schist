photo_merge_advanced.projective = Перспектива буенча тигезләү (бору белән)
photo_merge_advanced.cylindrical = Цилиндрлы панорама
photo_merge_advanced.deghost = Хәрәкәт итүче объектның икеләнгән эзен бетерү (беренче фото үрнәк булып тора)
photo_merge_advanced.focal = Фокус ераклыгы (px) / рәсем киңлеге (px)
photo_merge_advanced.masks = Фокусны берләштерү нәтиҗәсе үзгәртелә торган катлам битлекләрен куллана. Катламнарда битлекне сайлап, төгәлләү өчен буягыз.
photo_merge_advanced.no_match = Ышанычлы тигезләү табылмады. Детальләре ачык, җитәрлек дәрәҗәдә каплашкан һәм караш ноктасы аз үзгәргән фотоларны кулланыгыз.
photo_merge_advanced.invalid = Чыганак рәсемнәр яки берләштерү көйләүләре яраксыз.
