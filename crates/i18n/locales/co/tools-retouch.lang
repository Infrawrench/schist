tool.patch.choice.source = Surghjente
tool.patch.choice.destination = Destinazione
tool.patch.history.patch = Pezza

tool.content_aware_move.name = Spustamentu sensibile à u cuntenutu
tool.content_aware_move.description = Trascinate un ogettu selezziunatu altrò è u biotu ch'ellu lascia hè empiutu à partesi da ciò chì l'ingira. In modu Stende, l'ogettu hè stesu invece d'esse spustatu.
tool.content_aware_move.choice.move = Spustà
tool.content_aware_move.choice.extend = Stende
tool.content_aware_move.history.move = Spustamentu sensibile à u cuntenutu

tool.red_eye.name = Ochji rossi
tool.red_eye.description = Cliccate nant'à una pupilla per caccialli u rossu di u lampu.
