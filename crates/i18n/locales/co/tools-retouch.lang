tool.red_eye.option.darken = Scurisce
tool.red_eye.history.red_eye = Ochji rossi

tool.magic_eraser.name = Sguassaghjola magica
tool.magic_eraser.description = Cliccate per sguassà a zona di culore simile sottu à u puntatore, secondu a tullerenza di l'attrazzu — sia quella cunfinante cù u puntu cliccatu, sia tutte e zone simile di u stratu.
