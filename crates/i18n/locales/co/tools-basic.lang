tool.eyedropper.choice.average_3 = Media 3 per 3
tool.eyedropper.choice.average_5 = Media 5 per 5
tool.eyedropper.choice.average_11 = Media 11 per 11
tool.eyedropper.choice.average_31 = Media 31 per 31
tool.eyedropper.choice.all_layers = Tutti i strati
tool.eyedropper.choice.current_layer = Stratu attuale

tool.hand.name = Manu
tool.hand.description = Face scorre a vista. A zona di visualizazione appartene à a finestra, dunque senza interfaccia st'attrazzu ùn face nunda à u ducumentu.
tool.zoom.name = Zoom
tool.zoom.description = Ingrandisce o riduce a vista. A zona di visualizazione appartene à a finestra, dunque senza interfaccia st'attrazzu ùn face nunda à u ducumentu.
