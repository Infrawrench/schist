# Attrazzi di basa: Spustà, Pipetta, Manu è Zoom.

tool.move.name = Spustà
tool.move.description = Trascinate u cuntenutu di u stratu attivu in una pusizione nova. Cù Selezzione automatica attivata, quandu appughjate hè sceltu prima u stratu — o u gruppu sanu — chì si trova sottu à u puntatore.
tool.move.option.auto_select = Selezzione automatica
tool.move.history.move_layer = Spustà u stratu

tool.eyedropper.name = Pipetta
tool.eyedropper.description = Pigliate u culore sottu à u puntatore cum'è culore di primu pianu, o cum'è culore di fondu quandu alt hè tenutu appughjatu. Mentre trascinate, u prelevu cuntinueghja.
