# HEIC security update.
codec.heif.msg.unsafe_version = അറിയപ്പെടുന്ന സുരക്ഷാ ദൗർബല്യങ്ങൾ കാരണം libheif {version} ഉപയോഗിക്കുന്നത് നിരസിക്കുന്നു; {minimum} പതിപ്പോ അതിനുശേഷമുള്ള പതിപ്പോ ആവശ്യമാണ്. പുതുക്കിയ HEIC പിന്തുണ ഡൗൺലോഡ് ചെയ്യുക അല്ലെങ്കിൽ സിസ്റ്റം ലൈബ്രറി പുതുക്കുക.
codec.heif.msg.unknown_version = പതിപ്പ് സ്ഥിരീകരിക്കാൻ കഴിയാത്തതിനാൽ libheif ഉപയോഗിക്കുന്നത് നിരസിക്കുന്നു; {minimum} പതിപ്പോ അതിനുശേഷമുള്ള പതിപ്പോ ആവശ്യമാണ്. പുതുക്കിയ HEIC പിന്തുണ ഡൗൺലോഡ് ചെയ്യുക അല്ലെങ്കിൽ സിസ്റ്റം ലൈബ്രറി പുതുക്കുക.
dialog.open.heic_needs_safe_decoder = “{name}” തുറക്കാൻ HEVC ഡീകോഡറോടുകൂടിയ libheif {minimum} പതിപ്പോ അതിനുശേഷമുള്ള പതിപ്പോ ആവശ്യമാണ്. അറിയപ്പെടുന്ന സുരക്ഷാ ദൗർബല്യങ്ങളിൽനിന്ന് സംരക്ഷിക്കാൻ പഴയതോ സ്ഥിരീകരിക്കാൻ കഴിയാത്തതോ ആയ പതിപ്പുകൾ തടഞ്ഞിരിക്കുന്നു. തുടരാൻ പുതുക്കിയ HEIC പിന്തുണ ഡൗൺലോഡ് ചെയ്യുക.
