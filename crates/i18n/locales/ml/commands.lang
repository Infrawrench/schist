# Edit
command.edit.undo.title = പഴയപടിയാക്കുക
command.edit.undo.description = ഡോക്യുമെന്റിന്റെ പഴയപടിയാക്കൽ ചരിത്രത്തിൽ ഒരു ഘട്ടം പിന്നോട്ടുപോകുക.
command.edit.redo.title = വീണ്ടും ചെയ്യുക
command.edit.redo.description = അവസാനം പഴയപടിയാക്കിയ തിരുത്തൽ വീണ്ടും ചെയ്യുക.
command.edit.copy.title = പകർത്തുക
command.edit.copy.description = സജീവ ലെയറിൽ തിരഞ്ഞെടുത്ത പിക്സലുകൾ ആഭ്യന്തര ക്ലിപ്പ്ബോർഡിലേക്കു പകർത്തുക (ഒന്നും തിരഞ്ഞെടുത്തിട്ടില്ലെങ്കിൽ മുഴുവൻ ലെയറും).
command.edit.copy_merged.title = ലയിപ്പിച്ചത് പകർത്തുക
command.edit.copy_merged.description = സജീവ ലെയറിൽനിന്നു മാത്രം എടുക്കാതെ, ദൃശ്യമായ എല്ലാ ലെയറുകളും ചേർന്ന് കാണിക്കുന്ന രീതിയിൽ തിരഞ്ഞെടുപ്പ് പകർത്തുക.
command.edit.cut.title = മുറിക്കുക
command.edit.cut.description = തിരഞ്ഞെടുത്ത പിക്സലുകൾ ക്ലിപ്പ്ബോർഡിലേക്കു പകർത്തി സജീവ ലെയറിൽനിന്ന് മായ്ക്കുക.
command.edit.paste.title = ഒട്ടിക്കുക
command.edit.paste.description = ക്ലിപ്പ്ബോർഡിലെ ഉള്ളടക്കം സജീവ ലെയറിനു മുകളിൽ പുതിയ ലെയറായി, ക്യാൻവാസിന്റെ മധ്യത്തിൽ ഒട്ടിക്കുക.
command.edit.paste.layer_name = ഒട്ടിച്ച ലെയർ
command.edit.paste_in_place.title = അതേ സ്ഥാനത്ത് ഒട്ടിക്കുക
command.edit.paste_in_place.description = പകർത്തിയ അതേ കോഓർഡിനേറ്റുകളിൽ ക്ലിപ്പ്ബോർഡിലെ ഉള്ളടക്കം പുതിയ ലെയറായി ഒട്ടിക്കുക.
command.edit.fill_foreground.title = മുൻഭാഗ വർണ്ണംകൊണ്ട് നിറയ്ക്കുക
command.edit.fill_foreground.description = തിരഞ്ഞെടുപ്പ് മുൻഭാഗ വർണ്ണംകൊണ്ട് നിറയ്ക്കുക (ഒന്നും തിരഞ്ഞെടുത്തിട്ടില്ലെങ്കിൽ മുഴുവൻ ക്യാൻവാസും).
command.edit.fill_background.title = പശ്ചാത്തല വർണ്ണംകൊണ്ട് നിറയ്ക്കുക
command.edit.fill_background.description = തിരഞ്ഞെടുപ്പ് പശ്ചാത്തല വർണ്ണംകൊണ്ട് നിറയ്ക്കുക (ഒന്നും തിരഞ്ഞെടുത്തിട്ടില്ലെങ്കിൽ മുഴുവൻ ക്യാൻവാസും).

# Select
command.select.all.title = എല്ലാം തിരഞ്ഞെടുക്കുക
command.select.all.description = മുഴുവൻ ക്യാൻവാസും തിരഞ്ഞെടുക്കുക.
command.select.deselect.title = തിരഞ്ഞെടുപ്പ് ഒഴിവാക്കുക
command.select.deselect.description = തിരഞ്ഞെടുപ്പ് ഒഴിവാക്കി തിരുത്തലുകൾ വീണ്ടും മുഴുവൻ ലെയറിലും പ്രയോഗിക്കാനാക്കുക.
command.select.inverse.title = വിപരീതഭാഗം തിരഞ്ഞെടുക്കുക
command.select.inverse.description = തിരഞ്ഞെടുത്തതും തിരഞ്ഞെടുക്കാത്തതുമായ പ്രദേശങ്ങൾ പരസ്പരം മാറ്റുക.
command.select.reselect.title = വീണ്ടും തിരഞ്ഞെടുക്കുക
command.select.reselect.description = അവസാനം ഒഴിവാക്കിയ തിരഞ്ഞെടുപ്പ് തിരികെ കൊണ്ടുവരുക.
command.select.reselect.msg.nothing_to_reselect = വീണ്ടും തിരഞ്ഞെടുക്കാൻ ഒന്നുമില്ല
command.select.feather.title = തിരഞ്ഞെടുപ്പിന്റെ അരികു മൃദുവാക്കുക
command.select.feather.description = തിരഞ്ഞെടുപ്പിന്റെ അരിക് രണ്ടു പിക്സൽ മങ്ങലിലൂടെ മൃദുവാക്കി അടുത്ത തിരുത്തൽ അരികിലൂടെ ക്രമേണ മങ്ങിപ്പോകാനാക്കുക.
command.select.grow.title = വികസിപ്പിക്കുക
command.select.grow.description = മാന്ത്രിക ദണ്ഡിന്റെ സഹിഷ്ണുതയ്ക്കുള്ളിൽ, ഇതിനകം തിരഞ്ഞെടുത്തവയോട് സാമ്യമുള്ള തൊട്ടുകിടക്കുന്ന പിക്സലുകളിലേക്കു തിരഞ്ഞെടുപ്പ് വികസിപ്പിക്കുക.
command.select.similar.title = സമാനമായവ
command.select.similar.description = മാന്ത്രിക ദണ്ഡിന്റെ സഹിഷ്ണുതയ്ക്കുള്ളിൽ, തിരഞ്ഞെടുപ്പിനോട് സാമ്യമുള്ള ലെയറിലെ എല്ലാ പിക്സലുകളും—തൊട്ടുകിടന്നാലും ഇല്ലെങ്കിലും—തിരഞ്ഞെടുക്കുക.
command.select.save.title = തിരഞ്ഞെടുപ്പ് സംരക്ഷിക്കുക
command.select.save.description = നിലവിലെ തിരഞ്ഞെടുപ്പ് ഡോക്യുമെന്റിൽ പേരുള്ള ആൽഫ ചാനലായി സൂക്ഷിക്കുക.
command.select.save.channel_name = ആൽഫ {n}
command.select.load.title = തിരഞ്ഞെടുപ്പ് ലോഡ് ചെയ്യുക
command.select.load.description = ഏറ്റവും ഒടുവിൽ സംരക്ഷിച്ച തിരഞ്ഞെടുപ്പ് പുനഃസ്ഥാപിക്കുക.

# Layer
command.layer.new.title = പുതിയ ലെയർ
command.layer.new.description = സജീവ ലെയറിനു മുകളിൽ ഒഴിഞ്ഞ റാസ്റ്റർ ലെയർ ചേർത്ത് അതിനെ സജീവമാക്കുക.
command.layer.duplicate.title = ലെയർ പകർപ്പെടുത്തുക
command.layer.duplicate.description = സജീവ ലെയറിനെ അതിലെ മുഴുവൻ ഉള്ളടക്കത്തോടെയും അതിനു മുകളിലുള്ള പുതിയ ലെയറിലേക്കു പകർത്തുക.
command.layer.smart_object.title = സ്മാർട്ട് ഒബ്ജക്റ്റാക്കി മാറ്റുക
command.layer.smart_object.description = സജീവ റാസ്റ്റർ ലെയറിലെ പിക്സലുകൾ സ്മാർട്ട് ഒബ്ജക്റ്റിൽ പൊതിയുക; പിന്നീടുള്ള രൂപാന്തരങ്ങളും ഫിൽട്ടറുകളും മാറ്റമില്ലാത്ത ഉറവിടത്തിൽനിന്ന് പുനഃസാമ്പിൾ ചെയ്യും.
command.layer.rasterize.title = ലെയർ റാസ്റ്ററൈസ് ചെയ്യുക
command.layer.rasterize.description = ആകൃതി, എഴുത്ത്, അല്ലെങ്കിൽ സ്മാർട്ട് ഒബ്ജക്റ്റ് ലെയറിനെ സാധാരണ പിക്സലുകളാക്കി ഉറപ്പിക്കുക.
command.layer.delete.title = ലെയർ ഇല്ലാതാക്കുക
command.layer.delete.description = തിരഞ്ഞെടുത്ത ലെയറുകൾ ഇല്ലാതാക്കുക.
command.layer.group.title = ലെയറുകൾ ഗ്രൂപ്പാക്കുക
command.layer.group.description = തിരഞ്ഞെടുത്ത ലെയറുകളെ അതേ സ്ഥാനത്ത് പുതിയ ഗ്രൂപ്പിൽ പൊതിയുക.
command.layer.raise.title = മുന്നോട്ടു കൊണ്ടുവരുക
command.layer.raise.description = സജീവ ലെയറിനെ അതിന്റെ ഗ്രൂപ്പ് സ്റ്റാക്കിൽ ഒരു സ്ഥാനം മുകളിലേക്കു നീക്കുക.
command.layer.lower.title = പിന്നോട്ടയയ്ക്കുക
command.layer.lower.description = സജീവ ലെയറിനെ അതിന്റെ ഗ്രൂപ്പ് സ്റ്റാക്കിൽ ഒരു സ്ഥാനം താഴേക്കു നീക്കുക.
command.layer.to_front.title = ഏറ്റവും മുന്നിലേക്കു കൊണ്ടുവരുക
command.layer.to_front.description = സജീവ ലെയറിനെ അതിന്റെ ഗ്രൂപ്പിന്റെ മുകളിലേക്കു നീക്കുക.
command.layer.to_back.title = ഏറ്റവും പിന്നിലേക്കയയ്ക്കുക
command.layer.to_back.description = സജീവ ലെയറിനെ അതിന്റെ ഗ്രൂപ്പിന്റെ അടിയിലേക്കു നീക്കുക.
command.layer.clipping_mask.title = ക്ലിപ്പിങ് മാസ്ക് സൃഷ്ടിക്കുക/ഒഴിവാക്കുക
command.layer.clipping_mask.description = സജീവ ലെയറിനെ അതിനു താഴെയുള്ള ലെയറിലേക്കു ക്ലിപ്പ് ചെയ്യുക, അല്ലെങ്കിൽ ഇതിനകം ക്ലിപ്പ് ചെയ്തതാണെങ്കിൽ വിടുവിക്കുക; അടിസ്ഥാന ലെയറിൽ പിക്സലുകളുള്ളിടത്തു മാത്രമേ ക്ലിപ്പ് ചെയ്ത ലെയർ കാണൂ.
command.layer.cut_to_new.title = മുറിച്ച് പുതിയ ലെയറാക്കുക
command.layer.cut_to_new.description = തിരഞ്ഞെടുത്ത പിക്സലുകൾ സജീവ ലെയറിൽനിന്നു മാറ്റി അതിനു മുകളിലുള്ള പുതിയ ലെയറിലാക്കുക.
command.layer.cut_to_new.layer_name = മുറിച്ചെടുത്ത ലെയർ
command.layer.add_mask.title = ലെയർ മാസ്ക് ചേർക്കുക
command.layer.add_mask.description = സജീവ ലെയറിലേക്കു ലെയർ മാസ്ക് ചേർക്കുക; തിരഞ്ഞെടുപ്പ് ഉണ്ടെങ്കിൽ അതു മാത്രം വെളിപ്പെടുത്തുക.
command.layer.flatten.title = ചിത്രം പരത്തുക
command.layer.flatten.description = ദൃശ്യമായ എല്ലാം അതാര്യമായ ഒരൊറ്റ പശ്ചാത്തല ലെയറാക്കി സംയോജിപ്പിച്ച് മറഞ്ഞ ലെയറുകൾ ഉപേക്ഷിക്കുക.
command.layer.merge_down.title = താഴേക്ക് ലയിപ്പിക്കുക
command.layer.merge_down.description = സജീവ ലെയറിനെ അതിനു താഴെയുള്ള ലെയറുമായി സംയോജിപ്പിക്കുക.
command.layer.merge_down.msg.no_layer_below = ലയിപ്പിക്കാൻ താഴെ ലെയറില്ല
command.layer.merge_visible.title = ദൃശ്യമായവ ലയിപ്പിക്കുക
command.layer.merge_visible.description = ദൃശ്യമായ എല്ലാ ലെയറുകളും ഒന്നാക്കി സംയോജിപ്പിച്ച് മറഞ്ഞ ലെയറുകൾ മാറ്റമില്ലാതെ വിടുക.

command.msg.nothing_to_copy = പകർത്താൻ ഒരു പിക്സൽ ലെയർ തിരഞ്ഞെടുക്കുക
command.msg.clipboard_empty = ക്ലിപ്പ്ബോർഡിൽ ഒന്നുമില്ല

