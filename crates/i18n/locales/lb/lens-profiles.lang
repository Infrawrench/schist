# Lens profiles.
lens_profiles.invalid = Wielt eng valabel Lensfun v1/v2 XML Datebank (bis zu 8 MiB) mat ënnerstëtzt Kamera oder Lens Daten.
lens_profiles.calibration = Lens Eechung
lens_profiles.no_calibration = Keng Eechung deckt dës Astellungen. Kontrolléiert Brennwäit a Kamera Crop Faktor; manuell Korrektur bleift verfügbar.
lens_profiles.import = Lensfun XML importéieren…
lens_profiles.imported = Lensfun Datebank fir dës Sessioun importéiert. Wielt e Profil oder passt d'Fotometadaten.
lens_profiles.manual = Nëmme manuell Korrektur
lens_profiles.saved = Gespäichert Kalibrierung (Datebank net verfügbar)
lens_profiles.profile = Lens Profil
lens_profiles.aperture = Aperture (0 = onbekannt)
lens_profiles.distance = Fokusdistanz (0 = onbekannt)
lens_profiles.vignette = Kalibréiert Vignette
lens_profiles.color_context = Kalibréiert Vignette erfuerdert den agebaute sRGB Profil. Konvertéiert op sRGB fir d'Erscheinung ze bewahren, da öffnen d'Objektivkorrektur nei. Fir scho sRGB ontagged Pixelen ass sRGB ze ginn genuch. Geometrie a chromatesch Korrektur bleiwen verfügbar.
lens_profiles.vignette_missing = Keng Vignettéierungskalibratioun deckt d'Ouverture an d'Fokusdistanz. Gitt gemoossene Wäerter fir et z'aktivéieren; 1000 m representéiert wäitem Fokus a ville Lensfun Profiler.
lens_profiles.note = Kalibréiert Korrektur leeft virun de manuelle Kontrollen. Benotzt d'Original voll Frame; schneit duerno zou. Späichert e Filterstack am PSD/PSB fir editéierbar Kalibratioun ze behalen.
lens_profiles.automatic = Match Foto Metadaten
lens_profiles.components = Profilpass: Verzerrung {distortion}; Faarffrënn {tca}; vignette {vignette}.
