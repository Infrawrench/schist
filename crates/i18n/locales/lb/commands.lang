command.edit.undo.title = Réckgängeg maachen
command.edit.undo.description = Geet ee Schrëtt am Réckgängeg-Verlaf vum Dokument zeréck.
command.edit.redo.title = Widderhuelen
command.edit.redo.description = Widderhëlt déi Ännerung, déi fir d'lescht réckgängeg gemaach gouf.
command.edit.copy.title = Kopéieren
command.edit.copy.description = Kopéiert déi ausgewielt Pixel vun der aktiver Eben an den interne Tëschespäicher (déi ganz Eben, wa näischt ausgewielt ass).
command.edit.copy_merged.title = Zesummegefouert kopéieren
command.edit.copy_merged.description = Kopéiert d'Auswiel esou, wéi all siichtbar Ebenen zesummegesat sinn, amplaz nëmmen aus der aktiver Eben.
command.edit.cut.title = Ausschneiden
command.edit.cut.description = Kopéiert déi ausgewielt Pixel an den Tëschespäicher a läscht se aus der aktiver Eben.
command.edit.paste.title = Asetzen
command.edit.paste.description = Setzt den Tëschespäicher an eng nei Eben iwwer der aktiver an, zentréiert um Canvas.
command.edit.paste.layer_name = Agesaten Eben
command.edit.paste_in_place.title = Op der selwechter Plaz asetzen
command.edit.paste_in_place.description = Setzt den Tëschespäicher an eng nei Eben op de Koordinaten an, vun deenen e kopéiert gouf.
command.edit.fill_foreground.title = Mat Virdergrond fëllen
command.edit.fill_foreground.description = Fëllt d'Auswiel (oder de ganze Canvas, wa näischt ausgewielt ass) mat der Virdergrondfaarf.
command.edit.fill_background.title = Mat Hannergrond fëllen
command.edit.fill_background.description = Fëllt d'Auswiel (oder de ganze Canvas, wa näischt ausgewielt ass) mat der Hannergrondfaarf.

command.select.all.title = Alles auswielen
command.select.all.description = Wielt de ganze Canvas aus.
command.select.deselect.title = Auswiel ophiewen
command.select.deselect.description = Hieft d'Auswiel op, sou datt Ännerungen erëm op déi ganz Eben ugewannt ginn.
command.select.inverse.title = Auswiel ëmdréinen
command.select.inverse.description = Tauscht ausgewielt an net ausgewielt Beräicher.
command.select.reselect.title = Nach eng Kéier auswielen
command.select.reselect.description = Stellt déi fir d'lescht opgehuewen Auswiel erëm hier.
command.select.reselect.msg.nothing_to_reselect = Näischt fir nach eng Kéier auszewielen
command.select.feather.title = Auswiel mëll maachen
command.select.feather.description = Mécht de Rand vun der Auswiel mat enger Onschäerft vun zwee Pixel méi mëll, sou datt déi nächst Ännerung iwwer dëse Rand ausblennt.
command.select.grow.title = Vergréisseren
command.select.grow.description = Erweidert d'Auswiel op ugrenzend Pixel, déi de schonn ausgewielten änelen, bannent der Toleranz vum Zauberstaaf.
command.select.similar.title = Änlech
command.select.similar.description = Wielt all Pixel vun der Eben aus, déi der Auswiel änelen, egal ob se dru grenzen, bannent der Toleranz vum Zauberstaaf.
command.select.save.title = Auswiel späicheren
command.select.save.description = Späichert déi aktuell Auswiel als benannten Alpha-Kanal am Dokument.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Auswiel lueden
command.select.load.description = Stellt déi fir d'lescht gespäichert Auswiel erëm hier.

command.layer.new.title = Nei Eben
command.layer.new.description = Setzt eng eidel Rastereben iwwer déi aktiv Eben a mécht se aktiv.
command.layer.duplicate.title = Eben duplizéieren
command.layer.duplicate.description = Kopéiert déi aktiv Eben mat hirem ganzen Inhalt an eng nei Eben driwwer.
command.layer.smart_object.title = A Smartobjekt ëmwandelen
command.layer.smart_object.description = Leet d'Pixel vun der aktiver Rastereben an e Smartobjekt, sou datt spéider Transformatiounen a Filteren déi onverännert Quell nei oftaaschten.
command.layer.rasterize.title = Eben rasteriséieren
command.layer.rasterize.description = Wandelt eng Form-, Text- oder Smartobjekteben a gewéinlech Pixel ëm.
command.layer.delete.title = Eben läschen
command.layer.delete.description = Läscht déi ausgewielt Ebenen.
command.layer.group.title = Ebene gruppéieren
command.layer.group.description = Leet déi ausgewielt Ebenen op der selwechter Plaz an en neie Grupp.
command.layer.raise.title = No vir réckelen
command.layer.raise.description = Réckelt déi aktiv Eben ëm eng Plaz am Stapel vun hirem Grupp no uewen.
command.layer.lower.title = No hanne réckelen
command.layer.lower.description = Réckelt déi aktiv Eben ëm eng Plaz am Stapel vun hirem Grupp no ënnen.
command.layer.to_front.title = Ganz no vir
command.layer.to_front.description = Réckelt déi aktiv Eben ganz no uewen an hirem Grupp.
command.layer.to_back.title = Ganz no hannen
command.layer.to_back.description = Réckelt déi aktiv Eben ganz no ënnen an hirem Grupp.
command.layer.clipping_mask.title = Clippingmask erstellen/fräiginn
command.layer.clipping_mask.description = Beschneit déi aktiv Eben un där drënner oder gëtt se fräi, wa se scho beschnidden ass; eng beschnidden Eben erschéngt nëmmen do, wou hir Basis Pixel huet.
command.layer.cut_to_new.title = Eben duerch Ausschneiden
command.layer.cut_to_new.description = Réckelt déi ausgewielt Pixel aus der aktiver Eben an eng nei Eben driwwer.
command.layer.cut_to_new.layer_name = Eben duerch Ausschneiden
command.layer.add_mask.title = Ebenemask dobäisetzen
command.layer.add_mask.description = Setzt eng Ebenemask bei déi aktiv Eben dobäi, déi nëmmen d'Auswiel weist, wann eng besteet.
command.layer.flatten.title = Bild zesummeféieren
command.layer.flatten.description = Setzt alles Siichtbart an enger eenzeger deckender Hannergrondeben zesummen a verwërft verstoppt Ebenen.
command.layer.merge_down.title = No ënne zesummeféieren
command.layer.merge_down.description = Setzt déi aktiv Eben mat där direkt drënner zesummen.
command.layer.merge_down.msg.no_layer_below = Keng Eben drënner fir zesummenzeféieren
command.layer.merge_visible.title = Siichtbart zesummeféieren
command.layer.merge_visible.description = Setzt all siichtbar Ebenen zu enger zesummen a léisst verstoppt Ebenen onverännert.

command.msg.nothing_to_copy = Wielt eng Pixeleben aus, vun där kopéiert gëtt
command.msg.clipboard_empty = Näischt am Tëschespäicher

