# Virtual copies.
variants.create = Erstellt virtuell Kopie ...
variants.rename = Virtuell Kopie ëmbenennen ...
variants.delete = Läschen virtuell Kopie
variants.close = Zoumaachen dës Foto a seng virtuell Kopien ier se réckelen oder läschen.
variants.saved_hint = D'Kopie fänkt vun der gespäicherter Ännerung un, oder dem Original wann et keng Ännerung gëtt. Späicheren amgaang Ännerungen als éischt.
