# Kommandoer for redigering, markering og lag.
command.edit.undo.title = Angre
command.edit.undo.description = Gå ett trinn tilbake i dokumentets angrehistorikk.
command.edit.redo.title = Gjør om
command.edit.redo.description = Gjenta redigeringen som sist ble angret.
command.edit.copy.title = Kopier
command.edit.copy.description = Kopier de markerte bildepunktene i det aktive laget til den interne utklippstavlen (hele laget når ingenting er markert).
command.edit.copy_merged.title = Kopier sammenslått
command.edit.copy_merged.description = Kopier markeringen slik alle synlige lag settes sammen, i stedet for bare fra det aktive laget.
command.edit.cut.title = Klipp ut
command.edit.cut.description = Kopier de markerte bildepunktene til utklippstavlen og slett dem fra det aktive laget.
command.edit.paste.title = Lim inn
command.edit.paste.description = Lim inn utklippstavlen i et nytt lag over det aktive laget, midtstilt på lerretet.
command.edit.paste.layer_name = Innlimt lag
command.edit.paste_in_place.title = Lim inn på samme sted
command.edit.paste_in_place.description = Lim inn utklippstavlen i et nytt lag ved koordinatene den ble kopiert fra.
command.edit.fill_foreground.title = Fyll med forgrunnsfarge
command.edit.fill_foreground.description = Fyll markeringen (eller hele lerretet når ingenting er markert) med forgrunnsfargen.
command.edit.fill_background.title = Fyll med bakgrunnsfarge
command.edit.fill_background.description = Fyll markeringen (eller hele lerretet når ingenting er markert) med bakgrunnsfargen.
command.select.all.title = Marker alt
command.select.all.description = Marker hele lerretet.
command.select.deselect.title = Opphev markering
command.select.deselect.description = Fjern markeringen, slik at redigeringer igjen gjelder hele laget.
command.select.inverse.title = Inverter markering
command.select.inverse.description = Bytt om på markerte og umarkerte områder.
command.select.reselect.title = Marker på nytt
command.select.reselect.description = Gjenopprett markeringen som sist ble fjernet.
command.select.reselect.msg.nothing_to_reselect = Ingen markering å gjenopprette
command.select.feather.title = Ton ut markering
command.select.feather.description = Myk opp kanten av markeringen med to bildepunkters uskarphet, slik at neste redigering tones ut over kanten.
command.select.grow.title = Øk
command.select.grow.description = Utvid markeringen til tilstøtende bildepunkter som ligner på det som allerede er markert, innenfor tryllestavens toleranse.
command.select.similar.title = Lignende
command.select.similar.description = Marker alle bildepunkter i laget som ligner markeringen, enten de berører den eller ikke, innenfor tryllestavens toleranse.
command.select.save.title = Lagre markering
command.select.save.description = Lagre den gjeldende markeringen i dokumentet som en navngitt alfakanal.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Last inn markering
command.select.load.description = Gjenopprett markeringen som sist ble lagret.
command.layer.new.title = Nytt lag
command.layer.new.description = Legg til et tomt rasterlag over det aktive laget og gjør det aktivt.
command.layer.duplicate.title = Dupliser lag
command.layer.duplicate.description = Kopier hele det aktive laget til et nytt lag over det.
command.layer.smart_object.title = Konverter til smartobjekt
command.layer.smart_object.description = Pakk bildepunktene i det aktive rasterlaget inn i et smartobjekt, slik at senere transformeringer og filtre beregnes fra den urørte kilden.
command.layer.rasterize.title = Rasteriser lag
command.layer.rasterize.description = Gjør et form-, tekst- eller smartobjektlag om til vanlige bildepunkter.
command.layer.delete.title = Slett lag
command.layer.delete.description = Slett de markerte lagene.
command.layer.group.title = Grupper lag
command.layer.group.description = Legg de markerte lagene i en ny gruppe på samme sted.
command.layer.raise.title = Flytt fremover
command.layer.raise.description = Flytt det aktive laget ett trinn opp i gruppens stabel.
command.layer.lower.title = Flytt bakover
command.layer.lower.description = Flytt det aktive laget ett trinn ned i gruppens stabel.
command.layer.to_front.title = Flytt fremst
command.layer.to_front.description = Flytt det aktive laget øverst i gruppen.
command.layer.to_back.title = Flytt bakerst
command.layer.to_back.description = Flytt det aktive laget nederst i gruppen.
command.layer.clipping_mask.title = Opprett/frigjør klippemaske
command.layer.clipping_mask.description = Klipp det aktive laget til laget under, eller frigjør det hvis det allerede er klippet. Et klippet lag vises bare der grunnlaget har bildepunkter.
command.layer.cut_to_new.title = Lag via utklipp
command.layer.cut_to_new.description = Flytt de markerte bildepunktene ut av det aktive laget og til et nytt lag over det.
command.layer.cut_to_new.layer_name = Lag via utklipp
command.layer.add_mask.title = Legg til lagmaske
command.layer.add_mask.description = Legg til en lagmaske i det aktive laget som bare viser markeringen når det finnes en.
command.layer.flatten.title = Slå sammen bilde
command.layer.flatten.description = Sett sammen alt synlig til ett ugjennomsiktig bakgrunnslag, og forkast skjulte lag.
command.layer.merge_down.title = Slå sammen nedover
command.layer.merge_down.description = Sett det aktive laget sammen med laget under.
command.layer.merge_down.msg.no_layer_below = Ingen lag under å slå sammen med
command.layer.merge_visible.title = Slå sammen synlige
command.layer.merge_visible.description = Sett alle synlige lag sammen til ett, og la skjulte lag være urørt.
command.msg.nothing_to_copy = Velg et bildepunktlag å kopiere fra
command.msg.clipboard_empty = Ingenting på utklippstavlen
