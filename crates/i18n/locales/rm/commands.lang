# Cumonds da modificaziun, selecziun e stresas.
command.edit.undo.title = Revocar
command.edit.undo.description = Turnar in pass enavos en l'istorgia da revocaziuns dal document.
command.edit.redo.title = Repeter
command.edit.redo.description = Repeter la modificaziun revocada sco ultima.
command.edit.copy.title = Copiar
command.edit.copy.description = Copiar ils pixels selecziunads da la stresa activa en l'archiv provisoric intern (l'entira stresa sche nagut n'è selecziunà).
command.edit.copy_merged.title = Copiar reunì
command.edit.copy_merged.description = Copiar la selecziun sco cumposiziun da tut las stresas visiblas, empè da mo la stresa activa.
command.edit.cut.title = Tagliar
command.edit.cut.description = Copiar ils pixels selecziunads en l'archiv provisoric e stizzar els da la stresa activa.
command.edit.paste.title = Encollar
command.edit.paste.description = Encollar il cuntegn da l'archiv provisoric en ina nova stresa sur quella activa, centrà sin la taila.
command.edit.paste.layer_name = Stresa encollada
command.edit.paste_in_place.title = Encollar al lieu original
command.edit.paste_in_place.description = Encollar il cuntegn da l'archiv provisoric en ina nova stresa a las coordinatas d'origin.
command.edit.fill_foreground.title = Emplenir cun la colur davant
command.edit.fill_foreground.description = Emplenir la selecziun (u l'entira taila sche nagut n'è selecziunà) cun la colur davant.
command.edit.fill_background.title = Emplenir cun la colur da fund
command.edit.fill_background.description = Emplenir la selecziun (u l'entira taila sche nagut n'è selecziunà) cun la colur da fund.
command.select.all.title = Selecziunar tut
command.select.all.description = Selecziunar l'entira taila.
command.select.deselect.title = Deselecziunar
command.select.deselect.description = Abolir la selecziun per che las modificaziuns valian puspè per l'entira stresa.
command.select.inverse.title = Inverter la selecziun
command.select.inverse.description = Barattar las regiuns selecziunadas e betg selecziunadas.
command.select.reselect.title = Selecziunar danovamain
command.select.reselect.description = Restabilir la selecziun abolida sco ultima.
command.select.reselect.msg.nothing_to_reselect = Nagut da selecziunar danovamain
command.select.feather.title = Far l'ur da la selecziun lom
command.select.feather.description = Render pli lom l'ur da la selecziun cun ina diffusiun da dus pixels, per che la proxima modificaziun svaneschia plaunsieu sur l'ur.
command.select.grow.title = Crescher
command.select.grow.description = Extender la selecziun en pixels vischins che sumeglian quels gia selecziunads, entaifer la toleranza da la festa magica.
command.select.similar.title = Sumegliant
command.select.similar.description = Selecziunar tut ils pixels da la stresa che sumeglian la selecziun, saja ch'els la tutgan u betg, entaifer la toleranza da la festa magica.
command.select.save.title = Memorisar la selecziun
command.select.save.description = Depositar la selecziun actuala en il document sco canal alfa numnà.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Chargiar la selecziun
command.select.load.description = Restabilir la selecziun memorisada il pli da nov.
command.layer.new.title = Nova stresa
command.layer.new.description = Agiuntar ina stresa da raster vida sur la stresa activa e l'activar.
command.layer.duplicate.title = Duplitgar la stresa
command.layer.duplicate.description = Copiar l'entira stresa activa en ina nova stresa sur ella.
command.layer.smart_object.title = Converter en in object intelligent
command.layer.smart_object.description = Integrar ils pixels da la stresa da raster activa en in object intelligent, uschia che transfurmaziuns e filters posteriurs reinterpoleschian la funtauna intacta.
command.layer.rasterize.title = Rasterisar la stresa
command.layer.rasterize.description = Converter definitivamain ina stresa da furma, text u object intelligent en pixels simpels.
command.layer.delete.title = Stizzar la stresa
command.layer.delete.description = Stizzar las stresas selecziunadas.
command.layer.group.title = Gruppar las stresas
command.layer.group.description = Metter las stresas selecziunadas en ina nova gruppa al medem lieu.
command.layer.raise.title = Spustar enavant
command.layer.raise.description = Spustar la stresa activa in plaz ensi en il mantun da sia gruppa.
command.layer.lower.title = Spustar enavos
command.layer.lower.description = Spustar la stresa activa in plaz engiu en il mantun da sia gruppa.
command.layer.to_front.title = Spustar davant tut
command.layer.to_front.description = Spustar la stresa activa sisum sia gruppa.
command.layer.to_back.title = Spustar davos tut
command.layer.to_back.description = Spustar la stresa activa giudim sia gruppa.
command.layer.clipping_mask.title = Crear/Liberar la mascra da retagl
command.layer.clipping_mask.description = Retagliar la stresa activa tenor quella sutvart u la liberar, sch'ella è gia retagliada; ina stresa retagliada è visibla mo nua che sia basa ha pixels.
command.layer.cut_to_new.title = Stresa cun tagliar
command.layer.cut_to_new.description = Prender ils pixels selecziunads or da la stresa activa ed als metter sin ina nova stresa sur ella.
command.layer.cut_to_new.layer_name = Stresa cun tagliar
command.layer.add_mask.title = Agiuntar ina mascra da stresa
command.layer.add_mask.description = Agiuntar ina mascra a la stresa activa che mussa mo la selecziun, sch'ina exista.
command.layer.flatten.title = Reducir il maletg ad ina stresa
command.layer.flatten.description = Cumponer tut quai ch'è visibel en ina suletta stresa da fund opaca e refusar las stresas zuppentadas.
command.layer.merge_down.title = Reunir engiu
command.layer.merge_down.description = Cumponer la stresa activa en la stresa sutvart.
command.layer.merge_down.msg.no_layer_below = Nagina stresa sutvart per reunir
command.layer.merge_visible.title = Reunir las stresas visiblas
command.layer.merge_visible.description = Cumponer tut las stresas visiblas en ina e laschar las stresas zuppentadas intactas.
command.msg.nothing_to_copy = Selecziunescha ina stresa da pixels per copiar
command.msg.clipboard_empty = Nagut en l'archiv provisoric
