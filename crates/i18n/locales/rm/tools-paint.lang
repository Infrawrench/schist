# Utensils da malegiar.
tool.brush.name = Penel
tool.brush.description = Malegia in stritg cun urs loms en la colur davant; sia grondezza vegn determinada da la grondezza, direzza ed opacitad dal penel en l'editur.
tool.brush.history.stroke = Penel
tool.pencil.name = Rispli
tool.pencil.description = Malegia in stritg cun urs dirs, senza antialiasing, en la colur davant.
tool.pencil.history.stroke = Rispli
tool.eraser.name = Gumma
tool.eraser.description = Stizza per lung dal stritg e renda la stresa transparenta.
tool.eraser.history.stroke = Gumma
tool.clone.name = Bul da clonaziun
tool.clone.description = Bul da clonaziun: clicca cun Alt per definir il punct da funtauna e malegia lura pixels copiads da là cun la medema distanza relativa.
tool.clone.history.stroke = Bul da clonaziun
tool.dodge.name = Sclerider
tool.dodge.description = Sclerescha ils pixels sur ils quals passa il stritg.
tool.dodge.history.stroke = Sclerider
tool.burn.name = Stgirader
tool.burn.description = Stgirenta ils pixels sur ils quals passa il stritg.
tool.burn.history.stroke = Stgirader
tool.sponge.name = Spungia
tool.sponge.description = Augmenta u reducescha la saturaziun dals pixels sur ils quals passa il stritg.
tool.sponge.history.stroke = Spungia
tool.blur.name = Diffusiun
tool.blur.description = Diffundascha ils pixels sur ils quals passa il stritg.
tool.blur.history.stroke = Diffusiun
tool.sharpen.name = Accentuaziun
tool.sharpen.description = Accentuescha ils pixels sur ils quals passa il stritg.
tool.sharpen.history.stroke = Accentuaziun
tool.smudge.name = Sfruschar
tool.smudge.description = Tira la colur per lung dal stritg, sco sche ti stumplassas colur bletscha.
tool.smudge.history.stroke = Sfruschar
tool.heal.name = Penel da reparaziun
tool.heal.description = Penel da reparaziun: clicca cun Alt per definir la funtauna e malegia lura; la structura da la funtauna vegn maschadada cun l'atgna colur e glisch da la destinaziun.
tool.heal.history.stroke = Penel da reparaziun
tool.spot_heal.name = Penel da reparaziun punctuala
tool.spot_heal.description = Penel da reparaziun punctuala: malegia sur in defect ed el vegn remplazzà cun structura prendida dal conturn, senza definir in punct da funtauna.
tool.spot_heal.history.stroke = Penel da reparaziun punctuala
tool.history_brush.name = Penel d'istorgia
tool.history_brush.description = Malegia enavos pixels or d'ina copia dal stadi en l'istorgia dal document e revochescha lavur pli nova stritg per stritg.
tool.history_brush.history.stroke = Penel d'istorgia
tool.background_eraser.name = Gumma da fund
tool.background_eraser.description = Stizza la colur prendida sut il center dal penel e lascha pixels d'autras colurs intactas, per distatgar in motiv da ses fund.
tool.background_eraser.history.stroke = Gumma da fund
tool.gradient.name = Gradient
tool.gradient.description = Tira per emplenir la stresa — tras la selecziun, sch'ina exista — cun in gradient linear da la colur davant a la colur da fund en direcziun dal tratg.
tool.gradient.radial.name = Gradient radial
tool.gradient.radial.description = Tira dal center vers anora per emplenir cun in gradient radial tranter la colur davant e la colur da fund.
tool.gradient.option.gradient = Gradient
tool.gradient.option.reverse = Inverter
tool.gradient.option.dither = Tramaischar
tool.gradient.choice.foreground_to_background = Da la colur davant a la colur da fund
tool.gradient.choice.foreground_to_transparent = Da la colur davant a transparent
tool.gradient.choice.linear = Linear
tool.gradient.choice.radial = Radial
tool.gradient.choice.angle = Angul
tool.gradient.choice.reflected = Reflectà
tool.gradient.choice.diamond = Diamant
tool.gradient.history.gradient = Gradient
tool.bucket.name = Sadella da colur
tool.bucket.description = Clicca per emplenir la regiun colliada da colur sumeglianta sut il punctader cun la colur davant, entaifer la toleranza da l'utensil.
tool.bucket.option.contiguous = Regiun colliada
tool.bucket.option.all_layers = Tut las stresas
tool.bucket.history.fill = Sadella da colur
