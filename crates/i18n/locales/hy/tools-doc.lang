# Փաստաթղթի տարրերի գործիքները՝ մոնտաժային տիրույթներ, հատվածներ, շրջանակներ, նշումներ և հաշվիչներ

tool.artboard.name = Մոնտաժային տիրույթ
tool.artboard.description = Քաշելով ստեղծեք մոնտաժային տիրույթ՝ կտավի անվանված հատված, որն արտահանվում է առանձին։ Գոյություն ունեցող տիրույթի ներսում քաշելը տեղափոխում է այն։
tool.artboard.default_name = Մոնտաժային տիրույթ {n}

tool.slice.name = Հատված
tool.slice.description = Քաշելով ստեղծեք արտահանման հատված՝ կտավի անվանված ուղղանկյուն, որն արտահանվում է որպես առանձին պատկեր։ Գոյություն ունեցող հատվածի ներսում քաշելը տեղափոխում է այն։
tool.slice.default_name = Հատված {n}

tool.frame.name = Շրջանակ
tool.frame.description = Քաշելով ստեղծեք շրջանակ՝ ուղղանկյուն (կամ էլիպսաձև) շերտ, որը դիմակավորում է իր մեջ տեղադրված ամեն ինչ։
tool.frame.default_name = Շրջանակ {n}
tool.frame.choice.rectangle = Ուղղանկյուն
tool.frame.choice.ellipse = Էլիպս
tool.frame.history.frame = Շրջանակ

tool.note.name = Նշում
tool.note.description = Սեղմեք կտավի դատարկ մասում՝ այնտեղ նշում ամրացնելու համար՝ խմբագրիչի վիճակում նշված հեղինակի անունով և գույնով։ Սեղմեք գոյություն ունեցող նշիչին՝ այն «Նշումներ» վահանակում ընտրելու համար։
tool.note.history.place = Նշման տեղադրում
tool.note.history.move = Նշման տեղափոխում
tool.note.history.delete = Նշման ջնջում

tool.count.name = Հաշվիչ
tool.count.description = Սեղմեք՝ կտավի վրա համարակալված հաշվիչ նշիչներ տեղադրելու համար, իսկ գոյություն ունեցող նշիչին սեղմեք՝ այն հեռացնելու համար։
tool.count.default_name = Հաշվիչ {n}
