# Խմբագրման, ընտրության և շերտերի հրամաններ
command.edit.undo.title = Հետարկել
command.edit.undo.description = Փաստաթղթի հետարկման պատմության մեջ մեկ քայլ հետ գնալ։
command.edit.redo.title = Կրկնել
command.edit.redo.description = Կրկնել վերջին հետարկված խմբագրումը։
command.edit.copy.title = Պատճենել
command.edit.copy.description = Ակտիվ շերտի ընտրված փիքսելները պատճենել ներքին փոխանակման բուֆերում (եթե ընտրություն չկա՝ ամբողջ շերտը)։
command.edit.copy_merged.title = Պատճենել միավորվածը
command.edit.copy_merged.description = Ընտրությունը պատճենել այնպես, ինչպես այն կազմվում է բոլոր տեսանելի շերտերից, ոչ միայն ակտիվ շերտից։
command.edit.cut.title = Կտրել
command.edit.cut.description = Ընտրված փիքսելները պատճենել փոխանակման բուֆերում և ջնջել ակտիվ շերտից։
command.edit.paste.title = Տեղադրել
command.edit.paste.description = Փոխանակման բուֆերը տեղադրել ակտիվ շերտի վերևում գտնվող նոր շերտում՝ կտավի կենտրոնում։
command.edit.paste.layer_name = Տեղադրված շերտ
command.edit.paste_in_place.title = Տեղադրել նույն տեղում
command.edit.paste_in_place.description = Փոխանակման բուֆերը տեղադրել նոր շերտում՝ այն կոորդինատներում, որտեղից պատճենվել էր։
command.edit.fill_foreground.title = Լցնել առաջին պլանի գույնով
command.edit.fill_foreground.description = Ընտրությունը (կամ ամբողջ կտավը, եթե ընտրություն չկա) լցնել առաջին պլանի գույնով։
command.edit.fill_background.title = Լցնել հետին պլանի գույնով
command.edit.fill_background.description = Ընտրությունը (կամ ամբողջ կտավը, եթե ընտրություն չկա) լցնել հետին պլանի գույնով։
command.select.all.title = Ընտրել բոլորը
command.select.all.description = Ընտրել ամբողջ կտավը։
command.select.deselect.title = Ապաընտրել
command.select.deselect.description = Հեռացնել ընտրությունը, որպեսզի խմբագրումները կրկին կիրառվեն ամբողջ շերտի վրա։
command.select.inverse.title = Հակադարձ ընտրություն
command.select.inverse.description = Փոխանակել ընտրված և չընտրված տարածքները։
command.select.reselect.title = Կրկին ընտրել
command.select.reselect.description = Վերականգնել վերջին հեռացված ընտրությունը։
command.select.reselect.msg.nothing_to_reselect = Կրկին ընտրելու բան չկա
command.select.feather.title = Փափկեցնել ընտրությունը
command.select.feather.description = Ընտրության եզրը փափկեցնել երկու փիքսելի լղոզմամբ, որպեսզի հաջորդ խմբագրումը դրա երկայնքով աստիճանաբար մարի։
command.select.grow.title = Աճեցնել
command.select.grow.description = Ընտրությունն ընդլայնել դեպի հարակից փիքսելներ, որոնք նման են արդեն ընտրվածներին՝ կախարդական փայտիկի թույլատրելի շեղման սահմաններում։
command.select.similar.title = Նման
command.select.similar.description = Շերտում ընտրել ընտրությանը նման բոլոր փիքսելները՝ անկախ հարակից լինելուց, կախարդական փայտիկի թույլատրելի շեղման սահմաններում։
command.select.save.title = Պահել ընտրությունը
command.select.save.description = Ընթացիկ ընտրությունը փաստաթղթում պահել որպես անվանված ալֆա կապուղի։
command.select.save.channel_name = Ալֆա {n}
command.select.load.title = Բեռնել ընտրությունը
command.select.load.description = Վերականգնել ամենավերջին պահված ընտրությունը։
command.layer.new.title = Նոր շերտ
command.layer.new.description = Ակտիվ շերտի վերևում ավելացնել դատարկ ռաստերային շերտ և այն դարձնել ակտիվ։
command.layer.duplicate.title = Կրկնօրինակել շերտը
command.layer.duplicate.description = Ակտիվ շերտն իր ամբողջ պարունակությամբ պատճենել դրա վերևում գտնվող նոր շերտում։
command.layer.smart_object.title = Փոխարկել խելացի օբյեկտի
command.layer.smart_object.description = Ակտիվ ռաստերային շերտի փիքսելները փաթեթավորել խելացի օբյեկտում, որպեսզի հետագա ձևափոխումներն ու զտիչները վերանմուշառեն անփոփոխ աղբյուրը։
command.layer.rasterize.title = Ռաստերացնել շերտը
command.layer.rasterize.description = Ձևի, տեքստի կամ խելացի օբյեկտի շերտը վերածել սովորական փիքսելների։
command.layer.delete.title = Ջնջել շերտը
command.layer.delete.description = Ջնջել ընտրված շերտերը։
command.layer.group.title = Խմբավորել շերտերը
command.layer.group.description = Ընտրված շերտերը նույն տեղում ընդգրկել նոր խմբում։
command.layer.raise.title = Բերել առաջ
command.layer.raise.description = Ակտիվ շերտը խմբի դարսակում մեկ դիրքով բարձրացնել։
command.layer.lower.title = Ուղարկել հետ
command.layer.lower.description = Ակտիվ շերտը խմբի դարսակում մեկ դիրքով իջեցնել։
command.layer.to_front.title = Բերել ամենաառաջ
command.layer.to_front.description = Ակտիվ շերտը տեղափոխել իր խմբի վերև։
command.layer.to_back.title = Ուղարկել ամենահետ
command.layer.to_back.description = Ակտիվ շերտը տեղափոխել իր խմբի ներքև։
command.layer.clipping_mask.title = Ստեղծել/ազատել կտրող դիմակը
command.layer.clipping_mask.description = Ակտիվ շերտը կտրել դրա ներքևի շերտով կամ ազատել, եթե արդեն կտրված է․ կտրված շերտը երևում է միայն այնտեղ, որտեղ հիմքում փիքսելներ կան։
command.layer.cut_to_new.title = Շերտ՝ կտրման միջոցով
command.layer.cut_to_new.description = Ընտրված փիքսելներն ակտիվ շերտից տեղափոխել դրա վերևում գտնվող նոր շերտ։
command.layer.cut_to_new.layer_name = Շերտ՝ կտրման միջոցով
command.layer.add_mask.title = Ավելացնել շերտի դիմակ
command.layer.add_mask.description = Ակտիվ շերտին ավելացնել դիմակ, որը ընտրության առկայության դեպքում բացահայտում է միայն այն։
command.layer.flatten.title = Հարթեցնել պատկերը
command.layer.flatten.description = Բոլոր տեսանելի տարրերը միավորել մեկ անթափանց «Հետին պլան» շերտում՝ հեռացնելով թաքնված շերտերը։
command.layer.merge_down.title = Միավորել ներքևի հետ
command.layer.merge_down.description = Ակտիվ շերտը միավորել դրա տակ գտնվող շերտի հետ։
command.layer.merge_down.msg.no_layer_below = Ներքևում միավորման ենթակա շերտ չկա
command.layer.merge_visible.title = Միավորել տեսանելի շերտերը
command.layer.merge_visible.description = Բոլոր տեսանելի շերտերը միավորել մեկում՝ թաքնված շերտերն անփոփոխ թողնելով։
command.msg.nothing_to_copy = Ընտրեք փիքսելային շերտ, որից կարելի է պատճենել
command.msg.clipboard_empty = Փոխանակման բուֆերը դատարկ է
