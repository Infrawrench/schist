# HEIC security update.
codec.heif.msg.unsafe_version = জ্ঞাত সুৰক্ষা দুৰ্বলতাৰ বাবে libheif {version} ব্যৱহাৰ কৰিবলৈ অস্বীকাৰ কৰা হৈছে; সংস্কৰণ {minimum} বা তাৰ পাছৰ সংস্কৰণ প্ৰয়োজন। আপডেট কৰা HEIC সমৰ্থন ডাউনল'ড কৰক বা ছিষ্টেমৰ লাইব্ৰেৰী উন্নীত কৰক।
codec.heif.msg.unknown_version = libheif-ৰ সংস্কৰণ যাচাই কৰিব নোৱাৰাৰ বাবে ইয়াক ব্যৱহাৰ কৰিবলৈ অস্বীকাৰ কৰা হৈছে; সংস্কৰণ {minimum} বা তাৰ পাছৰ সংস্কৰণ প্ৰয়োজন। আপডেট কৰা HEIC সমৰ্থন ডাউনল'ড কৰক বা ছিষ্টেমৰ লাইব্ৰেৰী উন্নীত কৰক।
dialog.open.heic_needs_safe_decoder = “{name}” খুলিবলৈ HEVC ডিক'ডাৰসহ libheif {minimum} বা তাৰ পাছৰ সংস্কৰণ প্ৰয়োজন। জ্ঞাত সুৰক্ষা দুৰ্বলতাৰ পৰা সুৰক্ষিত ৰাখিবলৈ পুৰণি বা যাচাই কৰিব নোৱাৰা সংস্কৰণসমূহ অৱৰোধ কৰা হৈছে। আগবাঢ়িবলৈ আপডেট কৰা HEIC সমৰ্থন ডাউনল'ড কৰক।
workspace.docs.heic_safe_decoder_needed = আপডেট কৰা HEIC সমৰ্থন প্ৰয়োজন
