# Photographic merging. Machine-assisted translation with terminology review.
photo_merge.title = ফটোসমূহ একত্ৰিত কৰক...
photo_merge.align = স্বয়ংক্ৰিয় প্ৰান্তিককৰণ
photo_merge.focus = বিভিন্ন ফ'কাচ দূৰত্বৰ সৈতে ফটোসমূহ একত্ৰিত কৰক
photo_merge.hdr = একাধিক এক্সপোজাৰ স্তৰৰ পৰা HDR
photo_merge.panorama = ফটোসমূহক এটা পেনোৰামাত একত্ৰিত কৰক
photo_merge.translation = কেৱল অনুভূমিক আৰু উলম্ব ছবিৰ গতি (X/Y); কোনো ঘূৰ্ণন বা দৃষ্টিভংগী সংশোধন নহয়।
photo_merge.crop = শস্যৰ পৰা ভাগ কৰা অঞ্চললৈ
photo_merge.exposure_note = প্ৰতিখন ফটোৰ আপেক্ষিক এক্সপ’জাৰ ছেট কৰক: +1 EV মানে দুগুণ পোহৰ। 32-বিট HDR সংৰক্ষণ কৰিবলে ছবি টোন মেপিং নিষ্ক্ৰিয় কৰক।
photo_merge.tone_map = ছবিৰ টোন মেপিং
photo_merge.order = মুক্ত দস্তাবেজ টেবসমূহৰ ক্ৰম ব্যৱহাৰ কৰক। প্ৰতিখন পেনোৰামা ফটোৱে আগৰ ফটোখনৰ ওপৰত কমেও ২৫% ওভাৰলেপ কৰিব লাগিব।
photo_merge.invalid = 2–16 খন বৈধ ছবি নিৰ্ব্বাচন কৰক আৰু এক্সপোজাৰ ছেটিংছ পৰীক্ষা কৰক।
photo_merge.limit = সীমা: প্ৰতিখন ছবি বা আউটপুটত ৬৪ মিলিয়ন পিক্সেল, মুঠ ১২৮ মিলিয়ন; প্ৰতিটো ফালে 30000 পিক্সেল।
photo_merge.no_match = কোনো নিৰ্ভৰযোগ্য ওভাৰলেপ পোৱা নগ’ল। ঘূৰ্ণন বা দৃষ্টিভংগী সলনি নকৰাকৈ ওভাৰলেপিং ফটো ব্যৱহাৰ কৰক।
