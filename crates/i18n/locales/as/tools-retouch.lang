# The region retouching tools (plugins/tools-retouch): Patch,
# Content-Aware Move, Red Eye, Magic Eraser. Mode and Tolerance come
# from common.lang.

# Patch
tool.patch.name = পেচ
tool.patch.description = দোষটোৰ চাৰিওফালে এটা সীমাৰেখা টানি, সেই নিৰ্বাচনটো পৰিষ্কাৰ পিক্সেলৰ ওপৰলৈ টানি নিয়ক: তাৰ টেক্সচাৰ দোষটোৰ সৈতে খাপ খুৱাই দিয়া হয়। পেচ মোডে যোৰাটোৰ কোনটো মূৰ টানিব সেয়া নিৰ্ধাৰণ কৰে।
tool.patch.option.patch = পেচ
tool.patch.choice.source = উৎস
tool.patch.choice.destination = গন্তব্য
tool.patch.history.patch = পেচ

# Content-Aware Move
tool.content_aware_move.name = বিষয়বস্তু-সচেতন স্থানান্তৰ
tool.content_aware_move.description = নিৰ্বাচিত বস্তু এটা আন ঠাইলৈ টানি নিয়ক; ই এৰি যোৱা খালী ঠাই চাৰিওফালৰ অংশৰ পৰা পূৰণ কৰা হয়। প্ৰসাৰণ মোডত বস্তুটো স্থানান্তৰ কৰাৰ সলনি প্ৰসাৰিত কৰা হয়।
tool.content_aware_move.choice.move = স্থানান্তৰ
tool.content_aware_move.choice.extend = প্ৰসাৰণ
tool.content_aware_move.history.move = বিষয়বস্তু-সচেতন স্থানান্তৰ

# Red Eye
tool.red_eye.name = ৰঙা চকু
tool.red_eye.description = ফ্লেছৰ ফলত হোৱা ৰঙা ৰং আঁতৰাবলৈ চকুৰ মণিত ক্লিক কৰক।
tool.red_eye.option.pupil_size = চকুৰ মণিৰ আকাৰ
tool.red_eye.option.darken = গাঢ় কৰক
tool.red_eye.history.red_eye = ৰঙা চকু

# Magic Eraser
tool.magic_eraser.name = যাদুকৰী ইৰেজাৰ
tool.magic_eraser.description = সঁজুলিটোৰ সহনসীমাৰ ভিতৰত পইণ্টাৰৰ তলৰ একে ধৰণৰ ৰঙৰ অঞ্চল মচিবলৈ ক্লিক কৰক—ক্লিক কৰা ঠাইৰ সৈতে সংলগ্ন অঞ্চলটো অথবা স্তৰটোৰ সকলো মিলা অঞ্চল।
tool.magic_eraser.option.contiguous = সংলগ্ন
tool.magic_eraser.history.erase = যাদুকৰী ইৰেজাৰ
