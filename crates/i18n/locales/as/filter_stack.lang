# Editable filter stacks.
filter_stack.title = ফিল্টাৰ স্তূপ
filter_stack.add = ফিল্টাৰ যোগ কৰক
filter_stack.enable = সক্ষম কৰক
filter_stack.disable = অক্ষম কৰক
filter_stack.up = ওপৰলৈ
filter_stack.down = তললৈ
filter_stack.remove = আঁতৰাওক
filter_stack.bake = ফিল্টাৰ স্তূপ স্থায়ী কৰক
filter_stack.note = প্ৰভাৱসমূহ সংৰক্ষিত উৎসৰ পৰা ওপৰৰ পৰা তললৈ প্ৰয়োগ হয়। সম্পাদনা কৰিবলৈ এটা ফিল্টাৰত ক্লিক কৰক। অঁকা, স্থানান্তৰ, ৰূপান্তৰ বা ৰঙৰ ধৰণ সলনি কৰিলে স্তূপৰ দৃশ্যমান ফল স্থায়ী হয় আৰু সম্পাদনযোগ্য বিন্যাস আঁতৰে; পূৰ্বাৱস্থাই ইয়াক পুনৰুদ্ধাৰ কৰে।
filter_stack.eligibility = কেৱল স্বয়ংসম্পূৰ্ণ ফিল্টাৰসমূহ দেখুওৱা হয়। মানচিত্ৰ, পথ, পটভূমি বা বাহ্যিক সংলাপৰ প্ৰয়োজন হোৱা ফিল্টাৰ স্তূপত সংৰক্ষণ কৰিব নোৱাৰি।
filter_stack.unavailable = ফিল্টাৰ স্তূপ সম্পাদনা কৰিবলৈ এটা আনলক কৰা পিক্সেল স্তৰ বা স্মাৰ্ট অবজেক্ট নিৰ্বাচন কৰক।
filter_stack.render_failed = ফিল্টাৰ স্তূপটো ৰেণ্ডাৰ কৰিব পৰা নগ’ল। ইয়াৰ উৎস আৰু সংৰক্ষিত ছেটিংছ অপৰিৱৰ্তিত আছে।
filter_stack.edit_history = ফিল্টাৰ স্তূপ সম্পাদনা কৰক
filter_stack.bake_history = ফিল্টাৰ স্তূপ স্থায়ী কৰক
filter_stack.updated = ফিল্টাৰ স্তূপ আপডেট কৰা হ'ল
filter_stack.missing = অনুপলব্ধ ফিল্টাৰ: {id}
