filter.neural.param.detail = বিৱৰণ
filter.neural.param.eyes = চকু

# What a model-backed filter says in its dialog
filter.neural.msg.using_model = {model} · {license} ব্যৱহাৰ কৰা হৈছে।
filter.neural.msg.get_model = ফিল্টাৰ ▸ Neural Filters ▸ মডেলসমূহ পৰিচালনা কৰক-ৰ পৰা ইয়াক লওক।

