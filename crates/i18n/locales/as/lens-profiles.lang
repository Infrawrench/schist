# Lens profile controls.
lens_profiles.invalid = সমৰ্থিত কেমেৰা বা লেন্স তথ্যৰ সৈতে এটা বৈধ Lensfun v1/v2 XML ডাটাবেইচ (8 MiB লৈকে) নিৰ্ব্বাচন কৰক।
lens_profiles.calibration = লেন্স মানাংকন
lens_profiles.no_calibration = কোনো মানাংকনে এই সংহতিসমূহ সামৰি লোৱা নাই। ফ'কেল লেংথ আৰু কেমেৰাৰ ক্ৰপ ফ্যাক্টৰ পৰীক্ষা কৰক; হাতৰ দ্বাৰা সংশোধন উপলব্ধ হৈয়েই আছে।
lens_profiles.import = Lensfun XML আমদানি...
lens_profiles.imported = এই অধিবেশনৰ বাবে আমদানি কৰা হৈছে Lensfun ডাটাবেইচ। এটা আলেখ্যন নিৰ্ব্বাচন কৰক বা ফটো মেটাডাটাৰ সৈতে মিলাওক।
lens_profiles.manual = কেৱল হাতৰ দ্বাৰা সংশোধন কৰা
lens_profiles.saved = সংৰক্ষিত মানাংকন (ডাটাবেইচ উপলব্ধ নহয়)
lens_profiles.profile = লেন্স প্ৰফাইল
lens_profiles.aperture = এপাৰচাৰ (০ = অজ্ঞাত)
lens_profiles.distance = ফ'কাচ দূৰত্ব (০ = অজ্ঞাত)
lens_profiles.vignette = মানাংকিত ভিনেটিং
lens_profiles.color_context = মানাংকিত ভিনেটিঙৰ বাবে অন্তৰ্নিৰ্মিত sRGB আলেখ্যনৰ প্ৰয়োজন। ৰূপ সংৰক্ষণ কৰিবলে sRGB লৈ ৰূপান্তৰ কৰক, তাৰ পিছত লেন্স সংশোধন পুনৰ খোলক। ইতিমধ্যে-sRGB টেগ নকৰা পিক্সেলসমূহৰ বাবে, sRGB নিযুক্ত কৰাটো যথেষ্ট। জ্যামিতি আৰু ৰঙীন সংশোধন উপলব্ধ হৈয়েই আছে।
lens_profiles.vignette_missing = কোনো ভিনেটিং মানাংকনে এপাৰচাৰ আৰু ফ'কাচ দূৰত্ব সামৰি লোৱা নাই। ইয়াক সক্ৰিয় কৰিবলৈ জুখি উলিওৱা মানসমূহ দিয়ক; বহু Lensfun প্ৰফাইলত 1000 m দূৰৈৰ ফ'কাচ বুজায়।
lens_profiles.note = মানাংকিত সংশোধন হাতৰ নিয়ন্ত্ৰণৰ আগতে প্ৰয়োগ হয়। মূল সম্পূৰ্ণ ফ্ৰেম ব্যৱহাৰ কৰক; তাৰ পিছত ক্ৰপ কৰক। সম্পাদনযোগ্য মানাংকন ৰাখিবলৈ PSD/PSB-ত ফিল্টাৰৰ স্তূপ সংৰক্ষণ কৰক।
lens_profiles.automatic = ফটো মেটাডাটা মিলাওক
lens_profiles.components = প্ৰফাইল পাছ: বিকৃতি {distortion}; ৰঙৰ ফ্ৰিঞ্জ {tca}; ভিনেটিং {vignette}.
