# Kmandi ewlenin tal-editjar, l-għażla u s-saffi.
command.edit.undo.title = Ħoll
command.edit.undo.description = Mur lura entrata waħda fl-istorja tat-tħollija tad-dokument.
command.edit.redo.title = Erġa' Agħmel
command.edit.redo.description = Erġa' agħmel l-aħħar bidla li nħallet.
command.edit.copy.title = Ikkopja
command.edit.copy.description = Ikkopja l-pixels magħżula tas-saff attiv fil-clipboard intern (is-saff kollu meta ma jkun magħżul xejn).
command.edit.copy_merged.title = Ikkopja Magħqud
command.edit.copy_merged.description = Ikkopja l-għażla kif jikkomponuha s-saffi viżibbli kollha, minflok mis-saff attiv biss.
command.edit.cut.title = Aqta'
command.edit.cut.description = Ikkopja l-pixels magħżula fil-clipboard u ħassarhom mis-saff attiv.
command.edit.paste.title = Waħħal
command.edit.paste.description = Waħħal il-clipboard f'saff ġdid fuq is-saff attiv, iċċentrat fuq il-kanvas.
command.edit.paste.layer_name = Saff Imwaħħal
command.edit.paste_in_place.title = Waħħal f'Postu
command.edit.paste_in_place.description = Waħħal il-clipboard f'saff ġdid fil-koordinati li minnhom ġie kkopjat.
command.edit.fill_foreground.title = Imla bil-Kulur ta' Quddiem
command.edit.fill_foreground.description = Imla l-għażla (jew il-kanvas kollu meta ma jkun magħżul xejn) bil-kulur ta' quddiem.
command.edit.fill_background.title = Imla bil-Kulur tal-Isfond
command.edit.fill_background.description = Imla l-għażla (jew il-kanvas kollu meta ma jkun magħżul xejn) bil-kulur tal-isfond.
command.select.all.title = Agħżel Kollox
command.select.all.description = Agħżel il-kanvas kollu.
command.select.deselect.title = Neħħi l-Għażla
command.select.deselect.description = Neħħi l-għażla biex il-bidliet jerġgħu japplikaw għas-saff kollu.
command.select.inverse.title = Aqleb l-Għażla
command.select.inverse.description = Aqleb iż-żoni magħżula ma' dawk mhux magħżula.
command.select.reselect.title = Erġa' Agħżel
command.select.reselect.description = Ġib lura l-aħħar għażla li tneħħiet.
command.select.reselect.msg.nothing_to_reselect = Ma hemm xejn x'jerġa' jintgħażel
command.select.feather.title = Rattab Truf l-Għażla
command.select.feather.description = Rattab xifer l-għażla b'ċajpir ta' żewġ pixels, biex il-bidla li jmiss tgħib gradwalment minn fuqu.
command.select.grow.title = Kabbar
command.select.grow.description = Wessa' l-għażla għal pixels li jmissuha u jixbhu lil dawk diġà magħżula, fil-limitu tat-tolleranza tal-bastun maġiku.
command.select.similar.title = Simili
command.select.similar.description = Agħżel kull pixel fis-saff li jixbah l-għażla, kemm jekk imissha kif ukoll jekk le, fil-limitu tat-tolleranza tal-bastun maġiku.
command.select.save.title = Issejvja l-Għażla
command.select.save.description = Aħżen l-għażla attwali fid-dokument bħala kanal alfa msemmi.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Għabbi l-Għażla
command.select.load.description = Erġa' ġib l-aktar għażla ssejvjata reċentement.
command.layer.new.title = Saff Ġdid
command.layer.new.description = Żid saff raster vojt fuq is-saff attiv u agħmlu attiv.
command.layer.duplicate.title = Idduplika s-Saff
command.layer.duplicate.description = Ikkopja s-saff attiv, bil-kontenut kollu tiegħu, f'saff ġdid fuqu.
command.layer.smart_object.title = Ikkonverti f'Oġġett Intelliġenti
command.layer.smart_object.description = Geżwer il-pixels tas-saff raster attiv f'oġġett intelliġenti, biex trasformazzjonijiet u filtri ta' wara jerġgħu jieħdu kampjun mis-sors mhux mibdul.
command.layer.rasterize.title = Irrasterizza s-Saff
command.layer.rasterize.description = Ikkonverti saff ta' forma, test jew oġġett intelliġenti f'pixels sempliċi.
command.layer.delete.title = Ħassar is-Saff
command.layer.delete.description = Ħassar is-saffi magħżula.
command.layer.group.title = Iggruppa s-Saffi
command.layer.group.description = Geżwer is-saffi magħżula fi grupp ġdid fl-istess post.
command.layer.raise.title = Ġib 'il Quddiem
command.layer.raise.description = Mexxi s-saff attiv post wieħed 'il fuq fil-munzell tal-grupp tiegħu.
command.layer.lower.title = Ibgħat Lura
command.layer.lower.description = Mexxi s-saff attiv post wieħed 'l isfel fil-munzell tal-grupp tiegħu.
command.layer.to_front.title = Ġib Fuq Nett
command.layer.to_front.description = Mexxi s-saff attiv fil-quċċata tal-grupp tiegħu.
command.layer.to_back.title = Ibgħat Wara Nett
command.layer.to_back.description = Mexxi s-saff attiv fil-qiegħ tal-grupp tiegħu.
command.layer.clipping_mask.title = Oħloq/Neħħi Maskra tal-Qtugħ
command.layer.clipping_mask.description = Aqta' s-saff attiv skont dak ta' taħtu, jew neħħi l-qtugħ jekk diġà hemm; saff maqtugħ jidher biss fejn il-bażi tiegħu għandha pixels.
command.layer.cut_to_new.title = Saff permezz tal-Qtugħ
command.layer.cut_to_new.description = Neħħi l-pixels magħżula mis-saff attiv u qegħedhom f'saff ġdid fuqu.
command.layer.cut_to_new.layer_name = Saff permezz tal-Qtugħ
command.layer.add_mask.title = Żid Maskra tas-Saff
command.layer.add_mask.description = Żid maskra mas-saff attiv, li turi biss l-għażla meta jkun hemm waħda.
command.layer.flatten.title = Iċċattja l-Immaġni
command.layer.flatten.description = Ikkomponi kulma jidher f'saff wieħed opak tal-Isfond, u warrab is-saffi moħbija.
command.layer.merge_down.title = Għaqqad 'l Isfel
command.layer.merge_down.description = Ikkomponi s-saff attiv fis-saff ta' taħtu.
command.layer.merge_down.msg.no_layer_below = Ma hemm ebda saff taħtu biex jingħaqad miegħu
command.layer.merge_visible.title = Għaqqad il-Viżibbli
command.layer.merge_visible.description = Ikkomponi kull saff viżibbli f'wieħed, u ħalli s-saffi moħbija kif inhuma.
command.msg.nothing_to_copy = Agħżel saff ta' pixels biex tikkopja minnu
command.msg.clipboard_empty = Ma hemm xejn fil-clipboard
