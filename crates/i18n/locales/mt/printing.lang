printing.captions = Inkludi l-ismijiet tal-fajls, il-klassifikazzjonijiet u l-kummenti
printing.pages = Paġni: {count}
printing.color_note = Il-pixels jinbidlu għal sRGB. Il-programm li juri l-PDF u l-istampatur tiegħek jimmaniġġjaw il-profil tal-istampatur.
printing.sizing_note = Il-mod ta’ adattament jimla kull ċellola mingħajr ma jaqta’ l-istampa. Id-daqs reali juża d-DPI tad-dokument; naqqas l-għadd ta’ ringieli jew kolonni jekk l-istampa ma tidħolx. Ipprintja l-PDF f’100% mingħajr l-għażla li tadattah għall-paġna.
printing.running = Qed jitħejja l-PDF…
printing.save_pdf = Issejvja l-PDF…
printing.open_print = Issejvja u iftaħ il-PDF biex tipprintjah…
printing.invalid = Is-settings tal-istampar jew id-dimensjonijiet tal-istampa mhumiex validi.
printing.limit = Ix-xogħol tal-istampar jaqbeż il-limitu: 200 stampa, 40 miljun pixel / 32768 pixel għal kull naħa ta’ kull stampa jew 256 MiB ta’ data PDF ikkompressata.
printing.profile_error = Din l-istampa għandha profil tal-kulur invalidu, li ma jaqbilx jew mhux appoġġjat. CMYK/Lab nattiv jeħtieġ profil inkorporat validu; RGB jeħtieġ profil RGB.
printing.does_not_fit = L-istampa bid-DPI tad-dokument tagħha ma tidħolx f’din iċ-ċellola. Uża l-mod ta’ adattament, inqas ringieli jew kolonni, jew karta akbar.
printing.caption_limit = Kumment huwa twil wisq għal din il-grilja. Uża inqas ringieli jew kolonni, qassar il-kumment jew itfi l-kummenti.
printing.font_error = M’hemmx font disponibbli għall-kumment. Installa font tat-test jew itfi l-kummenti.
printing.no_document = Iftaħ dokument jew agħżel ritratti mill-gallerija qabel tipprintja.
printing.source_error = Ritratt magħżul, fajl sekondarju editjat jew kumment ma setax jinqara. L-ebda PDF ma ġie ssejvjat.
printing.save_error = Il-PDF ma setax jiġi ssejvjat. Agħżel isem ġdid tal-fajl f’folder li tista’ tikteb fih; il-fajls eżistenti qatt ma jinbidlu.
printing.downloaded = Il-PDF tniżżel. Iftaħu fi programm li juri l-PDF biex tipprintjah f’100%.
printing.saved = PDF issejvjat: {path}
printing.letter = US Letter
printing.a4 = A4
printing.margin_value = {value} mm

