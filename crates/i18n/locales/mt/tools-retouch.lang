# Garża
tool.patch.name = Garża
tool.patch.description = Iddreggja kontorn madwar difett, imbagħad iddreggja dik l-għażla fuq pixels nodfa: in-nisġa ta' hemmhekk tiġi adattata għad-difett. Il-mod Garża jagħżel liema tarf mill-par għandek tiddreggja.
tool.patch.option.patch = Garża
tool.patch.choice.source = Sors
tool.patch.choice.destination = Destinazzjoni
tool.patch.history.patch = Garża

# Ċaqliq Konxju tal-Kontenut
tool.content_aware_move.name = Ċaqliq Konxju tal-Kontenut
tool.content_aware_move.description = Iddreggja oġġett magħżul għal post ieħor u l-vojt li jħalli jimtela mill-inħawi tiegħu. Fil-mod Estendi, l-oġġett jiġġebbed minflok jiċċaqlaq.
tool.content_aware_move.choice.move = Ċaqlaq
