tool.clone.name = Timbru tal-Ikkupjar
tool.clone.description = Timbru tal-Ikkupjar: agħfas alt u kklikkja biex tissettja l-punt tas-sors, imbagħad żebgħa pixels ikkupjati minnu bl-istess spostament.
tool.clone.history.stroke = Timbru tal-Ikkupjar
tool.dodge.name = Dawwal
tool.dodge.description = Dawwal il-pixels li tgħaddi fuqhom id-daqqa.
