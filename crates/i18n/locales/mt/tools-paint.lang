tool.smudge.history.stroke = Iċċappas
tool.heal.name = Pinzell tat-Tiswija
tool.heal.description = Pinzell tat-Tiswija: agħfas alt u kklikkja biex tissettja s-sors, imbagħad żebgħa; in-nisġa tas-sors titħallat mal-kulur u d-dawl tad-destinazzjoni.
tool.heal.history.stroke = Pinzell tat-Tiswija
