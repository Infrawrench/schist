tool.spot_heal.description = Pinzell tat-Tiswija tal-Punti: żebgħa fuq tebgħa u din tinbidel b'nisġa meħuda minn madwarha — ma għandekx għalfejn tissettja punt tas-sors.
tool.spot_heal.history.stroke = Pinzell tat-Tiswija tal-Punti
tool.history_brush.name = Pinzell tal-Istorja
tool.history_brush.description = Erġa' pinġi l-pixels mill-istampa tal-istorja tad-dokument, u ħoll ix-xogħol li sar wara daqqa b'daqqa.
tool.history_brush.history.stroke = Pinzell tal-Istorja
tool.background_eraser.name = Gomma tal-Isfond
tool.background_eraser.description = Ħassar il-kulur li jittieħed bħala kampjun taħt iċ-ċentru tal-pinzell u ħalli l-pixels differenti kif inhuma, biex tinqala' figura mill-isfond tagħha.
tool.background_eraser.history.stroke = Gomma tal-Isfond
tool.gradient.name = Gradjent
