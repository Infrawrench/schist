# Għodod taż-żebgħa.
tool.brush.name = Pinzell
tool.brush.description = Pinġi daqqa bi truf rotob bil-kulur ta' quddiem, bid-daqs, l-ebusija u l-opaċità tal-pinzell stabbiliti fl-editur.
tool.brush.history.stroke = Pinzell
tool.pencil.name = Lapes
