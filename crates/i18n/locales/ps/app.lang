# په Linux کې د Vulkan کتنه. د بستو نومونه او قوماندې هماغسې پاتې دي.
app.vulkan.no_loader = schist: په دې سیسټم کې د Vulkan باروونکی نشته، نو د انځورولو لپاره څه نشته.\n\nSchist د Vulkan له لارې انځوروي، او `libvulkan.so.1` نه دی لګول شوی.\nباروونکی او چلوونکی دواړه اړین دي:\n\n    Arch, CachyOS, Omarchy    sudo pacman -S vulkan-icd-loader vulkan-driver\n    Debian, Ubuntu, Mint      sudo apt install libvulkan1 mesa-vulkan-drivers\n    Fedora, RHEL              sudo dnf install vulkan-loader mesa-vulkan-drivers\n
app.vulkan.override_missing = schist: هغه Vulkan چلوونکی چې دا ناسته ورته اشاره کوي، نشته.\n\n{var} ټاکل شوی، او ټاکل یې د چلوونکو لپاره د باروونکي لټون د زیاتولو پر ځای *ځایناستی* کوي. نو دا دوتنې، چې شتون نه لري،\nد چلوونکو بشپړ لړلیک دی — او په دې ناسته کې د Vulkan هېڅ پروګرام\nهېڅ چلوونکی نه ویني، که هر څو چلوونکي لګول شوي هم وي:\n\n{missing}\n    {var}={value}\n\nهغه داسې څرګندپاڼې ته ورسم کړئ چې شته وي — لګول شوي چلوونکي خپلې څرګندپاڼې په\n/usr/share/vulkan/icd.d کې ږدي — یا یې ارزښت لرې کړئ او باروونکي ته پرېږدئ چې خپل چلوونکی ومومي.\nهغه ناسته چې دا ارزښت له امستنې دوتنې اخلي (د Hyprland `env =`،\nد systemd environment.d ورزیاتونه، یا د شېل پېژنیال) باید هماغلته بدله شي،\nاو بدلون هغو روانو چارو ته د رسېدو لپاره نوې ننوتنه غواړي.\n
app.vulkan.override_note = \n{var} په {value} ټاکل شوی، او دا د باروونکي خپل\nلټون ځایناستی کوي: که له دغو څرګندپاڼو هېڅ یوه د دې ماشین لپاره نه وي، د ارزښت لرې کول یې\nلومړۍ هڅه ده.\n
app.vulkan.no_driver = schist: د Vulkan هېڅ چلوونکی نه دی لګول شوی، نو د انځورولو لپاره څه نشته.\n\nSchist د Vulkan له لارې انځوروي. باروونکی لګول شوی، خو هېڅ\nچلوونکی نه ښيي — د لټون په دواړو ځایونو کې هېڅ چلوونکي ځان نه دی ثبت کړی:\n\n{dirs}\n\nباروونکی له چلوونکو جلا وړاندې کېږي، نو دا معمولا د یوې\nناشتې بستې ستونزه وي.\n\nد دې ماشین د GPU لپاره چلوونکی ولګوئ:\n\n    Arch, CachyOS, Omarchy    sudo pacman -S vulkan-driver\n    Debian, Ubuntu, Mint      sudo apt install mesa-vulkan-drivers\n    Fedora, RHEL              sudo dnf install mesa-vulkan-drivers\n\nد NVIDIA ځانګړی چلوونکی خپل چلوونکی لري (په Arch کې `nvidia-utils`،\nپه Debian کې `nvidia-driver`). په مجازي ماشین، یا داسې ځای کې چې\nد GPU چلوونکی نشي لګېدای، ساوتریز راسټرکوونکی کار کوي:\nپه Arch کې `vulkan-swrast` او په نورو ځایونو کې د `mesa-vulkan-drivers` برخه. دا\nورو دی، خو پیلېږي.\n{overridden}
app.vulkan.no_device = schist: د Vulkan چلوونکی لګول شوی، خو د انځورولو لپاره هېڅ وسیله نه وړاندې کوي.\n\nکېدای شي چلوونکی دا GPU ونه پوښي، یا لاسرسی ورته ونه لري —\nد SSH له لارې یا د کانتینر دننه، /dev/dri ډېری وخت\nنه وي. `vulkaninfo --summary` ښيي چې باروونکی څه ویني.\n\nکه دا ماشین GPU نه لري، ساوتریز راسټرکوونکی بې له GPU څخه انځوروي:\nپه Arch کې `vulkan-swrast`، او په Debian او Fedora کې\nد `mesa-vulkan-drivers` برخه.\n
app.vulkan.skip_hint = د دې لپاره چې Schist بیا هم پیل کړئ او پرېږدئ چې په خپله لاره ناکام شي، {var}=1 وټاکئ.
