tool.brush.name = Pincel
tool.brush.description = Pinta un trazo de bordos suaves coa cor de primeiro plano e co tamaño, dureza e opacidade de pincel definidos no editor.
tool.brush.history.stroke = Pincel
tool.pencil.name = Lapis
tool.pencil.description = Pinta un trazo de bordos definidos e sen suavizado coa cor de primeiro plano.
tool.pencil.history.stroke = Lapis
tool.eraser.name = Borrador
tool.eraser.description = Borra ao longo do trazo, devolvendo a capa á transparencia.
tool.eraser.history.stroke = Borrador
tool.clone.name = Tampón de clonar
tool.clone.description = Tampón de clonar: preme mantendo Alt para fixar o punto de orixe e, despois, pinta os píxeles copiados desde ese punto co mesmo desprazamento.
tool.clone.history.stroke = Tampón de clonar
tool.dodge.name = Sobreexpoñer
tool.dodge.description = Aclara os píxeles polos que pasa o trazo.
tool.dodge.history.stroke = Sobreexpoñer
tool.burn.name = Subexpoñer
tool.burn.description = Escurece os píxeles polos que pasa o trazo.
tool.burn.history.stroke = Subexpoñer
tool.sponge.name = Esponxa
tool.sponge.description = Satura ou desatura os píxeles polos que pasa o trazo.
tool.sponge.history.stroke = Esponxa
tool.blur.name = Desenfocar
tool.blur.description = Desenfoca os píxeles polos que pasa o trazo.
tool.blur.history.stroke = Desenfocar
tool.sharpen.name = Enfocar
tool.sharpen.description = Enfoca os píxeles polos que pasa o trazo.
tool.sharpen.history.stroke = Enfocar
tool.smudge.name = Dedo
tool.smudge.description = Arrastra a cor ao longo do trazo, como se empurrases pintura húmida.
tool.smudge.history.stroke = Dedo
tool.heal.name = Pincel corrector
tool.heal.description = Pincel corrector: preme mantendo Alt para fixar a orixe e, despois, pinta; a textura da orixe mestúrase coa cor e a iluminación propias do destino.
tool.heal.history.stroke = Pincel corrector
tool.spot_heal.name = Pincel corrector puntual
tool.spot_heal.description = Pincel corrector puntual: pinta sobre unha imperfección para substituíla por textura tomada da contorna; non hai que fixar ningún punto de orixe.
tool.spot_heal.history.stroke = Pincel corrector puntual
tool.history_brush.name = Pincel de historial
tool.history_brush.description = Recupera ao pintar os píxeles da instantánea do historial do documento, desfazendo os traballos posteriores trazo a trazo.
tool.history_brush.history.stroke = Pincel de historial
tool.background_eraser.name = Borrador de fondos
tool.background_eraser.description = Borra a cor tomada baixo o centro do pincel e deixa intactos os píxeles distintos, para separar un suxeito do fondo.
tool.background_eraser.history.stroke = Borrador de fondos
tool.gradient.name = Degradado
tool.gradient.description = Arrastra para encher a capa —a través da selección, se existe— cun degradado lineal que vai da cor de primeiro plano á cor de fondo na dirección do arrastre.
tool.gradient.radial.name = Degradado radial
tool.gradient.radial.description = Arrastra desde o centro cara a fóra para encher cun degradado radial entre as cores de primeiro plano e de fondo.
tool.gradient.option.gradient = Degradado
tool.gradient.option.reverse = Inverter
tool.gradient.option.dither = Tramado
tool.gradient.choice.foreground_to_background = De primeiro plano a fondo
tool.gradient.choice.foreground_to_transparent = De primeiro plano a transparente
tool.gradient.choice.linear = Lineal
tool.gradient.choice.radial = Radial
tool.gradient.choice.angle = Angular
tool.gradient.choice.reflected = Reflectido
tool.gradient.choice.diamond = Diamante
tool.gradient.history.gradient = Degradado
tool.bucket.name = Bote de pintura
tool.bucket.description = Preme para inundar coa cor de primeiro plano a zona conectada de cor semellante situada baixo o punteiro, dentro da tolerancia da ferramenta.
tool.bucket.option.contiguous = Contiguo
tool.bucket.option.all_layers = Todas as capas
tool.bucket.history.fill = Bote de pintura
