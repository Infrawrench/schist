# Ferramentas básicas: Mover, Contagotas, Man e Zoom.

tool.move.name = Mover
tool.move.description = Arrastra o contido da capa activa ata unha nova posición. Coa selección automática activada, ao premer escóllese primeiro a capa —ou o grupo enteiro— que estea baixo o punteiro.
