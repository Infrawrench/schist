command.edit.undo.title = Desfacer
command.edit.undo.description = Retrocede unha entrada no historial de accións desfeitas do documento.
command.edit.redo.title = Refacer
command.edit.redo.description = Repite a última edición desfeita.
command.edit.copy.title = Copiar
command.edit.copy.description = Copia no portapapeis interno os píxeles seleccionados da capa activa (ou a capa enteira se non hai selección).
command.edit.copy_merged.title = Copiar combinado
command.edit.copy_merged.description = Copia a selección tal como a compoñen todas as capas visibles, en vez de copiala só da capa activa.
command.edit.cut.title = Cortar
command.edit.cut.description = Copia no portapapeis os píxeles seleccionados e elimínaos da capa activa.
command.edit.paste.title = Pegar
command.edit.paste.description = Pega o portapapeis nunha capa nova sobre a activa, centrada no lenzo.
command.edit.paste.layer_name = Capa pegada
command.edit.paste_in_place.title = Pegar no mesmo lugar
command.edit.paste_in_place.description = Pega o portapapeis nunha capa nova nas coordenadas das que se copiou.
command.edit.fill_foreground.title = Encher coa cor de primeiro plano
command.edit.fill_foreground.description = Enche coa cor de primeiro plano a selección (ou todo o lenzo se non hai selección).
command.edit.fill_background.title = Encher coa cor de fondo
command.edit.fill_background.description = Enche coa cor de fondo a selección (ou todo o lenzo se non hai selección).
command.select.all.title = Seleccionar todo
command.select.all.description = Selecciona o lenzo enteiro.
command.select.deselect.title = Deseleccionar
command.select.deselect.description = Elimina a selección para que as edicións volvan aplicarse á capa enteira.
command.select.inverse.title = Inverter a selección
command.select.inverse.description = Intercambia as zonas seleccionadas e non seleccionadas.
command.select.reselect.title = Volver seleccionar
command.select.reselect.description = Recupera a última selección eliminada.
command.select.reselect.msg.nothing_to_reselect = Non hai nada que volver seleccionar
command.select.feather.title = Esvaecer selección
command.select.feather.description = Suaviza o bordo da selección cun desenfoque de dous píxeles para que a seguinte edición se esvaeza ao atravesalo.
command.select.grow.title = Aumentar
command.select.grow.description = Amplía a selección aos píxeles contiguos semellantes aos xa seleccionados, dentro da tolerancia da variña máxica.
command.select.similar.title = Semellante
command.select.similar.description = Selecciona todos os píxeles da capa semellantes á selección, sexan contiguos ou non, dentro da tolerancia da variña máxica.
command.select.save.title = Gardar selección
command.select.save.description = Garda a selección actual no documento como unha canle alfa con nome.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Cargar selección
command.select.load.description = Restaura a selección gardada máis recentemente.
command.layer.new.title = Nova capa
command.layer.new.description = Engade unha capa ráster baleira sobre a activa e actívaa.
command.layer.duplicate.title = Duplicar capa
command.layer.duplicate.description = Copia a capa activa con todo o seu contido nunha nova capa situada sobre ela.
command.layer.smart_object.title = Converter en obxecto intelixente
command.layer.smart_object.description = Encapsula os píxeles da capa ráster activa nun obxecto intelixente para que as transformacións e filtros posteriores remostren a orixe intacta.
command.layer.rasterize.title = Rasterizar capa
command.layer.rasterize.description = Converte unha capa de forma, texto ou obxecto intelixente en píxeles simples.
command.layer.delete.title = Eliminar capa
command.layer.delete.description = Elimina as capas seleccionadas.
command.layer.group.title = Agrupar capas
command.layer.group.description = Agrupa no mesmo lugar as capas seleccionadas nun grupo novo.
command.layer.raise.title = Traer cara adiante
command.layer.raise.description = Sobe a capa activa unha posición na pila do seu grupo.
command.layer.lower.title = Enviar cara atrás
command.layer.lower.description = Baixa a capa activa unha posición na pila do seu grupo.
command.layer.to_front.title = Traer á fronte
command.layer.to_front.description = Move a capa activa á parte superior do seu grupo.
command.layer.to_back.title = Enviar ao fondo
command.layer.to_back.description = Move a capa activa á parte inferior do seu grupo.
command.layer.clipping_mask.title = Crear/Liberar máscara de recorte
command.layer.clipping_mask.description = Recorta a capa activa segundo a inferior ou libéraa se xa está recortada; unha capa recortada só se mostra onde a súa base ten píxeles.
command.layer.cut_to_new.title = Capa mediante corte
command.layer.cut_to_new.description = Retira os píxeles seleccionados da capa activa e colócaos nunha capa nova sobre ela.
command.layer.cut_to_new.layer_name = Capa mediante corte
command.layer.add_mask.title = Engadir máscara de capa
command.layer.add_mask.description = Engade unha máscara á capa activa que só deixa visible a selección, se existe.
command.layer.flatten.title = Aplanar imaxe
command.layer.flatten.description = Compón todo o visible nunha única capa Fondo opaca e descarta as capas agochadas.
command.layer.merge_down.title = Combinar cara abaixo
command.layer.merge_down.description = Compón a capa activa coa capa situada debaixo.
command.layer.merge_down.msg.no_layer_below = Non hai ningunha capa inferior coa que combinar
command.layer.merge_visible.title = Combinar visibles
command.layer.merge_visible.description = Compón todas as capas visibles nunha soa e deixa intactas as agochadas.
command.msg.nothing_to_copy = Selecciona unha capa de píxeles da que copiar
command.msg.clipboard_empty = Non hai nada no portapapeis
