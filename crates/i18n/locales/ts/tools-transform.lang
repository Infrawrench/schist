# Ku hundzuluxa hi ku ntshunxeka, ku hundzuluxa nhlawulo ni ku tsema.

tool.transform.name = Hundzuluxa hi ku ntshunxeka
tool.transform.description = Hundzuluxa hi ku ntshunxeka. Loko xi pfuriwa, ku humelela bokisi ro hundzuluxa leri rhendzeleke leyara leyi tirhaka: koka khumbi ku cinca sayizi, koka ehandle ka khumbi ku rhendzevutisa, kutani u koka tlhelo ku voyamisa. A ku tsariwi xo karhi ku kondza u tiyisisa (Enter), naswona ku khansela (Escape) ku tlherisela leyara laha a yi ri kona.
