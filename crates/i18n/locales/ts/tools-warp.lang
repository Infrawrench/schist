tool.liquify.name = Gombonyokisa xifaniso
tool.liquify.description = Susumeta, rhendzevutisa, khwanyanisa kumbe kukumuxa tipikseli ehansi ka burachi leyikulu—nhlawulo wa mode wu hlawula leswi endliwaka. Ku gombonyokisa ku hlengeletana eka nete kutani ku tirhisiwa eka leyara loko ku tiyisisiwa.
