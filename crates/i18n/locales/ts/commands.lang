command.layer.delete.description = Susa maleyara lama hlawuriweke.
command.layer.group.title = Hlanganisa maleyara hi ntlawa
command.layer.group.description = Veka maleyara lama hlawuriweke eka ntlawa lowuntshwa, endhawini ya wona.
command.layer.raise.title = Yisa mahlweni
command.layer.raise.description = Yisa leyara leyi tirhaka ehenhla hi ndhawu yin'we eka ntlhandlamano wa ntlawa wa yona.
command.layer.lower.title = Yisa endzhaku
command.layer.lower.description = Yisa leyara leyi tirhaka ehansi hi ndhawu yin'we eka ntlhandlamano wa ntlawa wa yona.
command.layer.to_front.title = Yisa le mahlweni ngopfu
command.layer.to_front.description = Yisa leyara leyi tirhaka ehenhla ka ntlawa wa yona.
command.layer.to_back.title = Yisa le ndzhaku ngopfu
command.layer.to_back.description = Yisa leyara leyi tirhaka ehansi ka ntlawa wa yona.
command.layer.clipping_mask.title = Endla/Tshika maski yo tsema
command.layer.clipping_mask.description = Tsema leyara leyi tirhaka hi leyi nga ehansi ka yona, kumbe u yi tshika loko se yi tsemiwile; leyara leyi tsemiweke yi vonaka ntsena laha leyara ya masungulo yi nga ni tipikseli.
command.layer.cut_to_new.title = Leyara hi ku tsema
command.layer.cut_to_new.description = Susa tipikseli leti hlawuriweke eka leyara leyi tirhaka u ti yisa eka leyara leyintshwa ehenhla ka yona.
command.layer.cut_to_new.layer_name = Leyara hi ku tsema
command.layer.add_mask.title = Engetela maski ya leyara
command.layer.add_mask.description = Engetela maski eka leyara leyi tirhaka, leyi kombisaka nhlawulo ntsena loko wu ri kona.
command.layer.flatten.title = Hlanganisa xifaniso xi va leyara yin'we
command.layer.flatten.description = Hlanganisa hinkwaswu leswi vonakaka swi va leyara yin'we ya le ndzhaku leyi pfalekeke, u tshika maleyara lama tumbetiweke.
command.layer.merge_down.title = Hlanganisa ni leyi nga ehansi
command.layer.merge_down.description = Hlanganisa leyara leyi tirhaka eka leyara leyi nga ehansi ka yona.
command.layer.merge_down.msg.no_layer_below = Ku hava leyara ehansi yo hlanganisa eka yona
command.layer.merge_visible.title = Hlanganisa leswi vonakaka
command.layer.merge_visible.description = Hlanganisa leyara yin'wana ni yin'wana leyi vonakaka yi va yin'we, u siya maleyara lama tumbetiweke.

