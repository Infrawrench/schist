command.edit.undo.title = Tlherisela endzhaku
command.edit.undo.description = Tlherisela goza rin'we eka matimu ya ku tlherisela endzhaku ka dokhumente.
command.edit.redo.title = Endla nakambe
command.edit.redo.description = Endla nakambe ku hlela loku nga hetelela ku tlheriseriwa endzhaku.
command.edit.copy.title = Kopa
command.edit.copy.description = Kopa tipikseli leti hlawuriweke ta leyara leyi tirhaka u ti yisa eka clipboard ya le ndzeni (leyara hinkwawu loko ku nga hlawuriwanga).
command.edit.copy_merged.title = Kopa leswi hlanganisiweke
command.edit.copy_merged.description = Kopa nhlawulo hi ndlela leyi maleyara hinkwawu lama vonakaka ma hlanganisaka ha yona, ematshan'wini yo kopa eka leyara leyi tirhaka ntsena.
command.edit.cut.title = Tsema
command.edit.cut.description = Kopa tipikseli leti hlawuriweke u ti yisa eka clipboard kutani u ti sula eka leyara leyi tirhaka.
command.edit.paste.title = Namarheta
command.edit.paste.description = Namarheta leswi nga eka clipboard eka leyara leyintshwa ehenhla ka leyi tirhaka, swi ri exikarhini ka khanivhasi.
command.edit.paste.layer_name = Leyara leyi namarhetiweke
command.edit.paste_in_place.title = Namarheta endhawini ya kona
command.edit.paste_in_place.description = Namarheta leswi nga eka clipboard eka leyara leyintshwa eka tikhodineyiti leti swi kopiweke eka tona.
command.edit.fill_foreground.title = Tata hi muhlovo wa le mahlweni
command.edit.fill_foreground.description = Tata nhlawulo (kumbe khanivhasi hinkwawu loko ku nga hlawuriwanga) hi muhlovo wa le mahlweni.
command.edit.fill_background.title = Tata hi muhlovo wa le ndzhaku
command.edit.fill_background.description = Tata nhlawulo (kumbe khanivhasi hinkwawu loko ku nga hlawuriwanga) hi muhlovo wa le ndzhaku.

command.select.all.title = Hlawula hinkwako
command.select.all.description = Hlawula khanivhasi hinkwawu.
command.select.deselect.title = Tshika nhlawulo
command.select.deselect.description = Tshika nhlawulo leswaku ku hlela ku tlhela ku tirha eka leyara hinkwawu.
command.select.inverse.title = Hundzuluxa nhlawulo
command.select.inverse.description = Cincana tindhawu leti hlawuriweke ni leti nga hlawuriwangiki.
command.select.reselect.title = Hlawula nakambe
command.select.reselect.description = Vuyisa nhlawulo lowu nga hetelela ku tshikiwa.
command.select.reselect.msg.nothing_to_reselect = Ku hava xo hlawula nakambe
command.select.feather.title = Olovisa makumu ya nhlawulo
command.select.feather.description = Olovisa makumu ya nhlawulo hi ku ma fihla hi tipikseli timbirhi, leswaku ku hlela loku landzelaka ku nyamalala hakatsongo eka wona.
command.select.grow.title = Kurisa
command.select.grow.description = Ndlandlamuxa nhlawulo wu nghena eka tipikseli leti khumbanaka naswona ti fanaka ni leswi se swi hlawuriweke, hi mpimo wa ku hambana wa nhonga ya masalamusi.
command.select.similar.title = Swa fana
command.select.similar.description = Hlawula pikseli yin'wana ni yin'wana eka leyara leyi fanaka ni nhlawulo, hambi ya wu khumba kumbe e-e, hi mpimo wa ku hambana wa nhonga ya masalamusi.
command.select.save.title = Hlayisa nhlawulo
command.select.save.description = Hlayisa nhlawulo wa sweswi endzeni ka dokhumente wu ri chanele ya alpha leyi nga ni vito.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Layicha nhlawulo
command.select.load.description = Vuyisa nhlawulo lowu hlayisiweke sweswinyana.

command.layer.new.title = Leyara leyintshwa
command.layer.new.description = Engetela leyara ya raster leyi nga riki na chinhu ehenhla ka leyi tirhaka kutani u yi endla leyi tirhaka.
command.layer.duplicate.title = Endla kopi ya leyara
command.layer.duplicate.description = Kopa leyara leyi tirhaka ni leswi nga eka yona hinkwako eka leyara leyintshwa ehenhla ka yona.
command.layer.smart_object.title = Hundzuluxela eka xilo xa vutlhari
command.layer.smart_object.description = Pfala tipikseli ta leyara ya raster leyi tirhaka eka xilo xa vutlhari, leswaku ku hundzuluxa ni tifilitara ta le ndzhaku swi tlhela swi sampula xihlovo lexi nga khumbiwangiki.
command.layer.rasterize.title = Endla leyara yi va raster
command.layer.rasterize.description = Hundzuluxa leyara ya xivumbeko, tsalwa kumbe xilo xa vutlhari yi va tipikseli leti tolovelekeke.
