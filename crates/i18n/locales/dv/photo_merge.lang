# Photographic merging. Machine-assisted translation with terminology review.
photo_merge.title = ފޮޓޯތައް އެއްކޮށްލުން...
photo_merge.align = އޮޓޮމެޓިކް އެލައިންމަންޓް
photo_merge.focus = ތަފާތު ފޯކަސް ޑިސްޓެންސްތަކާއެކު ފޮޓޯތައް އެއްކޮށްލާށެވެ
photo_merge.hdr = މަލްޓިޕަލް އެކްސްޕޯޝަރ ލެވެލްތަކުން އެޗްޑީއާރު
photo_merge.panorama = ފޮޓޯތައް ޕެނަރަމާއަކަށް އެއްކޮށްލާށެވެ
photo_merge.translation = ހަމައެކަނި ހޮރައިޒޮންޓަލް އަދި ވަރޓިކަލް އިމޭޖް މޫވްމަންޓް (X/Y)؛ ރޮޓޭޝަން ނުވަތަ ޕާސްޕެކްޓިވް ކަރެކްޝަން އެއް ނެތެވެ.
photo_merge.crop = ކްރޮޕް ޓު ޝެއަރޑް އޭރިއާ
photo_merge.exposure_note = ކޮންމެ ފޮޓޯއެއްގެ ރިލޭޓިވް އެކްސްޕޯޝަރ ސެޓްކުރުން: +1 އީވީ މާނައަކީ ދެގުނަ އަލިކަމެވެ. 32 ބިޓް އެޗްޑީއާރު ރައްކާތެރިކުރުމަށް އިމޭޖް ޓޯން މެޕިން ޑިސެބަލްކުރުން.
photo_merge.tone_map = އިމޭޖް ޓޯން މެޕިންގ
photo_merge.order = ހުޅުވާފައި ހުންނަ ޑޮކިއުމަންޓް ޓެބްތަކުގެ ތަރުތީބު ބޭނުން ކުރާށެވެ. ކޮންމެ ޕެނަރަމާ ފޮޓޯއެއް ކުރީގެ ފޮޓޯއާ މަދުވެގެން %25 އޯވަލެޕްވާން ޖެހެއެވެ.
photo_merge.invalid = 2–16 ސައްހަ ތަސްވީރު ހޮވައި އެކްސްޕޯޝަރ ސެޓިންގސް ޗެކްކުރުން.
photo_merge.limit = ލިމިޓް: ކޮންމެ ތަސްވީރަކަށް ނުވަތަ އައުޓްޕުޓަކަށް 64 މިލިއަން ޕިކްސެލް، ޖުމްލަ 128 މިލިއަން؛ ކޮންމެ ފަރާތަކަށް 30000 ޕިކްސެލް އެވެ.
photo_merge.no_match = އިތުބާރު ހުރި އޯވަލެޕެއް ނުފެނެއެވެ. ރޮޓޭޝަން ނުވަތަ ޕާސްޕެކްޓިވް ބަދަލު ނުކޮށް އޯވަލެޕް ފޮޓޯ ބޭނުންކުރުން.
