# ބަދަލުކުރެވޭ ފިލްޓަރ ސްޓެކް.
filter_stack.title = ފިލްޓަރ ސްޓެކް
filter_stack.add = ފިލްޓަރެއް އިތުރުކުރުން
filter_stack.enable = ހުއްދަ ދިނުން
filter_stack.disable = ނުހިންގާ ގޮތަށް ހެދުން
filter_stack.up = މައްޗަށް
filter_stack.down = ތިރިއަށް
filter_stack.remove = ނައްތާލުން
filter_stack.bake = ސްޓެކުގެ ރެންޑަރކުރި ފެންނަ ގޮތް ދާއިމީކުރުން
filter_stack.note = ރައްކާކޮށްފައިވާ މަސްދަރުން، މަތީން ތިރިއަށް އެފެކްޓްތައް ހިނގާނެ. އެޑިޓްކުރުމަށް ފިލްޓަރަކަށް ކްލިކްކުރާށެވެ. ކުލަލުން، ގެންދިއުން، ޓްރާންސްފޯމްކުރުން ނުވަތަ ކުލަ މޯޑް ބަދަލުކުރުމުން ސްޓެކުގެ ރެންޑަރކުރި ފެންނަ ގޮތް ދާއިމީވެ، އެޑިޓްކުރެވޭ ސެޓިންގްތައް ނެތިދާނެ؛ އަންޑޫ ކުރުމުން އެ ސެޓިންގްތައް އަލުން ލިބޭނެ.
filter_stack.eligibility = މާހައުލާއި ބޭރުގެ އެހީއެއް ނުބޭނުން ފިލްޓަރުތައް އެކަނި ލިސްޓުކުރެވޭނެ. މެޕެއް، މަގެއް، ފަހަތެއް ނުވަތަ ބޭރުގެ ޑައިލޮގެއް ބޭނުންވާ ފިލްޓަރުތައް ސްޓެކަކަށް ސޭވްނުކުރެވޭނެ.
filter_stack.unavailable = ފިލްޓަރ ސްޓެކް އެޑިޓްކުރުމަށް ލޮކްނުކުރި ޕިކްސެލް ލޭޔަރެއް ނުވަތަ ސްމާޓް އޮބްޖެކްޓެއް ހޮވާށެވެ.
filter_stack.render_failed = ފިލްޓަރ ސްޓެކް ރެންޑަރކުރެވެން ނުކެރުނު. އޭގެ މަސްދަރާއި ސޭވްކުރި ސެޓިންގްތައް ބަދަލުނުވެ ހުރެއެވެ.
filter_stack.edit_history = ފިލްޓަރ ސްޓެކް އެޑިޓްކުރުން
filter_stack.bake_history = ފިލްޓަރ ސްޓެކުގެ ރެންޑަރކުރި ފެންނަ ގޮތް ދާއިމީކުރުން
filter_stack.updated = ފިލްޓަރ ސްޓެކް އަޕްޑޭޓްކުރެވިއްޖެ
filter_stack.missing = ނުލިބޭ ފިލްޓަރ: {id}
