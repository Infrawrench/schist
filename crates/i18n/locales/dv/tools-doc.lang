tool.artboard.name = އާޓްބޯޑް
tool.artboard.description = އާޓްބޯޑެއް ދަމާލައި ހަދާށެވެ: މިއީ މަސްދަރު ކުރާއިރު ވަކިން މަސްދަރުވާ ކެންވަހުގެ ނަންދީފައިވާ ދައިރާއެކެވެ. ކުރިން ހުރި އާޓްބޯޑެއްގެ ތެރޭގައި ދަމާލުމުން އެ އާޓްބޯޑް ބަދަލުވާނެއެވެ.
tool.artboard.default_name = އާޓްބޯޑް {n}

tool.slice.name = ސްލައިސް
tool.slice.description = މަސްދަރު ކުރާ ސްލައިސްއެއް ދަމާލައި ހަދާށެވެ؛ މިއީ ވަކި ފޮޓޯއެއްގެ ގޮތުގައި މަސްދަރުވާ ކެންވަހުގެ ނަންދީފައިވާ ހަތަރުހުޅި ދައިރާއެކެވެ. ކުރިން ހުރި ސްލައިސްއެއްގެ ތެރޭގައި ދަމާލުމުން އެ ސްލައިސް ބަދަލުވާނެއެވެ.
tool.slice.default_name = ސްލައިސް {n}

tool.frame.name = ފްރޭމް
tool.frame.description = ފްރޭމެއް ދަމާލައި ހަދާށެވެ: މިއީ އެތެރެއަށް ލާ ތަކެތި މާސްކު ކުރާ ހަތަރުހުޅި (ނުވަތަ ބިސް ބުރު) ލޭޔަރެކެވެ.
tool.frame.default_name = ފްރޭމް {n}
tool.frame.choice.rectangle = ހަތަރުހުޅި
tool.frame.choice.ellipse = ބިސް ބުރު
tool.frame.history.frame = ފްރޭމް

tool.note.name = ނޯޓް
tool.note.description = ހުސް ކެންވަހުގައި ކްލިކް ކޮށް، އެޑިޓަރުގެ ހާލަތުގައި ހުރި ލިޔުނީ މީހާގެ ނަމާއި ކުލަ ޖަހާފައިވާ ނޯޓެއް އެތަނުގައި ޕިން ކުރާށެވެ؛ ކުރިން ހުރި ޕިންއެއް ކްލިކް ކޮށް ނޯޓްތަކުގެ ޕެނަލަށް އެ ނޯޓް ހޮވާށެވެ.
tool.note.history.place = ނޯޓް ބެހެއްޓުން
tool.note.history.move = ނޯޓް ބަދަލު ކުރުން
tool.note.history.delete = ނޯޓް ފޮހެލުން

tool.count.name = ގުނުން
tool.count.description = ކެންވަހުގައި ނަންބަރު ޖެހި ގުނާ މާކަރުތައް ބެހެއްޓުމަށް ކްލިކް ކުރާށެވެ، ހުރި މާކަރެއް ނައްތާލުމަށް އެއީ ކްލިކް ކުރާށެވެ.
tool.count.default_name = ގުނުން {n}
