tool.pen.name = ގަލަން
tool.pen.description = މަގެއް ހަދާށެވެ: ކަން ޕޮއިންޓަކަށް ކްލިކް ކޮށް، ކާވް ހެންޑަލްތައް ނެރެލުމަށް ދަމައި، ބަންދުކުރުމަށް ފުރަތަމަ ޕޮއިންޓް ކްލިކް ކުރާށެވެ. ކޮމިޓް ކުރުމުން މަގު ޝޭޕް ލޭޔަރަކަށް ހެދޭނެއެވެ.
tool.pen.option.rubber_band = ރަބަރ ބޭންޑް
tool.pen.history.fill = މަގު ފުރުން
tool.pen.default_path_name = މަގު {n}
tool.pen.freeform.name = ފްރީފޯމް ގަލަން
tool.pen.freeform.description = އަތުން ކުރަހާ ރޮނގެއް ދަމާށެވެ؛ ފިޓް އޮޕްޝަނުގައި ބުނާ ލުއިކަމުގައި އެއީ މަގަކަށް ފިޓްވާނެއެވެ.
tool.pen.freeform.option.fit = ފިޓް
tool.pen.curvature.name = ކަވޭޗަރ ގަލަން
tool.pen.curvature.description = ޕޮއިންޓްތަކެއް ކްލިކް ކުރާށެވެ؛ މަގު އެ ޕޮއިންޓްތައް މެދުން މަޑުން ކާވްވާނެއެވެ.
tool.path_select.name = މަގު ހޮވުން
tool.path_select.description = މަގެއް ހޮވުމަށް އެއީ ކްލިކް ކޮށް، މުޅި މަގު ބަދަލުކުރުމަށް ދަމާށެވެ.
tool.direct_select.name = ސީދާ ހޮވުން
tool.direct_select.description = ވަކި އެންކަރ ޕޮއިންޓެއް ނުވަތަ އޭގެ ހެންޑަލްތައް ދަމައި، އެތަނުގެ ވަށައިގެން މަގުގެ ޝޭޕް ބަދަލު ކުރާށެވެ.
tool.shape.history.layer = {name} ލޭޔަރ
tool.shape.rect.name = ހަތަރުހުޅި އާލާތް
tool.shape.rect.label = ހަތަރުހުޅި
tool.shape.rect.description = ކުރިމަތީގެ ކުލައިގެ ހަތަރުހުޅި ޝޭޕް ލޭޔަރެއް ދަމާލާށެވެ؛ އެއީ ވެކްޓަރ ގޮތުގައި ހުރެ، ސައިޒު ބަދަލުކުރާއިރު އަލުން ރާސްޓަރައިޒްވާނެއެވެ.
tool.shape.ellipse.name = ބިސް ބުރު އާލާތް
tool.shape.ellipse.label = ބިސް ބުރު
tool.shape.ellipse.description = ކުރިމަތީގެ ކުލައިގެ ބިސް ބުރު ޝޭޕް ލޭޔަރެއް ދަމާލާށެވެ.
tool.shape.line.name = ރޮނގު އާލާތް
tool.shape.line.label = ރޮނގު
tool.shape.line.description = ކުރިމަތީގެ ކުލައިގެ ސީދާ ރޮނގު ޝޭޕް ލޭޔަރެއް ދަމާލާށެވެ.
tool.shape.line.option.weight = ބޯމިން
tool.shape.line.option.arrow_start = ފެށުން
tool.shape.line.option.arrow_end = ނިމުން
tool.shape.polygon.name = ޕޮލިގޮން އާލާތް
tool.shape.polygon.label = ޕޮލިގޮން
tool.shape.polygon.description = އޮޕްޝަންތަކުން ހޮވާ ކައިރިތަކުގެ އަދަދުން، ކުރިމަތީގެ ކުލައިގެ އާންމު ޕޮލިގޮން ޝޭޕް ލޭޔަރެއް ދަމާލާށެވެ.
tool.shape.polygon.option.sides = ކައިރިތައް
tool.shape.custom.name = ކަސްޓަމް ޝޭޕް
tool.shape.custom.label = ކަސްޓަމް ޝޭޕް
tool.shape.custom.description = ޝޭޕް އޮޕްޝަނުން ހޮވާ، ތެރޭގައި ހިމެނޭ ޕްރީސެޓް ޝޭޕްތަކުން އެއް ޝޭޕެއް ދަމާލާށެވެ.
