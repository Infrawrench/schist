codec.pdn.name = Paint.NET
codec.xcf.name = GIMP XCF
codec.layered.invalid = ލޭޔަރުތައް ހުންނަ ތަސްވީރު ފައިލު ހަލާކުވެފައި ނުވަތަ ފުރިހަމަ ނުވެފައި ވެއެވެ.
codec.layered.too_large = ލޭޔަރުތައް ހުންނަ ތަސްވީރުގެ ސައިޒު ނުވަތަ ލޭޔަރުތަކުގެ އަދަދު ސަޕޯޓް ކުރާ ހައްދުފަހަނަށް ގޮސްފައި ވެއެވެ.
codec.layered.unsupported = މި ފައިލުގައި ސަޕޯޓް ނުކުރާ ސިފައެއް ބޭނުން ކުރެއެވެ: {feature}.
codec.layered.export_layer = “{name}” ލޭޔަރުގައި މި ފޯމެޓުން ރައްކާ ކުރެވޭނެ ނޫން ސިފަތައް ހިމެނެއެވެ. ލޭޔަރ ރާސްޓަރައިޒް ކުރާށެވެ، ނުވަތަ PSD ގެ ގޮތުގައި ސޭވް ކުރާށެވެ.
codec.layered.export_depth = Paint.NET އަށް އެކްސްޕޯޓް ކުރުމަށް 8-ބިޓް RGB ޑޮކިއުމަންޓެއް ބޭނުންވެއެވެ. ފުރަތަމަ ޑޮކިއުމަންޓް 8-ބިޓް RGB އަށް ބަދަލު ކުރާށެވެ.
codec.layered.export_mode = އެކްސްޕޯޓް ކުރުމަށް RGB ޑޮކިއުމަންޓެއް ބޭނުންވެއެވެ. ފުރަތަމަ ޑޮކިއުމަންޓް RGB އަށް ބަދަލު ކުރާށެވެ.

