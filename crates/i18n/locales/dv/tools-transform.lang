tool.transform.resample.bicubic = ބައިކިއުބިކް

tool.crop.name = ކްރޮޕް
tool.crop.description = ބަހައްޓާނެ ދައިރާ ދަމާލައި ހޮވާ، އެއީގެ ހެންޑަލްތައް ރަނގަޅު ކުރާށެވެ؛ ކޮމިޓް (Enter) ކުރުމުން ޑޮކިއުމަންޓް އެ ދައިރާއަށް ކޮށާލެވޭނެއެވެ، ކެންސަލް (Escape) ކުރުމުން އެއީ ބަދަލު ނުވާނެއެވެ.
