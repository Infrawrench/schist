tool.transform.name = ފްރީ ޓްރާންސްފޯމް
tool.transform.description = ފްރީ ޓްރާންސްފޯމް. އެކްޓިވޭޓް ކުރުމުން އެކްޓިވް ލޭޔަރުގެ ވަށައިގެން ޓްރާންސްފޯމް ފޮށިއެއް ހުޅުވޭނެއެވެ: ސައިޒު ބަދަލު ކުރުމަށް ކަންކޮޅެއް ދަމާށެވެ، ބުރުވާލުމަށް ކަންކޮޅެއްގެ ބޭރުގައި ދަމާށެވެ، އަދި އަޅާލުމަށް ކައިރިއެއް ދަމާށެވެ. ކޮމިޓް (Enter) ނުކުރާ ހިނދަކު އެއްވެސް ބަދަލެއް ނުލިޔެވޭނެއެވެ، ކެންސަލް (Escape) ކުރުމުން ލޭޔަރ ކުރިން ހުރި ގޮތަށް އެނބުރޭނެއެވެ.
tool.transform.option.interpolation = އިންޓަޕޮލޭޝަން
tool.transform.history.transform = ފްރީ ޓްރާންސްފޯމް
tool.transform.history.image_size = ފޮޓޯގެ ސައިޒު
tool.transform.history.canvas_size = ކެންވަހުގެ ސައިޒު

tool.transform.selection.name = ސެލެކްޝަން ޓްރާންސްފޯމް ކުރުން
tool.transform.selection.description = ސެލެކްޝަން ޓްރާންސްފޯމް ކުރުން: އެއީ އެ ފޮށިއެވެ، ނަމަވެސް ތެރޭގައި ހުރި ޕިކްސެލްތަކުގެ ބަދަލުގައި ސެލެކްޝަނުގެ ބުރު ބަދަލުވާނެއެވެ. ނިންމުމަށް ކޮމިޓް ނުވަތަ ކެންސަލް ކުރާށެވެ.
tool.transform.selection.history.transform = ސެލެކްޝަން ޓްރާންސްފޯމް ކުރުން

