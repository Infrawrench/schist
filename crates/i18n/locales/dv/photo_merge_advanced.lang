photo_merge_advanced.projective = ޕާސްޕެކްޓިވް އެލައިންމަންޓް (ރޮޓޭޝަން ހިމެނޭ)
photo_merge_advanced.cylindrical = ސިލިންޑްރިކަލް ޕެނަރަމާ އެވެ
photo_merge_advanced.deghost = ހަރަކާތްތެރި ސަބްޖެކްޓުގެ ގޯސްޓް އެފެކްޓްތައް ނައްތާލާށެވެ (ފުރަތަމަ ފޮޓޯ ރެފަރެންސް).
photo_merge_advanced.focal = ފޯކަލް ލެންގްސް (px) / އިމޭޖް ވިޑްތް (px)
photo_merge_advanced.masks = ފޯކަސް އައުޓްޕުޓްގައި ބޭނުންކުރަނީ އެޑިޓް ކުރެވޭ ލޭޔަރ މާސްކްތަކެވެ. ލޭޔަރސް އިން މާސްކެއް ހޮވައި ރިފައިން ކުރަން ކުލަ ޖައްސާށެވެ.
photo_merge_advanced.no_match = އިތުބާރު ހުރި އެލައިންމަންޓެއް ނުފެނެއެވެ. ބޮޑު އޯވަލެޕްއާއި ކުޑަ ވިއުޕޮއިންޓް ބަދަލުތައް ހުރި ޓެކްސްޗަރޑް ފޮޓޯތައް ބޭނުންކުރާށެވެ.
photo_merge_advanced.invalid = ސައްހަ ނޫން ސޯސް އިމޭޖްސް ނުވަތަ މާރޖް ސެޓިންގސް.
