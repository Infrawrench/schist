# ވަރޝަން ހިސްޓްރީ.
versions.title = ވަރޝަން ހިސްޓްރީ
versions.open = ވަރޝަން ހިސްޓްރީ…
versions.original = އަސްލު
versions.current = މިހާރު ސޭވްކޮށްފައިވާ އެޑިޓް
versions.saved_at = {date} UTC ގައި ސޭވްކުރި
versions.saved_sequence = {date} UTC ގައި ސޭވްކުރި ({n})
versions.loading = ޕްރިވިއު ލޯޑްކުރަނީ…
versions.preview_failed = ޕްރިވިއު ނުލިބޭ. ކޮޕީއެއް ހުޅުވަން މަސައްކަތްކުރެވިދާނެ.
versions.drag_hint = ވަކިކުރާ ރޮނގު ދަމާފައި ވާތުން އަސްލާއި ކަނާތުން ހޮވި ވަރޝަން އަޅާކިޔާށެވެ.
versions.no_saved = ސޭވްކުރި އެޑިޓެއް އަދި ނެތް. ކޮންމެ ފަހަރަކު ސޭވްކުރުމުން ކުރީގެ އެޑިޓް މިތާ ބަހައްޓާނެ.
versions.copy_hint = އަލުން ހޯދުމުން ލޭޔަރުތަކާއެކު ސޭވްނުކުރި އާ ޑޮކިއުމަންޓެއް ހުޅުވޭނެ. އެ ކޮޕީ އާ ތަނަކަށް ސޭވްކުރާށެވެ.
versions.restore = ކޮޕީއެއްގެ ގޮތުގައި އަލުން ހޯދުން
versions.restoring = ކޮޕީ ހުޅުވަނީ…
versions.restored = ވަރޝަން ސޭވްނުކުރި ކޮޕީއެއްގެ ގޮތުގައި ހުޅުވިއްޖެ.
versions.copy_title = {name} — އަލުން ހޯދި ކޮޕީ
versions.restore_failed = މި ވަރޝަން ހުޅުވެން ނުކެރުނު: {error}
versions.read_failed = ވަރޝަން ހިސްޓްރީ ކިޔެން ނުކެރުނު: {error}
versions.close = ބަންދު ކުރުން
versions.previous = އާ ވަރޝަންތައް
versions.next = ކުރީގެ ވަރޝަންތައް
versions.page = {total} ސަފުހާއިން {n} ވަނަ ސަފުހާ
versions.preserve_failed = ކުރީގެ އެޑިޓް ރައްކާކުރެވެން ނުކެރުނީމާ ސޭވްކުރުން ކެންސަލްކުރެވިއްޖެ: {error}
versions.revert_failed = ހުރިހާ އެޑިޓެއް ރައްކާކުރެވެން ނުކެރުނު. އަސްލަށް އެނބުރި ފޮޓޯ: {n}. {error}
