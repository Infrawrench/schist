command.edit.undo.title = পূর্বাবস্থায় ফেরান
command.edit.undo.description = নথির পূর্বাবস্থার ইতিহাসে এক ধাপ পেছনে যান।
command.edit.redo.title = আবার করুন
command.edit.redo.description = সর্বশেষ পূর্বাবস্থায় নেওয়া সম্পাদনাটি আবার করুন।
command.edit.copy.title = অনুলিপি
command.edit.copy.description = সক্রিয় লেয়ারের নির্বাচিত পিক্সেল অভ্যন্তরীণ ক্লিপবোর্ডে অনুলিপি করুন (কিছু নির্বাচিত না থাকলে পুরো লেয়ার)।
command.edit.copy_merged.title = একত্রিত অনুলিপি
command.edit.copy_merged.description = শুধু সক্রিয় লেয়ার থেকে নয়, সব দৃশ্যমান লেয়ার যেভাবে একত্রে দেখা যায় সেভাবে নির্বাচনটি অনুলিপি করুন।
command.edit.cut.title = কাটুন
command.edit.cut.description = নির্বাচিত পিক্সেল ক্লিপবোর্ডে অনুলিপি করে সক্রিয় লেয়ার থেকে মুছে দিন।
command.edit.paste.title = পেস্ট
command.edit.paste.description = ক্লিপবোর্ডের বিষয়বস্তু সক্রিয় লেয়ারের ওপরে নতুন একটি লেয়ারে, ক্যানভাসের কেন্দ্রে পেস্ট করুন।
command.edit.paste.layer_name = পেস্ট করা লেয়ার
command.edit.paste_in_place.title = একই স্থানে পেস্ট
command.edit.paste_in_place.description = ক্লিপবোর্ডের বিষয়বস্তু যে স্থানাঙ্ক থেকে অনুলিপি হয়েছিল, সেখানেই নতুন লেয়ারে পেস্ট করুন।
command.edit.fill_foreground.title = সম্মুখভাগ দিয়ে পূরণ
command.edit.fill_foreground.description = নির্বাচনটি (কিছু নির্বাচিত না থাকলে পুরো ক্যানভাস) সম্মুখভাগের রং দিয়ে পূরণ করুন।
command.edit.fill_background.title = পটভূমি দিয়ে পূরণ
command.edit.fill_background.description = নির্বাচনটি (কিছু নির্বাচিত না থাকলে পুরো ক্যানভাস) পটভূমির রং দিয়ে পূরণ করুন।
command.select.all.title = সব নির্বাচন
command.select.all.description = পুরো ক্যানভাস নির্বাচন করুন।
command.select.deselect.title = নির্বাচন বাতিল
command.select.deselect.description = নির্বাচন বাদ দিন, যাতে সম্পাদনা আবার পুরো লেয়ারে প্রয়োগ হয়।
command.select.inverse.title = বিপরীত নির্বাচন
command.select.inverse.description = নির্বাচিত ও অনির্বাচিত অঞ্চল অদলবদল করুন।
command.select.reselect.title = পুনরায় নির্বাচন
command.select.reselect.description = সর্বশেষ বাদ দেওয়া নির্বাচনটি ফিরিয়ে আনুন।
command.select.reselect.msg.nothing_to_reselect = পুনরায় নির্বাচন করার কিছু নেই
command.select.feather.title = নির্বাচন ফেদার
command.select.feather.description = দুই পিক্সেলের ঝাপসা দিয়ে নির্বাচনের প্রান্ত কোমল করুন, যাতে পরের সম্পাদনাটি প্রান্তজুড়ে ধীরে মিলিয়ে যায়।
command.select.grow.title = বৃদ্ধি
command.select.grow.description = ম্যাজিক ওয়ান্ডের সহনশীলতার মধ্যে বর্তমানে নির্বাচিত অংশের সদৃশ সংলগ্ন পিক্সেলে নির্বাচন বাড়ান।
command.select.similar.title = সদৃশ
command.select.similar.description = ম্যাজিক ওয়ান্ডের সহনশীলতার মধ্যে নির্বাচনের সদৃশ লেয়ারের প্রতিটি পিক্সেল নির্বাচন করুন, সংলগ্ন হোক বা না হোক।
command.select.save.title = নির্বাচন সংরক্ষণ
command.select.save.description = বর্তমান নির্বাচনটি নথিতে নামযুক্ত আলফা চ্যানেল হিসেবে রেখে দিন।
command.select.save.channel_name = আলফা {n}
command.select.load.title = নির্বাচন লোড
command.select.load.description = সর্বশেষ সংরক্ষিত নির্বাচনটি পুনরুদ্ধার করুন।
command.layer.new.title = নতুন লেয়ার
command.layer.new.description = সক্রিয় লেয়ারের ওপরে ফাঁকা রাস্টার লেয়ার যোগ করে সেটিকে সক্রিয় করুন।
command.layer.duplicate.title = লেয়ারের প্রতিলিপি
command.layer.duplicate.description = সক্রিয় লেয়ারটি তার সব বিষয়বস্তুসহ ওপরে নতুন লেয়ারে অনুলিপি করুন।
command.layer.smart_object.title = স্মার্ট অবজেক্টে রূপান্তর
command.layer.smart_object.description = সক্রিয় রাস্টার লেয়ারের পিক্সেল স্মার্ট অবজেক্টে মুড়িয়ে দিন, যাতে পরবর্তী রূপান্তর ও ফিল্টার অপরিবর্তিত উৎস থেকে পুনরায় নমুনা নেয়।
command.layer.rasterize.title = লেয়ার রাস্টারাইজ
command.layer.rasterize.description = আকৃতি, টেক্সট বা স্মার্ট-অবজেক্ট লেয়ারকে সাধারণ পিক্সেলে পরিণত করুন।
command.layer.delete.title = লেয়ার মুছুন
