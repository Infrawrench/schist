command.layer.to_back.title = একদম পেছনে পাঠান
command.layer.to_back.description = সক্রিয় লেয়ারটিকে তার গ্রুপের একদম নিচে নিন।
command.layer.clipping_mask.title = ক্লিপিং মাস্ক তৈরি/মুক্ত করুন
command.layer.clipping_mask.description = সক্রিয় লেয়ারটি নিচের লেয়ারে ক্লিপ করুন, অথবা আগে থেকেই ক্লিপ করা থাকলে মুক্ত করুন; ক্লিপ করা লেয়ার শুধু তার ভিত্তিতে পিক্সেল থাকা স্থানে দেখা যায়।
command.layer.cut_to_new.title = কেটে নতুন লেয়ার
command.layer.cut_to_new.description = নির্বাচিত পিক্সেল সক্রিয় লেয়ার থেকে সরিয়ে তার ওপরে নতুন লেয়ারে নিন।
