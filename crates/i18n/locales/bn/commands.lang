command.layer.lower.title = পেছনে পাঠান
command.layer.lower.description = সক্রিয় লেয়ারটিকে তার গ্রুপের স্তূপে এক ধাপ নিচে নিন।
command.layer.to_front.title = একদম সামনে আনুন
