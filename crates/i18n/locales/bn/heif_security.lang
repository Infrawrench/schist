# HEIC security update.
codec.heif.msg.unsafe_version = পরিচিত নিরাপত্তা দুর্বলতার কারণে libheif {version} ব্যবহার প্রত্যাখ্যান করা হচ্ছে; {minimum} বা পরবর্তী সংস্করণ প্রয়োজন। আপডেট করা HEIC সমর্থন ডাউনলোড করুন অথবা সিস্টেমের লাইব্রেরি আপগ্রেড করুন।
codec.heif.msg.unknown_version = libheif-এর সংস্করণ যাচাই করা যাচ্ছে না বলে এর ব্যবহার প্রত্যাখ্যান করা হচ্ছে; {minimum} বা পরবর্তী সংস্করণ প্রয়োজন। আপডেট করা HEIC সমর্থন ডাউনলোড করুন অথবা সিস্টেমের লাইব্রেরি আপগ্রেড করুন।
dialog.open.heic_needs_safe_decoder = “{name}” খুলতে HEVC ডিকোডারসহ libheif {minimum} বা পরবর্তী সংস্করণ প্রয়োজন। পরিচিত নিরাপত্তা দুর্বলতা থেকে সুরক্ষা দিতে পুরোনো বা যাচাই করা যায় না এমন সংস্করণগুলো ব্লক করা হয়েছে। চালিয়ে যেতে আপডেট করা HEIC সমর্থন ডাউনলোড করুন।
workspace.docs.heic_safe_decoder_needed = আপডেট করা HEIC সমর্থন প্রয়োজন
