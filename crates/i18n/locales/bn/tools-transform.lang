tool.transform.name = মুক্ত রূপান্তর
tool.transform.description = মুক্ত রূপান্তর। এটি সক্রিয় করলে সক্রিয় লেয়ারের চারপাশে একটি রূপান্তর বাক্স খোলে: আকার বদলাতে কোণ টানুন, ঘোরাতে কোণের বাইরে টানুন, আর বাঁকাতে প্রান্ত টানুন। নিশ্চিত না করা পর্যন্ত (Enter) কিছু লেখা হয় না; বাতিল করলে (Escape) লেয়ারটি আগের অবস্থায় ফিরে যায়।
tool.transform.option.interpolation = ইন্টারপোলেশন
tool.transform.history.transform = মুক্ত রূপান্তর
tool.transform.history.image_size = ছবির আকার
tool.transform.history.canvas_size = ক্যানভাসের আকার
tool.transform.selection.name = নির্বাচন রূপান্তর
tool.transform.selection.description = নির্বাচন রূপান্তর: একই বাক্স, তবে নির্বাচনের ভেতরের পিক্সেলের বদলে নির্বাচনের সীমারেখা সরায়। শেষ করতে নিশ্চিত করুন বা বাতিল করুন।
tool.transform.selection.history.transform = নির্বাচন রূপান্তর
tool.transform.resample.nearest_neighbor = নিকটতম প্রতিবেশী
tool.transform.resample.bilinear = দ্বিরৈখিক
tool.transform.resample.bicubic = দ্বিঘন
tool.crop.name = ছাঁটাই
tool.crop.description = যে অঞ্চলটি রাখতে চান তা টেনে নির্ধারণ করুন এবং এর হাতলগুলো সামঞ্জস্য করুন; নিশ্চিত করলে (Enter) নথিটি ওই অঞ্চলে ছাঁটাই হয়, আর বাতিল করলে (Escape) অপরিবর্তিত থাকে।
