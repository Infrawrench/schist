# Lens profile controls.
lens_profiles.invalid = সমর্থিত ক্যামেরা বা লেন্স ডেটা সহ একটি বৈধ Lensfun v1/v2 XML ডাটাবেস (8 MiB পর্যন্ত) চয়ন করুন৷
lens_profiles.calibration = লেন্স ক্রমাঙ্কন
lens_profiles.no_calibration = কোন ক্রমাঙ্কন এই সেটিংস কভার. ফোকাল দৈর্ঘ্য এবং ক্যামেরা ক্রপ ফ্যাক্টর পরীক্ষা করুন; ম্যানুয়াল সংশোধন উপলব্ধ থাকে।
lens_profiles.import = Lensfun XML আমদানি করুন…
lens_profiles.imported = এই সেশনের জন্য Lensfun ডাটাবেস আমদানি করা হয়েছে। একটি প্রোফাইল নির্বাচন করুন বা ফটো মেটাডেটা মেলে।
lens_profiles.manual = শুধুমাত্র ম্যানুয়াল সংশোধন
lens_profiles.saved = সংরক্ষিত ক্রমাঙ্কন (ডাটাবেস অনুপলব্ধ)
lens_profiles.profile = লেন্স প্রোফাইল
lens_profiles.aperture = অ্যাপারচার (0 = অজানা)
lens_profiles.distance = ফোকাস দূরত্ব (0 = অজানা)
lens_profiles.vignette = ক্যালিব্রেটেড ভিগনেটিং
lens_profiles.color_context = ক্যালিব্রেটেড ভিগনেটিংয়ের জন্য বিল্ট-ইন sRGB প্রোফাইল প্রয়োজন। চেহারা সংরক্ষণ করতে sRGB-তে রূপান্তর করুন, তারপরে লেন্স সংশোধন আবার খুলুন। ইতিমধ্যে-sRGB মুক্ত পিক্সেলের জন্য, sRGB বরাদ্দ করা যথেষ্ট। জ্যামিতি এবং রঙিন সংশোধন উপলব্ধ থাকে।
lens_profiles.vignette_missing = কোন ভিগনেটিং ক্রমাঙ্কন অ্যাপারচার এবং ফোকাস দূরত্ব কভার করে না। এটি সক্ষম করতে পরিমাপ করা মান লিখুন; অনেক Lensfun প্রোফাইলে 1000 m দূরবর্তী ফোকাস প্রতিনিধিত্ব করে।
lens_profiles.note = ম্যানুয়াল নিয়ন্ত্রণের আগে ক্যালিব্রেটেড সংশোধন প্রয়োগ হয়। মূল পূর্ণ ফ্রেম ব্যবহার করুন; পরে ক্রপ করুন। সম্পাদনাযোগ্য ক্রমাঙ্কন ধরে রাখতে PSD/PSB-তে ফিল্টার স্ট্যাক সংরক্ষণ করুন।
lens_profiles.automatic = ছবির মেটাডেটা মেলে
lens_profiles.components = প্রোফাইল প্রয়োগ: বিকৃতি {distortion}; রঙের প্রান্ত {tca}; ভিগনেটিং {vignette}।
