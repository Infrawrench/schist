# Photographic merging. Machine-assisted translation with terminology review.
photo_merge.title = Сүрөттөрдү бириктирүү…
photo_merge.align = Автоматтык тегиздөө
photo_merge.focus = Фокустун ар кандай аралыктары менен сүрөттөрдү бириктириңиз
photo_merge.hdr = Бир нече экспозиция деңгээлинен HDR
photo_merge.panorama = Сүрөттөрдү панорамага бириктириңиз
photo_merge.translation = Бир гана горизонталдуу жана вертикалдуу сүрөт кыймылы (X/Y); эч кандай айлануу же перспективалык оңдоо.
photo_merge.crop = Бөлүшүлгөн аймакка кесүү
photo_merge.exposure_note = Ар бир сүрөттүн салыштырмалуу экспозициясын коюңуз: +1 EV эки эсе көп жарыкты билдирет. 32-бит HDRди сактоо үчүн сүрөттүн тонунун картасын өчүрүңүз.
photo_merge.tone_map = Сүрөттүн тонунун картасы
photo_merge.order = Ачык документ өтмөктөрүнүн тартибин колдонуңуз. Ар бир панорама сүрөтү мурунку сүрөткө 25%дан кем эмес дал келиши керек.
photo_merge.invalid = 2–16 жарактуу сүрөттөрдү тандап, экспозиция орнотууларын текшериңиз.
photo_merge.limit = Чек: сүрөт же чыгаруу үчүн 64 миллион пиксел, жалпысынан 128 миллион; Ар бир тарапка 30000 пиксел.
photo_merge.no_match = Ишенимдүү дал келүү табылган жок. Айлануусуз же перспективасын өзгөртпөстөн, кабатталган сүрөттөрдү колдонуңуз.
