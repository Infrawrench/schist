workspaces.current = Учурдагы жайгашуу
workspaces.help = Башкача сактоо учурдагы жайгашуунун аталышы бар көчүрмөсүн түзөт. Сакталган жайгашууну колдонуу, жаңыртуу, атын өзгөртүү же жок кылуу үчүн аны тандаңыз. Жайгашууну түзөтүүлөр дароо күчүнө кирет.
workspaces.show_panels = Каптал панелдерин көрсөтүү
workspaces.automatic = Автоматтык
workspaces.reset_help = Баштапкы абалга келтирүү панелдердин демейки жайгашуусун гана калыбына келтирет. Сакталган иш мейкиндиктери, документтер жана башка жөндөөлөр сакталып калат.
workspaces.save_error = Иш мейкиндигинин жөндөөлөрүн сактоо мүмкүн болгон жок. Өзгөртүү колдонулган жок.
workspaces.invalid_name = Башкаруу белгилери жок, узундугу 1–80 белгиден турган ат киргизиңиз.
workspaces.duplicate = Мындай аталыштагы иш мейкиндиги мурунтан бар.
workspaces.limit = 64кө чейин иш мейкиндигин сактай аласыз.
workspaces.keyboard = Баскычтоп: Alt+↑/↓ жайгашууну тандайт. Ctrl/Cmd+N анын атын түзөтөт; +S көчүрмөсүн сактайт; +Enter колдонот; +U жаңыртат; +R атын өзгөртөт; +D жок кылат; +0 баштапкы абалга келтирет.
