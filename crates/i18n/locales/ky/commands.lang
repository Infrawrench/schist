command.edit.undo.title = Артка кайтаруу
command.edit.undo.description = Документтин артка кайтаруу таржымалында бир кадам артка өтүү.
command.edit.redo.title = Кайталоо
command.edit.redo.description = Акыркы жолу артка кайтарылган өзгөртүүнү кайталоо.
command.edit.copy.title = Көчүрүү
command.edit.copy.description = Активдүү катмардын тандалган пикселдерин ички алмашуу буферине көчүрүү (эч нерсе тандалбаса, бүт катмарды).
command.edit.copy_merged.title = Бириктирип көчүрүү
command.edit.copy_merged.description = Тандалган аймакты активдүү катмардан гана эмес, бардык көрүнгөн катмарлардын композициясынан көчүрүү.
command.edit.cut.title = Кесип алуу
command.edit.cut.description = Тандалган пикселдерди алмашуу буферине көчүрүп, активдүү катмардан өчүрүү.
command.edit.paste.title = Чаптоо
command.edit.paste.description = Алмашуу буфериндеги нерсени активдүү катмардын үстүндөгү жаңы катмарга, кенептин ортосуна чаптоо.
command.edit.paste.layer_name = Чапталган катмар
command.edit.paste_in_place.title = Өз ордуна чаптоо
command.edit.paste_in_place.description = Алмашуу буфериндеги нерсени көчүрүлгөн координаттарындагы жаңы катмарга чаптоо.
command.edit.fill_foreground.title = Алдыңкы пландын түсү менен толтуруу
command.edit.fill_foreground.description = Тандалган аймакты (эч нерсе тандалбаса, бүт кенепти) алдыңкы пландын түсү менен толтуруу.
command.edit.fill_background.title = Арткы пландын түсү менен толтуруу
command.edit.fill_background.description = Тандалган аймакты (эч нерсе тандалбаса, бүт кенепти) арткы пландын түсү менен толтуруу.

command.select.all.title = Баарын тандоо
command.select.all.description = Бүт кенепти тандоо.
command.select.deselect.title = Тандоону алып салуу
command.select.deselect.description = Өзгөртүүлөр кайрадан бүт катмарга колдонулушу үчүн тандоону алып салуу.
command.select.inverse.title = Тандоону тескерилетүү
command.select.inverse.description = Тандалган жана тандалбаган аймактарды орун алмаштыруу.
command.select.reselect.title = Кайра тандоо
command.select.reselect.description = Акыркы жолу алынып салынган тандоону калыбына келтирүү.
command.select.reselect.msg.nothing_to_reselect = Кайра тандай турган эч нерсе жок
command.select.feather.title = Тандоонун четтерин жумшартуу
command.select.feather.description = Кийинки өзгөртүү четинде акырындап жоголушу үчүн тандоонун четин эки пикселге бүдөмүктөтүп жумшартуу.
command.select.grow.title = Чоңойтуу
command.select.grow.description = Сыйкырдуу таякчанын жол берилген айырмасынын чегинде, тандалган пикселдерге окшош жана аларга тийишкен пикселдерди тандоого кошуу.
command.select.similar.title = Окшош
command.select.similar.description = Сыйкырдуу таякчанын жол берилген айырмасынын чегинде, катмардагы тандоого окшош бардык пикселдерди, тийишсе да, тийишпесе да тандоо.
command.select.save.title = Тандоону сактоо
command.select.save.description = Учурдагы тандоону документте аталышы бар альфа-канал катары сактап коюу.
command.select.save.channel_name = Альфа {n}
command.select.load.title = Тандоону жүктөө
command.select.load.description = Эң акыркы сакталган тандоону калыбына келтирүү.

command.layer.new.title = Жаңы катмар
command.layer.new.description = Активдүү катмардын үстүнө бош растрдык катмар кошуп, аны активдүү кылуу.
command.layer.duplicate.title = Катмардын көчүрмөсүн түзүү
command.layer.duplicate.description = Активдүү катмарды бүт мазмуну менен анын үстүндөгү жаңы катмарга көчүрүү.
command.layer.smart_object.title = Акылдуу объектке айландыруу
command.layer.smart_object.description = Кийинки өзгөртүүлөр жана фильтрлер тийилбеген булакты кайра үлгүлөй алышы үчүн активдүү растрдык катмардын пикселдерин акылдуу объектке ороо.
command.layer.rasterize.title = Катмарды растрлоо
command.layer.rasterize.description = Фигура, текст же акылдуу объект катмарын кадимки пикселдерге айландыруу.
command.layer.delete.title = Катмарды өчүрүү
command.layer.delete.description = Тандалган катмарларды өчүрүү.
command.layer.group.title = Катмарларды топтоо
command.layer.group.description = Тандалган катмарларды ошол ордунда жаңы топко киргизүү.
command.layer.raise.title = Алга жылдыруу
command.layer.raise.description = Активдүү катмарды өз тобунда бир орун өйдө жылдыруу.
command.layer.lower.title = Артка жылдыруу
command.layer.lower.description = Активдүү катмарды өз тобунда бир орун ылдый жылдыруу.
command.layer.to_front.title = Эң алдыга чыгаруу
command.layer.to_front.description = Активдүү катмарды өз тобунун эң үстүнө жылдыруу.
command.layer.to_back.title = Эң артка жөнөтүү
command.layer.to_back.description = Активдүү катмарды өз тобунун эң астына жылдыруу.
command.layer.clipping_mask.title = Кесүүчү масканы түзүү/бошотуу
command.layer.clipping_mask.description = Активдүү катмарды астындагы катмарга кесүү же мурунтан кесилген болсо бошотуу; кесилген катмар негизинде пикселдер бар жерлерде гана көрүнөт.
command.layer.cut_to_new.title = Кесип жаңы катмар түзүү
command.layer.cut_to_new.description = Тандалган пикселдерди активдүү катмардан алып, анын үстүндөгү жаңы катмарга жылдыруу.
command.layer.cut_to_new.layer_name = Кесип түзүлгөн катмар
command.layer.add_mask.title = Катмар маскасын кошуу
command.layer.add_mask.description = Активдүү катмарга маска кошуу; тандоо бар болсо, ал тандалган аймакты гана көрсөтөт.
command.layer.flatten.title = Сүрөттү бир катмарга бириктирүү
command.layer.flatten.description = Бардык көрүнгөн нерсени бир тунук эмес «Фон» катмарына бириктирип, жашырылган катмарларды алып салуу.
command.layer.merge_down.title = Төмөнкү катмар менен бириктирүү
command.layer.merge_down.description = Активдүү катмарды астындагы катмар менен бир композицияга бириктирүү.
command.layer.merge_down.msg.no_layer_below = Бириктирүү үчүн астында катмар жок
command.layer.merge_visible.title = Көрүнгөндөрдү бириктирүү
command.layer.merge_visible.description = Бардык көрүнгөн катмарларды бир катмарга бириктирип, жашырылган катмарларга тийбөө.

command.msg.nothing_to_copy = Көчүрүү үчүн пикселдик катмарды тандаңыз
command.msg.clipboard_empty = Алмашуу буферинде эч нерсе жок

