tool.brush.name = Кылкалем
tool.brush.description = Редактордогу кылкалемдин өлчөмүнө, катуулугуна жана тунуктугуна жараша алдыңкы пландын түсү менен четтери жумшак сызык тартыңыз.
tool.brush.history.stroke = Кылкалем

tool.pencil.name = Карандаш
tool.pencil.description = Алдыңкы пландын түсү менен четтери катуу, антиалиасингсиз сызык тартыңыз.
tool.pencil.history.stroke = Карандаш

tool.eraser.name = Өчүргүч
tool.eraser.description = Сызык боюнча өчүрүп, катмарды кайра тунук кылыңыз.
tool.eraser.history.stroke = Өчүргүч

tool.clone.name = Клондоочу штамп
tool.clone.description = Клондоочу штамп: баштапкы чекитти коюу үчүн Alt менен басыңыз, анан ошол чекиттен белгиленген жылышта көчүрүлгөн пикселдер менен боёңуз.
tool.clone.history.stroke = Клондоочу штамп

tool.dodge.name = Агарткыч
tool.dodge.description = Сызык өткөн пикселдерди агартыңыз.
