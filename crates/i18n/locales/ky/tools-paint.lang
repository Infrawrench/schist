tool.sponge.name = Губка
tool.sponge.description = Сызык өткөн пикселдердин түсүн каныктырыңыз же каныккандыгын азайтыңыз.
tool.sponge.history.stroke = Губка

tool.blur.name = Бүдөмүктөгүч
