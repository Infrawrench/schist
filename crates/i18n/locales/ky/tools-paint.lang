tool.blur.history.stroke = Бүдөмүктөгүч
tool.sharpen.name = Курчуткуч
tool.sharpen.description = Сызык өткөн пикселдерди курчутуңуз.
tool.sharpen.history.stroke = Курчуткуч
tool.smudge.name = Жайгыч
tool.smudge.description = Нымдуу боёкту түрткөндөй, түстү сызык боюнча жайыңыз.
tool.smudge.history.stroke = Жайгыч

tool.heal.name = Калыбына келтирүүчү кылкалем
tool.heal.description = Калыбына келтирүүчү кылкалем: булакты коюу үчүн Alt менен басып, анан боёңуз; булактын текстурасы көздөгөн жердин түсү жана жарыгы менен аралашат.
tool.heal.history.stroke = Калыбына келтирүүчү кылкалем
tool.spot_heal.name = Чекиттик калыбына келтирүүчү кылкалем
tool.spot_heal.description = Чекиттик калыбына келтирүүчү кылкалем: тактын үстүнөн боёсоңуз, ал тегерегинен алынган текстура менен алмашат; булак чекитин коюунун кереги жок.
tool.spot_heal.history.stroke = Чекиттик калыбына келтирүүчү кылкалем

tool.history_brush.name = Таржымал кылкалеми
tool.history_brush.description = Документтин таржымал сүрөтүнөн пикселдерди кайра боёп чыгарып, кийинки иштерди сызык сайын жокко чыгарыңыз.
