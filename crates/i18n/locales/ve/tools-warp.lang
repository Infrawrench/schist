tool.liquify.name = Liquify
tool.liquify.description = Sukumedza, monisa, kwanyeledza kana kukumusa dzipixel fhasi ha bulatsho ḽihulu — khetho ya moudu i nanga zwine zwa itwa. U shanduka hu kuvhangana kha mesh nahone hu shumiswa kha ḽeyara musi hu tshi khwaṱhisedzwa.
tool.liquify.option.tool = Tshishumiswa
tool.liquify.choice.forward_warp = Shandukisa u ya Phanḓa
tool.liquify.choice.reconstruct = Fhaṱulula hafhu
tool.liquify.choice.twirl_cw = Monisa nga sia ḽa watshi
tool.liquify.choice.twirl_ccw = Monisa u hanedza sia ḽa watshi
tool.liquify.choice.pucker = Kwanyeledza
tool.liquify.choice.bloat = Kukumusa
tool.liquify.choice.push_left = Sukumedza Monde
tool.liquify.history.liquify = Liquify
tool.puppet_warp.name = Shanduko ya Phaphete
tool.puppet_warp.description = Puṱedza u vhofha ḽeyara kha zwipiḓa zwi si gathi, nga murahu ni kokodze tshithihi: mesh i a peta u mona na dzipini, yo oma kana yo vhofholowa u ya nga khetho ya u Oma. U khwaṱhisedza zwi shumisa tshanduko.
tool.puppet_warp.option.stiffness = U Oma
tool.puppet_warp.history.puppet_warp = Shanduko ya Phaphete
tool.vanishing_point.name = Tshithoma tsha u nyamalala
tool.vanishing_point.description = Kokodza u sika pulane kha tshithu tshi re na phersipekithivi, nga murahu ni tshintshele moudu kha u Kopa ni pennde: dzipixel dzo kopiwaho dzi tevhela pulane, dzi tshi ṱukufhala na vhukule.
tool.vanishing_point.choice.edit_plane = Dzudzanya Pulane
tool.vanishing_point.choice.clone = Kopa
tool.vanishing_point.history.vanishing_point = Tshithoma tsha u nyamalala
