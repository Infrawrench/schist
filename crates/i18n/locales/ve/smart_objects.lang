smart.history.place = Vhea Smart Object
smart.history.embed = Dzhenisa tshiko tsha Smart Object tshi senguluseaho
smart.error.failed = Smart Object: {error}
smart.error.too_large = Tshiko tshi fhira mugumo wa dziphikisele dza miḽioni dza 32, dziphikisele dza 30,000 kha lurumbu luṅwe na luṅwe, kana 64 MiB.
smart.error.invalid = Tshiko tsha Smart Object tsho dzheniswaho a tshi shumi.
smart.error.unsupported = Fomathi iyi ya tshiko i nga si shumiswe sa Smart Object.
smart.error.locked = Vulani zwifanyiso zwoṱhe zwa tshiko ni sa athu zwi khwinisa.
smart.error.select = Nangani ḽeyara ya Smart Object i songo khiiwaho.
smart.error.browser_link = Ṱhumanyo dza sisiṱeme ya faela dzi wanala kha app ya desikithopo. Shumisani Smart Object yo dzheniswaho kha browser.
smart.error.changed = Fhethu hune zwa ya hone ho shanduka musi hu tshi senguluswa kana u dzheniswa. Vulani zwi re ngomu hafhu kana ni dovhe ni nange tshiko.
smart.error.no_link = Smart Object iyi a i na ṱhumanyo ya faela. Shumisani Ṱumanya Smart Object Hafhu u nanga tshiko.
smart.error.nesting = Valani thebu ya zwi re ngomu ni sa athu vula tshiṅwe tshiko tshi re ngomu.
smart.error.parent_closed = Ḽiṅwalo ḽa mubebi ḽo valiwa. Shumisani Vhulunga sa u vhulunga ḽiṅwalo iḽi ḽa zwi re ngomu.
smart.error.file_changed = Faela yo ṱumanywaho yo shanduka nnḓa ha Schist. Shumisani Vhulunga sa u vhulunga zwe na sengulusa, nga murahu Ṱumanya Smart Object Hafhu kana Khwinisa Zwifanyiso zwo Ṱumanywaho.
