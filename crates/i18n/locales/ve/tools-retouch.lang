tool.patch.name = Tshipatsho
tool.patch.description = Kokodza mutalo u monaho tshinyalo, nga murahu u kokodze zwo nangiwaho kha dzipixel dzo kunaho: thekisitsha ya henefho i dzheniswa kha tshinyalo. Moudu wa u nama u nanga uri ndi thungo ifhio ya zwenezwo zwivhili ine na i kokodza.
tool.patch.option.patch = Tshipatsho
tool.patch.choice.source = Tshiko
tool.patch.choice.destination = Hune zwa ya hone
tool.patch.history.patch = Tshipatsho
tool.content_aware_move.name = Sudzulusa u tshi ṱhogomela zwi re ngomu
tool.content_aware_move.description = Kokodza tshithu tsho nangiwaho u tshi isa huṅwe, buli ḽine tsha ḽi sia ḽa ḓadzwa nga zwi re tsini. Kha moudu wa u Engedza, tshithu tshi a tatamudzwa nṱhani ha u sudzuluswa.
tool.content_aware_move.choice.move = Sudzulusa
tool.content_aware_move.choice.extend = Engedza
tool.content_aware_move.history.move = Sudzulusa u tshi ṱhogomela zwi re ngomu
tool.red_eye.name = Iṱo ḽitswuku
tool.red_eye.description = Puṱedza ṅwana wa iṱo u bvisa vhutswuku ha fuḽeshe khawo.
tool.red_eye.option.pupil_size = Saizi ya Ṅwana wa Iṱo
tool.red_eye.option.darken = Swifhadza
tool.red_eye.history.red_eye = Iṱo ḽitswuku
tool.magic_eraser.name = Tshiphomi tsha manditi
tool.magic_eraser.description = Puṱedza u phumula fhethu ha muvhala u fanaho hu re fhasi ha tshisumbi, u ya nga tshikalo tsha u konḓelela tsha tshishumiswa — hu songo khethekana na he ha puṱedzwa, kana huṅwe na huṅwe kha ḽeyara.
tool.magic_eraser.option.contiguous = Zwo ṱumanaho
tool.magic_eraser.history.erase = Tshiphomi tsha manditi

# Remove
tool.remove.name = Bvisa
tool.remove.description = Pennda nṱha ha tshithu tshi sa ṱoḓei nga mutalo muthihi; musi ni tshi tutshela, tshi ḓo ḓadzwa nga zwi re tsini natsho. Arali “Bvisa Nga Murahu ha Mutalo Muṅwe na Muṅwe” yo dzimiwa, penndani mitalo minzhi ni kone u pwashea Enter u i bvisa yoṱhe nga tshifhinga tshithihi.
tool.remove.option.sample_all_layers = Tsumbo ya Dziḽeyara Dzoṱhe
tool.remove.option.remove_after_each_stroke = Bvisa Nga Murahu ha Mutalo Muṅwe na Muṅwe
tool.remove.history.remove = Bvisa
tool.remove.layer_name = Zwo bviswa
