# Lens profiles.
lens_profiles.invalid = Khethani database ya Lensfun v1/v2 XML i shumaho (u swika kha 8 MiB) i re na data ya khamera kana ḽentsi i tikedzwaho.
lens_profiles.calibration = U kalibara ḽentsi
lens_profiles.no_calibration = A hu na kalibareisheni i katelaho hedzi nzudzanyo. Sedzani vhulapfu ha focal na tshikalo tsha u geredza tsha khamera; u khakhulula nga tshanḓa hu kha ḓi hone.
lens_profiles.import = Dzhenisani Lensfun XML…
lens_profiles.imported = Database ya Lensfun yo dzheniswa kha heḽi sesheni. Nangani phurofaiḽi kana ni i vhambedze na metadata ya tshinepe.
lens_profiles.manual = U khakhulula nga tshanḓa fhedzi
lens_profiles.saved = Kalibareisheni yo vhulungwaho (database a i wanali)
lens_profiles.profile = Phurofaiḽi ya ḽentsi
lens_profiles.aperture = Vhuhulu ha buli ḽa ḽentsi (0 = a zwi ḓivhei)
lens_profiles.distance = Vhukhule ha u sedza (0 = a zwi ḓivhei)
lens_profiles.vignette = Vignette yo kalibarwaho
lens_profiles.color_context = Vignette yo kalibarwaho i ṱoḓa phurofaiḽi ya sRGB yo dzheniswaho. Shandukiselani kha sRGB uri mbonalo i dzule i sa shanduki, ni vule hafhu U Khakhulula Ḽentsi. Arali pixels dzi si na tshiga dzo no vha sRGB, u dzi ṋea sRGB zwi a eḓana. U khakhulula tshivhumbeo na mivhala hu kha ḓi wanala.
lens_profiles.vignette_missing = A hu na kalibareisheni ya vignette i katelaho vhuhulu ha buli na vhukhule ha u sedza. Dzhenisani zwikalo zwo elwaho uri ni i shumise; kha phurofaiḽi nnzhi dza Lensfun, 1000 m i amba u sedza kule.
lens_profiles.note = U khakhulula ho kalibarwaho hu thoma phanḓa ha nzudzanyo dza nga tshanḓa. Shumisani tshifanyiso tsha u thoma tshoṱhe; ni tshi geredze nga murahu. Vhulungani tshigwada tsha dzifiḽithara kha PSD/PSB uri kalibareisheni i kone u dzudzanywa.
lens_profiles.automatic = Vhambedzani na metadata ya tshinepe
lens_profiles.components = U shumisa phurofaiḽi: u khothea {distortion}; mivhala ya malungo {tca}; vignette {vignette}.
