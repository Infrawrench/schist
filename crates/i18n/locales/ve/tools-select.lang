tool.select.mode.subtract = Ṱusa
tool.select.mode.intersect = Ṱangana
tool.marquee.rect.name = Tshinangi tsha Tshikwea
tool.marquee.rect.description = Kokodza u sika zwo nangiwaho zwa tshikwea. Shift mathomoni a u kokodza i engedza kha zwo nangiwaho, alt i a ṱusa, dzoṱhe dzi a fhambanya; Shift musi ni tshi khou kokodza i zwi ita tshikwea tshi linganaho. U puṱedza hu si na u kokodza zwi litshisa u nanga.
tool.marquee.ellipse.name = Tshinangi tsha Tshitendeledzi
tool.marquee.ellipse.description = Kokodza u sika zwo nangiwaho zwa tshitendeledzi, nga u ṱanganya ha Shift/alt hu fanaho na ha tshinangi tsha tshikwea.
tool.lasso.name = Lasso
tool.lasso.description = Kokodza mutalo wo vhofholowaho; zwo nangiwaho zwi vala vhukati ha magumo musi u kokodza hu tshi fhela. Shift i a engedza, alt i a ṱusa.
tool.lasso.history.select = U Nanga nga Lasso
tool.lasso.polygonal.name = Lasso ya Phoḽigoni
tool.lasso.polygonal.description = Puṱedzani khuḓa nga khuḓa u fhaṱa zwo nangiwaho zwa meme dzo tswititaho, ni puṱedze tsini na tshithoma tsha u thoma u zwi vala.
tool.lasso.polygonal.history.select = Lasso ya Phoḽigoni
tool.lasso.magnetic.name = Lasso ya Maginete
tool.lasso.magnetic.description = Tevhelani meme nga u angaredza nahone mutalo u ḓo nambatela kha phambano khulwane i re tsini na nḓila.
tool.lasso.magnetic.history.select = Lasso ya Maginete
tool.lasso.magnetic.option.frequency = Frekhwentsi
tool.wand.name = Luṱanga lwa Manditi
tool.wand.description = Puṱedzani u nanga fhethu ho ṱumanaho ha muvhala u fanaho fhasi ha tshisumbi, u ya nga khetho ya u konḓelela -- u konḓelela huthihi hune Engedza, Zwi Fanaho na Tshikhala tsha Mivhala zwa vhala.
tool.wand.option.contiguous = Zwo ṱumanaho
tool.wand.history.select = Luṱanga lwa Manditi
tool.quick_select.name = U Nanga nga u Ṱavhanya
tool.quick_select.description = Penndani kha fhethu nahone zwo nangiwaho zwi engedzea kha dzipixel dzi fanaho dzine bulatsho ḽa fhira khadzo.
tool.quick_select.history.select = U Nanga nga u Ṱavhanya
tool.object_select.name = U Nanga Tshithu
tool.object_select.description = Kokodza bogisi ḽi mone tshithu nahone zwo nangiwaho zwi nambatela kha tshithu tsho wanalaho ngomu haḽo.
tool.object_select.history.select = U Nanga Tshithu
