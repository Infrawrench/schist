tool.pen.name = Peni
tool.pen.description = Fhaṱani nḓila: puṱedzani u itela tshithoma tsha khuḓa, kokodzani u bvisa zwifaraho zwa khavhe khatsho, ni puṱedze tshithoma tsha u thoma u vala. U khwaṱhisedza zwi shandula nḓila ya vha ḽeyara ya tshivhumbeo.
tool.pen.option.rubber_band = Bannda ḽa Raba
tool.pen.history.fill = U Ḓadza Nḓila
tool.pen.default_path_name = Nḓila {n}
tool.pen.freeform.name = Peni yo Vhofholowaho
tool.pen.freeform.description = Kokodza mutalo wo vhofholowaho nahone u linganyiswa na nḓila, u ya nga u vhofholowa ho bulwaho nga khetho ya u Linganyisa.
tool.pen.freeform.option.fit = Linganyisa
tool.pen.curvature.name = Peni ya Khavhe
tool.pen.curvature.description = Puṱedzani mutevhe wa zwithoma nahone nḓila i peta nga u tsenzhelela i tshi fhira khazwo.
tool.path_select.name = U Nanga Nḓila
tool.path_select.description = Puṱedzani nḓila u i nanga, ni kokodze u sudzulusa nḓila yoṱhe.
tool.direct_select.name = U Nanga nga u Livha
tool.direct_select.description = Kokodzani tshithoma tshithihi tsha u khwaṱhisa kana zwifaraho zwatsho u shandula tshivhumbeo tsha nḓila i tshi mona natsho.
