codec.layered.invalid = Faela ya tshifanyiso tshi re na dziḽeyara yo tshinyala kana a yo ngo fhelela.
codec.layered.too_large = Vhuhulwane ha tshifanyiso kana tshivhalo tsha dziḽeyara zwi fhira zwine zwa tikedzwa.
codec.layered.unsupported = Faela iyi i shumisa tshiteṅwa tshi sa tikedzwi: {feature}.
codec.layered.export_layer = Ḽeyara “{name}” i na zwiteṅwa zwine fomathi iyi ya sa kone u zwi vhulunga. I shandukiseleni kha dzipixel kana ni i vhulunge sa PSD.
codec.layered.export_depth = U rumela kha Paint.NET zwi ṱoḓa ḽiṅwalo ḽa RGB ḽa biti dza 8. Thomani nga u shandukisela ḽiṅwalo kha RGB ya biti dza 8.
codec.layered.export_mode = U rumela zwi ṱoḓa ḽiṅwalo ḽa RGB. Thomani nga u shandukisela ḽiṅwalo kha RGB.

