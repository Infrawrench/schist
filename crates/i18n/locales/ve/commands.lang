# Ndzudzanyo
command.edit.undo.title = Humisela murahu
command.edit.undo.description = Humela murahu nga tshithu tshithihi kha ḓivhazwakale ya u humisela murahu ya ḽiṅwalo.
command.edit.redo.title = Ita hafhu
command.edit.redo.description = Ita hafhu nzudzanyo ye ya fhedzisela u humiselwa murahu.
command.edit.copy.title = Kopa
command.edit.copy.description = Kopa dzipixel dzo nangiwaho dza ḽeyara i shumaho kha kiḽipibodo ya ngomu (ḽeyara yoṱhe arali hu si na zwo nangiwaho).
command.edit.copy_merged.title = Kopa zwo Ṱanganyiswaho
command.edit.copy_merged.description = Kopa zwo nangiwaho nga nḓila ine dziḽeyara dzoṱhe dzi vhonalaho dza zwi ṱanganyisa ngayo, hu si kha ḽeyara i shumaho fhedzi.
command.edit.cut.title = Gera
command.edit.cut.description = Kopa dzipixel dzo nangiwaho kha kiḽipibodo ni dzi phumule kha ḽeyara i shumaho.
command.edit.paste.title = Nambatedza
command.edit.paste.description = Nambatedza zwi re kha kiḽipibodo kha ḽeyara ntswa nṱha ha i shumaho, vhukati ha khanvasi.
command.edit.paste.layer_name = Ḽeyara yo Nambatedzwaho
command.edit.paste_in_place.title = Nambatedza Vhuimoni
command.edit.paste_in_place.description = Nambatedza zwi re kha kiḽipibodo kha ḽeyara ntswa kha coordinates dze zwa kopiwa khadzo.
command.edit.fill_foreground.title = Ḓadza nga Muvhala wa Phanḓa
command.edit.fill_foreground.description = Ḓadza zwo nangiwaho (kana khanvasi yoṱhe arali hu si na zwo nangiwaho) nga muvhala wa phanḓa.
command.edit.fill_background.title = Ḓadza nga Muvhala wa Murahu
command.edit.fill_background.description = Ḓadza zwo nangiwaho (kana khanvasi yoṱhe arali hu si na zwo nangiwaho) nga muvhala wa murahu.

# U nanga
command.select.all.title = Nanga Zwoṱhe
command.select.all.description = Nanga khanvasi yoṱhe.
command.select.deselect.title = Litsha u nanga
command.select.deselect.description = Litsha zwo nangiwaho uri nzudzanyo dzi dovhe dzi shume kha ḽeyara yoṱhe.
command.select.inverse.title = Shandukisa Zwo Nangiwaho
command.select.inverse.description = Tshintshana fhethu ho nangiwaho na hu songo nangiwaho.
command.select.reselect.title = Nanga Hafhu
command.select.reselect.description = Vhuedzedza zwo nangiwaho zwe zwa fhedzisela u litshiwa.
command.select.reselect.msg.nothing_to_reselect = A hu na tshine tsha nga nangiwa hafhu
command.select.feather.title = Lembeledza Meme dza Zwo Nangiwaho
command.select.feather.description = Tsenzheledza meme dza zwo nangiwaho nga u fhungudza u vhonala zwavhuḓi nga dzipixel mbili, uri nzudzanyo i tevhelaho i ngalangale nga zwiṱuku u mona nadzo.
command.select.grow.title = Engedza
command.select.grow.description = Engedza zwo nangiwaho kha dzipixel dzi kwamaho dzine dza fana na dzo no nangiwaho, hu tshi tevhedzwa u konḓelela ha magic wand.
command.select.similar.title = Zwi Fanaho
command.select.similar.description = Nanga pixel iṅwe na iṅwe kha ḽeyara ine ya fana na zwo nangiwaho, hu sa londwi uri i a zwi kwama kana hai, hu tshi tevhedzwa u konḓelela ha magic wand.
command.select.save.title = Vhulunga Zwo Nangiwaho
command.select.save.description = Vhulunga zwo nangiwaho zwino kha ḽiṅwalo sa tshanele ya alpha i re na dzina.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Longela Zwo Nangiwaho
command.select.load.description = Vhuedzedza zwo nangiwaho zwe zwa fhedzisela u vhulungwa.

# Ḽeyara
command.layer.new.title = Ḽeyara Ntswa
command.layer.new.description = Engedza ḽeyara ya dzipixel i si na tshithu nṱha ha i shumaho nahone ni i ite i shumaho.
command.layer.duplicate.title = Ita Khophi ya Ḽeyara
command.layer.duplicate.description = Kopa ḽeyara i shumaho, na zwoṱhe zwi re khayo, kha ḽeyara ntswa nṱha hayo.
command.layer.smart_object.title = Shandukisela kha Smart Object
command.layer.smart_object.description = Putela dzipixel dza ḽeyara i shumaho kha smart object, uri tshanduko na dzi-fiḽithara dza nga murahu dzi dovhe dzi sedze tshiko tshi songo kwamiwaho.
command.layer.rasterize.title = Shandukisela Ḽeyara kha Dzipixel
command.layer.rasterize.description = Shandukisa ḽeyara ya tshivhumbeo, maṅwalo kana smart object uri i vhe dzipixel dzo ḓoweleaho.
command.layer.delete.title = Thutha Ḽeyara
command.layer.delete.description = Thutha dziḽeyara dzo nangiwaho.
command.layer.group.title = Kuvhanganya Dziḽeyara
command.layer.group.description = Vhea dziḽeyara dzo nangiwaho kha tshigwada tshiswa henefho fhethu hadzo.
command.layer.raise.title = Isa Phanḓa
command.layer.raise.description = Sudzulusa ḽeyara i shumaho nga vhuimo vhuthihi u ya nṱha kha thulwi ya tshigwada tshayo.
command.layer.lower.title = Isa Murahu
command.layer.lower.description = Sudzulusa ḽeyara i shumaho nga vhuimo vhuthihi u ya fhasi kha thulwi ya tshigwada tshayo.
command.layer.to_front.title = Isa Phanḓa-phanḓa
command.layer.to_front.description = Sudzulusa ḽeyara i shumaho u ya nṱha-nṱha kha tshigwada tshayo.
command.layer.to_back.title = Isa Murahu-murahu
command.layer.to_back.description = Sudzulusa ḽeyara i shumaho u ya fhasi-fhasi kha tshigwada tshayo.
command.layer.clipping_mask.title = Ita/Bvisa Masiki wa u Gera
command.layer.clipping_mask.description = Gera ḽeyara i shumaho u ya kha i re nga fhasi hayo, kana ni i vhofholole arali yo no gerwa; ḽeyara yo gerwaho i vhonala fhethu hune mutheo wayo wa vha na dzipixel fhedzi.
command.layer.cut_to_new.title = Ḽeyara nga u Gera
command.layer.cut_to_new.description = Bvisa dzipixel dzo nangiwaho kha ḽeyara i shumaho ni dzi ise kha ḽeyara ntswa nṱha hayo.
command.layer.cut_to_new.layer_name = Ḽeyara nga u Gera
command.layer.add_mask.title = Engedza Masiki wa Ḽeyara
command.layer.add_mask.description = Engedza masiki kha ḽeyara i shumaho, une wa sumbedza zwo nangiwaho fhedzi arali zwi hone.
command.layer.flatten.title = Ṱanganyisa Tshifanyiso
command.layer.flatten.description = Ṱanganyisa zwoṱhe zwi vhonalaho kha ḽeyara nthihi ya Murahu i sa vhonadzi, ni laṱe dziḽeyara dzo dzumbiwaho.
command.layer.merge_down.title = Ṱanganyisa na ya Fhasi
command.layer.merge_down.description = Ṱanganyisa ḽeyara i shumaho na ḽeyara i re nga fhasi hayo.
command.layer.merge_down.msg.no_layer_below = A hu na ḽeyara fhasi ine ha nga ṱanganyiswa nayo
command.layer.merge_visible.title = Ṱanganyisa dzi Vhonalaho
command.layer.merge_visible.description = Ṱanganyisa ḽeyara iṅwe na iṅwe i vhonalaho uri dzi vhe nthihi, ni litshe dzo dzumbiwaho dzi songo kwamiwa.

command.msg.nothing_to_copy = Nangani ḽeyara ya dzipixel ine ha ḓo kopiwa khayo
command.msg.clipboard_empty = A hu na tshithu kha kiḽipibodo

