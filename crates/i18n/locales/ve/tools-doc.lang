tool.frame.choice.ellipse = Tshitendeledzi
tool.frame.history.frame = Fureme
tool.note.name = Notsi
tool.note.description = Puṱedza kha khanvasi i si na tshithu u nambatedza notsi henefho, yo swaiwa nga muṅwali na muvhala zwi re kha tshiimo tsha musengulusi; puṱedza pini i re hone u i nanga kha phanele ya Notsi.
