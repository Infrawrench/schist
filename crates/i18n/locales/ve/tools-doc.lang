tool.slice.name = Tshipiḓa
tool.slice.description = Kokodza u sika tshipiḓa tsha u rumela, tshikwea tsho irwaho dzina kha khanvasi tshine tsha rumelwa sa tshifanyiso nga tshoṱhe. U kokodza ngomu ha tshi re hone zwi a tshi sudzulusa.
