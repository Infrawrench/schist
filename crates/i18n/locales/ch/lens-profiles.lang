lens_profiles.invalid = A'atan i Lensfun v1/v2 XML na basen datos ni' válidu (asta 8 MiB) ya guaha datos i kamera pat lente ni' ma'apoya.
lens_profiles.calibration = Kalibrasion i lente
lens_profiles.no_calibration = Tåya' kalibrasion para este na setbisio siha. Chek i focal length yan i crop factor i kamera; siña ha' ma'usa i inadilånto gi kannai.
lens_profiles.import = Importa Lensfun XML…
lens_profiles.imported = Ma'importa i Lensfun na basen datos para este na sesion. A'atan un prufil pat na'daña' i metadata i litråtu.
lens_profiles.manual = Manma'ayek ha'
lens_profiles.saved = Ma na'setbe i kalibråsion (ti ma sodda' i basen datos)
lens_profiles.profile = Prufil i lente
lens_profiles.aperture = Apertura (0 = ti ma tungo')
lens_profiles.distance = I distansian i inatan (0 = ti ma tungo')
lens_profiles.vignette = Ma'ayek na viñeta
lens_profiles.color_context = I kalibrao na vignetting ha nisisita i built-in sRGB na prufil. Konbiette guato gi sRGB para un guaha i parehu na lini'e', pues abri ta'lo i Lens Correction. Para i pixels ni' sRGB dija lao ti ma'tag, siña ma'asigna i sRGB. I geometry yan chromatic correction siha manma'usa ha'.
lens_profiles.vignette_missing = Tåya' kalibrasion i vignetting para este na apertura yan distansian focus. Na'halom i bale siha ni' ma'amot para un na'funksiona; gi meggai na Lensfun na prufil, 1000 m ha reprisisenta i focus gi chågo'.
lens_profiles.note = I kalibrao na inadilånto ma cho'gue antes di i kontrol gi kannai. Usa i orihinat na kuadru enteru; despues, kåtga i litråtu. Na'setbe i filter stack gi PSD/PSB para u siña ma'edit i kalibrasion.
lens_profiles.automatic = Na'daña' i metgot na litråtu
lens_profiles.components = I prufil na pasu: distorsion {distortion}; kulot i kanton {tca}; vignetting {vignette}.
