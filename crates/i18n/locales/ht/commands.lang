command.edit.undo.title = Defè
command.edit.undo.description = Retounen yon etap nan istorik defè dokiman an.
command.edit.redo.title = Refè
command.edit.redo.description = Refè dènye modifikasyon ki te defèt la.
command.edit.copy.title = Kopye
command.edit.copy.description = Kopye piksèl seleksyone nan kouch aktif la nan pres-papye entèn lan (tout kouch la si pa gen seleksyon).
command.edit.copy_merged.title = Kopye fizyone
command.edit.copy_merged.description = Kopye seleksyon an jan tout kouch vizib yo konpoze l, olye kouch aktif la sèlman.
command.edit.cut.title = Koupe
command.edit.cut.description = Kopye piksèl seleksyone yo nan pres-papye a epi efase yo nan kouch aktif la.
command.edit.paste.title = Kole
command.edit.paste.description = Kole pres-papye a nan yon nouvo kouch anlè kouch aktif la, nan sant twal la.
command.edit.paste.layer_name = Kouch kole
command.edit.paste_in_place.title = Kole anplas
command.edit.paste_in_place.description = Kole pres-papye a nan yon nouvo kouch nan kowòdone kote yo te kopye l la.
command.edit.fill_foreground.title = Ranpli ak premye plan
command.edit.fill_foreground.description = Ranpli seleksyon an (oswa tout twal la si pa gen seleksyon) ak koulè premye plan an.
command.edit.fill_background.title = Ranpli ak aryèplan
command.edit.fill_background.description = Ranpli seleksyon an (oswa tout twal la si pa gen seleksyon) ak koulè aryèplan an.

command.select.all.title = Seleksyone tout
command.select.all.description = Seleksyone tout twal la.
command.select.deselect.title = Deseleksyone
command.select.deselect.description = Retire seleksyon an pou modifikasyon yo aplike sou tout kouch la ankò.
command.select.inverse.title = Envèse seleksyon
command.select.inverse.description = Boukante zòn seleksyone ak zòn ki pa seleksyone yo.
command.select.reselect.title = Seleksyone ankò
command.select.reselect.description = Retabli dènye seleksyon yo te retire a.
command.select.reselect.msg.nothing_to_reselect = Pa gen anyen pou seleksyone ankò
command.select.feather.title = Adousi bò seleksyon
command.select.feather.description = Adousi bò seleksyon an ak yon flou de piksèl pou pwochen modifikasyon an disparèt tikras pa tikras sou li.
command.select.grow.title = Agrandi
command.select.grow.description = Pwolonje seleksyon an nan piksèl ki kole epi ki sanble ak sa ki deja seleksyone, selon tolerans bagèt majik la.
command.select.similar.title = Sanblab
command.select.similar.description = Seleksyone tout piksèl nan kouch la ki sanble ak seleksyon an, kit yo kole avè l kit yo pa kole, selon tolerans bagèt majik la.
command.select.save.title = Anrejistre seleksyon
command.select.save.description = Konsève seleksyon aktyèl la nan dokiman an kòm yon kanal alfa ki gen non.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Chaje seleksyon
command.select.load.description = Retabli seleksyon ki te anrejistre pi resamman an.

command.layer.new.title = Nouvo kouch
command.layer.new.description = Ajoute yon kouch raster vid anlè kouch aktif la epi aktive l.
command.layer.duplicate.title = Diplike kouch
command.layer.duplicate.description = Kopye kouch aktif la ak tout sa ki ladan l nan yon nouvo kouch anlè li.
command.layer.smart_object.title = Konvèti an objè entelijan
command.layer.smart_object.description = Mete piksèl kouch raster aktif la nan yon objè entelijan pou transfòmasyon ak filtè ki vin apre yo re-echantiyonnen sous ki pa touche a.
command.layer.rasterize.title = Rasterize kouch
command.layer.rasterize.description = Konvèti yon kouch fòm, tèks oswa objè entelijan an piksèl senp.
command.layer.delete.title = Efase kouch
command.layer.delete.description = Efase kouch seleksyone yo.
command.layer.group.title = Gwoupe kouch
command.layer.group.description = Mete kouch seleksyone yo nan yon nouvo gwoup nan menm kote a.
command.layer.raise.title = Pote devan
command.layer.raise.description = Monte kouch aktif la yon plas nan pil gwoup li a.
command.layer.lower.title = Voye dèyè
command.layer.lower.description = Desann kouch aktif la yon plas nan pil gwoup li a.
command.layer.to_front.title = Pote devan nèt
command.layer.to_front.description = Mete kouch aktif la anlè nèt nan gwoup li a.
command.layer.to_back.title = Voye dèyè nèt
command.layer.to_back.description = Mete kouch aktif la anba nèt nan gwoup li a.
command.layer.clipping_mask.title = Kreye/Retire mask dekoupaj
command.layer.clipping_mask.description = Dekoupe kouch aktif la selon kouch anba li a, oswa lage l si li deja dekoupe; yon kouch dekoupe parèt sèlman kote baz li gen piksèl.
command.layer.cut_to_new.title = Kouch pa koupe
command.layer.cut_to_new.description = Retire piksèl seleksyone yo nan kouch aktif la epi mete yo sou yon nouvo kouch anlè li.
command.layer.cut_to_new.layer_name = Kouch pa koupe
command.layer.add_mask.title = Ajoute mask kouch
command.layer.add_mask.description = Ajoute yon mask sou kouch aktif la, ki montre sèlman seleksyon an si gen youn.
command.layer.flatten.title = Aplati imaj
command.layer.flatten.description = Konpoze tout sa ki vizib nan yon sèl kouch Aryèplan opak epi jete kouch kache yo.
command.layer.merge_down.title = Fizyone anba
command.layer.merge_down.description = Konpoze kouch aktif la nan kouch ki anba li a.
command.layer.merge_down.msg.no_layer_below = Pa gen kouch anba pou fizyone ladan l
command.layer.merge_visible.title = Fizyone sa ki vizib
command.layer.merge_visible.description = Konpoze tout kouch vizib yo nan yon sèl epi kite kouch kache yo jan yo ye.

