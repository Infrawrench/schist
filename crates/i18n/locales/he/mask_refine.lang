mask_refine.apply = החלת מסכה
mask_refine.history = שיפור מסכה
mask_refine.output_layer = עותק מסכה משופר
mask_refine.applied = המסכה המשופרת הוחלה.
mask_refine.preview_note = התצוגה המקדימה מוקטנת לשיפור המהירות. מידות הקצה הן בפיקסלים של המסמך; ההחלה מתבצעת ברזולוציה מלאה. ההגדלה מגדילה תצוגה מקדימה זו.
mask_refine.duplicate_note = פלט: שכבה חדשה עם צבעי קצה מתוקנים ומסכה. השכבה המקורית נשמרת ומוסתרת.
mask_refine.mask_note = פלט: מסכה בשכבה הפעילה. הפיקסלים של השכבה והבחירה הנוכחית נשמרים.
mask_refine.no_raster = יש לבחור שכבת רסטר כדי לשפר את המסכה שלה.
mask_refine.locked = יש לבטל את נעילת השכבה לפני שיפור המסכה שלה.
mask_refine.no_mask = תחילה יש לבצע בחירה או להוסיף מסכת שכבה.
mask_refine.changed = המסמך השתנה. יש לסגור את שיפור המסכה ולפתוח אותו שוב.
mask_refine.rgb_only = הסרת הילות צבע זמינה בשכבות RGB. שיפור המסכה פועל במצב צבע זה.
mask_refine.too_large = המסכה חורגת ממגבלת הזיכרון הבטוחה. יש להשתמש במסמך או בבחירה קטנים יותר.
mask_refine.processing = המסכה ברזולוציה מלאה משתפרת… ניתן לבטל בלי לשנות את המסמך.
