actions.no_settings_folder = אחסון הפעולות אינו זמין.
actions.storage_failed = לא ניתן לשמור את ספריית הפעולות.
actions.load_failed = לא ניתן לטעון פעולות שמורות: {error}
actions.unsupported = פעולת עריכה שאינה נתמכת: {name}
actions.unavailable = פעולת העריכה אינה זמינה: {name}
actions.unavailable_action = הפעולה השמורה אינה זמינה עוד.
actions.failed = הפעולה נכשלה: {error}
actions.not_recorded = העריכה לא הוקלטה: {error}
actions.step_failed = שלב {n} נכשל: {error}
actions.command_no_change = הפקודה לא ביצעה שינוי; יש לבדוק את השכבה הפעילה ואת הבחירה.
actions.needs_pixels = שלב זה דורש שכבת פיקסלים פעילה עם תוכן באזור היעד.
actions.layer_locked = השכבה הפעילה נעולה.
actions.needs_adjustment = שלב זה דורש שכבת התאמה פעילה מהסוג שהוקלט.
actions.needs_document = יש לפתוח מסמך לפני הקלטה או הפעלה מחדש של פעולה.
actions.native_channel = פעולות דורשות עריכה מורכבת; עריכות ערוץ מקוריות אינן מוקלטות.
actions.native_adjustment = התאמות הרסניות של CMYK/Lab אינן מוקלטות; יש להשתמש בשכבת התאמה.
actions.skipped = פעולה זו לא הוקלטה: {name}
actions.document_changed = ההקלטה נעצרה כי המסמך הפעיל השתנה. השלבים הקיימים נשארים זמינים בפעולות.
actions.inactive_adjustment = הגדרות בשכבת התאמה שאינה פעילה לא הוקלטו.
actions.step_limit = ההקלטה הגיעה ל־128 שלבים. יש לפתוח את פעולות כדי לשמור.
actions.no_psd_writer = אין כותב PSD זמין לעותקי פעולה.
actions.no_output_name = לא ניתן היה להקצות שם שאינו בשימוש לעותק הפעולה.

