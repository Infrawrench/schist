actions.empty = כדי להתחיל, יש להקליט עריכות או לבחור פעולה שמורה.
actions.no_parameters = לשלב זה אין פרמטרים מספריים.
actions.supported_help = הפעולה מקליטה פקודות בחירה שאושרו, יצירה/שכפול/המרה לרסטר/מיזוג של שכבות, מילויי חזית/רקע, טשטוש גאוסי/תיבה/תנועה, חידוד, מסכת חידוד, חציון והתאמות.
actions.unsupported_help = משיחות מכחול, בחירה ידנית של שכבות, שינויי צורה, ניווט בהיסטוריה, מסננים חיצוניים או תלויי משאבים, מסננים אקראיים, ערימות מסננים ופקודות קובץ/יישום אינם מוקלטים. עריכות ערוץ מקוריות והתאמות הרסניות של CMYK/Lab אינן נתמכות.
actions.replay_help = השלבים פועלים על השכבה הפעילה ועל הבחירה הנוכחית. ביטול אחד מבטל פעולה שלמה. שלב שנכשל מחזיר את הפעולה כולה לאחור. הפקדים המספריים עורכים את הפעולה שבעבודה; שמירת פעולה משמרת את השינויים.
actions.play_document = הפעלה מחדש במסמך הפעיל
actions.played = פעולה שהופעלה מחדש: {name}
actions.batch_help = הפעלה מחדש בגלריה מתחילה מהעריכה השמורה של כל תמונה, אם קיימת, ואחרת מהמקור, עם השכבה הפעילה השמורה או שכבת הפיקסלים העליונה. התוצאות הן עותקי PSD חדשים בתיקייה שנבחרה. המקורות והעריכות השמורות אינם משתנים.
actions.play_gallery = הפעלה מחדש בתמונות הגלריה שנבחרו ({n})…
actions.select_photos = תחילה יש לבחור תמונות בגלריה.
actions.choose_output = שמירת עותקי הפעולה כאן
actions.batch_title = תוצאות הפעולה
