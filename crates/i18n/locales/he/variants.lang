# Virtual copies.
variants.create = צור עותק וירטואלי...
variants.rename = שנה את שם העותק הווירטואלי...
variants.delete = מחק עותק וירטואלי
variants.close = סגור את התמונה הזו ואת העותקים הווירטואליים שלה לפני העברה או מחיקה שלהן.
variants.saved_hint = ההעתקה מתחילה מהעריכה השמורה, או מהמקור כאשר אין עריכה. שמור תחילה שינויים ממתינים.
variants.move_original = הזז את התמונה המקורית כדי להעביר את העותקים הווירטואליים שלה.
variants.protected_export = בחר יעד אחר. ייצוא גלריה לא יכול להחליף את המקור או את אחסון העריכה שלו.
