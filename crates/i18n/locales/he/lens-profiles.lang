# Lens profiles.
lens_profiles.invalid = בחר מסד נתונים חוקי Lensfun v1/v2 XML (עד 8 MiB) עם נתוני מצלמה או עדשה נתמכים.
lens_profiles.calibration = כיול עדשה
lens_profiles.no_calibration = שום כיול לא מכסה את ההגדרות הללו. בדוק את אורך המוקד ואת גורם החיתוך של המצלמה; תיקון ידני נשאר זמין.
lens_profiles.import = ייבוא ​​Lensfun XML...
lens_profiles.imported = מסד הנתונים Lensfun מיובא עבור הפעלה זו. בחר פרופיל או התאם את המטא נתונים של התמונה.
lens_profiles.manual = תיקון ידני בלבד
lens_profiles.saved = כיול שמור (בסיס הנתונים אינו זמין)
lens_profiles.profile = פרופיל עדשה
lens_profiles.aperture = צמצם (0 = לא ידוע)
lens_profiles.distance = מרחק מיקוד (0 = לא ידוע)
lens_profiles.vignette = ויגנטיות מכויל
lens_profiles.color_context = מכויל וינייטינג דורש את פרופיל sRGB המובנה. המר ל-sRGB כדי לשמור על המראה, ואז פתח מחדש את תיקון העדשה. עבור פיקסלים שכבר לא מתויגים ב-sRGB, הקצאת sRGB מספיקה. גיאומטריה ותיקון כרומטי נשארים זמינים.
lens_profiles.vignette_missing = שום כיול ויגנטיות לא מכסה את הצמצם ואת מרחק המיקוד. הזן ערכים נמדדים כדי לאפשר זאת; 1000 m מייצג מיקוד מרוחק בפרופילים רבים של Lensfun.
lens_profiles.note = תיקון מכויל פועל לפני הפקדים הידניים. השתמש בתמונה המקורית במלואה; לאחר מכן בצע חיתוך. שמור ערימת מסננים ב-PSD/PSB כדי לשמור על כיול הניתן לעריכה.
lens_profiles.automatic = התאם מטא נתונים של תמונה
lens_profiles.components = מעבר פרופיל: עיוות {distortion}; פרנזים צבעוניים {tca}; וינייטינג {vignette}.
