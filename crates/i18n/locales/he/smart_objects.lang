# מקורות של אובייקטים חכמים ניתנים לעריכה ומקושרים.
smart.place_embedded = מיקום אובייקט חכם מוטבע…
smart.place_linked = מיקום אובייקט חכם מקושר…
smart.edit_contents = עריכת תוכן
smart.replace_contents = החלפת תוכן…
smart.relink = קישור מחדש של אובייקט חכם…
smart.update_linked = עדכון מופעים מקושרים
smart.pick_source = בחירת מקור לאובייקט חכם
smart.loading = מקור האובייקט החכם נטען…
smart.updated = מופעי האובייקט החכם עודכנו
smart.edit_hint = יש לערוך את מסמך המקור, ואז לבחור שמירה כדי לעדכן את המופעים שלו ולחזור למסמך האב.
smart.contents_title = {name} — תוכן
smart.history.update = עדכון תוכן אובייקט חכם
smart.history.place = מיקום אובייקט חכם
smart.history.embed = הטבעת מקור אובייקט חכם ניתן לעריכה
smart.error.failed = אובייקט חכם: {error}
smart.error.too_large = המקור חורג מהמגבלה של 32 מיליון פיקסלים, 30,000 פיקסלים לכל צד או 64 MiB.
smart.error.invalid = מקור האובייקט החכם המוטבע אינו תקין.
smart.error.unsupported = אי אפשר להשתמש בתבנית מקור זו כאובייקט חכם.
smart.error.locked = יש לבטל את נעילת כל מופעי המקור לפני עדכונם.
smart.error.select = יש לבחור שכבת אובייקט חכם שאינה נעולה.
smart.error.browser_link = קישורים למערכת הקבצים זמינים ביישום שולחן העבודה. בדפדפן יש להשתמש באובייקט חכם מוטבע.
smart.error.changed = היעד השתנה במהלך העריכה או הטעינה. יש לפתוח שוב את התוכן או לבחור שוב את המקור.
smart.error.no_link = לאובייקט חכם זה אין קישור לקובץ. יש להשתמש בקישור מחדש כדי לבחור מקור.
smart.error.nesting = יש לסגור כרטיסיית תוכן לפני פתיחת מקור מקונן נוסף.
smart.error.parent_closed = מסמך האב נסגר. יש להשתמש בשמירה בשם כדי לשמור את מסמך התוכן הזה.
smart.error.file_changed = הקובץ המקושר השתנה מחוץ ל-Schist. יש להשתמש בשמירה בשם כדי לשמור את העריכות, ואז בקישור מחדש או בעדכון מופעים מקושרים.
smart.embedded_source = מקור מוטבע — שכבה ▸ עריכת תוכן
smart.link_current = מקור מקושר
smart.link_changed = המקור השתנה — עדכון מופעים מקושרים
smart.link_missing = המקור חסר — יש לקשר מחדש כדי לשחזר אותו
smart.link_browser = המקור המקושר נשמר במטמון — נדרש יישום שולחן העבודה כדי לעדכן
smart.link_status = {status}: {path}
