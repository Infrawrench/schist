# AI-assisted translation; native-speaker review pending.
tethered.title = צילום מחובר
tethered.capture = צלם תמונה
tethered.invalid_name = יש לבחור שם באורך 1–120 בתים, ללא לוכסנים, נקודתיים או סימני אחוז, ושאינו מתחיל בנקודה.
tethered.install = ספריית המצלמה של המערכת אינה זמינה. יש להתקין את סביבת הריצה של המצלמה לפלטפורמה זו ולהפעיל מחדש את Schist.
tethered.timeout = הזמן שהוקצב לבקשה מהמצלמה פג. יש לבדוק את המצלמה ולחבר אותה מחדש לפני ניסיון נוסף.
tethered.failed = הבקשה מהמצלמה נכשלה: {detail}
tethered.unsupported = המצלמה הזו אינה מצהירה על תמיכה בצילום מרחוק.
tethered.no_download = המצלמה לא העבירה תמונה מלאה. קובצי המקור נשארים במצלמה.
tethered.session_help = יש לבחור מצלמה, ואז צלם תמונה. בצילום הראשון יש לבחור יעד וקידומת לשם הקובץ; לתמונות מתווספים מספר סידורי וסיומת הקובץ של המצלמה. שמירה בשם… משנה את היעד ואת הקידומת.
tethered.preview_failed = התמונה נשמרה ויובאה, אך לא ניתן לפענח את התצוגה המקדימה שלה. יש לפתוח את הקובץ בעורך כדי לבדוק אותו.
tethered.partial = חלק מקובצי הצילום נשמרו ויובאו; לא ניתן היה לשמור את הקבצים הנותרים: {error}
tethered.camera_permission = יש לאפשר גישה למצלמה בהגדרות המערכת ← פרטיות ואבטחה ← מצלמה, ואז לנסות שוב את צלם תמונה. אם Schist הופעל ממסוף, יש לבדוק גם את הרשאת המצלמה של אותו מסוף.
tethered.camera_usage_missing = בתצורה זו חסר תיאור הרשאת המצלמה. יש לבנות מחדש את Schist באמצעות make או להשתמש ביישום הארוז.
tethered.select_camera = יש לבחור מצלמה כדי לצלם תמונה.
tethered.choose_destination = צלם תמונה ישאל היכן לשמור את התמונות שלך.
tethered.preview_empty = יש לצלם תמונה כדי לראות אותה כאן.
