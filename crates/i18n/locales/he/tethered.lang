tethered.invalid_name = Choose a name of 1–120 bytes without slashes, colons, percent signs or a leading dot.
tethered.install = The system camera library is unavailable. Install the platform camera runtime and restart Schist.
tethered.timeout = Camera request timed out. Check the camera and reconnect before retrying.
tethered.failed = Camera request failed: {detail}
tethered.unsupported = This camera does not advertise remote image capture support.
tethered.no_download = The camera did not deliver a complete image. Camera originals are retained.
