# Lens profile controls.
lens_profiles.invalid = समर्थितस्य चित्रग्राहकस्य अथवा काचस्य दत्तांशैः युक्तं वैधं Lensfun v1/v2 XML दत्तांशसञ्चयं (८ MiB पर्यन्तम्) चिनोतु।
lens_profiles.calibration = काचस्य अंशशोधनम्
lens_profiles.no_calibration = एतासां व्यवस्थासां कृते अंशशोधनं नास्ति। केन्द्रीयदूरं चित्रग्राहकस्य कर्तनगुणकं च परीक्षताम्; हस्तेन संशोधनमपि शक्यम्।
lens_profiles.import = Lensfun XML आयातयतु…
lens_profiles.imported = अस्मिन् सत्रे Lensfun दत्तांशसञ्चयः आयातितः। काचरूपरेखां चिनोतु अथवा चित्रस्य मेटादत्तांशेन मेलयतु।
lens_profiles.manual = केवलं हस्तेन संशोधनम्
lens_profiles.saved = रक्षितम् अंशशोधनम् (दत्तांशसञ्चयः अनुपलब्धः)
lens_profiles.profile = काचस्य रूपरेखा
lens_profiles.aperture = छिद्रविस्तारः (० = अज्ञातः)
lens_profiles.distance = केन्द्रणदूरम् (० = अज्ञातम्)
lens_profiles.vignette = अंशशोधितं सीमाच्छायनम्
lens_profiles.color_context = अंशशोधितस्य सीमाच्छायनस्य कृते अन्तर्निहिता sRGB रूपरेखा आवश्यकी। दृश्यरूपं रक्षितुं sRGB मध्ये परिवर्तयतु, ततः काचसंशोधनं पुनरुद्घाटयतु। पूर्वमेव sRGB-वर्णव्यवस्थायां स्थितेभ्यः अचिह्नितेभ्यः चित्रकणेभ्यः sRGB रूपरेखां निर्देष्टुमेव पर्याप्तम्। आकृतिसंशोधनं वर्णसीमासंशोधनं च उपलब्धमेव।
lens_profiles.vignette_missing = छिद्रविस्तारस्य केन्द्रणदूरस्य च अनुरूपं सीमाच्छायनांशशोधनं नास्ति। तत् सक्रियं कर्तुं मापितानि मूल्यानि निवेशयतु; बहुषु Lensfun रूपरेखासु 1000 m दूरस्थं केन्द्रणं सूचयति।
lens_profiles.note = अंशशोधितं संशोधनं हस्तनियन्त्रणात् पूर्वं प्रयुज्यते। मूलं सम्पूर्णं चित्रफलकं प्रयुङ्क्ताम्; अनन्तरं कर्तयतु। सम्पादनीयं अंशशोधनं रक्षितुं शोधकस्तरसमूहं PSD/PSB मध्ये रक्षतु।
lens_profiles.automatic = चित्रस्य मेटादत्तांशेन मेलयतु
lens_profiles.components = रूपरेखानुसारं संशोधनम्: विकृतिः {distortion}; वर्णसीमाः {tca}; सीमाच्छायनम् {vignette}।
