command.edit.undo.title = प्रत्याहारः
command.edit.undo.description = प्रलेखस्य प्रत्याहारेतिहासे एकं क्रमं पृष्ठतः गच्छति।
command.edit.redo.title = पुनः क्रियताम्
command.edit.redo.description = अन्तिमप्रत्याहृतं सम्पादनं पुनः करोति।
command.edit.copy.title = प्रतिलिपिः
command.edit.copy.description = सक्रियस्तरस्य चयनितपिक्सेलान् आन्तरिकस्मृतिफलके प्रतिलिपीकरोति; चयनाभावे समग्रस्तरम्।
command.edit.copy_merged.title = सम्मिलितप्रतिलिपिः
command.edit.copy_merged.description = केवलं सक्रियस्तरात् न, सर्वैः दृश्यस्तरैः संयोजितं चयनं प्रतिलिपीकरोति।
command.edit.cut.title = छेदनम्
command.edit.cut.description = चयनितपिक्सेलान् स्मृतिफलके प्रतिलिपीकृत्य सक्रियस्तरात् मार्जयति।
command.edit.paste.title = स्थापनम्
command.edit.paste.description = स्मृतिफलकं सक्रियस्तरस्य उपरि नूतनस्तरे चित्रपटमध्ये स्थापयति।
command.edit.paste.layer_name = स्थापितस्तरः
command.edit.paste_in_place.title = स्वस्थाने स्थापनम्
command.edit.paste_in_place.description = स्मृतिफलकं यतः प्रतिलिपीकृतं तेष्वेव निर्देशाङ्केषु नूतनस्तरे स्थापयति।
command.edit.fill_foreground.title = अग्रभूम्या पूरयतु
command.edit.fill_foreground.description = चयनम् अग्रभूमिवर्णेन पूरयति; चयनाभावे समग्रचित्रपटम्।
command.edit.fill_background.title = पृष्ठभूम्या पूरयतु
command.edit.fill_background.description = चयनं पृष्ठभूमिवर्णेन पूरयति; चयनाभावे समग्रचित्रपटम्।
command.select.all.title = सर्वं चिनोतु
command.select.all.description = समग्रचित्रपटं चिनोति।
command.select.deselect.title = चयनं त्यजतु
command.select.deselect.description = चयनं त्यजति, येन सम्पादनानि पुनः समग्रस्तरे प्रयुज्यन्ते।
command.select.inverse.title = विपरीतं चिनोतु
command.select.inverse.description = चयनित-अचयनितप्रदेशौ विनिमयति।
command.select.reselect.title = पुनः चिनोतु
command.select.reselect.description = अन्तिमत्यक्तं चयनं पुनरानयति।
command.select.reselect.msg.nothing_to_reselect = पुनश्चयनाय किमपि नास्ति
command.select.feather.title = चयनसीमां मृद्वीं करोतु
command.select.feather.description = द्विपिक्सेलधूमिलतया चयनधारं मृद्वीं करोति, येन अग्रिमं सम्पादनं तस्याः पारं क्रमशः क्षीयते।
command.select.grow.title = वर्धयतु
command.select.grow.description = मायादण्डस्य सहिष्णुतायाः अन्तः चयनसदृशेषु संलग्नपिक्सेलेषु चयनं विस्तारयति।
command.select.similar.title = सदृशम्
command.select.similar.description = मायादण्डस्य सहिष्णुतायाः अन्तः चयनसदृशान् स्तरस्य सर्वान् पिक्सेलान् चिनोति, संलग्नान् असंलग्नान् वा।
command.select.save.title = चयनं रक्षतु
command.select.save.description = वर्तमानचयनं प्रलेखे नामयुक्ताल्फाप्रणालिकारूपेण रक्षति।
