tool.move.name = चालनम्
tool.move.description = सक्रियस्तरस्य विषयं कर्षित्वा नूतनस्थानं नयति। स्वतश्चयनं सक्रियं चेत्, प्रथमं सूचकस्य अधः स्थितं यत्किमपि स्तरं समग्रं समूहं वा नोदनमेव चिनोति।
tool.move.option.auto_select = स्वतश्चयनम्
tool.move.history.move_layer = स्तरचालनम्

tool.eyedropper.name = वर्णग्राहिका
tool.eyedropper.description = सूचकस्य अधः स्थितं वर्णं अग्रभूमिवर्णफलकाय गृह्णाति, अथवा Alt धारिते पृष्ठभूमिवर्णफलकाय। कर्षणे नमूनाग्रहणं निरन्तरं भवति।
tool.eyedropper.option.sample_size = नमूनापरिमाणम्
tool.eyedropper.option.sample = नमूना
