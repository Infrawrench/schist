# Animação de fotogramas (plugins/commands-core/src/animation.rs).
command.animation.create.title = Criar animação de fotogramas
command.animation.create.description = Inicie uma animação de fotogramas cujo primeiro fotograma é o documento tal como está agora.
command.animation.make_frames_from_layers.title = Criar fotogramas a partir de camadas
command.animation.make_frames_from_layers.description = Substitua os fotogramas por um fotograma por cada camada de nível superior, cada um a mostrar apenas essa camada.
command.animation.flatten_frames_into_layers.title = Achatar fotogramas em camadas
command.animation.flatten_frames_into_layers.description = Renderize cada fotograma numa nova camada no topo, visível apenas no seu próprio fotograma.
command.animation.new_frame.title = Novo fotograma
command.animation.new_frame.description = Duplique o fotograma selecionado e selecione a cópia.
command.animation.delete_frame.title = Eliminar fotograma
command.animation.delete_frame.description = Elimine o fotograma selecionado e selecione o anterior.
command.animation.first_frame.title = Primeiro fotograma
command.animation.first_frame.description = Selecione o primeiro fotograma da animação.
command.animation.previous_frame.title = Fotograma anterior
command.animation.previous_frame.description = Selecione o fotograma anterior; depois do primeiro, volta ao último.
command.animation.next_frame.title = Fotograma seguinte
command.animation.next_frame.description = Selecione o fotograma seguinte; depois do último, volta ao primeiro.
command.animation.last_frame.title = Último fotograma
command.animation.last_frame.description = Selecione o último fotograma da animação.
command.animation.reverse_frames.title = Inverter fotogramas
command.animation.reverse_frames.description = Inverta a ordem dos fotogramas.
command.animation.delete_animation.title = Eliminar animação
command.animation.delete_animation.description = Remova a animação de fotogramas e mantenha as camadas tal como o fotograma selecionado as mostra.
