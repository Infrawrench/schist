command.edit.undo.title = Desfazer
command.edit.undo.description = Recue uma entrada no histórico de ações do documento.
command.edit.redo.title = Refazer
command.edit.redo.description = Repita a última edição desfeita.
command.edit.copy.title = Copiar
command.edit.copy.description = Copie os píxeis selecionados da camada ativa para a área de transferência interna (ou toda a camada, se nada estiver selecionado).
command.edit.copy_merged.title = Copiar combinado
command.edit.copy_merged.description = Copie a seleção tal como resulta da composição de todas as camadas visíveis, em vez de copiar apenas a camada ativa.
command.edit.cut.title = Cortar
command.edit.cut.description = Copie os píxeis selecionados para a área de transferência e apague-os da camada ativa.
command.edit.paste.title = Colar
command.edit.paste.description = Cole a área de transferência numa nova camada acima da camada ativa, centrada na tela.
command.edit.paste.layer_name = Camada colada
command.edit.paste_in_place.title = Colar no local
command.edit.paste_in_place.description = Cole a área de transferência numa nova camada nas coordenadas de onde foi copiada.
command.edit.fill_foreground.title = Preencher com primeiro plano
command.edit.fill_foreground.description = Preencha a seleção (ou toda a tela, se nada estiver selecionado) com a cor do primeiro plano.
command.edit.fill_background.title = Preencher com fundo
command.edit.fill_background.description = Preencha a seleção (ou toda a tela, se nada estiver selecionado) com a cor de fundo.
command.select.all.title = Selecionar tudo
command.select.all.description = Selecione toda a tela.
command.select.deselect.title = Desmarcar
command.select.deselect.description = Remova a seleção para que as edições voltem a ser aplicadas a toda a camada.
command.select.inverse.title = Inverter seleção
command.select.inverse.description = Troque as áreas selecionadas pelas não selecionadas.
command.select.reselect.title = Selecionar novamente
command.select.reselect.description = Restaure a última seleção removida.
command.select.reselect.msg.nothing_to_reselect = Nada para selecionar novamente
command.select.feather.title = Esbater seleção
command.select.feather.description = Suavize a margem da seleção com um desfoque de dois píxeis, para que a edição seguinte se desvaneça ao longo dela.
command.select.grow.title = Expandir
command.select.grow.description = Estenda a seleção aos píxeis adjacentes semelhantes ao que já está selecionado, dentro da tolerância da varinha mágica.
command.select.similar.title = Semelhante
command.select.similar.description = Selecione todos os píxeis da camada semelhantes à seleção, adjacentes ou não, dentro da tolerância da varinha mágica.
command.select.save.title = Guardar seleção
command.select.save.description = Guarde a seleção atual no documento como um canal alfa com nome.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Carregar seleção
command.select.load.description = Restaure a seleção guardada mais recentemente.
command.layer.new.title = Nova camada
command.layer.new.description = Adicione uma camada rasterizada vazia acima da camada ativa e torne-a ativa.
command.layer.duplicate.title = Duplicar camada
command.layer.duplicate.description = Copie a camada ativa, incluindo todo o conteúdo, para uma nova camada acima dela.
command.layer.smart_object.title = Converter em objeto inteligente
command.layer.smart_object.description = Envolva os píxeis da camada rasterizada ativa num objeto inteligente, para que as transformações e os filtros posteriores reamostrem a origem intacta.
command.layer.rasterize.title = Rasterizar camada
command.layer.rasterize.description = Converta uma camada de forma, texto ou objeto inteligente em píxeis simples.
command.layer.delete.title = Eliminar camada
command.layer.delete.description = Elimine as camadas selecionadas.
command.layer.group.title = Agrupar camadas
command.layer.group.description = Coloque as camadas selecionadas num novo grupo, no mesmo local.
command.layer.raise.title = Avançar
command.layer.raise.description = Mova a camada ativa uma posição para cima na pilha do grupo.
command.layer.lower.title = Recuar
command.layer.lower.description = Mova a camada ativa uma posição para baixo na pilha do grupo.
command.layer.to_front.title = Trazer para a frente
command.layer.to_front.description = Mova a camada ativa para o topo do grupo.
command.layer.to_back.title = Enviar para trás
command.layer.to_back.description = Mova a camada ativa para o fundo do grupo.
command.layer.clipping_mask.title = Criar/libertar máscara de corte
command.layer.clipping_mask.description = Recorte a camada ativa pela camada abaixo ou liberte-a, caso já esteja recortada; uma camada recortada só aparece onde a sua base contém píxeis.
command.layer.cut_to_new.title = Camada através de corte
command.layer.cut_to_new.description = Retire os píxeis selecionados da camada ativa e coloque-os numa nova camada acima dela.
command.layer.cut_to_new.layer_name = Camada através de corte
command.layer.add_mask.title = Adicionar máscara de camada
command.layer.add_mask.description = Adicione uma máscara à camada ativa, revelando apenas a seleção quando existir.
command.layer.flatten.title = Achatar imagem
command.layer.flatten.description = Combine tudo o que está visível numa única camada Fundo opaca, descartando as camadas ocultas.
command.layer.merge_down.title = Combinar abaixo
command.layer.merge_down.description = Combine a camada ativa com a camada abaixo dela.
command.layer.merge_down.msg.no_layer_below = Não há uma camada abaixo com que combinar
command.layer.merge_visible.title = Combinar visíveis
command.layer.merge_visible.description = Combine todas as camadas visíveis numa só, sem alterar as camadas ocultas.
command.msg.nothing_to_copy = Selecione uma camada de píxeis de onde copiar
command.msg.clipboard_empty = Não há nada na área de transferência
