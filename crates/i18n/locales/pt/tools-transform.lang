tool.transform.history.transform = Transformação livre
tool.transform.history.image_size = Tamanho da imagem
tool.transform.history.canvas_size = Tamanho da tela

tool.transform.selection.name = Transformar seleção
tool.transform.selection.description = Transformar seleção: a mesma caixa, mas deslocando o contorno da seleção em vez dos píxeis dentro dela. Confirme ou cancele para terminar.
tool.transform.selection.history.transform = Transformar seleção

