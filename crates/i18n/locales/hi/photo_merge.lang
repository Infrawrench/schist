# Selected-document photographic merging.
photo_merge.title = फ़ोटो मर्ज करें…
photo_merge.align = स्वचालित संरेखण
photo_merge.focus = फ़ोकस स्टैकिंग
photo_merge.hdr = अलग-अलग एक्सपोज़र से HDR
photo_merge.panorama = पैनोरमा जोड़ना
photo_merge.translation = केवल क्षैतिज और ऊर्ध्वाधर विस्थापन (X/Y); घुमाव और परिप्रेक्ष्य ठीक नहीं किए जाते।
photo_merge.crop = साझा क्षेत्र तक क्रॉप करें
photo_merge.exposure_note = हर फ़ोटो का सापेक्ष एक्सपोज़र सेट करें: +1 EV = दोगुना प्रकाश। 32-बिट HDR बनाए रखने के लिए टोन मैपिंग बंद करें।
photo_merge.tone_map = टोन मैपिंग
photo_merge.order = पैनोरमा की फ़ोटो टैब के क्रम में ली जाती हैं; लगातार फ़ोटो में कम से कम 25% ओवरलैप होना चाहिए।
photo_merge.invalid = 2–16 मान्य चित्र चुनें और एक्सपोज़र सेटिंग जाँचें।
photo_merge.limit = सीमा: हर चित्र या आउटपुट में 64 मिलियन पिक्सेल, कुल 128 मिलियन; हर ओर अधिकतम 30,000 पिक्सेल।
photo_merge.no_match = भरोसेमंद ओवरलैप नहीं मिला। घुमाव या परिप्रेक्ष्य में बदलाव के बिना ओवरलैप करने वाली फ़ोटो इस्तेमाल करें।
