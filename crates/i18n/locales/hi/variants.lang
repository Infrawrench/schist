# Virtual copies.
variants.create = वर्चुअल कॉपी बनाएं...
variants.rename = वर्चुअल कॉपी का नाम बदलें...
variants.delete = वर्चुअल कॉपी हटाएँ
variants.close = इस फ़ोटो और इसकी आभासी प्रतियों को स्थानांतरित करने या हटाने से पहले उन्हें बंद कर दें।
variants.saved_hint = प्रतिलिपि सहेजे गए संपादन से शुरू होती है, या जब कोई संपादन नहीं होता है तो मूल से शुरू होती है। पहले लंबित परिवर्तन सहेजें.
variants.move_original = इसकी आभासी प्रतियों को स्थानांतरित करने के लिए मूल फ़ोटो को स्थानांतरित करें।
variants.protected_export = कोई अन्य गंतव्य चुनें. गैलरी निर्यात मूल या उसके संपादन संग्रहण को प्रतिस्थापित नहीं कर सकता।
