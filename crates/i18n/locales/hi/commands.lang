command.edit.undo.title = पूर्ववत करें
command.edit.undo.description = दस्तावेज़ के पूर्ववत इतिहास में एक चरण पीछे जाएँ।
command.edit.redo.title = फिर से करें
command.edit.redo.description = पिछली बार पूर्ववत किया गया संपादन फिर से करें।
command.edit.copy.title = कॉपी करें
command.edit.copy.description = सक्रिय लेयर के चुने हुए पिक्सेल आंतरिक क्लिपबोर्ड पर कॉपी करें (कुछ चुना न होने पर पूरी लेयर)।
command.edit.copy_merged.title = मर्ज की हुई कॉपी
command.edit.copy_merged.description = केवल सक्रिय लेयर से लेने के बजाय चयन को वैसा कॉपी करें जैसा सभी दृश्यमान लेयर मिलकर कंपोज़िट करती हैं।
command.edit.cut.title = काटें
command.edit.cut.description = चुने हुए पिक्सेल क्लिपबोर्ड पर कॉपी करके सक्रिय लेयर से मिटा दें।
command.edit.paste.title = चिपकाएँ
command.edit.paste.description = क्लिपबोर्ड की सामग्री सक्रिय लेयर के ऊपर नई लेयर में कैनवास के केंद्र पर चिपकाएँ।
command.edit.paste.layer_name = चिपकाई गई लेयर
command.edit.paste_in_place.title = उसी स्थान पर चिपकाएँ
command.edit.paste_in_place.description = क्लिपबोर्ड की सामग्री को नई लेयर में उन्हीं निर्देशांकों पर चिपकाएँ जहाँ से उसे कॉपी किया गया था।
command.edit.fill_foreground.title = अग्रभूमि से भरें
command.edit.fill_foreground.description = चयन को (या कुछ चुना न होने पर पूरे कैनवास को) अग्रभूमि रंग से भरें।
command.edit.fill_background.title = पृष्ठभूमि से भरें
command.edit.fill_background.description = चयन को (या कुछ चुना न होने पर पूरे कैनवास को) पृष्ठभूमि रंग से भरें।
command.select.all.title = सभी चुनें
command.select.all.description = पूरा कैनवास चुनें।
command.select.deselect.title = चयन हटाएँ
command.select.deselect.description = चयन हटा दें, ताकि संपादन फिर से पूरी लेयर पर लागू हो।
command.select.inverse.title = चयन उलटें
command.select.inverse.description = चुने और न चुने क्षेत्रों को आपस में बदलें।
command.select.reselect.title = फिर से चुनें
command.select.reselect.description = पिछली बार हटाया गया चयन वापस लाएँ।
command.select.reselect.msg.nothing_to_reselect = फिर से चुनने के लिए कुछ नहीं है
command.select.feather.title = चयन के किनारे नरम करें
command.select.feather.description = चयन के किनारे को दो पिक्सेल धुँधलाकर नरम करें, ताकि अगला संपादन किनारे पर धीरे-धीरे फीका पड़े।
command.select.grow.title = चयन बढ़ाएँ
command.select.grow.description = मैजिक वैंड की सहनशीलता के भीतर मौजूदा चयन से मिलते-जुलते जुड़े पिक्सेलों तक चयन फैलाएँ।
command.select.similar.title = समान क्षेत्र चुनें
command.select.similar.description = मैजिक वैंड की सहनशीलता के भीतर लेयर के हर ऐसे पिक्सेल को चुनें जो चयन से मिलता-जुलता हो, चाहे उससे जुड़ा हो या नहीं।
command.select.save.title = चयन सहेजें
command.select.save.description = वर्तमान चयन को दस्तावेज़ में नामित अल्फ़ा चैनल के रूप में रखें।
command.select.save.channel_name = अल्फ़ा {n}
command.select.load.title = चयन लोड करें
command.select.load.description = सबसे हाल में सहेजा गया चयन वापस लाएँ।
command.layer.new.title = नई लेयर
command.layer.new.description = सक्रिय लेयर के ऊपर खाली रास्टर लेयर जोड़कर उसे सक्रिय करें।
command.layer.duplicate.title = लेयर की प्रतिलिपि बनाएँ
command.layer.duplicate.description = सक्रिय लेयर को उसकी पूरी सामग्री सहित उसके ऊपर नई लेयर में कॉपी करें।
command.layer.smart_object.title = स्मार्ट ऑब्जेक्ट में बदलें
command.layer.smart_object.description = सक्रिय रास्टर लेयर के पिक्सेलों को स्मार्ट ऑब्जेक्ट में लपेटें, ताकि बाद के ट्रांसफ़ॉर्म और फ़िल्टर अक्षत स्रोत का पुनः नमूनाकरण करें।
command.layer.rasterize.title = लेयर रास्टराइज़ करें
command.layer.rasterize.description = आकृति, टेक्स्ट या स्मार्ट-ऑब्जेक्ट लेयर को साधारण पिक्सेलों में स्थायी रूप से बदलें।
command.layer.delete.title = लेयर हटाएँ
command.layer.delete.description = चुनी हुई लेयर हटाएँ।
command.layer.group.title = लेयर समूहित करें
command.layer.group.description = चुनी हुई लेयर को वहीं एक नए समूह में रखें।
command.layer.raise.title = एक स्तर आगे लाएँ
command.layer.raise.description = सक्रिय लेयर को उसके समूह के स्टैक में एक स्थान ऊपर ले जाएँ।
command.layer.lower.title = एक स्तर पीछे भेजें
command.layer.lower.description = सक्रिय लेयर को उसके समूह के स्टैक में एक स्थान नीचे ले जाएँ।
command.layer.to_front.title = सबसे आगे लाएँ
command.layer.to_front.description = सक्रिय लेयर को उसके समूह में सबसे ऊपर ले जाएँ।
command.layer.to_back.title = सबसे पीछे भेजें
command.layer.to_back.description = सक्रिय लेयर को उसके समूह में सबसे नीचे ले जाएँ।
command.layer.clipping_mask.title = क्लिपिंग मास्क बनाएँ/हटाएँ
command.layer.clipping_mask.description = सक्रिय लेयर को उसके नीचे वाली लेयर से क्लिप करें, या पहले से क्लिप होने पर मुक्त करें; क्लिप की गई लेयर केवल वहीं दिखती है जहाँ उसकी आधार लेयर में पिक्सेल हैं।
command.layer.cut_to_new.title = काटकर नई लेयर
command.layer.cut_to_new.description = चुने हुए पिक्सेल सक्रिय लेयर से निकालकर उसके ऊपर नई लेयर में ले जाएँ।
command.layer.cut_to_new.layer_name = काटकर बनी लेयर
command.layer.add_mask.title = लेयर मास्क जोड़ें
command.layer.add_mask.description = सक्रिय लेयर में लेयर मास्क जोड़ें; चयन होने पर केवल वही प्रकट होगा।
command.layer.flatten.title = छवि समतल करें
command.layer.flatten.description = सभी दृश्यमान सामग्री को एक अपारदर्शी पृष्ठभूमि लेयर में कंपोज़िट करके छिपी लेयर छोड़ दें।
command.layer.merge_down.title = नीचे मर्ज करें
command.layer.merge_down.description = सक्रिय लेयर को उसके नीचे वाली लेयर में कंपोज़िट करें।
command.layer.merge_down.msg.no_layer_below = मर्ज करने के लिए नीचे कोई लेयर नहीं है
command.layer.merge_visible.title = दृश्यमान लेयर मर्ज करें
command.layer.merge_visible.description = सभी दृश्यमान लेयर को एक में कंपोज़िट करें और छिपी लेयर को यथावत रहने दें।
