lens_profiles.aperture = Irekiera (0 = ezezaguna)
lens_profiles.distance = Foku distantzia (0 = ezezaguna)
lens_profiles.vignette = Kalibratu bineta
lens_profiles.color_context = Kalibratu binetatzeak sRGB profila behar du. Bihurtu sRGB itxura gordetzeko, eta ireki berriro Objektiboaren zuzenketa. Jada-sRGB etiketatu gabeko pixeletarako, nahikoa da sRGB esleitzea. Geometria eta zuzenketa kromatikoa eskuragarri jarraitzen dute.
lens_profiles.vignette_missing = Biñetatze-kalibrazioak ez du irekiera eta fokatze distantzia estaltzen. Idatzi neurtutako balioak gaitzeko; 1000 m urruneko fokua adierazten du Lensfun profil askotan.
lens_profiles.note = Kalibratutako zuzenketa eskuzko kontrolen aurretik exekutatzen da. Erabili jatorrizko irudi osoa; moztu ondoren. Gorde iragazki-pila bat PSD/PSB-n, kalibrazio editagarria gordetzeko.
lens_profiles.automatic = Lotu argazkien metadatuak
lens_profiles.components = Profilaren pasabidea: distortsioa {distortion}; kolorezko ertzak {tca}; bineta {vignette}.
