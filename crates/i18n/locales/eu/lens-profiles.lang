# Lens profiles.
lens_profiles.invalid = Aukeratu baliozko Lensfun v1/v2 XML datu-base bat (8 MiB arte) kamera edo objektiboa onartzen dituen datuekin.
lens_profiles.calibration = Lenteen kalibrazioa
lens_profiles.no_calibration = Ez da kalibraziorik ezartzen ezarpen hauek. Egiaztatu foku-distantzia eta kameraren mozketa-faktorea; eskuzko zuzenketak eskuragarri jarraitzen du.
lens_profiles.import = Inportatu Lensfun XML…
lens_profiles.imported = Lensfun datu-basea saio honetarako inportatu da. Hautatu profil bat edo lotu argazkien metadatuekin.
lens_profiles.manual = Eskuzko zuzenketa soilik
lens_profiles.saved = Gordetako kalibrazioa (datu-basea ez dago erabilgarri)
