# Bewurkje
command.edit.undo.title = Ungedien meitsje
command.edit.undo.description = Gean ien stap tebek yn de skiednis foar Ungedien meitsje fan it dokumint.
command.edit.redo.title = Opnij útfiere
command.edit.redo.description = Fier de bewurking dy't it lêst ûngedien makke is opnij út.
command.edit.copy.title = Kopiearje
command.edit.copy.description = Kopiearje de selektearre piksels fan de aktive laach nei it ynterne klamboerd (de hiele laach as neat selektearre is).
command.edit.copy_merged.title = Gearfoege kopiearje
command.edit.copy_merged.description = Kopiearje de seleksje sa't alle sichtbere lagen dy gearstalle, yn stee fan allinnich út de aktive laach.
command.edit.cut.title = Knippe
command.edit.cut.description = Kopiearje de selektearre piksels nei it klamboerd en wiskje se út de aktive laach.
command.edit.paste.title = Plakke
command.edit.paste.description = Plak it klamboerd sintraal op it kanvas yn in nije laach boppe de aktive laach.
command.edit.paste.layer_name = Plakte laach
command.edit.paste_in_place.title = Op itselde plak plakke
command.edit.paste_in_place.description = Plak it klamboerd yn in nije laach op de koördinaten dêr't it wei kopiearre is.
command.edit.fill_foreground.title = Folje mei foargrûn
command.edit.fill_foreground.description = Folje de seleksje (of it hiele kanvas as neat selektearre is) mei de foargrûnkleur.
command.edit.fill_background.title = Folje mei eftergrûn
command.edit.fill_background.description = Folje de seleksje (of it hiele kanvas as neat selektearre is) mei de eftergrûnkleur.

# Selektearje
command.select.all.title = Alles selektearje
command.select.all.description = Selektearje it hiele kanvas.
command.select.deselect.title = Deselektearje
command.select.deselect.description = Helje de seleksje fuort, sadat bewurkingen wer foar de hiele laach jilde.
command.select.inverse.title = Seleksje omkeare
command.select.inverse.description = Wikselje de selektearre en net-selektearre gebieten om.
command.select.reselect.title = Opnij selektearje
command.select.reselect.description = Bring de seleksje werom dy't it lêst fuorthelle is.
command.select.reselect.msg.nothing_to_reselect = Neat om opnij te selektearjen
command.select.feather.title = Seleksjerâne fersêftsje
command.select.feather.description = Meitsje de râne fan de seleksje sêfter mei in ferwaging fan twa piksels, sadat de folgjende bewurking oer dy râne stadichoan útrint.
command.select.grow.title = Fergrutsje
command.select.grow.description = Wreidzje de seleksje binnen de tolerânsje fan de toverstêf út nei oanslutende piksels dy't lykje op wat al selektearre is.
command.select.similar.title = Ferlykber
command.select.similar.description = Selektearje binnen de tolerânsje fan de toverstêf alle piksels yn de laach dy't op de seleksje lykje, ek as se der net op oanslute.
command.select.save.title = Seleksje bewarje
command.select.save.description = Bewarje de hjoeddeiske seleksje yn it dokumint as in alfakanaal mei in namme.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Seleksje lade
command.select.load.description = Helje de lêst bewarre seleksje werom.

# Laach
command.layer.new.title = Nije laach
command.layer.new.description = Foegje in lege rasterlaach boppe de aktive laach ta en meitsje dy aktyf.
