command.layer.add_mask.title = Laachmasker tafoegje
command.layer.add_mask.description = Foegje in laachmasker oan de aktive laach ta dat, as der in seleksje is, allinnich dy seleksje sjen lit.
command.layer.flatten.title = Ofbylding plat meitsje
command.layer.flatten.description = Stel alles wat sichtber is gear yn ien ûntrochsichtige Eftergrûnlaach en smyt ferburgen lagen fuort.
command.layer.merge_down.title = Nei ûnderen gearfoegje
