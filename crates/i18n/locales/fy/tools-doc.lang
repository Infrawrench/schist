# Tekengebiet
tool.artboard.name = Tekengebiet
tool.artboard.description = Sleep in tekengebiet út: in neamd part fan it kanvas dat apart eksportearre wurdt. Troch binnen in besteand tekengebiet te slepen, ferpleatse jo it.
tool.artboard.default_name = Tekengebiet {n}

# Utsnijing
tool.slice.name = Utsnijing
tool.slice.description = Sleep in eksportútsnijing út, in neamde rjochthoeke fan it kanvas dy't as aparte ôfbylding eksportearre wurdt. Troch binnen in besteande útsnijing te slepen, ferpleatse jo dy.
tool.slice.default_name = Utsnijing {n}

