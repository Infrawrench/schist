# Pinnen
tool.pen.name = Pinne
tool.pen.description = Meitsje in paad: klik foar in hoekpunt, sleep om der krommehânsels út te lûken en klik op it earste punt om it paad te sluten. By befêstigjen wurdt it paad in foarmlaach.
tool.pen.option.rubber_band = Elastyske line
tool.pen.history.fill = Paadfolling
tool.pen.default_path_name = Paad {n}
tool.pen.freeform.name = Frije pinne
tool.pen.freeform.description = Sleep in frije line; dy wurdt neffens de opsje Passend mear of minder strak yn in paad past.
tool.pen.freeform.option.fit = Passend
tool.pen.curvature.name = Krommepinne
tool.pen.curvature.description = Klik op in rige punten; it paad wurdt dêr glêd trochhinne bûgd.

# Seleksjepylken
tool.path_select.name = Paadseleksje
tool.path_select.description = Klik op in paad om it te selektearjen en sleep om it hiele paad te ferpleatsen.
tool.direct_select.name = Direkte seleksje
tool.direct_select.description = Sleep in apart ankerpunt of de hânsels dêrfan om it paad deromhinne in oare foarm te jaan.

