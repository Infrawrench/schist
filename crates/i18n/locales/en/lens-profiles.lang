# Lens profiles.
lens_profiles.invalid = Choose a valid Lensfun v1/v2 XML database (up to 8 MiB) with supported camera or lens data.
lens_profiles.calibration = Lens calibration
lens_profiles.no_calibration = No calibration covers these settings. Check focal length and camera crop factor; manual correction remains available.
lens_profiles.import = Import Lensfun XML…
lens_profiles.imported = Lensfun database imported for this session. Select a profile or match the photo metadata.
lens_profiles.manual = Manual correction only
lens_profiles.saved = Saved calibration (database unavailable)
lens_profiles.profile = Lens profile
lens_profiles.aperture = Aperture (0 = unknown)
lens_profiles.distance = Focus distance (0 = unknown)
lens_profiles.vignette = Calibrated vignetting
lens_profiles.color_context = Calibrated vignetting requires the built-in sRGB profile. Convert to sRGB to preserve appearance, then reopen Lens Correction. For already-sRGB untagged pixels, assigning sRGB is sufficient. Geometry and chromatic correction remain available.
lens_profiles.vignette_missing = No vignetting calibration covers the aperture and focus distance. Enter measured values to enable it; 1000 m represents distant focus in many Lensfun profiles.
lens_profiles.note = Calibrated correction runs before the manual controls. Use the original full frame; crop afterward. Save a filter stack in PSD/PSB to retain editable calibration.
lens_profiles.automatic = Match photo metadata
lens_profiles.components = Profile pass: distortion {distortion}; color fringes {tca}; vignetting {vignette}.
