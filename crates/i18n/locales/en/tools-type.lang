# The type tool (plugins/tools-type). Font, Style, Size, Left, Center,
# Right and the "Text" a new layer is named come from common.lang; font
# family names are never translated.

tool.type.name = Type
tool.type.description = Click to start a text layer there, or click an existing one to edit it. While it is open the tool takes raw keys (send characters as key input), and committing renders the layer and closes the edit.

