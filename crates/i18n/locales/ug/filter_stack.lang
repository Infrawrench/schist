filter_stack.note = ئۈنۈملەر ساقلاپ قېلىنغان مەنبەدىن باشلىنىپ، يۇقىرىدىن تۆۋەنگە ئىجرا بولىدۇ. تەھرىرلەش ئۈچۈن سۈزگۈچنى چېكىڭ. بوياش، يۆتكەش، ئۆزگەرتىش ياكى رەڭ ھالىتىنى ئالماشتۇرۇش دۆۋىنى مۇقىملاشتۇرىدۇ؛ يېنىۋېلىش ئۇنى ئەسلىگە كەلتۈرىدۇ.
filter_stack.eligibility = پەقەت مۇستەقىل ئىشلىيەلەيدىغان سۈزگۈچلەر كۆرسىتىلىدۇ. خەرىتە، يول، ئارقا كۆرۈنۈش ياكى سىرتقى سۆزلىشىش كۆزنىكى تەلەپ قىلىدىغان سۈزگۈچلەرنى دۆۋىگە ساقلىغىلى بولمايدۇ.
filter_stack.unavailable = سۈزگۈچ دۆۋىسىنى تەھرىرلەش ئۈچۈن قۇلۇپلانمىغان پېكسىل قەۋىتى ياكى ئەقلىي ئوبيېكتنى تاللاڭ.
filter_stack.render_failed = سۈزگۈچ دۆۋىسىنى رەسىمگە ئايلاندۇرغىلى بولمىدى. ئۇنىڭ مەنبەسى ۋە ساقلانغان تەڭشەكلىرى ئۆزگەرمىدى.
filter_stack.edit_history = سۈزگۈچ دۆۋىسىنى تەھرىرلەش
filter_stack.bake_history = سۈزگۈچ دۆۋىسىنى مۇقىملاشتۇرۇش
filter_stack.updated = سۈزگۈچ دۆۋىسى يېڭىلاندى
