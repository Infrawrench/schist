# HEIC security update.
codec.heif.msg.unsafe_version = مەلۇم بىخەتەرلىك يوچۇقلىرى سەۋەبىدىن libheif {version} نى ئىشلىتىش رەت قىلىندى؛ {minimum} ياكى ئۇنىڭدىن يېڭى نەشرى كېرەك. يېڭىلانغان HEIC قوللىشىنى چۈشۈرۈڭ ياكى سىستېما كۈتۈپخانىسىنى يېڭىلاڭ.
codec.heif.msg.unknown_version = نەشرىنى دەلىللىگىلى بولمىغاچقا libheif نى ئىشلىتىش رەت قىلىندى؛ {minimum} ياكى ئۇنىڭدىن يېڭى نەشرى كېرەك. يېڭىلانغان HEIC قوللىشىنى چۈشۈرۈڭ ياكى سىستېما كۈتۈپخانىسىنى يېڭىلاڭ.
dialog.open.heic_needs_safe_decoder = «{name}» نى ئېچىش ئۈچۈن HEVC يېشكۈچى بار libheif {minimum} ياكى ئۇنىڭدىن يېڭى نەشرى كېرەك. مەلۇم بىخەتەرلىك يوچۇقلىرىدىن قوغدىنىش ئۈچۈن كونا ياكى دەلىللىگىلى بولمايدىغان نەشرلەر توسۇلدى. داۋاملاشتۇرۇش ئۈچۈن يېڭىلانغان HEIC قوللىشىنى چۈشۈرۈڭ.
workspace.docs.heic_safe_decoder_needed = يېڭىلانغان HEIC قوللىشى كېرەك
