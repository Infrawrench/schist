command.edit.copy.title = كۆچۈرۈش
command.edit.copy.description = ئاكتىپ قەۋەتتىكى تاللانغان پېكسىللارنى ئىچكى چاپلاش تاختىسىغا كۆچۈرۈڭ (تاللانما بولمىسا پۈتۈن قەۋەتنى).
