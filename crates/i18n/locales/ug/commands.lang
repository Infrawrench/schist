command.edit.undo.title = يېنىۋېلىش
command.edit.undo.description = ھۆججەتنىڭ يېنىۋېلىش تارىخىدا بىر قەدەم كەينىگە قايتىڭ.
command.edit.redo.title = قايتا قىلىش
