lens_profiles.invalid = قوللايدىغان كامېرا ياكى لىنزا سانلىق مەلۇماتلىرى بار ئىناۋەتلىك Lensfun v1/v2 XML سانداننى تاللاڭ (8 MiB غىچە).
lens_profiles.calibration = لىنزا تەڭشەش
lens_profiles.no_calibration = بۇ تەڭشەكلەرگە ماس كېلىدىغان تەڭشەش مەلۇماتى يوق. فوكۇس ئارىلىقى ۋە كامېرانىڭ كېسىش نىسبىتىنى تەكشۈرۈڭ؛ قولدا تۈزىتىش يەنىلا بار.
lens_profiles.import = Lensfun XML نى ئەكىرىش…
lens_profiles.imported = Lensfun ساندانى بۇ قېتىملىق ئىشلىتىش ئۈچۈن ئەكىرىلدى. لىنزا ئارخىپىنى تاللاڭ ياكى سۈرەتنىڭ مېتا مەلۇماتىغا ماسلاشتۇرۇڭ.
lens_profiles.manual = پەقەت قولدا تۈزىتىش
lens_profiles.saved = ساقلانغان تەڭشەش (سانداننى ئىشلەتكىلى بولمايدۇ)
lens_profiles.profile = لىنزا ئارخىپى
lens_profiles.aperture = دىئافراگما (0 = نامەلۇم)
lens_profiles.distance = فوكۇس ئارىلىقى (0 = نامەلۇم)
lens_profiles.vignette = تەڭشەلگەن چەت قاراڭغۇلىشىش
lens_profiles.color_context = تەڭشەلگەن چەت قاراڭغۇلىشىشنى تۈزىتىش ئۈچۈن ئىچكى sRGB ئارخىپى كېرەك. كۆرۈنۈشىنى ساقلاش ئۈچۈن رەسىمنى sRGB غا ئايلاندۇرۇپ، ئاندىن «لىنزا تۈزىتىش»نى قايتا ئېچىڭ. پىكسېللار ئاللىقاچان sRGB بولۇپ، پەقەت ئارخىپ بەلگىسى بولمىسا، sRGB نى تەقسىملەش يېتەرلىك. گېئومېتىرىيە ۋە رەڭ تارقىلىشىنى تۈزىتىش يەنىلا بار.
lens_profiles.vignette_missing = بۇ دىئافراگما ۋە فوكۇس ئارىلىقىغا ماس چەت قاراڭغۇلىشىش تەڭشىكى يوق. ئۇنى قوزغىتىش ئۈچۈن ئۆلچەنگەن قىممەتلەرنى كىرگۈزۈڭ؛ نۇرغۇن Lensfun ئارخىپىدا 1000 m يىراقتىكى نۇقتىغا فوكۇسلاشنى بىلدۈرىدۇ.
lens_profiles.note = تەڭشەلگەن تۈزىتىش قولدا باشقۇرۇشتىن بۇرۇن ئىجرا قىلىنىدۇ. ئەسلىدىكى تولۇق كادرنى ئىشلىتىڭ؛ كېيىن كېسىڭ. تەڭشەشنى تەھرىرلىگىلى بولۇشى ئۈچۈن سۈزگۈچ تىزىمىنى PSD/PSB دا ساقلاڭ.
lens_profiles.automatic = سۈرەتنىڭ مېتا مەلۇماتىغا ماسلاشتۇرۇش
lens_profiles.components = ئارخىپ تۈزىتىشى: شەكىل بۇزۇلۇشى {distortion}؛ رەڭلىك گىرۋەكلەر {tca}؛ چەت قاراڭغۇلىشىش {vignette}.
