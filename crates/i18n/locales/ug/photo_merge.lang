# Photographic merging. Machine-assisted translation with terminology review.
photo_merge.title = رەسىملەرنى بىرلەشتۈرۈش…
photo_merge.align = ئاپتوماتىك توغرىلاش
photo_merge.focus = ئوخشىمىغان فوكۇس ئارىلىقىدىكى رەسىملەرنى بىرلەشتۈرۈڭ
photo_merge.hdr = كۆپ خىل ئاشكارلىنىش سەۋىيىسىدىن HDR
photo_merge.panorama = سۈرەتلەرنى پۈتۈن مەنزىرىگە بىرلەشتۈرۈڭ
photo_merge.translation = پەقەت گورىزونتال ۋە تىك رەسىم ھەرىكىتى (X / Y); ئايلىنىش ياكى كۆز قاراش تۈزىتىش يوق.
photo_merge.crop = ئورتاق رايونغا تېرىش
photo_merge.exposure_note = ھەر بىر رەسىمنىڭ نىسپىي ئاشكارلىنىشىنى تەڭشەڭ: +1 EV ئىككى ھەسسە يورۇقلۇقنى كۆرسىتىدۇ. 32 بىتلىق HDR نى ساقلاش ئۈچۈن رەسىم ئاۋاز خەرىتىسىنى چەكلەڭ.
photo_merge.tone_map = رەسىم ئاھاڭى خەرىتىسى
photo_merge.order = ئوچۇق ھۆججەت بەتكۈچلىرىنىڭ تەرتىپىنى ئىشلىتىڭ. ھەر بىر پۈتۈن سۈرەت چوقۇم ئالدىنقى رەسىمنى كەم دېگەندە% 25 قاپلىشى كېرەك.
photo_merge.invalid = 2-16 ئىناۋەتلىك رەسىملەرنى تاللاڭ ۋە ئاشكارىلاش تەڭشەكلىرىنى تەكشۈرۈڭ.
photo_merge.limit = چەكلىمىسى: ھەر بىر رەسىم ياكى چىقىرىشتا 64 مىليون پېكسىل ، ئومۇمىي سانى 128 مىليون. ھەر بىر تەرىپى 30000 پىكسېل.
photo_merge.no_match = ئىشەنچلىك قاپلاش تېپىلمىدى. قاپلانغان رەسىملەرنى ئايلىنىش ياكى كۆز قاراش ئۆزگەرتىشسىز ئىشلىتىڭ.
