app.vulkan.no_loader = schist: بۇ سىستېمىدا Vulkan يۈكلىگۈچى يوق، شۇڭا سىزىدىغان نەرسە يوق.\n\nSchist ‏Vulkan ئارقىلىق رەسىم ھاسىل قىلىدۇ، ئەمما `libvulkan.so.1` ئورنىتىلمىغان.\nيۈكلىگۈچى ۋە قوزغاتقۇچنىڭ ھەر ئىككىسى كېرەك:\n\n    Arch, CachyOS, Omarchy    sudo pacman -S vulkan-icd-loader vulkan-driver\n    Debian, Ubuntu, Mint      sudo apt install libvulkan1 mesa-vulkan-drivers\n    Fedora, RHEL              sudo dnf install vulkan-loader mesa-vulkan-drivers\n
app.vulkan.override_missing = schist: بۇ سېيىستا كۆرسىتىلگەن Vulkan قوزغاتقۇچ مەۋجۇت ئەمەس.\n\n{var} تەڭشەلگەن؛ ئۇنى تەڭشەش يۈكلىگۈچىنىڭ قوزغاتقۇچ ئىزدەش يولىغا قوشۇلماستىن، بەلكى ئۇنىڭ ئورنىنى ئالىدۇ. شۇڭا مەۋجۇت بولمىغان تۆۋەندىكى ھۆججەتلەر پۈتۈن قوزغاتقۇچ تىزىملىكى بولۇپ قالغان؛ قانچە قوزغاتقۇچ ئورنىتىلغان بولۇشىدىن قەتئىينەزەر، بۇ سېيىستىكى بارلىق Vulkan پروگراممىلىرى ھېچقانداق قوزغاتقۇچنى كۆرەلمەيدۇ:\n\n{missing}\n    {var}={value}\n\nئۇنى مەۋجۇت manifest قا كۆرسىتىڭ — ئورنىتىلغان قوزغاتقۇچلار manifest لىرىنى /usr/share/vulkan/icd.d غا قويىدۇ — ياكى ئۇنىڭ تەڭشىكىنى بىكار قىلىپ، يۈكلىگۈچىگە ئۆزى ئىزدەشكە يول قويۇڭ. بۇ قىممەت سەپلىمە ھۆججىتىدىن (Hyprland نىڭ `env =`، systemd environment.d قىستۇرمىسى ياكى shell ئارخىپىدىن) تەڭشەلسە، شۇ يەردە ئۆزگەرتىش كېرەك؛ ئۆزگەرتىش ئاللىقاچان ئىجرا بولۇۋاتقان پروگراممىلارغا يېتىش ئۈچۈن قايتا كىرىش زۆرۈر.\n
app.vulkan.override_note = \n{var} نىڭ قىممىتى {value} قىلىپ تەڭشەلگەن، بۇ يۈكلىگۈچىنىڭ ئۆزى ئىزدەيدىغان يولىنى ئالماشتۇرىدۇ: ئەگەر بۇ manifest لارنىڭ ھېچقايسىسى بۇ كومپيۇتېرغا ماس كەلمىسە، ئالدى بىلەن ئۇنىڭ تەڭشىكىنى بىكار قىلىپ سىناڭ.\n
app.vulkan.no_driver = schist: Vulkan قوزغاتقۇچ ئورنىتىلمىغان، شۇڭا سىزىدىغان نەرسە يوق.\n\nSchist ‏Vulkan ئارقىلىق رەسىم ھاسىل قىلىدۇ. يۈكلىگۈچى ئورنىتىلغان، ئەمما قوزغاتقۇچ يوق دەپ دوكلات قىلدى؛ ئىزدەيدىغان ئىككى ئورۇننىڭ ھېچقايسىسىدا قوزغاتقۇچ تىزىملاتمىغان:\n\n{dirs}\n\nيۈكلىگۈچى قوزغاتقۇچلاردىن ئايرىم تەمىنلىنىدۇ، شۇڭا ئادەتتە پەقەت بىر بوغچا كەم بولىدۇ.\n\nبۇ كومپيۇتېرنىڭ GPU سىغا ماس قوزغاتقۇچنى ئورنىتىڭ:\n\n    Arch, CachyOS, Omarchy    sudo pacman -S vulkan-driver\n    Debian, Ubuntu, Mint      sudo apt install mesa-vulkan-drivers\n    Fedora, RHEL              sudo dnf install mesa-vulkan-drivers\n\nNVIDIA نىڭ خۇسۇسىي قوزغاتقۇچى ئۆزىنىڭكىنى ئۆز ئىچىگە ئالىدۇ (Arch تا `nvidia-utils`، Debian دا `nvidia-driver`). مەۋھۇم كومپيۇتېردا ياكى GPU قوزغاتقۇچ ئورناتقىلى بولمايدىغان جايدا، يۇمشاق دېتال rasterizer ئىشلەيدۇ: Arch تا `vulkan-swrast`، باشقا سىستېمىلاردا `mesa-vulkan-drivers` نىڭ بىر قىسمى. ئۇ ئاستا، ئەمما قوزغىلىدۇ.\n{overridden}
app.vulkan.no_device = schist: Vulkan قوزغاتقۇچ ئورنىتىلغان، ئەمما رەسىم ھاسىل قىلىدىغان ئۈسكۈنە تەمىنلىمىدى.\n\nقوزغاتقۇچ بۇ GPU نى قوللىماسلىقى ياكى ئۇنىڭغا يېتەلمەسلىكى مۇمكىن؛ SSH ئارقىلىق ياكى container ئىچىدە /dev/dri نىڭ يوقلۇقى كۆپ ئۇچرايدۇ. `vulkaninfo --summary` يۈكلىگۈچى كۆرگەن نەرسىلەرنى دوكلات قىلىدۇ.\n\nئەگەر بۇ كومپيۇتېردا GPU بولمىسا، يۇمشاق دېتال rasterizer پۈتۈنلەي GPU سىز رەسىم ھاسىل قىلىدۇ: Arch تا `vulkan-swrast`، Debian ۋە Fedora دا `mesa-vulkan-drivers` نىڭ بىر قىسمى.\n
app.vulkan.skip_hint = Schist نى بەرىبىر قوزغىتىپ ئۆز ئۇسۇلىدا مەغلۇپ بولۇشىغا يول قويۇش ئۈچۈن {var}=1 قىلىپ تەڭشەڭ.
