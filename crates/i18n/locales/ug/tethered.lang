tethered.title = كامېراغا ئۇلاپ سۈرەتكە تارتىش
tethered.capture = سۈرەتكە تارتىش
tethered.invalid_name = قىيپاش سىزىق، قوش چېكىت، پىرسەنت بەلگىسى ياكى باشتىكى چېكىت بولمىغان، ئۇزۇنلۇقى 1–120 بايتلىق نام تاللاڭ.
tethered.install = سىستېمىنىڭ كامېرا كۇتۇپخانىسى ئىشلىمەيدۇ. بۇ سۇپا ئۈچۈن كامېرا ئىجرا مۇھىتىنى ئورنىتىپ، Schist نى قايتا قوزغىتىڭ.
tethered.timeout = كامېرا تەلىپىنىڭ مۆھلىتى توشتى. قايتا سىناشتىن بۇرۇن كامېرانى تەكشۈرۈپ، قايتا ئۇلاڭ.
tethered.failed = كامېرا تەلىپى مەغلۇپ بولدى: {detail}
tethered.unsupported = بۇ كامېرا يىراقتىن سۈرەت تارتىشنى قوللايدىغانلىقىنى بىلدۈرمەيدۇ.
tethered.no_download = كامېرا تولۇق سۈرەتنى يەتكۈزمىدى. كامېرادىكى ئەسلى سۈرەتلەر ساقلىنىپ قالىدۇ.
tethered.session_help = كامېرانى تاللاڭ، ئاندىن «سۈرەتكە تارتىش»نى بېسىڭ. تۇنجى قېتىم سۈرەتكە تارتقاندا ساقلاش ئورنى ۋە ھۆججەت نامىنىڭ ئالدى قىسمىنى تاللاڭ؛ تارتىلغان سۈرەتلەرگە تەرتىپ نومۇرى ۋە كامېرا ھۆججىتىنىڭ كېڭەيتمىسى قوشۇلىدۇ. «باشقا نامدا ساقلاش» ساقلاش ئورنى ۋە نامنىڭ ئالدى قىسمىنى ئۆزگەرتىدۇ.
tethered.preview_failed = سۈرەت ساقلاندى ۋە كىرگۈزۈلدى، ئەمما ئالدىن كۆرۈش سۈرىتىنى يېشىپ بولمىدى. ھۆججەتنى تەكشۈرۈش ئۈچۈن تەھرىرلىگۈچتە ئېچىڭ.
tethered.partial = بەزى سۈرەت ھۆججەتلىرى ساقلىنىپ كىرگۈزۈلدى؛ قالغانلىرىنى ساقلىغىلى بولمىدى: {error}
tethered.camera_permission = سىستېما تەڭشەكلىرى → مەخپىيەتلىك ۋە بىخەتەرلىك → كامېرا دىن كامېرانى ئىشلىتىشكە رۇخسەت بېرىڭ، ئاندىن «سۈرەتكە تارتىش»نى قايتا سىناڭ. ئەگەر Schist تېرمىنالدىن قوزغىتىلغان بولسا، شۇ تېرمىنالنىڭمۇ كامېرا رۇخسىتىنى تەكشۈرۈڭ.
tethered.camera_usage_missing = بۇ نەشرىدە كامېرا رۇخسىتىنىڭ چۈشەندۈرۈشى يوق. Schist نى make بىلەن قايتا قۇرۇڭ ياكى ئورالغان ئەپنى ئىشلىتىڭ.
tethered.select_camera = سۈرەتكە تارتىش ئۈچۈن كامېرا تاللاڭ.
tethered.choose_destination = «سۈرەتكە تارتىش» سۈرەتلەرنى قەيەرگە ساقلاشنى سورايدۇ.
tethered.preview_empty = بۇ يەردە كۆرۈش ئۈچۈن سۈرەتكە تارتىڭ.
