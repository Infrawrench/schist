photo_merge_advanced.projective = پېرسپېكتىۋا بويىچە توغرىلاش (ئايلاندۇرۇشنىمۇ ئۆز ئىچىگە ئالىدۇ)
photo_merge_advanced.cylindrical = سىلىندىر شەكىللىك پانوراما
photo_merge_advanced.deghost = ھەرىكەتتىكى ئوبيېكتنىڭ قوش كۆرۈنۈشىنى يوقىتىش (بىرىنچى سۈرەتنى ئۆلچەم قىلىپ)
photo_merge_advanced.focal = فوكۇس ئۇزۇنلۇقى (px) / رەسىم كەڭلىكى (px)
photo_merge_advanced.masks = فوكۇس بىرلەشتۈرۈش نەتىجىسى تەھرىرلىگىلى بولىدىغان قەۋەت نىقابلىرىنى ئىشلىتىدۇ. قەۋەتلەردىن نىقابنى تاللاپ، ئىنچىكە تۈزىتىش ئۈچۈن سىزىڭ.
photo_merge_advanced.no_match = ئىشەنچلىك توغرىلاش تېپىلمىدى. تەپسىلاتى روشەن، ئۈستىگە چۈشۈشى كۆپ، كۆرۈش نۇقتىسى ئاز ئۆزگەرگەن سۈرەتلەرنى ئىشلىتىڭ.
photo_merge_advanced.invalid = مەنبە رەسىملەر ياكى بىرلەشتۈرۈش تەڭشەكلىرى ئىناۋەتسىز.
