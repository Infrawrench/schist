# Herramientas de pintura.
tool.brush.name = Pincel
tool.brush.description = Pinta un trazo de bordes suaves con el color frontal, cuyo tamaño, dureza y opacidad corresponden a los ajustes de pincel del editor.
tool.brush.history.stroke = Pincel
tool.pencil.name = Lápiz
tool.pencil.description = Pinta un trazo de bordes duros y sin suavizado con el color frontal.
tool.pencil.history.stroke = Lápiz
tool.eraser.name = Borrador
tool.eraser.description = Borra a lo largo del trazo y devuelve la capa a la transparencia.
tool.eraser.history.stroke = Borrador
tool.clone.name = Tampón de clonar
tool.clone.description = Tampón de clonar: pulsa Alt y haz clic para fijar el punto de origen; después pinta los píxeles copiados manteniendo ese desplazamiento.
tool.clone.history.stroke = Tampón de clonar
tool.dodge.name = Sobreexponer
tool.dodge.description = Aclara los píxeles por los que pasa el trazo.
tool.dodge.history.stroke = Sobreexponer
tool.burn.name = Subexponer
tool.burn.description = Oscurece los píxeles por los que pasa el trazo.
tool.burn.history.stroke = Subexponer
tool.sponge.name = Esponja
tool.sponge.description = Satura o desatura los píxeles por los que pasa el trazo.
tool.sponge.history.stroke = Esponja
tool.blur.name = Desenfocar
tool.blur.description = Desenfoca los píxeles por los que pasa el trazo.
tool.blur.history.stroke = Desenfocar
tool.sharpen.name = Enfocar
tool.sharpen.description = Enfoca los píxeles por los que pasa el trazo.
tool.sharpen.history.stroke = Enfocar
tool.smudge.name = Dedo
tool.smudge.description = Arrastra el color a lo largo del trazo, como si empujaras pintura húmeda.
tool.smudge.history.stroke = Dedo
tool.heal.name = Pincel corrector
tool.heal.description = Pincel corrector: pulsa Alt y haz clic para fijar el origen; después pinta para mezclar la textura del origen con el color y la iluminación del destino.
tool.heal.history.stroke = Pincel corrector
tool.spot_heal.name = Pincel corrector puntual
tool.spot_heal.description = Pincel corrector puntual: pinta sobre una imperfección para sustituirla por una textura tomada de su entorno, sin tener que fijar un punto de origen.
tool.spot_heal.history.stroke = Pincel corrector puntual
tool.history_brush.name = Pincel de historia
tool.history_brush.description = Recupera píxeles de la instantánea del historial del documento y deshace el trabajo posterior trazo a trazo.
tool.history_brush.history.stroke = Pincel de historia
tool.background_eraser.name = Borrador de fondos
tool.background_eraser.description = Borra el color muestreado bajo el centro del pincel y conserva los píxeles distintos, para separar un sujeto de su fondo.
tool.background_eraser.history.stroke = Borrador de fondos
tool.gradient.name = Degradado
tool.gradient.description = Arrastra para rellenar la capa —a través de la selección, si existe— con un degradado lineal que va del color frontal al de fondo siguiendo el arrastre.
tool.gradient.radial.name = Degradado radial
tool.gradient.radial.description = Arrastra desde el centro hacia fuera para rellenar con un degradado radial entre los colores frontal y de fondo.
tool.gradient.option.gradient = Degradado
tool.gradient.option.reverse = Invertir
tool.gradient.option.dither = Tramado
tool.gradient.choice.foreground_to_background = Frontal a fondo
tool.gradient.choice.foreground_to_transparent = Frontal a transparente
tool.gradient.choice.linear = Lineal
tool.gradient.choice.radial = Radial
tool.gradient.choice.angle = Ángulo
tool.gradient.choice.reflected = Reflejado
tool.gradient.choice.diamond = Diamante
tool.gradient.history.gradient = Degradado
tool.bucket.name = Bote de pintura
tool.bucket.description = Haz clic para inundar con el color frontal el área conectada de color similar bajo el puntero, dentro de la tolerancia de la herramienta.
tool.bucket.option.contiguous = Contiguo
tool.bucket.option.all_layers = Todas las capas
tool.bucket.history.fill = Bote de pintura

tool.brush.symmetry = Simetría
tool.brush.seamless_preview = Vista previa de mosaico continuo
