# Comandos de edición, selección y capas.
command.edit.undo.title = Deshacer
command.edit.undo.description = Retrocede una entrada en el historial de acciones deshechas del documento.
command.edit.redo.title = Rehacer
command.edit.redo.description = Repite la última edición deshecha.
command.edit.copy.title = Copiar
command.edit.copy.description = Copia en el portapapeles interno los píxeles seleccionados de la capa activa (o la capa completa si no hay selección).
command.edit.copy_merged.title = Copiar combinado
command.edit.copy_merged.description = Copia la selección tal como resulta de combinar todas las capas visibles, en lugar de copiar únicamente la capa activa.
command.edit.cut.title = Cortar
command.edit.cut.description = Copia los píxeles seleccionados al portapapeles y los borra de la capa activa.
command.edit.paste.title = Pegar
command.edit.paste.description = Pega el contenido del portapapeles en una capa nueva, sobre la capa activa y centrada en el lienzo.
command.edit.paste.layer_name = Capa pegada
command.edit.paste_in_place.title = Pegar en contexto
command.edit.paste_in_place.description = Pega el contenido del portapapeles en una capa nueva, en las coordenadas desde las que se copió.
command.edit.fill_foreground.title = Rellenar con color frontal
command.edit.fill_foreground.description = Rellena la selección (o todo el lienzo si no hay selección) con el color frontal.
command.edit.fill_background.title = Rellenar con color de fondo
command.edit.fill_background.description = Rellena la selección (o todo el lienzo si no hay selección) con el color de fondo.
command.select.all.title = Seleccionar todo
command.select.all.description = Selecciona todo el lienzo.
command.select.deselect.title = Deseleccionar
command.select.deselect.description = Elimina la selección para que las ediciones vuelvan a aplicarse a toda la capa.
command.select.inverse.title = Invertir selección
command.select.inverse.description = Intercambia las áreas seleccionadas y no seleccionadas.
command.select.reselect.title = Volver a seleccionar
command.select.reselect.description = Restaura la última selección eliminada.
command.select.reselect.msg.nothing_to_reselect = No hay nada que volver a seleccionar
command.select.feather.title = Desvanecer selección
command.select.feather.description = Suaviza el borde de la selección con un desenfoque de dos píxeles para que la siguiente edición se desvanezca a lo largo del borde.
command.select.grow.title = Extender
command.select.grow.description = Extiende la selección a los píxeles contiguos que se parezcan a los ya seleccionados, dentro de la tolerancia de la varita mágica.
command.select.similar.title = Similar
command.select.similar.description = Selecciona todos los píxeles de la capa que se parezcan a la selección, sean contiguos o no, dentro de la tolerancia de la varita mágica.
command.select.save.title = Guardar selección
command.select.save.description = Guarda la selección actual en el documento como un canal alfa con nombre.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Cargar selección
command.select.load.description = Restaura la selección guardada más recientemente.
command.layer.new.title = Nueva capa
command.layer.new.description = Añade una capa rasterizada vacía sobre la capa activa y la convierte en activa.
command.layer.duplicate.title = Duplicar capa
command.layer.duplicate.description = Copia la capa activa con todo su contenido en una capa nueva situada encima.
command.layer.smart_object.title = Convertir en objeto inteligente
command.layer.smart_object.description = Envuelve los píxeles de la capa rasterizada activa en un objeto inteligente para que las transformaciones y filtros posteriores remuestreen el origen intacto.
command.layer.rasterize.title = Rasterizar capa
command.layer.rasterize.description = Convierte una capa de forma, texto u objeto inteligente en píxeles simples.
command.layer.delete.title = Eliminar capa
command.layer.delete.description = Elimina las capas seleccionadas.
command.layer.group.title = Agrupar capas
command.layer.group.description = Coloca las capas seleccionadas en un grupo nuevo, sin cambiar su posición.
command.layer.raise.title = Hacia delante
command.layer.raise.description = Sube la capa activa una posición en la pila de su grupo.
command.layer.lower.title = Hacia atrás
command.layer.lower.description = Baja la capa activa una posición en la pila de su grupo.
command.layer.to_front.title = Traer al frente
command.layer.to_front.description = Mueve la capa activa a la parte superior de su grupo.
command.layer.to_back.title = Enviar al fondo
command.layer.to_back.description = Mueve la capa activa a la parte inferior de su grupo.
command.layer.clipping_mask.title = Crear/Soltar máscara de recorte
command.layer.clipping_mask.description = Recorta la capa activa a la capa inferior o la libera si ya está recortada; una capa recortada solo aparece donde su base contiene píxeles.
command.layer.cut_to_new.title = Capa vía cortar
command.layer.cut_to_new.description = Extrae los píxeles seleccionados de la capa activa y los coloca en una capa nueva situada encima.
command.layer.cut_to_new.layer_name = Capa vía cortar
command.layer.add_mask.title = Añadir máscara de capa
command.layer.add_mask.description = Añade una máscara a la capa activa que, si existe una selección, solo muestra dicha selección.
command.layer.flatten.title = Acoplar imagen
command.layer.flatten.description = Combina todo lo visible en una única capa Fondo opaca y descarta las capas ocultas.
command.layer.merge_down.title = Combinar hacia abajo
command.layer.merge_down.description = Combina la capa activa con la capa situada debajo.
command.layer.merge_down.msg.no_layer_below = No hay ninguna capa inferior con la que combinar
command.layer.merge_visible.title = Combinar visibles
command.layer.merge_visible.description = Combina todas las capas visibles en una y conserva intactas las capas ocultas.
command.msg.nothing_to_copy = Selecciona una capa de píxeles de la que copiar
command.msg.clipboard_empty = El portapapeles está vacío
