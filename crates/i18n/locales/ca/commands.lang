command.edit.undo.title = Desfés
command.edit.undo.description = Retrocedeix una entrada en l'historial de desfer del document.
command.edit.redo.title = Refés
command.edit.redo.description = Torna a aplicar l'última edició desfeta.
command.edit.copy.title = Copia
command.edit.copy.description = Copia els píxels seleccionats de la capa activa al porta-retalls intern (o tota la capa si no hi ha res seleccionat).
command.edit.copy_merged.title = Copia fusionat
command.edit.copy_merged.description = Copia la selecció tal com la componen totes les capes visibles, en comptes de copiar només la capa activa.
command.edit.cut.title = Retalla
command.edit.cut.description = Copia els píxels seleccionats al porta-retalls i els esborra de la capa activa.
command.edit.paste.title = Enganxa
command.edit.paste.description = Enganxa el porta-retalls en una capa nova damunt de l'activa, centrada al llenç.
command.edit.paste.layer_name = Capa enganxada
command.edit.paste_in_place.title = Enganxa al mateix lloc
command.edit.paste_in_place.description = Enganxa el porta-retalls en una capa nova a les coordenades d'on s'ha copiat.
command.edit.fill_foreground.title = Emplena amb el primer pla
command.edit.fill_foreground.description = Emplena la selecció (o tot el llenç si no hi ha res seleccionat) amb el color de primer pla.
command.edit.fill_background.title = Emplena amb el fons
command.edit.fill_background.description = Emplena la selecció (o tot el llenç si no hi ha res seleccionat) amb el color de fons.
command.select.all.title = Selecciona-ho tot
command.select.all.description = Selecciona tot el llenç.
command.select.deselect.title = Desselecciona
command.select.deselect.description = Elimina la selecció perquè les edicions tornin a aplicar-se a tota la capa.
command.select.inverse.title = Inverteix la selecció
command.select.inverse.description = Intercanvia les zones seleccionades i les no seleccionades.
command.select.reselect.title = Torna a seleccionar
command.select.reselect.description = Recupera l'última selecció eliminada.
command.select.reselect.msg.nothing_to_reselect = No hi ha res per tornar a seleccionar
command.select.feather.title = Esvaeix la selecció
command.select.feather.description = Suavitza la vora de la selecció amb un desenfocament de dos píxels perquè l'edició següent s'hi esvaeixi gradualment.
command.select.grow.title = Expandeix
command.select.grow.description = Estén la selecció als píxels adjacents semblants als ja seleccionats, dins de la tolerància de la vareta màgica.
command.select.similar.title = Similar
command.select.similar.description = Selecciona tots els píxels de la capa semblants a la selecció, siguin adjacents o no, dins de la tolerància de la vareta màgica.
command.select.save.title = Desa la selecció
command.select.save.description = Desa la selecció actual al document com un canal alfa amb nom.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Carrega la selecció
command.select.load.description = Restaura la selecció desada més recent.
command.layer.new.title = Capa nova
command.layer.new.description = Afegeix una capa rasteritzada buida damunt de l'activa i l'activa.
command.layer.duplicate.title = Duplica la capa
command.layer.duplicate.description = Copia la capa activa, amb tot el contingut, en una capa nova damunt seu.
command.layer.smart_object.title = Converteix en objecte intel·ligent
command.layer.smart_object.description = Encapsula els píxels de la capa rasteritzada activa en un objecte intel·ligent perquè les transformacions i els filtres posteriors remostregin l'origen intacte.
command.layer.rasterize.title = Rasteritza la capa
command.layer.rasterize.description = Converteix una capa de forma, text o objecte intel·ligent en píxels simples.
command.layer.delete.title = Suprimeix la capa
command.layer.delete.description = Suprimeix les capes seleccionades.
command.layer.group.title = Agrupa les capes
command.layer.group.description = Col·loca les capes seleccionades en un grup nou, al mateix lloc.
command.layer.raise.title = Avança
command.layer.raise.description = Mou la capa activa una posició amunt a la pila del grup.
command.layer.lower.title = Enrere
command.layer.lower.description = Mou la capa activa una posició avall a la pila del grup.
command.layer.to_front.title = Porta al davant
command.layer.to_front.description = Mou la capa activa a la part superior del grup.
command.layer.to_back.title = Envia al darrere
command.layer.to_back.description = Mou la capa activa a la part inferior del grup.
command.layer.clipping_mask.title = Crea/allibera una màscara de retall
command.layer.clipping_mask.description = Retalla la capa activa segons la capa inferior, o l'allibera si ja ho està; una capa retallada només es mostra on la base té píxels.
command.layer.cut_to_new.title = Capa mitjançant retall
command.layer.cut_to_new.description = Treu els píxels seleccionats de la capa activa i els posa en una capa nova damunt seu.
command.layer.cut_to_new.layer_name = Capa mitjançant retall
command.layer.add_mask.title = Afegeix una màscara de capa
command.layer.add_mask.description = Afegeix una màscara a la capa activa que només revela la selecció, si n'hi ha.
command.layer.flatten.title = Aplana la imatge
command.layer.flatten.description = Compon tot el que és visible en una única capa Fons opaca i descarta les capes amagades.
command.layer.merge_down.title = Fusiona cap avall
command.layer.merge_down.description = Compon la capa activa amb la capa inferior.
command.layer.merge_down.msg.no_layer_below = No hi ha cap capa inferior amb què fusionar
command.layer.merge_visible.title = Fusiona les visibles
command.layer.merge_visible.description = Compon totes les capes visibles en una de sola, sense alterar les amagades.
command.msg.nothing_to_copy = Seleccioneu una capa de píxels d'on copiar
command.msg.clipboard_empty = El porta-retalls és buit
