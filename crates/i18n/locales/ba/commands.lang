# Үҙгәртеү, Һайлау һәм Ҡатлам командалары.
command.edit.undo.title = Кире ҡайтарыу
command.edit.undo.description = Документтың кире ҡайтарыу тарихында бер аҙым артҡа күсеү.
command.edit.redo.title = Ҡабатлау
command.edit.redo.description = Һуңғы кире ҡайтарылған үҙгәртеүҙе ҡабатлау.
command.edit.copy.title = Күсереп алыу
command.edit.copy.description = Әүҙем ҡатламдың һайланған пикселдәрен эске алмашыу буферына күсереп алыу (бер ни һайланмаһа, тотош ҡатламды).
command.edit.copy_merged.title = Берләштерелгәнде күсереп алыу
command.edit.copy_merged.description = Һайланған өлкәне әүҙем ҡатламдан ғына түгел, ә бөтә күренгән ҡатламдар берләштергәнсә күсереп алыу.
command.edit.cut.title = Ҡырҡып алыу
command.edit.cut.description = Һайланған пикселдәрҙе алмашыу буферына күсереп алып, әүҙем ҡатламдан юйыу.
command.edit.paste.title = Өҫтәү
command.edit.paste.description = Алмашыу буферын әүҙем ҡатлам өҫтөндәге яңы ҡатламға, киндер уртаһына өҫтәү.
command.edit.paste.layer_name = Өҫтәлгән ҡатлам
command.edit.paste_in_place.title = Үҙ урынына өҫтәү
command.edit.paste_in_place.description = Алмашыу буферын ул күсереп алынған координаталарҙағы яңы ҡатламға өҫтәү.
command.edit.fill_foreground.title = Алғы төҫ менән тултырыу
command.edit.fill_foreground.description = Һайланған өлкәне (бер ни һайланмаһа, тотош киндерҙе) алғы төҫ менән тултырыу.
command.edit.fill_background.title = Артҡы төҫ менән тултырыу
command.edit.fill_background.description = Һайланған өлкәне (бер ни һайланмаһа, тотош киндерҙе) артҡы төҫ менән тултырыу.

command.select.all.title = Барыһын һайлау
command.select.all.description = Тотош киндерҙе һайлау.
command.select.deselect.title = Һайлауҙы бөтөрөү
command.select.deselect.description = Һайлауҙы алып, үҙгәртеүҙәрҙе тағы ла тотош ҡатламға ҡулланыу.
command.select.inverse.title = Киреһен һайлау
command.select.inverse.description = Һайланған һәм һайланмаған өлкәләрҙе алмаштырыу.
command.select.reselect.title = Яңынан һайлау
command.select.reselect.description = Һуңғы бөтөрөлгән һайлауҙы кире ҡайтарыу.
command.select.reselect.msg.nothing_to_reselect = Яңынан һайларлыҡ бер ни ҙә юҡ
command.select.feather.title = Һайлау ситен йомшартыу
command.select.feather.description = Һайлау ситен ике пикселгә тоноҡландырып йомшартыу, шуның менән киләһе үҙгәртеүҙе сик буйлап яйлап бөтөрөү.
command.select.grow.title = Үҫтереү
command.select.grow.description = Һайлауҙы тылсымлы таяҡтың рөхсәт ителгән айырмаһы сиктәрендә һайланғанға оҡшаған күрше пикселдәргә киңәйтеү.
command.select.similar.title = Оҡшаш
command.select.similar.description = Ҡатламдағы һайланғанға оҡшаған бөтә пикселдәрҙе, улар тейеп торһа ла, тормаһа ла, тылсымлы таяҡтың рөхсәт ителгән айырмаһы сиктәрендә һайлау.
command.select.save.title = Һайлауҙы һаҡлау
command.select.save.description = Әлеге һайлауҙы документта исемле альфа-канал итеп һаҡлау.
command.select.save.channel_name = Альфа {n}
command.select.load.title = Һайлауҙы йөкләү
command.select.load.description = Иң һуңғы һаҡланған һайлауҙы тергеҙеү.

command.layer.new.title = Яңы ҡатлам
command.layer.new.description = Әүҙем ҡатлам өҫтөнә буш растр ҡатламы өҫтәп, уны әүҙем итеү.
command.layer.duplicate.title = Ҡатламдың күсермәһен яһау
command.layer.duplicate.description = Әүҙем ҡатламды бөтә эстәлеге менән уның өҫтөндәге яңы ҡатламға күсереү.
command.layer.smart_object.title = Аҡыллы объектҡа әйләндереү
command.layer.smart_object.description = Әүҙем растр ҡатламының пикселдәрен аҡыллы объектҡа төрөү, шуның менән артабанғы үҙгәртеүҙәр һәм фильтрҙар тейелмәгән сығанаҡтан өлгө ала.
command.layer.rasterize.title = Ҡатламды растрлау
command.layer.rasterize.description = Форма, текст йәки аҡыллы объект ҡатламын ябай пикселдәргә әйләндереү.
command.layer.delete.title = Ҡатламды юйыу
command.layer.delete.description = Һайланған ҡатламдарҙы юйыу.
command.layer.group.title = Ҡатламдарҙы төркөмләү
command.layer.group.description = Һайланған ҡатламдарҙы урындарында яңы төркөмгә төрөү.
command.layer.raise.title = Алғараҡ сығарыу
command.layer.raise.description = Әүҙем ҡатламды төркөм стекында бер урынға өҫкә күсереү.
command.layer.lower.title = Артҡараҡ ебәреү
command.layer.lower.description = Әүҙем ҡатламды төркөм стекында бер урынға аҫҡа күсереү.
command.layer.to_front.title = Иң алға сығарыу
command.layer.to_front.description = Әүҙем ҡатламды төркөмөнөң иң өҫтөнә күсереү.
command.layer.to_back.title = Иң артҡа ебәреү
command.layer.to_back.description = Әүҙем ҡатламды төркөмөнөң иң аҫтына күсереү.
command.layer.clipping_mask.title = Киҫеү битлеген булдырыу/ысҡындырыу
command.layer.clipping_mask.description = Әүҙем ҡатламды аҫтындағы ҡатлам буйынса киҫеү йәки киҫелгән булһа ысҡындырыу; киҫелгән ҡатлам төп ҡатламда пикселдәр булған урында ғына күренә.
command.layer.cut_to_new.title = Ҡырҡып яңы ҡатламға
command.layer.cut_to_new.description = Һайланған пикселдәрҙе әүҙем ҡатламдан уның өҫтөндәге яңы ҡатламға күсереү.
command.layer.cut_to_new.layer_name = Ҡырҡып алынған ҡатлам
command.layer.add_mask.title = Ҡатлам битлеген өҫтәү
command.layer.add_mask.description = Әүҙем ҡатламға битлек өҫтәү; һайлау булһа, ул һайланған өлкәне генә күрһәтә.
command.layer.flatten.title = Рәсемде бер ҡатламға берләштереү
command.layer.flatten.description = Күренгәндең барыһын бер үтә күренмәгән Фон ҡатламына берләштереп, йәшерен ҡатламдарҙы ташлау.
command.layer.merge_down.title = Аҫҡа берләштереү
command.layer.merge_down.description = Әүҙем ҡатламды аҫтындағы ҡатлам менән берләштереү.
command.layer.merge_down.msg.no_layer_below = Берләштереү өсөн аҫта ҡатлам юҡ
command.layer.merge_visible.title = Күренгәндәрҙе берләштереү
command.layer.merge_visible.description = Барлыҡ күренгән ҡатламдарҙы бер ҡатламға берләштереп, йәшерендәренә теймәү.

command.msg.nothing_to_copy = Күсереп алыу өсөн пикселле ҡатлам һайлағыҙ
command.msg.clipboard_empty = Алмашыу буферында бер ни ҙә юҡ

