# Вектор ҡоралдары.
tool.pen.name = Перо
tool.pen.description = Контур төҙөгөҙ: мөйөш нөктәһе өсөн сиртегеҙ, унан кәкре һыҙыҡ тотҡаларын сығарыу өсөн һөйрәгеҙ һәм ябыу өсөн тәүге нөктәгә сиртегеҙ. Раҫлау контурҙы форма ҡатламына әйләндерә.
tool.pen.option.rubber_band = Һуҙылмалы һыҙыҡ
tool.pen.history.fill = Контурҙы тултырыу
tool.pen.default_path_name = Контур {n}
tool.pen.freeform.name = Ирекле перо
tool.pen.freeform.description = Ирекле һыҙыҡты һөйрәп һыҙығыҙ, һәм ул Яраҡлаштырыу параметрына ярашлы иркенлек менән контурға туралана.
tool.pen.freeform.option.fit = Яраҡлаштырыу
tool.pen.curvature.name = Кәкрелек пероһы
tool.pen.curvature.description = Бер нисә нөктәгә сиртегеҙ, һәм контур улар аша шыма кәкре булып үтә.

tool.path_select.name = Контурҙы һайлау
tool.path_select.description = Контурҙы һайлау өсөн уға сиртегеҙ, ә тотош контурҙы күсереү өсөн һөйрәгеҙ.
tool.direct_select.name = Туранан-тура һайлау
tool.direct_select.description = Контурҙың формаһын үҙгәртеү өсөн айырым терәк нөктәһен йәки уның тотҡаларын һөйрәгеҙ.

