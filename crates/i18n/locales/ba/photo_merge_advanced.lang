# Advanced photo merge.
photo_merge_advanced.projective = Перспективаны тура килтереп (әйләнеште үҙ эсенә ала)
photo_merge_advanced.cylindrical = Цилиндр рәүешендәге панорама
photo_merge_advanced.deghost = Хәрәкәт итеүсе объекттарҙың ҡабатланған һүрәттәрен бөтөрөгөҙ (беренсе фото өлгө була)
photo_merge_advanced.focal = Фокус арауығы (px) / һүрәт киңлеге (px)
photo_merge_advanced.masks = Фокус сығышы мөхәррирләнгән ҡатлам битлектәрен ҡуллана. Ҡатламдарҙа битлек һайлағыҙ һәм рафинациялау өсөн буяғыҙ.
photo_merge_advanced.no_match = Ышаныслы туралау табылманы. Бер-береһен байтаҡ ҡаплаған, деталдәре булған һәм төрлө ракурстан әллә ни айырылмаған фотоларҙы ҡулланығыҙ.
photo_merge_advanced.invalid = Дөрөҫ булмаған сығанаҡ һүрәттәре йәки берләштереү параметрҙары.
