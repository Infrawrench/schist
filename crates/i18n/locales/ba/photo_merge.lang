# Photographic merging. Machine-assisted translation with terminology review.
photo_merge.title = Фотоларҙы берләштереү...
photo_merge.align = Автоматик тура килтереү
photo_merge.focus = Төрлө фокус арауыҡтары булған фотоһүрәттәрҙе берләштереү
photo_merge.hdr = HDR бер нисә экспозиция кимәленән
photo_merge.panorama = Фотоһүрәттәрҙе панорамаға берләштереү
photo_merge.translation = Тик горизонталь һәм вертикаль һүрәт хәрәкәте (X/Y); әйләнеш йәки перспектива төҙәтеү юҡ.
photo_merge.crop = Дөйөм майҙанға ҡырҡыу
photo_merge.exposure_note = Һәр фотоның сағыштырмаса экспозицияһын ҡуйығыҙ: +1 EV ике тапҡырға күберәк яҡтылыҡ тигәнде аңлата. 32-битлы HDR һаҡлау өсөн һүрәт тоны картаһын өҙөү.
photo_merge.tone_map = Һүрәттең тондарын картаға төшөрөү
photo_merge.order = Асыҡ документ өлөшсәләренең тәртибен ҡулланығыҙ. Һәр панорама фотоһы алдағы фото менән кәмендә 25 процентҡа ҡапланырға тейеш.
photo_merge.invalid = 2–16 дөрөҫ һүрәт һайлағыҙ һәм экспозиция параметрҙарын тикшерегеҙ.
photo_merge.limit = Сик: 64 миллион пиксель бер һүрәт йәки сығыш, 128 миллион дөйөм; 30000 пиксель бер яҡтан.
photo_merge.no_match = Ышаныслы ҡапланыу табылмаған. Ҡулланыу ҡапланған фотоһүрәттәр әйләнешһеҙ йәки перспектива үҙгәрештәре.
