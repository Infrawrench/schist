# Lens profile controls.
lens_profiles.invalid = Камера йәки объектив тураһында яраҡлы мәғлүмәт булған Lensfun v1/v2 XML базаһын һайлағыҙ (8 MiB тиклем).
lens_profiles.calibration = Объективты калибровкалау
lens_profiles.no_calibration = Был көйләүҙәргә ярашлы калибрлау юҡ. Фокус арауығын һәм камераның кроп-факторын тикшерегеҙ; ҡул менән төҙәтеү ҙә мөмкин.
lens_profiles.import = Lensfun XML импортлау…
lens_profiles.imported = Был сеанс өсөн Lensfun базаһы импортланды. Профилде һайлағыҙ йәки фотоның метамағлүмәттәренә ярашлыһын табығыҙ.
lens_profiles.manual = Ҡул менән генә төҙәтеү
lens_profiles.saved = Һаҡланған калибровка (мәғлүмәттәр базаһы юҡ)
lens_profiles.profile = Объектив профиле
lens_profiles.aperture = Диафрагма (0 = билдәһеҙ)
lens_profiles.distance = Фокус арауығы (0 = билдәһеҙ)
lens_profiles.vignette = Калибрланған виньетка
lens_profiles.color_context = Калибрланған виньеткалау өсөн программаға индерелгән sRGB профиле кәрәк. Төҫтәрҙең күренешен һаҡлау өсөн sRGB-ға үҙгәртегеҙ, һуңынан Объективты төҙәтеүҙе яңынан асығыҙ. Пикселдәр sRGB форматында булып, тик билдәләнмәгән булһа, уларға sRGB профилен тәғәйенләү етә. Геометрик һәм хроматик төҙәтеүҙәр ҡулланырлыҡ булып ҡала.
lens_profiles.vignette_missing = Был диафрагма һәм фокус арауығына ярашлы виньеткалау калибрлауы юҡ. Уны эшләтеү өсөн үлсәнгән ҡиммәттәрҙе индерегеҙ; күп Lensfun профилдәрендә 1000 m алыҫҡа фокуслауҙы аңлата.
lens_profiles.note = Калибрланған төҙәтеү ҡул менән идара итеү элементтарынан алда ҡулланыла. Тәүге тулы кадрҙы файҙаланығыҙ; һуңынан ҡырҡығыҙ. Үҙгәртеп була торған калибрлауҙы һаҡлау өсөн фильтрҙар теҙмәһен PSD/PSB форматында һаҡлағыҙ.
lens_profiles.automatic = Фото метамағлүмәттәрен тап килтерегеҙ
lens_profiles.components = Профиль үткәреү: боҙолоу {distortion}; төҫлө ҡырҙар {tca}; виньеткалау {vignette}.
