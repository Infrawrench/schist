tool.marquee.rect.name = Ukukhetha Okungumgceke
tool.marquee.rect.description = Hudula udale okukhethiweyo okungumgceke. Ukubamba u-Shift uqala ukuhudula kwengeza kokukhethiweyo, u-Alt uyasusa, ukubamba bobabili kukhetha lapho okuphambana khona; ukubamba u-Shift ngesikhathi uhudula kwenza kube zikwele. Ukuchofoza ungahudulanga kuyekela ukukhetha.
tool.marquee.ellipse.name = Ukukhetha Okuyindilinga
tool.marquee.ellipse.description = Hudula udale okukhethiweyo okuyindilinga, usebenzisa u-Shift lo-Alt ukuhlanganisa ngendlela efanana leyokukhetha okungumgceke.

tool.lasso.name = I-Lasso
tool.lasso.description = Hudula umngcele ngesandla; okukhethiweyo kuvaleka phakathi kwemikhawulo nxa uqeda ukuhudula. U-Shift uyengeza, u-Alt uyasusa.
tool.lasso.history.select = Ukukhetha Nge-Lasso
tool.lasso.polygonal.name = I-Lasso Yezinhlangothi
tool.lasso.polygonal.description = Chofoza ikhona lilandelwa ngelinye ukuze wakhe ukukhetha okulomngcele oqondileyo, ubusuvala ngokuchofoza eduze kwephuzu lokuqala.
tool.lasso.polygonal.history.select = I-Lasso Yezinhlangothi
tool.lasso.magnetic.name = I-Lasso Elomazibuthe
tool.lasso.magnetic.description = Landela umphetho eduze, umngcele unamathele kumehluko oqine kakhulu eduze komzila.
tool.lasso.magnetic.history.select = I-Lasso Elomazibuthe
tool.lasso.magnetic.option.frequency = Ukuphindaphinda

