command.edit.undo.title = Hlehlisa
command.edit.undo.description = Buyela emuva ngenyathelo elilodwa embalini yokuhlehlisa yedokhumenti.
command.edit.redo.title = Yenza Futhi
command.edit.redo.description = Yenza futhi ukuhlela okwahlehliswa ekucineni.
command.edit.copy.title = Kopa
command.edit.copy.description = Kopa amaphikseli akhethiweyo esendlalelo esisebenzayo uwafake ebhodini langaphakathi lokukopa (isendlalelo sonke nxa kungelakukhethiweyo).
command.edit.copy_merged.title = Kopa Okuhlanganisiweyo
command.edit.copy_merged.description = Kopa okukhethiweyo ngendlela zonke izendlalelo ezibonakalayo ezikuhlanganisa ngayo, hatshi kusendlalelo esisebenzayo kuphela.
command.edit.cut.title = Sika
command.edit.cut.description = Kopa amaphikseli akhethiweyo uwafake ebhodini lokukopa ubusuwasula kusendlalelo esisebenzayo.
command.edit.paste.title = Namathisela
command.edit.paste.description = Namathisela okusebhodini lokukopa kusendlalelo esitsha esiphezu kwaleso esisebenzayo, kufakwe phakathi kwekhanvasi.
command.edit.paste.layer_name = Isendlalelo Esinamathiselweyo
command.edit.paste_in_place.title = Namathisela Endaweni
command.edit.paste_in_place.description = Namathisela okusebhodini lokukopa kusendlalelo esitsha ezixhumanisini lapho okwakotshwa khona.
command.edit.fill_foreground.title = Gcwalisa Ngombala Wangaphambili
command.edit.fill_foreground.description = Gcwalisa okukhethiweyo (kumbe ikhanvasi yonke nxa kungelakukhethiweyo) ngombala wangaphambili.
command.edit.fill_background.title = Gcwalisa Ngombala Wangemuva
command.edit.fill_background.description = Gcwalisa okukhethiweyo (kumbe ikhanvasi yonke nxa kungelakukhethiweyo) ngombala wangemuva.

command.select.all.title = Khetha Konke
command.select.all.description = Khetha ikhanvasi yonke.
command.select.deselect.title = Yekela Ukukhetha
command.select.deselect.description = Yekela okukhethiweyo ukuze ukuhlela kusebenze kusendlalelo sonke futhi.
command.select.inverse.title = Khetha Okuphambeneyo
command.select.inverse.description = Tshintshanisa indawo ezikhethiweyo lezingakhethwanga.
command.select.reselect.title = Khetha Futhi
command.select.reselect.description = Buyisa ukukhetha okwayekelwa ekucineni.
command.select.reselect.msg.nothing_to_reselect = Akulalutho olungakhethwa futhi
command.select.feather.title = Thambisa Umphetho Wokukhethiweyo
command.select.feather.description = Thambisa umphetho wokukhethiweyo ngokufiphalisa amaphikseli amabili ukuze ukuhlela okulandelayo kuphele kancane phakathi kwawo.
command.select.grow.title = Khulisa
command.select.grow.description = Nweba okukhethiweyo kungene kumaphikseli athintanayo afanana lasekhethiwe, phakathi kokubekezelela kwentonga yomlingo.
command.select.similar.title = Okufananayo
command.select.similar.description = Khetha wonke amaphikseli kusendlalelo afanana lokukhethiweyo, kungelani lokuthi ayakuthinta loba hatshi, phakathi kokubekezelela kwentonga yomlingo.
command.select.save.title = Gcina Okukhethiweyo
command.select.save.description = Gcina okukhethiweyo kwamanje kudokhumenti njengeshaneli ye-alpha elebizo.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Layisha Okukhethiweyo
command.select.load.description = Buyisa ukukhetha okusanda kugcinwa.

command.layer.new.title = Isendlalelo Esitsha
command.layer.new.description = Engeza isendlalelo samaphikseli esingelalutho phezu kwesisebenzayo, usenze sisebenze.
command.layer.duplicate.title = Phinda Isendlalelo
command.layer.duplicate.description = Kopa isendlalelo esisebenzayo lakho konke okukuso, usifake kusendlalelo esitsha phezu kwaso.
command.layer.smart_object.title = Guqulela Entweni Ehlakaniphileyo
command.layer.smart_object.description = Goqela amaphikseli esendlalelo esisebenzayo entweni ehlakaniphileyo ukuze inguquko lezisefo zakamuva zibale kutsha umthombo ongakathintwa.
command.layer.rasterize.title = Guqulela Isendlalelo Kumaphikseli
command.layer.rasterize.description = Guqula isendlalelo sesimo, sombhalo kumbe sento ehlakaniphileyo sibe ngamaphikseli avamileyo.
command.layer.delete.title = Susa Isendlalelo
command.layer.delete.description = Susa izendlalelo ezikhethiweyo.
command.layer.group.title = Beka Izendlalelo Eqenjini
command.layer.group.description = Goqela izendlalelo ezikhethiweyo eqenjini elitsha zisendaweni yazo.
command.layer.raise.title = Sondeza Phambili
command.layer.raise.description = Hambisa isendlalelo esisebenzayo indawo eyodwa phezulu enqwabeni yeqembu laso.
command.layer.lower.title = Buyisela Emuva
command.layer.lower.description = Hambisa isendlalelo esisebenzayo indawo eyodwa phansi enqwabeni yeqembu laso.
command.layer.to_front.title = Letha Phambili
command.layer.to_front.description = Hambisa isendlalelo esisebenzayo phezulu kweqembu laso.
command.layer.to_back.title = Thumela Emuva
command.layer.to_back.description = Hambisa isendlalelo esisebenzayo phansi kweqembu laso.
command.layer.clipping_mask.title = Dala/Khulula Isimbozo Sokusika
command.layer.clipping_mask.description = Sika isendlalelo esisebenzayo ngesingaphansi kwaso, kumbe usikhulule nxa sesisikiwe; isendlalelo esisikiweyo sibonakala kuphela lapho isisekelo saso esilamaphikseli khona.
command.layer.cut_to_new.title = Isendlalelo Ngokusebenzisa Ukusika
command.layer.cut_to_new.description = Susa amaphikseli akhethiweyo kusendlalelo esisebenzayo uwafake kusendlalelo esitsha phezu kwaso.
command.layer.cut_to_new.layer_name = Isendlalelo Ngokusebenzisa Ukusika
command.layer.add_mask.title = Engeza Isimbozo Sesendlalelo
command.layer.add_mask.description = Engeza isimbozo kusendlalelo esisebenzayo, esibonisa okukhethiweyo kuphela nxa kukhona.
command.layer.flatten.title = Yenza Isithombe Sibe Yisendlalelo Esisodwa
command.layer.flatten.description = Hlanganisa konke okubonakalayo kube yisendlalelo Sangemuva esisodwa esingabonakalisi ngale, ulahle izendlalelo ezifihliweyo.
command.layer.merge_down.title = Hlanganisela Phansi
command.layer.merge_down.description = Hlanganisa isendlalelo esisebenzayo kwesingaphansi kwaso.
command.layer.merge_down.msg.no_layer_below = Akulasendlalelo esingaphansi okungahlanganiselwa kuso
command.layer.merge_visible.title = Hlanganisa Okubonakalayo
command.layer.merge_visible.description = Hlanganisa zonke izendlalelo ezibonakalayo zibe sinye, utshiye ezifihliweyo zinjalo.

command.msg.nothing_to_copy = Khetha isendlalelo samaphikseli ongakopa kuso
command.msg.clipboard_empty = Akulalutho ebhodini lokukopa

