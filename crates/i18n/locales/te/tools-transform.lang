tool.transform.name = స్వేచ్ఛా రూపాంతరం
tool.transform.description = స్వేచ్ఛా రూపాంతరం. దీన్ని సక్రియం చేస్తే సక్రియ లేయర్ చుట్టూ రూపాంతర పెట్టె తెరుచుకుంటుంది: పరిమాణం మార్చడానికి మూలను, తిప్పడానికి పెట్టె వెలుపల భాగాన్ని, వాలు చేయడానికి అంచును లాగండి. నిర్ధారించే వరకు (Enter) ఏ మార్పూ రాయబడదు; రద్దు చేస్తే (Escape) లేయర్ మునుపటి స్థితికి వస్తుంది.
tool.transform.option.interpolation = అంతర్వేశనం
tool.transform.history.transform = స్వేచ్ఛా రూపాంతరం
