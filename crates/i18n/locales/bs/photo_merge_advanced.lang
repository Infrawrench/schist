photo_merge_advanced.projective = Poravnavanje perspektive (uključuje rotaciju)
photo_merge_advanced.cylindrical = Cilindrična panorama
photo_merge_advanced.deghost = Uklonite tragove pokretnih objekata (prva fotografija je referenca)
photo_merge_advanced.focal = Žižna daljina (px) / širina slike (px)
photo_merge_advanced.masks = Rezultat spajanja fokusa koristi maske slojeva koje se mogu uređivati. Odaberite masku u Slojevima i slikajte da je doradite.
photo_merge_advanced.no_match = Nije pronađeno pouzdano poravnanje. Koristite fotografije s teksturom sa značajnim preklapanjem i skromnim promjenama gledišta.
photo_merge_advanced.invalid = Nevažeće izvorne slike ili postavke spajanja.
