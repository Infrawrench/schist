# AI-assisted translation; native-speaker review pending.
tethered.title = Povezano snimanje
tethered.capture = Snimi fotografiju
tethered.invalid_name = Odaberite naziv od 1–120 bajtova bez kosih crta, dvotački, znakova postotka ili tačke na početku.
tethered.install = Sistemska biblioteka za kameru nije dostupna. Instalirajte okruženje za kameru za ovu platformu i ponovo pokrenite Schist.
tethered.timeout = Vrijeme čekanja na zahtjev kameri je isteklo. Provjerite kameru i ponovo je povežite prije novog pokušaja.
tethered.failed = Zahtjev kameri nije uspio: {detail}
tethered.unsupported = Ova kamera ne prijavljuje podršku za daljinsko snimanje fotografija.
tethered.no_download = Kamera nije poslala potpunu sliku. Originali ostaju sačuvani na kameri.
tethered.session_help = Odaberite kameru, a zatim Snimi fotografiju. Pri prvom snimanju odaberite odredište i prefiks naziva datoteke; snimcima se dodaju redni broj i ekstenzija datoteke s kamere. Sačuvaj kao… mijenja odredište i prefiks.
tethered.preview_failed = Snimak je sačuvan i uvezen, ali njegov pregled nije bilo moguće dekodirati. Otvorite ga u uređivaču da pregledate datoteku.
tethered.partial = Neke datoteke snimaka su sačuvane i uvezene; preostale nije bilo moguće sačuvati: {error}
tethered.camera_permission = Dozvolite pristup kameri u Postavke sistema → Privatnost i sigurnost → Kamera, pa ponovo pokušajte Snimi fotografiju. Ako je Schist pokrenut iz terminala, provjerite i dozvolu za kameru tog terminala.
tethered.camera_usage_missing = Ovoj verziji nedostaje opis dozvole za kameru. Ponovo izgradite Schist naredbom make ili koristite zapakovanu aplikaciju.
tethered.select_camera = Odaberite kameru za fotografisanje.
tethered.choose_destination = Snimi fotografiju će vas pitati gdje želite sačuvati fotografije.
tethered.preview_empty = Snimite fotografiju da je vidite ovdje.
