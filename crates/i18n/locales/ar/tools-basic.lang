# الأدوات الأساسية: النقل والقطّارة واليد والتكبير/التصغير.

# النقل
tool.move.name = نقل
tool.move.description = اسحب محتوى الطبقة النشطة إلى موضع جديد. عند تشغيل التحديد التلقائي، يؤدي الضغط أولًا إلى اختيار الطبقة الواقعة تحت المؤشر، أو المجموعة بأكملها.
tool.move.option.auto_select = تحديد تلقائي
tool.move.history.move_layer = نقل الطبقة

# القطّارة
tool.eyedropper.name = القطّارة
tool.eyedropper.description = خذ عينة من اللون تحت المؤشر وضعها في عينة المقدمة، أو في عينة الخلفية عند الضغط على Alt. يستمر أخذ العينات أثناء السحب.
tool.eyedropper.option.sample_size = حجم العينة
tool.eyedropper.option.sample = أخذ عينة من
