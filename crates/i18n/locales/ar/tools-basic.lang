tool.eyedropper.choice.average_5 = متوسط 5 × 5
tool.eyedropper.choice.average_11 = متوسط 11 × 11
tool.eyedropper.choice.average_31 = متوسط 31 × 31
tool.eyedropper.choice.all_layers = كل الطبقات
tool.eyedropper.choice.current_layer = الطبقة الحالية

# اليد والتكبير/التصغير
tool.hand.name = اليد
tool.hand.description = حرّك العرض أفقيًا أو رأسيًا. تنتمي نافذة العرض إلى النافذة، لذلك لا تغيّر هذه الأداة المستند عند التشغيل بلا واجهة.
tool.zoom.name = تكبير/تصغير
tool.zoom.description = كبّر العرض أو صغّره. تنتمي نافذة العرض إلى النافذة، لذلك لا تغيّر هذه الأداة المستند عند التشغيل بلا واجهة.
