# Vanishing Point
tool.vanishing_point.name = Vanishing Point
tool.vanishing_point.description = Seret bidang ing ndhuwur samubarang sing nduwèni perspektif, banjur ganti modus dadi Klon lan pulasaké: piksel sing disalin bakal manut bidang lan saya cilik kanthi saya adoh.
