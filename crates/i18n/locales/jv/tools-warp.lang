# Puppet Warp
tool.puppet_warp.name = Puppet Warp
tool.puppet_warp.description = Klik kanggo masang pin ing sawatara titik lapisan, banjur seret salah siji: jejaring bakal mlengkung ngubengi pin, kanthi kaku utawa longgar manut pilihan Kakuné. Komit bakal ngetrapaké asilé.
