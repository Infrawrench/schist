command.edit.undo.title = Visszavonás
command.edit.undo.description = Lépjen vissza egy bejegyzést a dokumentum visszavonási előzményeiben.
command.edit.redo.title = Újra
command.edit.redo.description = Ismételje meg a legutóbb visszavont szerkesztést.
command.edit.copy.title = Másolás
command.edit.copy.description = Másolja az aktív réteg kijelölt képpontjait a belső vágólapra (ha nincs kijelölés, az egész réteget).
command.edit.copy_merged.title = Egyesített másolása
command.edit.copy_merged.description = Másolja a kijelölést úgy, ahogy az összes látható réteg együtt alkotja, ne csak az aktív rétegről.
command.edit.cut.title = Kivágás
command.edit.cut.description = Másolja a kijelölt képpontokat a vágólapra, és törölje őket az aktív rétegről.
command.edit.paste.title = Beillesztés
command.edit.paste.description = Illessze a vágólap tartalmát egy új rétegre az aktív fölött, a vászon közepére.
command.edit.paste.layer_name = Beillesztett réteg
command.edit.paste_in_place.title = Beillesztés helyben
command.edit.paste_in_place.description = Illessze a vágólap tartalmát egy új rétegre azokra a koordinátákra, ahonnan másolta.
command.edit.fill_foreground.title = Kitöltés előtérszínnel
command.edit.fill_foreground.description = Töltse ki a kijelölést (vagy kijelölés híján az egész vásznat) az előtérszínnel.
command.edit.fill_background.title = Kitöltés háttérszínnel
command.edit.fill_background.description = Töltse ki a kijelölést (vagy kijelölés híján az egész vásznat) a háttérszínnel.
command.select.all.title = Összes kijelölése
command.select.all.description = Jelölje ki az egész vásznat.
command.select.deselect.title = Kijelölés megszüntetése
command.select.deselect.description = Szüntesse meg a kijelölést, hogy a szerkesztések ismét az egész rétegre vonatkozzanak.
command.select.inverse.title = Kijelölés megfordítása
command.select.inverse.description = Cserélje fel a kijelölt és a ki nem jelölt területeket.
command.select.reselect.title = Újrakijelölés
command.select.reselect.description = Állítsa vissza a legutóbb megszüntetett kijelölést.
command.select.reselect.msg.nothing_to_reselect = Nincs visszaállítható kijelölés
command.select.feather.title = Kijelölés szélének lágyítása
command.select.feather.description = Lágyítsa a kijelölés szélét két képpontos életlenítéssel, hogy a következő szerkesztés fokozatosan halványuljon el rajta.
command.select.grow.title = Bővítés
command.select.grow.description = Bővítse a kijelölést az azt érintő, a már kijelöltekhez hasonló képpontokra a varázspálca tűrésén belül.
command.select.similar.title = Hasonló
command.select.similar.description = Jelölje ki a rétegen a kijelöléshez hasonló összes képpontot, függetlenül attól, hogy érintkeznek-e vele, a varázspálca tűrésén belül.
command.select.save.title = Kijelölés mentése
command.select.save.description = Tárolja az aktuális kijelölést névvel ellátott alfacsatornaként a dokumentumban.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Kijelölés betöltése
command.select.load.description = Állítsa vissza a legutóbb mentett kijelölést.
command.layer.new.title = Új réteg
command.layer.new.description = Adjon hozzá egy üres raszterréteget az aktív fölé, és tegye aktívvá.
command.layer.duplicate.title = Réteg kettőzése
command.layer.duplicate.description = Másolja az aktív réteget teljes tartalmával egy új rétegre fölötte.
command.layer.smart_object.title = Konvertálás intelligens objektummá
command.layer.smart_object.description = Csomagolja az aktív raszterréteg képpontjait intelligens objektumba, hogy a későbbi alakítások és szűrők az érintetlen forrást mintavételezzék újra.
command.layer.rasterize.title = Réteg raszterizálása
command.layer.rasterize.description = Alakítson egy alakzat-, szöveg- vagy intelligensobjektum-réteget egyszerű képpontokká.
command.layer.delete.title = Réteg törlése
command.layer.delete.description = Törölje a kijelölt rétegeket.
command.layer.group.title = Rétegek csoportosítása
command.layer.group.description = Helyezze a kijelölt rétegeket ugyanott egy új csoportba.
command.layer.raise.title = Előrébb hozás
command.layer.raise.description = Mozgassa az aktív réteget egy hellyel feljebb a csoportja vermében.
command.layer.lower.title = Hátrébb küldés
command.layer.lower.description = Mozgassa az aktív réteget egy hellyel lejjebb a csoportja vermében.
command.layer.to_front.title = Előtérbe hozás
command.layer.to_front.description = Mozgassa az aktív réteget a csoportja tetejére.
command.layer.to_back.title = Háttérbe küldés
command.layer.to_back.description = Mozgassa az aktív réteget a csoportja aljára.
command.layer.clipping_mask.title = Vágómaszk létrehozása/feloldása
command.layer.clipping_mask.description = Vágja az aktív réteget az alatta lévőhöz, vagy oldja fel, ha már vágott; a vágott réteg csak ott látszik, ahol az alaprétegnek vannak képpontjai.
command.layer.cut_to_new.title = Réteg kivágással
command.layer.cut_to_new.description = Mozgassa a kijelölt képpontokat az aktív rétegről egy új rétegre fölötte.
command.layer.cut_to_new.layer_name = Réteg kivágással
command.layer.add_mask.title = Rétegmaszk hozzáadása
command.layer.add_mask.description = Adjon rétegmaszkot az aktív réteghez, amely kijelölés esetén csak a kijelölt területet fedi fel.
command.layer.flatten.title = Kép lapítása
command.layer.flatten.description = Kompozitáljon minden láthatót egy átlátszatlan Háttér rétegre, a rejtett rétegeket eldobva.
command.layer.merge_down.title = Egyesítés lefelé
command.layer.merge_down.description = Kompozitálja az aktív réteget az alatta lévő rétegbe.
command.layer.merge_down.msg.no_layer_below = Nincs alatta egyesíthető réteg
command.layer.merge_visible.title = Láthatók egyesítése
command.layer.merge_visible.description = Kompozitálja az összes látható réteget egybe, a rejtett rétegeket változatlanul hagyva.
command.msg.nothing_to_copy = Jelöljön ki egy képpontréteget a másoláshoz
command.msg.clipboard_empty = A vágólap üres
