# Lens profile controls.
lens_profiles.invalid = Khetsa imininingwane ye-Lensfun v1/v2 XML lesebentako (ingedluli ku-8 MiB) lenemininingwane yekhamera noma yelensi lesekelwako.
lens_profiles.calibration = Kulinganisa ilensi
lens_profiles.no_calibration = Akukho kulinganiswa lokuhambisana naletilungiselelo. Hlola budze be-focal ne-crop factor yekhamera; kusaloku kukhona nekulungisa ngesandla.
lens_profiles.import = Ngenisa i-Lensfun XML…
lens_profiles.imported = Imininingwane ye-Lensfun ingenisiwe kulesikhatsi sekusebenta. Khetsa iphrofayili yelensi noma uyifanise nemininingwane yesitfombe.
lens_profiles.manual = Kulungisa ngesandla kuphela
lens_profiles.saved = Kulinganiswa lokugciniwe (imininingwane ayitfolakali)
lens_profiles.profile = Iphrofayili yelensi
lens_profiles.aperture = Kuvuleka kwelensi (0 = akwatiwa)
lens_profiles.distance = Libanga lekugxila (0 = akwatiwa)
lens_profiles.vignette = Kumnyama kwemaphetselo lokulinganisiwe
lens_profiles.color_context = Kumnyama kwemaphetselo lokulinganisiwe kudzinga iphrofayili ye-sRGB leyakhelwe ngaphakathi. Guculela ku-sRGB kugcina kubukeka kwesitfombe, bese uvula Kulungisa Ilensi futsi. Kuma-pixel lasese-sRGB kodvwa langenalo luphawu, kwabela iphrofayili ye-sRGB kwanele. Kulungiswa kwejiyomethri nemiphetselo yemibala kusatfolakala.
lens_profiles.vignette_missing = Akukho kulinganiswa kwekumnyama kwemaphetselo lokufanele kuvuleka kwelensi nelibanga lekugxila. Faka emanani lakaliwe kuze kusebente; kuma-phrofayili lamanyenti e-Lensfun, 1000 m usho kugxila kude.
lens_profiles.note = Kulungisa lokulinganisiwe kwentiwa ngaphambi kwekulawula ngesandla. Sebentisa sitfombe sonkhe sekucala; sisike ngemva kwaloko. Gcina sicumbi setihlungi ku-PSD/PSB kuze lokulinganiswa kuchubeke kushintjeka.
lens_profiles.automatic = Fanisa nemininingwane yesitfombe
lens_profiles.components = Kulungisa ngephrofayili: kugoba {distortion}; imiphetselo yemibala {tca}; kumnyama kwemaphetselo {vignette}.
