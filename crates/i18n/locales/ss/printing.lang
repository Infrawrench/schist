printing.actual_size = Usayizi mbamba kusuka ku-DPI yedokhumenti (kute sikali)
printing.captions = Faka emagama emafayela, tilinganiso kanye nemibhalo
printing.pages = Emakhasi: {count}
printing.color_note = Emaphikseli aguqulelwa ku-sRGB. Sibukeli sakho se-PDF kanye nesiphrinti kulawula iphrofayili yembala yesiphrinti.
printing.sizing_note = Imodi yekulinganisa ifaka sonkhe sitfombe esitokisini saso segridi ngaphandle kwekusisika. Usayizi mbamba usebentisa i-DPI yedokhumenti; nciphisa linani lemigca noma emakholomu uma singangeni. Phrinta i-PDF nga-100% ucishe inketho yekulinganisa ekhasini.
printing.running = Kulungiselela i-PDF...
printing.save_pdf = Gcina i-PDF...
printing.open_print = Gcina bese uvula i-PDF kute uyiphrinte...
printing.invalid = Tilungiselelo tekuphrinta letingasebenti noma tilinganiso tesitfombe.
printing.limit = Umsebenti wekuphrinta weca umkhawulo: titfombe leti-200, emaphikseli latigidzi leti-40 ngesitfombe ngasinye noma emaphikseli la-32768 kuluhlangotsi ngalunye lwesitfombe ngasinye, noma 256 MiB wedatha ye-PDF lecindezelwe.
printing.profile_error = Lesitfombe sinephrofayili yembala lengasebenti, lengahambisani naso noma lengasekelwa. Idokhumenti lenemashaneli embala e-CMYK/Lab emvelo idzinga iphrofayili lefakwe kuyo lesebentako; i-RGB idzinga iphrofayili ye-RGB.
printing.does_not_fit = Sitfombe nge-DPI yedokhumenti yaso asingangeni kulesitokisi. Sebentisa imodi yekulinganisa, igridi lencane noma liphepha lelikhulu.
printing.caption_limit = Inchazelo yindze kakhulu kulegridi. Sebentisa imigca noma emakholomu lambalwa, finyeta inchazelo noma ucishe tinchazelo.
printing.font_error = Kute ifonti letfolakalako yenchazelo. Faka ifonti yembhalo noma ucishe tinchazelo.
printing.no_document = Vula idokhumenti nobe ukhetse titfombe tegalari ngaphambi kwekutsi ushicilele.
printing.source_error = Sitfombe lesikhetsiwe, lifayela leliseceleni laso lelihletiwe, noma inchazelo akukwazekanga kufundvwa. Kute i-PDF legciniwe.
printing.save_error = Akukwazekanga kugcina i-PDF. Khetsa ligama lelifayela lelisha kufolda longabhala kuyo; emafayela lakhona akaze entiwe esikhundleni sawo.
printing.downloaded = I-PDF ilandziwe. Yivule esibukelini se-PDF kute uyiphrinte nga-100%.
printing.saved = I-PDF igcinwe: {path}
printing.letter = US Letter
