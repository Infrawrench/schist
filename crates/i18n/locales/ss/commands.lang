command.edit.undo.title = Hlehlisa
command.edit.undo.description = Buyela emuva ngesinyatselo sinye kuluhla lwemlandvo wekuhlehlisa wedokhumenti.
command.edit.redo.title = Phindza Wente
command.edit.redo.description = Phindza wente kuhlela lokugcine kuhoxiswa.
command.edit.copy.title = Kopisha
command.edit.copy.description = Kopisha emaphikseli lakhetsiwe eluhlaka lolusebentako uye ebhodini lekukopisha langekhatsi (luhlaka lonkhe nangabe kute lokukhetsiwe).
command.edit.copy_merged.title = Kopisha Lokuhlanganisiwe
command.edit.copy_merged.description = Kopisha lokukhetsiwe ngendlela tonkhe tinhlaka letibonakalako letikuhlanganisa ngayo, hhayi kusuka eluhlakeni lolusebentako kuphela.
command.edit.cut.title = Juba
command.edit.cut.description = Kopisha emaphikseli lakhetsiwe uye ebhodini lekukopisha bese uyawasusa eluhlakeni lolusebentako.
command.edit.paste.title = Namatsisela
command.edit.paste.description = Namatsisela lokusebhodini lekukopisha eluhlakeni lolusha ngetulu kwalolusebentako, kubekwe emkhatsini wekhanvasi.
command.edit.paste.layer_name = Luhlaka Lolunamatselisiwe
command.edit.paste_in_place.title = Namatsisela Endzaweni Yako
command.edit.paste_in_place.description = Namatsisela lokusebhodini lekukopisha eluhlakeni lolusha etixhumanisini lekwakukopishwe kuto.
command.edit.fill_foreground.title = Gcwalisa Ngembala Wangembili
command.edit.fill_foreground.description = Gcwalisa lokukhetsiwe (nobe ikhanvasi yonkhe nangabe kute lokukhetsiwe) ngembala wangembili.
command.edit.fill_background.title = Gcwalisa Ngembala Wangemuva
command.edit.fill_background.description = Gcwalisa lokukhetsiwe (nobe ikhanvasi yonkhe nangabe kute lokukhetsiwe) ngembala wangemuva.
command.select.all.title = Khetsa Konkhe
command.select.all.description = Khetsa yonkhe ikhanvasi.
command.select.deselect.title = Yekela Kukhetsa
command.select.deselect.description = Yekela lokukhetsiwe, kuze kuhlelwa kusebente kuluhlaka lonkhe futsi.
command.select.inverse.title = Khetsa Lokuphambene
command.select.inverse.description = Shintjanisa tindzawo letikhetsiwe naletingakakhetfwa.
command.select.reselect.title = Khetsa Kabusha
command.select.reselect.description = Buyisa lokukhetsiwe lokugcine kuyekelwa.
command.select.reselect.msg.nothing_to_reselect = Kute lokungakhetfwa kabusha
command.select.feather.title = Tsambisa Liphetfo Lalokukhetsiwe
command.select.feather.description = Tsambisa liphetfo lalokukhetsiwe ngekufiphala lokungemaphikseli lamabili, kuze kuhlelwa lokulandzelako kuphele kancane nakuwela.
command.select.grow.title = Khulisa
command.select.grow.description = Nweba lokukhetsiwe kuye kumaphikseli lakutsintsako lafana naloku lesekukhetsiwe, ngekhatsi kwemkhawulo wendvuku yemlingo.
command.select.similar.title = Lokufananako
command.select.similar.description = Khetsa onkhe emaphikseli eluhlakeni lafana nalokukhetsiwe, noma ayakutsintsa nobe cha, ngekhatsi kwemkhawulo wendvuku yemlingo.
command.select.save.title = Gcina Lokukhetsiwe
command.select.save.description = Gcina lokukhetsiwe kwamanje kudokhumenti njengelishaneli le-alpha lelineligama.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Layisha Lokukhetsiwe
command.select.load.description = Buyisa lokukhetsiwe lokugcine kugcinwa.
command.layer.new.title = Luhlaka Lolusha
command.layer.new.description = Engeta luhlaka lwe-raster lolungenalutfo ngetulu kwalolusebentako bese ulwenta lusebente.
command.layer.duplicate.title = Phindza Luhlaka
command.layer.duplicate.description = Kopisha luhlaka lolusebentako, kanye nako konkhe lokukulo, kuluhlaka lolusha lolungetulu kwalo.
command.layer.smart_object.title = Guculela Entfweni Lehlakaniphile
command.layer.smart_object.description = Songa emaphikseli eluhlaka lwe-raster lolusebentako entfweni lehlakaniphile, kuze kugucula netihlungi letitako tiphindze tithatse emasampula emtfombeni longakatsintfwa.
command.layer.rasterize.title = Yenta Luhlaka Lube Yi-raster
command.layer.rasterize.description = Gucula luhlaka lwesimo, lwembhalo nobe lwentfo lehlakaniphile lube ngemaphikseli lavamile kuphela.
command.layer.delete.title = Susa Luhlaka
command.layer.delete.description = Susa tinhlaka letikhetsiwe.
command.layer.group.title = Hlanganisa Tinhlaka Ngelicembu
command.layer.group.description = Faka tinhlaka letikhetsiwe elicembini lelisha khona lapho.
command.layer.raise.title = Sondeza Ngembili
command.layer.raise.description = Hambisa luhlaka lolusebentako lube yindzawo yinye kuya etulu esitakini selicembu lalo.
command.layer.lower.title = Buyisela Emuva
command.layer.lower.description = Hambisa luhlaka lolusebentako lube yindzawo yinye kuya phansi esitakini selicembu lalo.
command.layer.to_front.title = Letsa Embili
command.layer.to_front.description = Hambisa luhlaka lolusebentako luye etulu kakhulu kwelicembu lalo.
command.layer.to_back.title = Tfumela Emuva Kakhulu
command.layer.to_back.description = Hambisa luhlaka lolusebentako luye phansi kakhulu kwelicembu lalo.
command.layer.clipping_mask.title = Yakha/Yekela Sifihlo Sekusika
command.layer.clipping_mask.description = Sika luhlaka lolusebentako ngeluhlaka lolungephansi kwalo, nobe uluyekele nangabe selusikiwe; luhlaka lolusikiwe lubonakala kuphela lapho sisekelo salo sinemaphikseli khona.
command.layer.cut_to_new.title = Luhlaka Ngekujuba
command.layer.cut_to_new.description = Susa emaphikseli lakhetsiwe eluhlakeni lolusebentako uwafake eluhlakeni lolusha ngetulu kwalo.
command.layer.cut_to_new.layer_name = Luhlaka Ngekujuba
command.layer.add_mask.title = Engeta Sifihlo Seluhlaka
command.layer.add_mask.description = Engeta sifihlo seluhlaka eluhlakeni lolusebentako, lesikhombisa lokukhetsiwe kuphela nangabe kukhona.
command.layer.flatten.title = Yenta Umfanekiso Ube Sicaba
command.layer.flatten.description = Hlanganisa konkhe lokubonakalako kube luhlaka lunye Lwangemuva lolungabonakali ngale, ulahle tinhlaka letifihliwe.
command.layer.merge_down.title = Hlanganisela Phansi
command.layer.merge_down.description = Hlanganisa luhlaka lolusebentako eluhlakeni lolungephansi kwalo.
command.layer.merge_down.msg.no_layer_below = Kute luhlaka ngaphansi lokungahlanganiselwa kulo
command.layer.merge_visible.title = Hlanganisa Lokubonakalako
command.layer.merge_visible.description = Hlanganisa tonkhe tinhlaka letibonakalako tibe linye, ushiye letifihliwe tingakatsintfwa.
command.msg.nothing_to_copy = Khetsa luhlaka lwemaphikseli lotakopisha kulo
