tool.vanishing_point.name = Liphuzu Lekushabalala
tool.vanishing_point.description = Hudvula wakhe indzawo leyisicaba ngetulu kwentfo lenembono wekushona ekujuleni, bese ushintja imodi ibe nguKopisha upende: emaphikseli lakopishiwe alandzela lendzawo, abe mancane nakaya khashane.
