tool.liquify.name = Yenta Kube Lulwetsi
tool.liquify.description = Dvudvula, songeleta, nciphisa nobe khukhumalisa emaphikseli langephansi kwebhulashi lelikhulu — inkhetselo yemodi ikhetsa kutsi kwentiwe ngukuphi. Kugobeka kubutsana kunethi bese kusetjentiswa eluhlakeni nakwemukelwa.
