# Commandos principal de modification, selection e stratos.

command.edit.undo.title = Disfacer
command.edit.undo.description = Retorna un passo in le historia de actiones disfacibile del documento.
command.edit.redo.title = Refacer
command.edit.redo.description = Reface le modification disfacite le plus recentemente.
command.edit.copy.title = Copiar
command.edit.copy.description = Copia al area de transferentia interne le pixels seligite del strato active (le strato integre si nihil es seligite).
command.edit.copy_merged.title = Copiar fusionate
command.edit.copy_merged.description = Copia le selection como illo es componite per tote le stratos visibile, in vice de usar solmente le strato active.
command.edit.cut.title = Taliar
command.edit.cut.description = Copia le pixels seligite al area de transferentia e dele los del strato active.
command.edit.paste.title = Collar
command.edit.paste.description = Colla le area de transferentia in un nove strato super le strato active, centrate sur le tela.
command.edit.paste.layer_name = Strato collate
command.edit.paste_in_place.title = Collar in loco
command.edit.paste_in_place.description = Colla le area de transferentia in un nove strato al coordinatas de ubi illo esseva copiate.
command.edit.fill_foreground.title = Reimplir con prime plano
command.edit.fill_foreground.description = Reimple le selection (o tote le tela si nihil es seligite) con le color de prime plano.
command.edit.fill_background.title = Reimplir con fundo
command.edit.fill_background.description = Reimple le selection (o tote le tela si nihil es seligite) con le color de fundo.

command.select.all.title = Seliger toto
command.select.all.description = Selige le tela integre.
command.select.deselect.title = Desseliger
command.select.deselect.description = Abandona le selection, de sorta que le modificationes se applica de novo al strato integre.
command.select.inverse.title = Inverter selection
command.select.inverse.description = Excambia le areas seligite e non seligite.
command.select.reselect.title = Reseliger
command.select.reselect.description = Restabili le selection abandonate le plus recentemente.
command.select.reselect.msg.nothing_to_reselect = Nihil a reseliger
command.select.feather.title = Sfumar selection
command.select.feather.description = Suavifica le bordo del selection con un disfocalisation de duo pixels, de sorta que le proxime modification se dissolve trans illo.
command.select.grow.title = Crescer
command.select.grow.description = Extende le selection in pixels contigue similar a lo que jam es seligite, intra le tolerantia del virga magic.
command.select.similar.title = Simile
command.select.similar.description = Selige cata pixel del strato similar al selection, contigue o non, intra le tolerantia del virga magic.
command.select.save.title = Salvar selection
command.select.save.description = Immagazina le selection actual in le documento como un canal alpha nominate.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Cargar selection
command.select.load.description = Restabili le selection salvate le plus recentemente.

command.layer.new.title = Nove strato
command.layer.new.description = Adde un strato raster vacue super le strato active e rende lo active.
command.layer.duplicate.title = Duplicar strato
command.layer.duplicate.description = Copia le strato active con tote su contento in un nove strato super illo.
command.layer.smart_object.title = Converter a objecto intelligente
command.layer.smart_object.description = Include le pixels del strato raster active in un objecto intelligente, assi que le transformationes e filtros posterior reamostra le fonte intacte.
command.layer.rasterize.title = Rasterisar strato
command.layer.rasterize.description = Converte permanentemente un strato de forma, texto o objecto intelligente a pixels ordinari.
command.layer.delete.title = Deler strato
command.layer.delete.description = Dele le stratos seligite.
command.layer.group.title = Gruppar stratos
command.layer.group.description = Include le stratos seligite in un nove gruppo, in lor loco actual.
command.layer.raise.title = Portar avante
command.layer.raise.description = Move le strato active un position in alto in le pila de su gruppo.
command.layer.lower.title = Mandar retro
command.layer.lower.description = Move le strato active un position in basso in le pila de su gruppo.
command.layer.to_front.title = Portar al fronte
command.layer.to_front.description = Move le strato active al summitate de su gruppo.
command.layer.to_back.title = Mandar al fundo
command.layer.to_back.description = Move le strato active al fundo de su gruppo.
command.layer.clipping_mask.title = Crear/Liberar mascara de decoupage
command.layer.clipping_mask.description = Limita le strato active al strato sub illo, o libera lo si illo jam es limitate; un strato decoupate es visibile solmente ubi su base ha pixels.
command.layer.cut_to_new.title = Strato per taliatura
command.layer.cut_to_new.description = Move le pixels seligite foras del strato active a un nove strato super illo.
command.layer.cut_to_new.layer_name = Strato per taliatura
command.layer.add_mask.title = Adder mascara de strato
command.layer.add_mask.description = Adde un mascara al strato active, revelante solmente le selection si un existe.
command.layer.flatten.title = Applanar imagine
command.layer.flatten.description = Compone toto lo visibile in un singule strato Fundo opac, eliminante le stratos celate.
command.layer.merge_down.title = Fusionar verso basso
command.layer.merge_down.description = Compone le strato active in le strato sub illo.
command.layer.merge_down.msg.no_layer_below = Necun strato inferior in le qual fusionar
command.layer.merge_visible.title = Fusionar visibiles
command.layer.merge_visible.description = Compone tote le stratos visibile in un singule strato, lassante intacte le stratos celate.

command.msg.nothing_to_copy = Selige un strato de pixels del qual copiar
command.msg.clipboard_empty = Nihil in le area de transferentia

