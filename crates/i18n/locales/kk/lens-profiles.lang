# Lens profiles.
lens_profiles.invalid = Қолдау көрсетілетін камера немесе объектив деректері бар жарамды Lensfun v1/v2 XML дерекқорын (8 MiB дейін) таңдаңыз.
lens_profiles.calibration = Объективті калибрлеу
lens_profiles.no_calibration = Ешбір калибрлеу бұл параметрлерді қамтымайды. Фокустық қашықтықты және камераны кесу коэффициентін тексеріңіз; қолмен түзету қолжетімді болып қалады.
lens_profiles.import = Lensfun XML импорттау…
lens_profiles.imported = Lensfun дерекқоры осы сеанс үшін импортталды. Профильді таңдаңыз немесе фотосурет метадеректерімен сәйкестендіріңіз.
lens_profiles.manual = Тек қолмен түзету
lens_profiles.saved = Сақталған калибрлеу (деректер базасы қолжетімсіз)
lens_profiles.profile = Объектив профилі
lens_profiles.aperture = Диафрагма (0 = белгісіз)
lens_profiles.distance = Фокус қашықтығы (0 = белгісіз)
lens_profiles.vignette = Калибрленген виньеттеу
lens_profiles.color_context = Калибрленген виньеттеу үшін кірістірілген sRGB профилі қажет. Сыртқы түрін сақтау үшін sRGB түрлендіріңіз, содан кейін Объективті түзету сүзгісін қайта ашыңыз. Бұрыннан бар sRGB белгіленбеген пикселдер үшін sRGB тағайындау жеткілікті. Геометрия және хроматикалық түзету қолжетімді болып қалады.
lens_profiles.vignette_missing = Ешбір виньеттік калибрлеу апертура мен фокус қашықтығын қамтымайды. Оны қосу үшін өлшенген мәндерді енгізіңіз; 1000 м көптеген Lensfun профильдерінде қашықтағы фокусты білдіреді.
lens_profiles.note = Калибрленген түзету қолмен басқару элементтеріне дейін орындалады. Түпнұсқа толық кадрды пайдаланыңыз; содан кейін қиып алыңыз. Өңделетін калибрлеуді сақтау үшін сүзгі дестесін PSD/PSB ішінде сақтаңыз.
lens_profiles.automatic = Фотосурет метадеректерін сәйкестендіріңіз
lens_profiles.components = Профильді өту: бұрмалау {distortion}; түсті жиектер {tca}; виньетка {vignette}.
