command.edit.undo.title = Болдырмау
command.edit.undo.description = Құжаттың болдырмау тарихында бір қадам артқа қайту.
command.edit.redo.title = Қайталау
command.edit.redo.description = Соңғы болдырылмаған өңдеуді қайталау.
command.edit.copy.title = Көшіру
command.edit.copy.description = Белсенді қабаттың таңдалған пиксельдерін ішкі алмасу буферіне көшіру (ештеңе таңдалмаса, бүкіл қабатты).
command.edit.copy_merged.title = Біріктіріп көшіру
command.edit.copy_merged.description = Таңдауды тек белсенді қабаттан емес, барлық көрінетін қабаттардың біріктірілген көрінісі ретінде көшіру.
command.edit.cut.title = Қиып алу
command.edit.cut.description = Таңдалған пиксельдерді алмасу буферіне көшіріп, белсенді қабаттан өшіру.
command.edit.paste.title = Қою
command.edit.paste.description = Алмасу буферін белсенді қабаттың үстіндегі жаңа қабатқа, кенептің ортасына қою.
command.edit.paste.layer_name = Қойылған қабат
command.edit.paste_in_place.title = Орнына қою
command.edit.paste_in_place.description = Алмасу буферін көшірілген координаттарындағы жаңа қабатқа қою.
command.edit.fill_foreground.title = Алдыңғы түспен толтыру
command.edit.fill_foreground.description = Таңдауды (ештеңе таңдалмаса, бүкіл кенепті) алдыңғы түспен толтыру.
command.edit.fill_background.title = Артқы фонмен толтыру
command.edit.fill_background.description = Таңдауды (ештеңе таңдалмаса, бүкіл кенепті) артқы фон түсімен толтыру.

command.select.all.title = Барлығын таңдау
command.select.all.description = Бүкіл кенепті таңдау.
command.select.deselect.title = Таңдауды алып тастау
command.select.deselect.description = Кейінгі өңдеулер қайтадан бүкіл қабатқа қолданылуы үшін таңдауды алып тастау.
command.select.inverse.title = Таңдауды терістеу
command.select.inverse.description = Таңдалған және таңдалмаған аймақтарды алмастыру.
command.select.reselect.title = Қайта таңдау
command.select.reselect.description = Соңғы алып тасталған таңдауды қайтару.
command.select.reselect.msg.nothing_to_reselect = Қайта таңдайтын ештеңе жоқ
command.select.feather.title = Таңдауды жұмсарту
command.select.feather.description = Келесі өңдеу жиек бойымен біртіндеп өшуі үшін таңдау жиегін екі пиксельдік бұлыңғырлаумен жұмсарту.
command.select.grow.title = Үлкейту
command.select.grow.description = Сиқырлы таяқшаның төзімділік шегінде таңдауды таңдалған аймаққа ұқсайтын жанасқан пиксельдерге дейін кеңейту.
command.select.similar.title = Ұқсас
command.select.similar.description = Сиқырлы таяқшаның төзімділік шегінде қабаттағы таңдауға ұқсайтын барлық пиксельдерді, жанасса да, жанаспаса да, таңдау.
command.select.save.title = Таңдауды сақтау
command.select.save.description = Ағымдағы таңдауды құжатта атаулы альфа арнасы ретінде сақтау.
command.select.save.channel_name = Альфа {n}
command.select.load.title = Таңдауды жүктеу
command.select.load.description = Ең соңғы сақталған таңдауды қалпына келтіру.

command.layer.new.title = Жаңа қабат
command.layer.new.description = Белсенді қабаттың үстіне бос растрлық қабат қосып, оны белсенді ету.
command.layer.duplicate.title = Қабат көшірмесін жасау
command.layer.duplicate.description = Белсенді қабатты бүкіл мазмұнымен бірге үстіндегі жаңа қабатқа көшіру.
command.layer.smart_object.title = Смарт нысанға түрлендіру
command.layer.smart_object.description = Кейінгі түрлендірулер мен сүзгілер өзгермеген бастапқы деректерді қайта үлгілеуі үшін белсенді растрлық қабаттың пиксельдерін смарт нысанға орау.
command.layer.rasterize.title = Қабатты растрлау
command.layer.rasterize.description = Пішін, мәтін немесе смарт нысан қабатын кәдімгі пиксельдерге айналдыру.
command.layer.delete.title = Қабатты жою
command.layer.delete.description = Таңдалған қабаттарды жою.
command.layer.group.title = Қабаттарды топтау
command.layer.group.description = Таңдалған қабаттарды орнын өзгертпей жаңа топқа біріктіру.
command.layer.raise.title = Алға жылжыту
command.layer.raise.description = Белсенді қабатты өз тобының жинағында бір орын жоғары жылжыту.
command.layer.lower.title = Артқа жылжыту
command.layer.lower.description = Белсенді қабатты өз тобының жинағында бір орын төмен жылжыту.
command.layer.to_front.title = Ең алдына шығару
command.layer.to_front.description = Белсенді қабатты өз тобының ең үстіне жылжыту.
command.layer.to_back.title = Ең артына жіберу
command.layer.to_back.description = Белсенді қабатты өз тобының ең астына жылжыту.
command.layer.clipping_mask.title = Қию маскасын жасау/босату
command.layer.clipping_mask.description = Белсенді қабатты астындағы қабатқа қию немесе бұрын қиылған болса босату; қиылған қабат тек негізінде пиксель бар жерлерде көрінеді.
command.layer.cut_to_new.title = Қиып алынған қабат
command.layer.cut_to_new.description = Таңдалған пиксельдерді белсенді қабаттан алып, оның үстіндегі жаңа қабатқа жылжыту.
command.layer.cut_to_new.layer_name = Қиып алынған қабат
command.layer.add_mask.title = Қабат маскасын қосу
command.layer.add_mask.description = Белсенді қабатқа қабат маскасын қосу; таңдау бар болса, тек сол аймақ көрінеді.
command.layer.flatten.title = Кескінді біріктіру
command.layer.flatten.description = Көрінетіннің бәрін бір мөлдір емес «Фон» қабатына біріктіріп, жасырын қабаттарды алып тастау.
command.layer.merge_down.title = Төменгі қабатпен біріктіру
command.layer.merge_down.description = Белсенді қабатты астындағы қабатпен біріктіру.
command.layer.merge_down.msg.no_layer_below = Біріктіретін төменгі қабат жоқ
command.layer.merge_visible.title = Көрінетін қабаттарды біріктіру
command.layer.merge_visible.description = Барлық көрінетін қабаттарды бір қабатқа біріктіріп, жасырын қабаттарды өзгеріссіз қалдыру.

command.msg.nothing_to_copy = Көшіру үшін пиксельдік қабатты таңдаңыз
command.msg.clipboard_empty = Алмасу буфері бос

