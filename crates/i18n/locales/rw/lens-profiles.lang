# Lens profile controls.
lens_profiles.invalid = Hitamo ububiko bw’amakuru bwa Lensfun v1/v2 XML bwemewe (butarengeje 8 MiB), burimo amakuru ya kamera cyangwa lenzi ashyigikiwe.
lens_profiles.calibration = Guhuza lenzi n’ibipimo
lens_profiles.no_calibration = Nta bipimo byo guhuza lenzi bijyanye n’iyi miterere. Reba uburebure bwa fokali n’igipimo cyo gukata cya kamera; ushobora no gukosora n’intoki.
lens_profiles.import = Kuzana Lensfun XML…
lens_profiles.imported = Ububiko bw’amakuru bwa Lensfun bwinjijwe muri iki gihe cyo gukoresha. Hitamo umwirondoro wa lenzi cyangwa uhuze n’amakuru y’ifoto.
lens_profiles.manual = Gukosora n’intoki gusa
lens_profiles.saved = Ibipimo byabitswe (ububiko bw’amakuru ntibuboneka)
lens_profiles.profile = Umwirondoro wa lenzi
lens_profiles.aperture = Ubugari bw’umwenge wa lenzi (0 = ntibuzwi)
lens_profiles.distance = Intera yo gukarishya ishusho (0 = ntizwi)
lens_profiles.vignette = Umwijima wo ku nkengero wahujwe n’ibipimo
lens_profiles.color_context = Umwijima wo ku nkengero wahujwe n’ibipimo ukenera umwirondoro wa sRGB urimo muri porogaramu. Hindurira muri sRGB kugira ngo ishusho igumane uko igaragara, hanyuma wongere ufungure Gukosora lenzi. Niba pigiseli zisanzwe ari iza sRGB ariko zitagaragajwe nk’izo, kuziha umwirondoro wa sRGB birahagije. Gukosora imiterere n’amabara biracyashoboka.
lens_profiles.vignette_missing = Nta bipimo by’umwijima wo ku nkengero bihuye n’ubugari bw’umwenge wa lenzi n’intera yo gukarishya. Injiza agaciro wapimye kugira ngo bikore; muri myinshi mu myirondoro ya Lensfun, 1000 m yerekana gukarishya kure.
lens_profiles.note = Gukosora hakurikijwe ibipimo bikorwa mbere y’igenamiterere rikorwa n’intoki. Koresha ifoto y’umwimerere yose; uyikate nyuma. Bika uruhererekane rw’utuyunguruzo muri PSD/PSB kugira ngo ibipimo bikomeze gushobora guhindurwa.
lens_profiles.automatic = Guhuza n’amakuru y’ifoto
lens_profiles.components = Gukosora hakurikijwe umwirondoro: kugoreka {distortion}; inkombe z’amabara {tca}; umwijima wo ku nkengero {vignette}.
