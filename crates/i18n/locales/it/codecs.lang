# Messaggi di importazione condivisi
codec.msg.decoding = decodifica di {name}
codec.msg.zero_sized = l'immagine non contiene pixel
codec.msg.assembling_document = composizione del documento

# File raw della fotocamera
codec.raw.msg.decoding = decodifica del file raw
codec.raw.msg.developing = sviluppo del file raw
codec.raw.msg.finding_preview = ricerca dell'anteprima incorporata
codec.raw.msg.decoding_preview = decodifica dell'anteprima incorporata
