# Affinity
codec.affinity.import_title = Importazione Affinity
codec.affinity.flattened_preview_layer = Anteprima a livelli uniti
codec.affinity.msg.no_preview = Nessuna anteprima incorporata utilizzabile. Il formato a livelli di Affinity è proprietario; Schist importa l'anteprima a livelli uniti contenuta nel file. Questo file non ne contiene una: salvalo di nuovo in Affinity oppure esportalo come PSD per importare tutti i livelli.

# HEIF
codec.heif.msg.no_library = libheif non è disponibile ({details}). Per aprire file HEIC è necessaria la libreria libheif (Linux: installa libheif1; macOS: brew install libheif).
codec.heif.msg.no_decoder = {what}: {message} — questa versione di libheif potrebbe non includere un decoder HEVC (su Debian/Ubuntu, installa libheif-plugin-libde265)
codec.heif.msg.unknown_error = errore sconosciuto
codec.heif.msg.initialising = inizializzazione di libheif
codec.heif.msg.reading_container = lettura del contenitore HEIF
