# Modifica
command.edit.undo.title = Annulla
command.edit.undo.description = Torna indietro di una voce nella cronologia di annullamento del documento.
command.edit.redo.title = Ripristina
command.edit.redo.description = Ripristina l'ultima modifica annullata.
command.edit.copy.title = Copia
command.edit.copy.description = Copia negli Appunti interni i pixel selezionati del livello attivo, oppure l'intero livello se non è presente una selezione.
command.edit.copy_merged.title = Copia elementi uniti
command.edit.copy_merged.description = Copia la selezione così come risulta dalla composizione di tutti i livelli visibili, anziché dal solo livello attivo.
command.edit.cut.title = Taglia
command.edit.cut.description = Copia negli Appunti i pixel selezionati e li cancella dal livello attivo.
command.edit.paste.title = Incolla
command.edit.paste.description = Incolla gli Appunti in un nuovo livello sopra quello attivo, centrandoli sul quadro.
command.edit.paste.layer_name = Livello incollato
command.edit.paste_in_place.title = Incolla nella stessa posizione
command.edit.paste_in_place.description = Incolla gli Appunti in un nuovo livello alle coordinate da cui erano stati copiati.
command.edit.fill_foreground.title = Riempi con colore di primo piano
command.edit.fill_foreground.description = Riempie la selezione, oppure l'intero quadro se non è presente una selezione, con il colore di primo piano.
command.edit.fill_background.title = Riempi con colore di sfondo
command.edit.fill_background.description = Riempie la selezione, oppure l'intero quadro se non è presente una selezione, con il colore di sfondo.

# Selezione
command.select.all.title = Seleziona tutto
command.select.all.description = Seleziona l'intero quadro.
command.select.deselect.title = Deseleziona
command.select.deselect.description = Elimina la selezione, affinché le modifiche vengano applicate di nuovo all'intero livello.
command.select.inverse.title = Inversa
command.select.inverse.description = Scambia le aree selezionate con quelle non selezionate.
command.select.reselect.title = Riseleziona
command.select.reselect.description = Ripristina l'ultima selezione eliminata.
command.select.reselect.msg.nothing_to_reselect = Nulla da riselezionare
command.select.feather.title = Sfuma selezione
command.select.feather.description = Ammorbidisce il bordo della selezione con una sfocatura di due pixel, affinché la modifica successiva sfumi gradualmente lungo il bordo.
command.select.grow.title = Espandi
command.select.grow.description = Estende la selezione ai pixel contigui simili a quelli già selezionati, entro la tolleranza della bacchetta magica.
command.select.similar.title = Simile
command.select.similar.description = Seleziona tutti i pixel del livello simili alla selezione, contigui o meno, entro la tolleranza della bacchetta magica.
command.select.save.title = Salva selezione
command.select.save.description = Memorizza la selezione corrente nel documento come canale alfa con nome.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Carica selezione
command.select.load.description = Ripristina l'ultima selezione salvata.

# Livello
command.layer.new.title = Nuovo livello
command.layer.new.description = Aggiunge un livello raster vuoto sopra quello attivo e lo rende attivo.
command.layer.duplicate.title = Duplica livello
command.layer.duplicate.description = Copia integralmente il livello attivo in un nuovo livello sopra di esso.
command.layer.smart_object.title = Converti in oggetto avanzato
command.layer.smart_object.description = Racchiude i pixel del livello raster attivo in un oggetto avanzato, affinché trasformazioni e filtri successivi ricampionino la sorgente originale.
command.layer.rasterize.title = Rasterizza livello
command.layer.rasterize.description = Converte un livello forma, testo o oggetto avanzato in normali pixel.
command.layer.delete.title = Elimina livello
command.layer.delete.description = Elimina i livelli selezionati.
command.layer.group.title = Raggruppa livelli
command.layer.group.description = Racchiude sul posto i livelli selezionati in un nuovo gruppo.
command.layer.raise.title = Porta avanti
command.layer.raise.description = Sposta il livello attivo di una posizione verso l'alto nella pila del gruppo.
command.layer.lower.title = Porta indietro
command.layer.lower.description = Sposta il livello attivo di una posizione verso il basso nella pila del gruppo.
command.layer.to_front.title = Porta in primo piano
command.layer.to_front.description = Sposta il livello attivo in cima al gruppo.
command.layer.to_back.title = Porta sotto
command.layer.to_back.description = Sposta il livello attivo in fondo al gruppo.
command.layer.clipping_mask.title = Crea/Rilascia maschera di ritaglio
command.layer.clipping_mask.description = Ritaglia il livello attivo in base a quello sottostante, oppure lo libera se è già ritagliato; un livello ritagliato appare solo dove il livello di base contiene pixel.
command.layer.cut_to_new.title = Crea livello tagliato
command.layer.cut_to_new.description = Sposta i pixel selezionati dal livello attivo in un nuovo livello sopra di esso.
command.layer.cut_to_new.layer_name = Livello tagliato
command.layer.add_mask.title = Aggiungi maschera di livello
command.layer.add_mask.description = Aggiunge una maschera al livello attivo, mostrando solo la selezione quando presente.
command.layer.flatten.title = Unico livello
command.layer.flatten.description = Compone tutti gli elementi visibili in un unico livello Sfondo opaco, eliminando i livelli nascosti.
command.layer.merge_down.title = Unisci sotto
command.layer.merge_down.description = Compone il livello attivo nel livello sottostante.
command.layer.merge_down.msg.no_layer_below = Nessun livello sottostante da unire
command.layer.merge_visible.title = Unisci livelli visibili
command.layer.merge_visible.description = Compone tutti i livelli visibili in uno solo, lasciando invariati quelli nascosti.

command.msg.nothing_to_copy = Seleziona un livello pixel da cui copiare
command.msg.clipboard_empty = Gli Appunti sono vuoti

