tool.eyedropper.choice.average_5 = Media 5 × 5
tool.eyedropper.choice.average_11 = Media 11 × 11
tool.eyedropper.choice.average_31 = Media 31 × 31
tool.eyedropper.choice.all_layers = Tutti i livelli
tool.eyedropper.choice.current_layer = Livello corrente

# Mano e Zoom
tool.hand.name = Mano
tool.hand.description = Sposta la visualizzazione. La finestra di visualizzazione appartiene alla finestra dell'applicazione, pertanto in modalità headless questo strumento non modifica il documento.
tool.zoom.name = Zoom
tool.zoom.description = Ingrandisce o riduce la visualizzazione. La finestra di visualizzazione appartiene alla finestra dell'applicazione, pertanto in modalità headless questo strumento non modifica il documento.
