# Strumenti di base: Sposta, Contagocce, Mano e Zoom.

# Sposta
tool.move.name = Sposta
tool.move.description = Trascina il contenuto del livello attivo in una nuova posizione. Se Selezione automatica è attiva, alla pressione viene selezionato il livello, o l'intero gruppo, che si trova per primo sotto il puntatore.
tool.move.option.auto_select = Selezione automatica
