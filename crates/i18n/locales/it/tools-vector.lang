# Penne
tool.pen.name = Penna
tool.pen.description = Crea un tracciato: fai clic per inserire un punto d'angolo, trascina per estrarne le maniglie della curva e fai clic sul primo punto per chiudere. Confermando, il tracciato diventa un livello forma.
tool.pen.option.rubber_band = Banda elastica
