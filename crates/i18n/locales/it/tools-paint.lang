tool.bucket.name = Secchiello
tool.bucket.description = Fai clic per riempire con il colore di primo piano l'area contigua di colore simile sotto il puntatore, entro la tolleranza dello strumento.
tool.bucket.option.contiguous = Contiguo
tool.bucket.option.all_layers = Tutti i livelli
tool.bucket.history.fill = Secchiello

tool.brush.symmetry = Simmetria
tool.brush.seamless_preview = Anteprima motivo senza giunture
