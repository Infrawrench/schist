command.edit.undo.title = Бекор кардан
command.edit.undo.description = Дар таърихи бекоркунии ҳуҷҷат як қадам ба қафо баргардед.
command.edit.redo.title = Аз нав иҷро кардан
command.edit.redo.description = Таҳриреро, ки охирин бор бекор шуда буд, аз нав иҷро кунед.
command.edit.copy.title = Нусхабардорӣ
command.edit.copy.description = Пикселҳои интихобшудаи қабати фаъолро ба ҳофизаи муваққатии дохилӣ нусхабардорӣ кунед (агар чизе интихоб нашуда бошад, тамоми қабатро).
command.edit.copy_merged.title = Нусхабардории муттаҳидшуда
command.edit.copy_merged.description = Интихобро тавре нусхабардорӣ кунед, ки ҳамаи қабатҳои намоён онро таркиб медиҳанд, на танҳо аз қабати фаъол.
command.edit.cut.title = Буридан
command.edit.cut.description = Пикселҳои интихобшударо ба ҳофизаи муваққатӣ нусхабардорӣ карда, аз қабати фаъол пок кунед.
command.edit.paste.title = Гузоштан
command.edit.paste.description = Муҳтавои ҳофизаи муваққатиро дар қабати наве болои қабати фаъол, дар маркази рони тасвир гузоред.
command.edit.paste.layer_name = Қабати гузошташуда
command.edit.paste_in_place.title = Дар ҷояш гузоштан
command.edit.paste_in_place.description = Муҳтавои ҳофизаи муваққатиро дар қабати наве дар ҳамон координатаҳое гузоред, ки аз онҳо нусхабардорӣ шуда буд.
command.edit.fill_foreground.title = Пур кардан бо ранги пешзамина
command.edit.fill_foreground.description = Интихобро (ё агар чизе интихоб нашуда бошад, тамоми рони тасвирро) бо ранги пешзамина пур кунед.
command.edit.fill_background.title = Пур кардан бо ранги пасзамина
command.edit.fill_background.description = Интихобро (ё агар чизе интихоб нашуда бошад, тамоми рони тасвирро) бо ранги пасзамина пур кунед.

command.select.all.title = Интихоби ҳама
command.select.all.description = Тамоми рони тасвирро интихоб кунед.
command.select.deselect.title = Бекор кардани интихоб
command.select.deselect.description = Интихобро бардоред, то таҳрирҳо боз ба тамоми қабат татбиқ шаванд.
command.select.inverse.title = Баръакс кардани интихоб
command.select.inverse.description = Ҷойҳои интихобшуда ва интихобнашударо бо ҳам иваз кунед.
command.select.reselect.title = Интихоби дубора
command.select.reselect.description = Интихоберо, ки охирин бор бардошта шуда буд, барқарор кунед.
command.select.reselect.msg.nothing_to_reselect = Барои интихоби дубора чизе нест
command.select.feather.title = Нарм кардани канори интихоб
command.select.feather.description = Канори интихобро бо хиракунии дупикселӣ нарм кунед, то таҳрири навбатӣ дар он тадриҷан камранг шавад.
command.select.grow.title = Густариш
command.select.grow.description = Интихобро дар ҳудуди таҳаммулпазирии асои сеҳрнок ба пикселҳои ҳамсояе густариш диҳед, ки ба пикселҳои аллакай интихобшуда монанданд.
command.select.similar.title = Монанд
command.select.similar.description = Ҳамаи пикселҳои қабатро, ки дар ҳудуди таҳаммулпазирии асои сеҳрнок ба интихоб монанданд, хоҳ ҳамсоя бошанд хоҳ не, интихоб кунед.
command.select.save.title = Захира кардани интихоб
command.select.save.description = Интихоби ҷориро дар ҳуҷҷат ҳамчун канали алфаи номдор нигоҳ доред.
command.select.save.channel_name = Алфа {n}
command.select.load.title = Бор кардани интихоб
command.select.load.description = Интихоби охирин захирашударо барқарор кунед.

command.layer.new.title = Қабати нав
command.layer.new.description = Болои қабати фаъол қабати холии растрӣ илова карда, онро фаъол кунед.
command.layer.duplicate.title = Такрор кардани қабат
command.layer.duplicate.description = Қабати фаъолро бо тамоми муҳтавояш ба қабати наве болои он нусхабардорӣ кунед.
command.layer.smart_object.title = Табдил ба объекти ҳушманд
command.layer.smart_object.description = Пикселҳои қабати растрии фаъолро дар объекти ҳушманд ҷой диҳед, то табдилҳо ва филтрҳои баъдӣ манбаи дастнорасидаро аз нав намунагирӣ кунанд.
command.layer.rasterize.title = Растрӣ кардани қабат
command.layer.rasterize.description = Қабати шакл, матн ё объекти ҳушмандро ба пикселҳои одӣ табдил диҳед.
command.layer.delete.title = Нест кардани қабат
command.layer.delete.description = Қабатҳои интихобшударо нест кунед.
command.layer.group.title = Гурӯҳбандии қабатҳо
command.layer.group.description = Қабатҳои интихобшударо дар ҳамон ҷой ба гурӯҳи нав ҷой диҳед.
command.layer.raise.title = Як зина ба пеш
command.layer.raise.description = Қабати фаъолро дар тартиби гурӯҳаш як ҷой боло баред.
command.layer.lower.title = Як зина ба қафо
command.layer.lower.description = Қабати фаъолро дар тартиби гурӯҳаш як ҷой поён баред.
command.layer.to_front.title = Ба пеши ҳама
command.layer.to_front.description = Қабати фаъолро ба болои гурӯҳаш кӯчонед.
command.layer.to_back.title = Ба паси ҳама
command.layer.to_back.description = Қабати фаъолро ба поёни гурӯҳаш кӯчонед.
command.layer.clipping_mask.title = Сохтан/озод кардани ниқоби буриш
command.layer.clipping_mask.description = Қабати фаъолро ба қабати зери он маҳдуд кунед ё, агар аллакай маҳдуд бошад, озод намоед; қабати маҳдуд танҳо дар ҷойҳое дида мешавад, ки қабати асосӣ пиксел дорад.
command.layer.cut_to_new.title = Қабат тавассути буридан
command.layer.cut_to_new.description = Пикселҳои интихобшударо аз қабати фаъол ба қабати наве болои он кӯчонед.
command.layer.cut_to_new.layer_name = Қабат тавассути буридан
command.layer.add_mask.title = Илова кардани ниқоби қабат
command.layer.add_mask.description = Ба қабати фаъол ниқоби қабат илова кунед; агар интихоб мавҷуд бошад, ниқоб танҳо онро намоён мекунад.
command.layer.flatten.title = Ҳамвор кардани тасвир
command.layer.flatten.description = Ҳамаи чизҳои намоёнро дар як қабати ношаффофи «Пасзамина» таркиб дода, қабатҳои пинҳонро дур кунед.
command.layer.merge_down.title = Муттаҳид кардан ба поён
command.layer.merge_down.description = Қабати фаъолро бо қабати зери он таркиб диҳед.
command.layer.merge_down.msg.no_layer_below = Дар поён қабате барои муттаҳид кардан нест
command.layer.merge_visible.title = Муттаҳид кардани намоёнҳо
command.layer.merge_visible.description = Ҳамаи қабатҳои намоёнро дар як қабат таркиб диҳед ва ба қабатҳои пинҳон даст нарасонед.

command.msg.nothing_to_copy = Барои нусхабардорӣ қабати пикселиро интихоб кунед
command.msg.clipboard_empty = Дар ҳофизаи муваққатӣ чизе нест

