# Arahan Edit, Pilih dan Lapisan
command.edit.undo.title = Buat Asal
command.edit.undo.description = Undur satu entri dalam sejarah buat asal dokumen.
command.edit.redo.title = Buat Semula
command.edit.redo.description = Buat semula suntingan yang kali terakhir dibuat asal.
command.edit.copy.title = Salin
command.edit.copy.description = Salin piksel terpilih pada lapisan aktif ke papan keratan dalaman (seluruh lapisan jika tiada pilihan).
command.edit.copy_merged.title = Salin Tergabung
command.edit.copy_merged.description = Salin pilihan seperti yang dikompositkan oleh semua lapisan kelihatan, bukan daripada lapisan aktif sahaja.
command.edit.cut.title = Potong
command.edit.cut.description = Salin piksel terpilih ke papan keratan dan padamkannya daripada lapisan aktif.
command.edit.paste.title = Tampal
command.edit.paste.description = Tampal kandungan papan keratan ke lapisan baharu di atas lapisan aktif, berpusat pada kanvas.
command.edit.paste.layer_name = Lapisan Ditampal
command.edit.paste_in_place.title = Tampal di Tempat Asal
command.edit.paste_in_place.description = Tampal kandungan papan keratan ke lapisan baharu pada koordinat asalnya disalin.
command.edit.fill_foreground.title = Isi dengan Latar Depan
command.edit.fill_foreground.description = Isi pilihan (atau seluruh kanvas jika tiada pilihan) dengan warna latar depan.
command.edit.fill_background.title = Isi dengan Latar Belakang
command.edit.fill_background.description = Isi pilihan (atau seluruh kanvas jika tiada pilihan) dengan warna latar belakang.
command.select.all.title = Pilih Semua
command.select.all.description = Pilih seluruh kanvas.
command.select.deselect.title = Nyahpilih
command.select.deselect.description = Gugurkan pilihan supaya suntingan digunakan pada seluruh lapisan semula.
command.select.inverse.title = Songsangkan Pilihan
command.select.inverse.description = Tukar ganti kawasan terpilih dengan kawasan tidak terpilih.
command.select.reselect.title = Pilih Semula
command.select.reselect.description = Kembalikan pilihan yang kali terakhir digugurkan.
command.select.reselect.msg.nothing_to_reselect = Tiada apa-apa untuk dipilih semula
command.select.feather.title = Kaburkan Tepi Pilihan
command.select.feather.description = Lembutkan tepi pilihan dengan kabur dua piksel supaya suntingan seterusnya beransur hilang merentasinya.
command.select.grow.title = Besarkan
command.select.grow.description = Luaskan pilihan ke piksel bersentuhan yang menyerupai piksel yang sudah dipilih, dalam toleransi tongkat sakti.
command.select.similar.title = Serupa
command.select.similar.description = Pilih setiap piksel dalam lapisan yang menyerupai pilihan, sama ada bersentuhan atau tidak, dalam toleransi tongkat sakti.
command.select.save.title = Simpan Pilihan
command.select.save.description = Simpan pilihan semasa dalam dokumen sebagai saluran alfa bernama.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Muatkan Pilihan
command.select.load.description = Pulihkan pilihan yang paling baru disimpan.
command.layer.new.title = Lapisan Baharu
command.layer.new.description = Tambah lapisan raster kosong di atas lapisan aktif dan aktifkannya.
command.layer.duplicate.title = Gandakan Lapisan
command.layer.duplicate.description = Salin lapisan aktif berserta seluruh kandungannya ke lapisan baharu di atasnya.
command.layer.smart_object.title = Tukar kepada Objek Pintar
command.layer.smart_object.description = Balut piksel lapisan raster aktif dalam objek pintar supaya transformasi dan penapis kemudian mensampel semula sumber yang tidak disentuh.
command.layer.rasterize.title = Rasterkan Lapisan
command.layer.rasterize.description = Ratakan lapisan bentuk, teks atau objek pintar menjadi piksel biasa.
command.layer.delete.title = Padam Lapisan
command.layer.delete.description = Padam lapisan terpilih.
command.layer.group.title = Kumpulkan Lapisan
command.layer.group.description = Balut lapisan terpilih dalam kumpulan baharu di kedudukan yang sama.
command.layer.raise.title = Bawa ke Hadapan
command.layer.raise.description = Alihkan lapisan aktif satu kedudukan ke atas dalam tindanan kumpulannya.
command.layer.lower.title = Hantar ke Belakang
command.layer.lower.description = Alihkan lapisan aktif satu kedudukan ke bawah dalam tindanan kumpulannya.
command.layer.to_front.title = Bawa ke Paling Hadapan
command.layer.to_front.description = Alihkan lapisan aktif ke bahagian atas kumpulannya.
command.layer.to_back.title = Hantar ke Paling Belakang
command.layer.to_back.description = Alihkan lapisan aktif ke bahagian bawah kumpulannya.
command.layer.clipping_mask.title = Cipta/Lepaskan Topeng Keratan
command.layer.clipping_mask.description = Kerat lapisan aktif mengikut lapisan di bawahnya atau lepaskannya jika sudah dikerat; lapisan terkerat hanya kelihatan di tempat lapisan asasnya mempunyai piksel.
command.layer.cut_to_new.title = Lapisan melalui Potongan
command.layer.cut_to_new.description = Alihkan piksel terpilih keluar daripada lapisan aktif ke lapisan baharu di atasnya.
command.layer.cut_to_new.layer_name = Lapisan melalui Potongan
command.layer.add_mask.title = Tambah Topeng Lapisan
command.layer.add_mask.description = Tambah topeng lapisan pada lapisan aktif, yang hanya mendedahkan pilihan jika ada.
command.layer.flatten.title = Ratakan Imej
command.layer.flatten.description = Kompositkan semua yang kelihatan menjadi satu lapisan Latar Belakang legap dan buang lapisan tersembunyi.
command.layer.merge_down.title = Gabung ke Bawah
command.layer.merge_down.description = Kompositkan lapisan aktif ke dalam lapisan di bawahnya.
command.layer.merge_down.msg.no_layer_below = Tiada lapisan di bawah untuk digabungkan
command.layer.merge_visible.title = Gabung yang Kelihatan
command.layer.merge_visible.description = Kompositkan setiap lapisan kelihatan menjadi satu tanpa mengubah lapisan tersembunyi.
command.msg.nothing_to_copy = Pilih lapisan piksel untuk disalin
command.msg.clipboard_empty = Tiada apa-apa pada papan keratan
