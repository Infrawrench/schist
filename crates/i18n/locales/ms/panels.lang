# The chrome around the canvas (crates/app/src/panels): the side
# panels, the toolbar and its options bar, the status bar, the title
# bar, the document tabs and the right-click menus; and the file
# dialogs in crates/app/src/keymap.rs. Panel names follow Photoshop's
# own localisations. Titles that another area already has — Layers,
# Color, Notes, Opacity, Size — are reused from common.lang and
# menu.lang rather than repeated here.

# The modifier keys as a menu's shortcut hint spells them
panel.keys.cmd = Cmd
panel.keys.ctrl = Ctrl
panel.keys.shift = Shift
panel.keys.alt = Alt

# Status bar: the document's title and size, with a dot when unsaved
