# Treuzfurmiñ dieub, treuzfurmiñ an diuzadenn ha krennañ.
tool.transform.name = Treuzfurmiñ dieub
tool.transform.description = Treuzfurmiñ dieub. Pa vez gweredekaet e tiger ur voest dreuzfurmiñ tro-dro d'ar gwiskad oberiant: riklit ur c'horn evit cheñch ar skeul, riklit en diavaez d'ur c'horn evit treiñ, riklit ur riblenn evit stummañ a-veskell. Netra ne vez skrivet betek kadarnaat (Enter), ha pa zilezer (Escape) e vez adlakaet ar gwiskad evel ma oa.
tool.transform.option.interpolation = Etrepoladur
