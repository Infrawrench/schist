# Binvioù distummañ: Liquify, Distummañ margodenn ha Poent tec'h.
tool.liquify.name = Lakaat da zour
tool.liquify.description = Bountañ, treiñ en ur wirenn, strishaat pe c'hwezañ ar pikselioù dindan ur broust bras — an dibarzh mod a zibab petra ober. An distummadur a emsamm en ur rouedad hag a vez arloet ouzh ar gwiskad pa gadarnait.
