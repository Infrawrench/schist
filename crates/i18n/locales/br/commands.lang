command.edit.undo.title = Dizober
command.edit.undo.description = Distreiñ ur bazenn en istor dizober an teul.
command.edit.redo.title = Adober
command.edit.redo.description = Adober ar c'hemm diwezhañ bet dizgraet.
command.edit.copy.title = Eilañ
command.edit.copy.description = Eilañ pikselioù diuzet ar gwiskad oberiant er golver diabarzh (ar gwiskad a-bezh pa n'eus diuzadenn ebet).
command.edit.copy_merged.title = Eilañ an hini kendeuzet
command.edit.copy_merged.description = Eilañ an diuzadenn evel ma vez kenaozet gant an holl wiskadoù hewel, e-lec'h diwar ar gwiskad oberiant hepken.
command.edit.cut.title = Troc'hañ
command.edit.cut.description = Eilañ ar pikselioù diuzet er golver ha diverkañ anezho eus ar gwiskad oberiant.
command.edit.paste.title = Pegañ
command.edit.paste.description = Pegañ ar golver en ur gwiskad nevez a-us d'an hini oberiant, kreizet war ar steuenn.
command.edit.paste.layer_name = Gwiskad peget
command.edit.paste_in_place.title = Pegañ el lec'h
command.edit.paste_in_place.description = Pegañ ar golver en ur gwiskad nevez er c'henurzhioù ma voe eilet diouto.
command.edit.fill_foreground.title = Leuniañ gant ar rakleur
command.edit.fill_foreground.description = Leuniañ an diuzadenn (pe ar steuenn a-bezh pa n'eus diuzadenn ebet) gant liv ar rakleur.
command.edit.fill_background.title = Leuniañ gant an drekleur
command.edit.fill_background.description = Leuniañ an diuzadenn (pe ar steuenn a-bezh pa n'eus diuzadenn ebet) gant liv an drekleur.

command.select.all.title = Diuzañ pep tra
command.select.all.description = Diuzañ ar steuenn a-bezh.
command.select.deselect.title = Diziuz
command.select.deselect.description = Dilezel an diuzadenn, evit ma vo arloet ar c'hemmoù d'ar gwiskad a-bezh en-dro.
command.select.inverse.title = Eilpennañ an diuzadenn
command.select.inverse.description = Eskemm an takadoù diuzet ha diziuzet.
command.select.reselect.title = Ad-diuzañ
command.select.reselect.description = Adlakaat an diuzadenn diwezhañ bet dilezet.
command.select.reselect.msg.nothing_to_reselect = Netra da ad-diuzañ
command.select.feather.title = Pluñvañ an diuzadenn
command.select.feather.description = Blotañ riblenn an diuzadenn gant ur flou daou biksel, evit ma steuzio ar c'hemm da-heul drezi.
command.select.grow.title = Kreskiñ
command.select.grow.description = Astenn an diuzadenn er pikselioù kefin heñvel ouzh ar re diuzet dija, hervez dalc'husted ar vazh hud.
command.select.similar.title = Heñvel
command.select.similar.description = Diuzañ pep piksel er gwiskad heñvel ouzh an diuzadenn, pe e vefent kefin dezhi pe get, hervez dalc'husted ar vazh hud.
command.select.save.title = Enrollañ an diuzadenn
command.select.save.description = Mirout an diuzadenn vremanel en teul evel ur sanell alfa anvet.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Kargañ un diuzadenn
command.select.load.description = Assav an diuzadenn bet enrollet da ziwezhañ.

command.layer.new.title = Gwiskad nevez
command.layer.new.description = Ouzhpennañ ur gwiskad raster goullo a-us d'an hini oberiant ha gweredekaat anezhañ.
command.layer.duplicate.title = Eilañ ar gwiskad
command.layer.duplicate.description = Eilañ ar gwiskad oberiant, gant e holl endalc'had, en ur gwiskad nevez a-us dezhañ.
command.layer.smart_object.title = Amdreiñ en ergorenn speredek
command.layer.smart_object.description = Pakata pikselioù ar gwiskad raster oberiant en un ergorenn speredek, evit ma vo adstandilhonet an tarzh digemmet gant an treuzfurmadurioù hag ar siloù da-heul.
command.layer.rasterize.title = Rasterelaat ar gwiskad
command.layer.rasterize.description = Amdreiñ ur gwiskad stumm, testenn pe ergorenn speredek e pikselioù eeun.
command.layer.delete.title = Dilemel ar gwiskad
command.layer.delete.description = Dilemel ar gwiskadoù diuzet.
command.layer.group.title = Strollañ ar gwiskadoù
command.layer.group.description = Pakata ar gwiskadoù diuzet en ur strollad nevez, el lec'h m'emaint.
command.layer.raise.title = Kas war-raok
command.layer.raise.description = Sevel ar gwiskad oberiant ul lec'h e bern e strollad.
command.layer.lower.title = Kas war-gil
command.layer.lower.description = Diskenn ar gwiskad oberiant ul lec'h e bern e strollad.
command.layer.to_front.title = Kas dirak pep tra
command.layer.to_front.description = Dilec'hiañ ar gwiskad oberiant e penn uhelañ e strollad.
command.layer.to_back.title = Kas a-dreñv pep tra
command.layer.to_back.description = Dilec'hiañ ar gwiskad oberiant e traoñ e strollad.
command.layer.clipping_mask.title = Krouiñ/Dieubiñ ur maskl didroc'hañ
command.layer.clipping_mask.description = Didroc'hañ ar gwiskad oberiant diouzh an hini dindanañ, pe e zieubiñ ma'z eo didroc'het dija; ur gwiskad didroc'het ne ziskouez nemet el lec'hioù ma'z eus pikselioù gant e ziaz.
command.layer.cut_to_new.title = Gwiskad dre droc'hañ
command.layer.cut_to_new.description = Dilec'hiañ ar pikselioù diuzet er-maez eus ar gwiskad oberiant ha war ur gwiskad nevez a-us dezhañ.
command.layer.cut_to_new.layer_name = Gwiskad dre droc'hañ
command.layer.add_mask.title = Ouzhpennañ ur maskl gwiskad
command.layer.add_mask.description = Ouzhpennañ ur maskl d'ar gwiskad oberiant, o tiskouez an diuzadenn hepken pa vez unan.
command.layer.flatten.title = Plaenaat ar skeudenn
command.layer.flatten.description = Kenaozañ pep tra hewel en ur gwiskad Drekleur didreuzwelus, en ur zilezel ar gwiskadoù kuzhet.
command.layer.merge_down.title = Kendeuziñ d'an traoñ
command.layer.merge_down.description = Kenaozañ ar gwiskad oberiant er gwiskad dindanañ.
command.layer.merge_down.msg.no_layer_below = Gwiskad ebet dindanañ evit kendeuziñ ennañ
command.layer.merge_visible.title = Kendeuziñ ar re hewel
command.layer.merge_visible.description = Kenaozañ an holl wiskadoù hewel en unan, en ur lezel ar gwiskadoù kuzhet evel m'emaint.

command.msg.nothing_to_copy = Diuzit ur gwiskad piksel da eilañ dioutañ
command.msg.clipboard_empty = Netra er golver

