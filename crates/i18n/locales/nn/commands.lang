command.edit.undo.title = Angre
command.edit.undo.description = Gå eitt steg tilbake i angrehistorikken til dokumentet.
command.edit.redo.title = Gjer om
command.edit.redo.description = Gjer om den siste endringa som vart angra.
command.edit.copy.title = Kopier
command.edit.copy.description = Kopier dei valde pikslane i det aktive laget til den interne utklippstavla, eller heile laget dersom ingenting er valt.
command.edit.copy_merged.title = Kopier samanslege
command.edit.copy_merged.description = Kopier utvalet slik alle dei synlege laga ser ut når dei er fletta saman, i staden for berre frå det aktive laget.
command.edit.cut.title = Klipp ut
command.edit.cut.description = Kopier dei valde pikslane til utklippstavla og visk dei ut frå det aktive laget.
command.edit.paste.title = Lim inn
command.edit.paste.description = Lim inn utklippstavla i eit nytt lag over det aktive laget, midtstilt på lerretet.
command.edit.paste.layer_name = Innlimt lag
command.edit.paste_in_place.title = Lim inn på same stad
command.edit.paste_in_place.description = Lim inn utklippstavla i eit nytt lag på koordinatane ho vart kopiert frå.
command.edit.fill_foreground.title = Fyll med framgrunn
command.edit.fill_foreground.description = Fyll utvalet med framgrunnsfargen, eller heile lerretet dersom ingenting er valt.
command.edit.fill_background.title = Fyll med bakgrunn
command.edit.fill_background.description = Fyll utvalet med bakgrunnsfargen, eller heile lerretet dersom ingenting er valt.

command.select.all.title = Vel alt
command.select.all.description = Vel heile lerretet.
command.select.deselect.title = Opphev val
command.select.deselect.description = Fjern utvalet, slik at endringar vert brukte på heile laget att.
command.select.inverse.title = Inverter utval
command.select.inverse.description = Byt om valde og uvalde område.
command.select.reselect.title = Vel på nytt
command.select.reselect.description = Hent tilbake utvalet som sist vart fjerna.
command.select.reselect.msg.nothing_to_reselect = Inkje utval å henta tilbake
command.select.feather.title = Mjuk kant på utval
command.select.feather.description = Mjuk opp kanten på utvalet med to pikslar uskarpleik, slik at den neste endringa tonar ut over kanten.
command.select.grow.title = Veks
command.select.grow.description = Utvid utvalet til tilgrensande pikslar som liknar på dei som alt er valde, innanfor toleransen til tryllestaven.
command.select.similar.title = Liknande
command.select.similar.description = Vel alle pikslane i laget som liknar på utvalet, anten dei grensar til det eller ikkje, innanfor toleransen til tryllestaven.
command.select.save.title = Lagre utval
command.select.save.description = Gøym det gjeldande utvalet i dokumentet som ein namngjeven alfakanal.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Last inn utval
command.select.load.description = Hent tilbake utvalet som sist vart lagra.

command.layer.new.title = Nytt lag
command.layer.new.description = Legg eit tomt rasterlag over det aktive laget, og gjer det nye laget aktivt.
command.layer.duplicate.title = Dupliser lag
command.layer.duplicate.description = Kopier det aktive laget med alt innhaldet til eit nytt lag over det.
command.layer.smart_object.title = Konverter til smartobjekt
command.layer.smart_object.description = Pakk pikslane i det aktive rasterlaget inn i eit smartobjekt, slik at seinare transformeringar og filter kan henta nye pikslar frå den urørte kjelda.
command.layer.rasterize.title = Rasteriser lag
command.layer.rasterize.description = Gjer eit form-, tekst- eller smartobjektlag permanent om til vanlege pikslar.
command.layer.delete.title = Slett lag
command.layer.delete.description = Slett dei valde laga.
command.layer.group.title = Grupper lag
command.layer.group.description = Legg dei valde laga i ei ny gruppe på same stad.
command.layer.raise.title = Flytt framover
command.layer.raise.description = Flytt det aktive laget éin plass opp i stabelen til gruppa.
command.layer.lower.title = Flytt bakover
command.layer.lower.description = Flytt det aktive laget éin plass ned i stabelen til gruppa.
command.layer.to_front.title = Flytt fremst
command.layer.to_front.description = Flytt det aktive laget øvst i gruppa.
command.layer.to_back.title = Flytt bakarst
command.layer.to_back.description = Flytt det aktive laget nedst i gruppa.
command.layer.clipping_mask.title = Opprett/frigjer klippemaske
command.layer.clipping_mask.description = Klipp det aktive laget til laget under, eller frigjer det dersom det alt er klipt. Eit klipt lag er berre synleg der grunnlaget har pikslar.
command.layer.cut_to_new.title = Lag via utklipp
command.layer.cut_to_new.description = Flytt dei valde pikslane ut av det aktive laget og over på eit nytt lag over det.
command.layer.cut_to_new.layer_name = Lag via utklipp
command.layer.add_mask.title = Legg til lagmaske
command.layer.add_mask.description = Legg ei lagmaske til det aktive laget. Dersom det finst eit utval, viser maska berre det.
command.layer.flatten.title = Slå saman bilete
command.layer.flatten.description = Flett alt som er synleg, saman i eitt ugjennomsiktig bakgrunnslag, og forkast dei gøymde laga.
command.layer.merge_down.title = Slå saman nedover
command.layer.merge_down.description = Flett det aktive laget inn i laget under.
command.layer.merge_down.msg.no_layer_below = Inkje lag under å slå saman med
command.layer.merge_visible.title = Slå saman synlege
command.layer.merge_visible.description = Flett alle synlege lag til eitt, utan å endra dei gøymde laga.

