# AI-assisted translation; native-speaker review pending.
tethered.title = Sawir qaadis kamarad ku xiran kombiyuutarka
tethered.capture = Sawir qaad
tethered.invalid_name = Dooro magac dhererkiisu yahay 1–120 bayt oo aan lahayn calaamado slash, laba dhibcood, calaamado boqolkiiba ama dhibic bilowga taal.
tethered.install = Maktabadda kamaradda ee nidaamka lama heli karo. Ku rakib barnaamijka kamaradda ee madashaada, dabadeedna dib u bilow Schist.
tethered.timeout = Wakhtigii codsiga kamaraddu wuu dhammaaday. Hubi kamaradda oo dib u xidh ka hor intaadan mar kale isku dayin.
tethered.failed = Codsigii kamaraddu wuu fashilmay: {detail}
tethered.unsupported = Kamaraddani ma sheegto inay taageerto sawir qaadista meel fog laga hago.
tethered.no_download = Kamaraddu ma soo gudbin sawir dhammaystiran. Sawirradii asalka ahaa kamaradda ayay ku sii jiraan.
tethered.session_help = Dooro kamarad, dabadeed guji «Sawir qaad». Sawirka koowaad, dooro meesha lagu kaydinayo iyo bilowga magaca faylka; sawir kasta waxaa lagu daraa lambar taxane ah iyo kordhinta faylka kamaradda. «U Kaydi Sida…» waxay beddeshaa meesha kaydinta iyo bilowga magaca.
tethered.preview_failed = Sawirka waa la kaydiyey waana la soo geliyey, balse muuqaalkiisii hore lama furfuri karin. Faylka ku fur tafatiraha si aad u eegto.
tethered.partial = Qaar ka mid ah faylasha sawirrada waa la kaydiyey waana la soo geliyey; faylasha harayna lama kaydin karin: {error}
tethered.camera_permission = U oggolow kamaradda inay shaqayso adigoo maraya System Settings → Privacy & Security → Camera, dabadeed mar kale isku day «Sawir qaad». Haddii Schist laga bilaabay terminal, hubi oggolaanshaha kamaradda ee terminalkaasna.
tethered.camera_usage_missing = Dhismadan waxaa ka maqan sharraxaadda oggolaanshaha kamaradda. Schist dib ugu dhis make ama isticmaal app-ka baakadaysan.
tethered.select_camera = Dooro kamarad si aad sawir u qaaddo.
tethered.choose_destination = «Sawir qaad» waxay ku weydiinaysaa meesha lagu kaydinayo sawirradaada.
tethered.preview_empty = Sawir qaad si aad halkan ugu aragto.
