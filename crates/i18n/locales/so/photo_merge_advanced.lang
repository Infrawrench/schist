photo_merge_advanced.projective = Isku-aaddinta aragtida (wareejinta way ku jirtaa)
photo_merge_advanced.cylindrical = Panorama dhululubo ah
photo_merge_advanced.deghost = Ka saar raadadka walxaha dhaqaaqaya (sawirka koowaad ayaa tixraac ah)
photo_merge_advanced.focal = Dhererka foogalka (px) / ballaca sawirka (px)
photo_merge_advanced.masks = Natiijada isku-darka diiraddu waxay isticmaashaa maaskaro lakab oo la tafatiri karo. Ka dooro maaskaro Lakabyada oo ku rinji si aad u hagaajiso.
photo_merge_advanced.no_match = Isku-aaddin lagu kalsoonaan karo lama helin. Isticmaal sawirro leh qaab muuqda, is-dul-saar badan iyo isbeddel yar oo dhinaca aragtida ah.
photo_merge_advanced.invalid = Sawirrada ilaha ama dejimaha isku-darka waa khaldan yihiin.
