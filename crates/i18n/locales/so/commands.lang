command.edit.undo.title = Ka noqo
command.edit.undo.description = Hal tallaabo dib ugu noqo taariikhda ka-noqoshada dukumentiga.
command.edit.redo.title = Dib u samee
command.edit.redo.description = Dib u samee tafatirkii ugu dambeeyey ee laga noqday.
command.edit.copy.title = Nuqul
command.edit.copy.description = Pixels-ka la xushay ee lakabka firfircoon ku nuqul sabuuradda gudaha (lakabka oo dhan marka aan waxba la xulin).
command.edit.copy_merged.title = Nuqul Midaysan
command.edit.copy_merged.description = Xulashada u nuqul sida ay dhammaan lakabyada muuqda isu dul saaraan, halkii laga qaadi lahaa lakabka firfircoon oo keliya.
command.edit.cut.title = Goo
command.edit.cut.description = Pixels-ka la xushay ku nuqul sabuuradda oo ka tirtir lakabka firfircoon.
command.edit.paste.title = Ku dheji
command.edit.paste.description = Waxa sabuuradda ku jira ku dheji lakab cusub oo ka sarreeya kan firfircoon, bartamaha shiraaca.
command.edit.paste.layer_name = Lakab La Dhejiyey
command.edit.paste_in_place.title = Halkiisii Ku dheji
command.edit.paste_in_place.description = Waxa sabuuradda ku jira ku dheji lakab cusub, isla isku-duwayaashii laga soo nuquliyey.
command.edit.fill_foreground.title = Ku Buuxi Midabka Hore
command.edit.fill_foreground.description = Xulashada (ama shiraaca oo dhan marka aan waxba la xulin) ku buuxi midabka hore.
command.edit.fill_background.title = Ku Buuxi Midabka Gadaal
command.edit.fill_background.description = Xulashada (ama shiraaca oo dhan marka aan waxba la xulin) ku buuxi midabka gadaal.
command.select.all.title = Xulo Dhammaan
command.select.all.description = Xulo shiraaca oo dhan.
command.select.deselect.title = Xulashada ka saar
command.select.deselect.description = Xulashada ka tag, si tafatirradu mar kale ugu dhacaan lakabka oo dhan.
command.select.inverse.title = Rog Xulashada
command.select.inverse.description = Isweydaari aagagga la xushay iyo kuwa aan la xulin.
command.select.reselect.title = Mar Kale Xulo
command.select.reselect.description = Soo celi xulashadii ugu dambaysay ee laga tegay.
command.select.reselect.msg.nothing_to_reselect = Ma jiro wax mar kale la xulo
command.select.feather.title = Jilci Geesaha Xulashada
command.select.feather.description = Geeska xulashada ku jilci ceeryaamayn laba-pixel ah, si tafatirka xiga tartiib ugu libdho marka uu geeska gudbayo.
command.select.grow.title = Ballaadhi
command.select.grow.description = Xulashada ku fidi pixels-ka taabanaya ee la midka ah kuwa la xushay, inta uu ku jiro dulqaadka usha sixirka.
command.select.similar.title = Kuwa La Midka ah
command.select.similar.description = Xulo pixel kasta oo lakabka ku jira oo la mid ah xulashada, ha taabto ama yaanu taaban, inta uu ku jiro dulqaadka usha sixirka.
command.select.save.title = Kaydi Xulashada
command.select.save.description = Xulashada hadda dukumentiga ugu kaydi kanaal alfa oo magac leh.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Soo Rar Xulashada
command.select.load.description = Soo celi xulashadii ugu dambaysay ee la kaydiyey.
command.layer.new.title = Lakab Cusub
command.layer.new.description = Lakab raster madhan ku dar kan firfircoon dushiisa oo ka dhig mid firfircoon.
command.layer.duplicate.title = Lakabka Nuqul ka Samee
command.layer.duplicate.description = Lakabka firfircoon iyo wax kasta oo ku jira ku nuqul lakab cusub oo ka sarreeya.
command.layer.smart_object.title = U Beddel Shay Caqli leh
command.layer.smart_object.description = Pixels-ka lakabka raster-ka firfircoon ku duub shay caqli leh, si beddellada iyo shaandhooyinka dambe ay muunad cusub uga qaataan isha aan la taaban.
command.layer.rasterize.title = Lakabka Raster ka Dhig
command.layer.rasterize.description = Lakab qaab, qoraal ama shay caqli leh u beddel pixels caadi ah.
command.layer.delete.title = Tirtir Lakabka
command.layer.delete.description = Tirtir lakabyada la xushay.
command.layer.group.title = Kooxee Lakabyada
command.layer.group.description = Lakabyada la xushay meeshooda ugu duub koox cusub.
command.layer.raise.title = Hore u Soo Qaad
command.layer.raise.description = Lakabka firfircoon hal meel kor ugu qaad isdulsaarnaanta kooxdiisa.
command.layer.lower.title = Gadaal u Dir
command.layer.lower.description = Lakabka firfircoon hal meel hoos ugu dhig isdulsaarnaanta kooxdiisa.
command.layer.to_front.title = Xagga Hore Keen
command.layer.to_front.description = Lakabka firfircoon dhig meesha ugu sarreysa kooxdiisa.
command.layer.to_back.title = Xagga Dambe Dir
command.layer.to_back.description = Lakabka firfircoon dhig meesha ugu hooseysa kooxdiisa.
command.layer.clipping_mask.title = Samee/Sii Daa Maaskarada Xaddidaysa
command.layer.clipping_mask.description = Lakabka firfircoon ku xaddid kan ka hooseeya, ama sii daa haddii hore loo xaddiday; lakab xaddidan wuxuu ka muuqdaa oo keliya meelaha salkiisu pixels ku leeyahay.
command.layer.cut_to_new.title = Lakab ku Samee Goyn
command.layer.cut_to_new.description = Pixels-ka la xushay ka saar lakabka firfircoon oo geli lakab cusub oo ka sarreeya.
command.layer.cut_to_new.layer_name = Lakab ku Samee Goyn
command.layer.add_mask.title = Ku dar Maaskarada Lakabka
command.layer.add_mask.description = Lakabka firfircoon ku dar maaskaro lakab, taas oo muujisa xulashada oo keliya marka ay jirto.
command.layer.flatten.title = Simi Sawirka
command.layer.flatten.description = Wax kasta oo muuqda ku midee hal lakab Gadaal oo aan hufnayn, lakabyada qarsoonna iska tuur.
command.layer.merge_down.title = Hoos ugu Midee
command.layer.merge_down.description = Lakabka firfircoon ku midee lakabka ka hooseeya.
command.layer.merge_down.msg.no_layer_below = Ma jiro lakab hoose oo lagu mideeyo
command.layer.merge_visible.title = Midee Kuwa Muuqda
command.layer.merge_visible.description = Dhammaan lakabyada muuqda hal lakab ku midee, kuwa qarsoonna sida ay yihiin u daa.
command.msg.nothing_to_copy = Xulo lakab pixel ah oo wax laga nuquliyo
command.msg.clipboard_empty = Sabuuraddu waa madhan tahay
