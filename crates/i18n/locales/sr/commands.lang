# Основне команде за уређивање, избор и слојеве.
command.edit.undo.title = Опозови
command.edit.undo.description = Враћа један корак у историји опозива документа.
command.edit.redo.title = Понови
command.edit.redo.description = Понавља последњу опозвану измену.
command.edit.copy.title = Копирај
command.edit.copy.description = Копира изабране пикселе активног слоја у интерну привремену меморију (цео слој када ништа није изабрано).
command.edit.copy_merged.title = Копирај спојено
command.edit.copy_merged.description = Копира избор онако како га састављају сви видљиви слојеви, уместо само са активног слоја.
command.edit.cut.title = Исеци
command.edit.cut.description = Копира изабране пикселе у привремену меморију и брише их са активног слоја.
command.edit.paste.title = Налепи
command.edit.paste.description = Лепи садржај привремене меморије у нови слој изнад активног, центриран на платну.
command.edit.paste.layer_name = Налепљени слој
command.edit.paste_in_place.title = Налепи на исто место
command.edit.paste_in_place.description = Лепи садржај привремене меморије у нови слој на координатама са којих је копиран.
command.edit.fill_foreground.title = Попуни бојом предњег плана
command.edit.fill_foreground.description = Попуњава избор (или цело платно када ништа није изабрано) бојом предњег плана.
command.edit.fill_background.title = Попуни бојом позадине
command.edit.fill_background.description = Попуњава избор (или цело платно када ништа није изабрано) бојом позадине.

command.select.all.title = Изабери све
command.select.all.description = Бира цело платно.
command.select.deselect.title = Поништи избор
command.select.deselect.description = Уклања избор, па се измене поново примењују на цео слој.
command.select.inverse.title = Обрни избор
command.select.inverse.description = Замењује изабране и неизабране области.
command.select.reselect.title = Поново изабери
command.select.reselect.description = Враћа последњи поништени избор.
command.select.reselect.msg.nothing_to_reselect = Нема избора који се може вратити
command.select.feather.title = Умекшај избор
command.select.feather.description = Умекшава ивицу избора замућењем од два пиксела, тако да следећа измена постепено ишчезава преко ње.
command.select.grow.title = Прошири
command.select.grow.description = Проширује избор на суседне пикселе сличне већ изабраним, унутар толеранције чаробног штапића.
command.select.similar.title = Слично
command.select.similar.description = Бира све пикселе у слоју сличне избору, без обзира да ли га додирују, унутар толеранције чаробног штапића.
command.select.save.title = Сачувај избор
command.select.save.description = Чува тренутни избор у документу као именовани алфа-канал.
command.select.save.channel_name = Алфа {n}
command.select.load.title = Учитај избор
command.select.load.description = Враћа последњи сачувани избор.

command.layer.new.title = Нови слој
command.layer.new.description = Додаје празан растерски слој изнад активног и активира га.
command.layer.duplicate.title = Дуплирај слој
command.layer.duplicate.description = Копира активни слој са целим садржајем у нови слој изнад њега.
command.layer.smart_object.title = Претвори у паметни објекат
command.layer.smart_object.description = Обавија пикселе активног растерског слоја паметним објектом, тако да касније трансформације и филтери поново узоркују нетакнути извор.
command.layer.rasterize.title = Растеризуј слој
command.layer.rasterize.description = Претвара слој облика, текста или паметног објекта у обичне пикселе.
command.layer.delete.title = Избриши слој
command.layer.delete.description = Брише изабране слојеве.
command.layer.group.title = Групиши слојеве
command.layer.group.description = Смешта изабране слојеве у нову групу на истом месту.
command.layer.raise.title = Помери напред
command.layer.raise.description = Помера активни слој једно место навише у низу његове групе.
command.layer.lower.title = Помери назад
command.layer.lower.description = Помера активни слој једно место наниже у низу његове групе.
command.layer.to_front.title = Премести испред свега
command.layer.to_front.description = Помера активни слој на врх његове групе.
command.layer.to_back.title = Премести иза свега
command.layer.to_back.description = Помера активни слој на дно његове групе.
command.layer.clipping_mask.title = Направи/ослободи маску одсецања
command.layer.clipping_mask.description = Одсеца активни слој према слоју испод или га ослобађа ако је већ одсечен; одсечени слој се види само тамо где његова основа има пикселе.
command.layer.cut_to_new.title = Слој исецањем
command.layer.cut_to_new.description = Премешта изабране пикселе из активног слоја у нови слој изнад њега.
command.layer.cut_to_new.layer_name = Слој исецањем
command.layer.add_mask.title = Додај маску слоја
command.layer.add_mask.description = Додаје маску активном слоју и, када постоји избор, открива само њега.
command.layer.flatten.title = Споји слику
command.layer.flatten.description = Саставља све видљиво у један непрозиран слој Позадина и одбацује скривене слојеве.
command.layer.merge_down.title = Споји надоле
command.layer.merge_down.description = Саставља активни слој са слојем испод њега.
command.layer.merge_down.msg.no_layer_below = Испод нема слоја са којим се може спојити
command.layer.merge_visible.title = Споји видљиве
command.layer.merge_visible.description = Саставља све видљиве слојеве у један, не мењајући скривене слојеве.

command.msg.nothing_to_copy = Изаберите пикселски слој са ког желите да копирате
command.msg.clipboard_empty = Привремена меморија је празна

