tool.gradient.choice.foreground_to_transparent = Од предњег плана до провидног
tool.gradient.choice.linear = Линеарно
tool.gradient.choice.radial = Радијално
tool.gradient.choice.angle = Угаоно
tool.gradient.choice.reflected = Одражено
tool.gradient.choice.diamond = Ромб
tool.gradient.history.gradient = Градијент

tool.bucket.name = Канта са бојом
tool.bucket.description = Кликните да бојом предњег плана попуните повезану област сличне боје испод показивача, унутар толеранције алатке.
