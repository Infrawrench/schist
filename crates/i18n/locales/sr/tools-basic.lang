# Основне алатке: Померање, Пипета, Рука и Зумирање.
tool.move.name = Померање
tool.move.description = Превуците садржај активног слоја на ново место. Када је аутоматски избор укључен, притиском се најпре бира слој — или цела група — испод показивача.
tool.move.option.auto_select = Аутоматски избор
tool.move.history.move_layer = Помери слој

tool.eyedropper.name = Пипета
