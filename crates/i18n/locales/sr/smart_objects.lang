# Извори паметних објеката који се могу уређивати и повезивати.
smart.place_embedded = Постави уграђени паметни објекат…
smart.place_linked = Постави повезани паметни објекат…
smart.edit_contents = Уреди садржај
smart.replace_contents = Замени садржај…
smart.relink = Поново повежи паметни објекат…
smart.update_linked = Ажурирај повезане инстанце
smart.pick_source = Изаберите извор паметног објекта
smart.loading = Учитавање извора паметног објекта…
smart.updated = Инстанце паметног објекта су ажуриране
smart.edit_hint = Уредите изворни документ, затим изаберите „Сачувај” да бисте ажурирали његове инстанце и вратили се на надређени документ.
smart.contents_title = {name} — Садржај
smart.history.update = Ажурирање садржаја паметног објекта
smart.history.place = Постављање паметног објекта
smart.history.embed = Уграђивање извора паметног објекта који се може уређивати
smart.error.failed = Паметни објекат: {error}
smart.error.too_large = Извор премашује ограничење од 32 милиона пиксела, 30,000 пиксела по страни или 64 MiB.
smart.error.invalid = Уграђени извор паметног објекта није важећи.
smart.error.unsupported = Овај формат извора не може да се користи као паметни објекат.
smart.error.locked = Откључајте све инстанце извора пре ажурирања.
smart.error.select = Изаберите откључани слој паметног објекта.
smart.error.browser_link = Везе са системом датотека доступне су у апликацији за рачунар. У прегледачу користите уграђени паметни објекат.
smart.error.changed = Одредиште се променило током уређивања или учитавања. Поново отворите садржај или поново изаберите извор.
smart.error.no_link = Овај паметни објекат нема везу са датотеком. Изаберите „Поново повежи паметни објекат” да бисте изабрали извор.
smart.error.nesting = Затворите картицу садржаја пре отварања другог угнежђеног извора.
smart.error.parent_closed = Надређени документ је затворен. Изаберите „Сачувај као…” да бисте сачували овај документ садржаја.
smart.error.file_changed = Повезана датотека промењена је изван програма Schist. Изаберите „Сачувај као…” да бисте сачували измене, а затим „Поново повежи паметни објекат” или „Ажурирај повезане инстанце”.
smart.embedded_source = Уграђени извор — Слој ▸ Уреди садржај
smart.link_current = Повезани извор
smart.link_changed = Извор је промењен — Ажурирај повезане инстанце
smart.link_missing = Извор недостаје — поново га повежите да бисте га вратили
smart.link_browser = Повезани извор је кеширан — за ажурирање је потребна апликација за рачунар
smart.link_status = {status}: {path}
