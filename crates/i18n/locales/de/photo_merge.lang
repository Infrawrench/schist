# Selected-document photographic merging.
photo_merge.title = Fotos zusammenfügen…
photo_merge.align = Automatische Ausrichtung
photo_merge.focus = Fokus-Stacking
photo_merge.hdr = HDR aus Belichtungsreihe
photo_merge.panorama = Panorama zusammenfügen
photo_merge.translation = Nur horizontale und vertikale Verschiebungen (X/Y); Drehung und Perspektive werden nicht korrigiert.
photo_merge.crop = Auf gemeinsamen Bereich zuschneiden
photo_merge.exposure_note = Relative Belichtung jeder Aufnahme einstellen: +1 EV = doppelte Lichtmenge. Tonemapping deaktivieren, um 32-Bit-HDR beizubehalten.
photo_merge.tone_map = Tonemapping
photo_merge.order = Panoramabilder folgen der Tab-Reihenfolge; aufeinanderfolgende Fotos müssen sich mindestens zu 25% überlappen.
photo_merge.invalid = 2–16 gültige Bilder auswählen und die Belichtungseinstellungen prüfen.
photo_merge.limit = Grenze: 64 Millionen Pixel pro Bild oder Ausgabe, insgesamt 128 Millionen; 30.000 Pixel pro Seite.
photo_merge.no_match = Keine zuverlässige Überlappung gefunden. Überlappende Fotos ohne Drehungs- oder Perspektivänderungen verwenden.
