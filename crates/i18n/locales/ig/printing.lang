printing.caption_limit = Nkọwa foto dị ogologo karịa oghere a. Belata ahịrị ma ọ bụ kọlụm, mee ka nkọwa ahụ dị mkpụmkpụ, ma ọ bụ gbanyụọ nkọwa foto.
printing.font_error = Enweghị mkpụrụedemede maka nkọwa foto. Wụnye mkpụrụedemede ederede ma ọ bụ gbanyụọ nkọwa foto.
printing.no_document = Mepee dọkụmentị ma ọ bụ họrọ foto na galari tupu ibipụta.
printing.source_error = Enweghị ike ịgụ foto ahọpụtara, faịlụ enyemaka nke ndezi, ma ọ bụ nkọwa foto. Enweghị PDF echekwara.
printing.save_error = Enweghị ike ichekwa PDF. Họrọ aha faịlụ ọhụrụ n'ime folda a pụrụ ide ihe na ya; a naghị edechi faịlụ ndị dị adị.
