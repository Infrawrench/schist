# HEIC security update.
codec.heif.msg.unsafe_version = Anaghị anabata libheif {version} n'ihi adịghị ike nchekwa ndị a maara; a chọrọ ụdị {minimum} ma ọ bụ nke ọhụrụ karịa ya. Budata nkwado HEIC emelitere ma ọ bụ melite ọba akwụkwọ sistemụ.
codec.heif.msg.unknown_version = Anaghị anabata libheif n'ihi na enweghị ike ikwenye ụdị ya; a chọrọ ụdị {minimum} ma ọ bụ nke ọhụrụ karịa ya. Budata nkwado HEIC emelitere ma ọ bụ melite ọba akwụkwọ sistemụ.
dialog.open.heic_needs_safe_decoder = Imepe “{name}” chọrọ libheif {minimum} ma ọ bụ ụdị ọhụrụ karịa ya nke nwere HEVC decoder. A na-egbochi ụdị ndị ochie ma ọ bụ ndị a na-apụghị ikwenye iji chebe megide adịghị ike nchekwa ndị a maara. Budata nkwado HEIC emelitere iji gaa n'ihu.
workspace.docs.heic_safe_decoder_needed = A chọrọ nkwado HEIC emelitere
