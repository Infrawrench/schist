photo_merge_advanced.projective = Poravnanje perspektive (uključuje rotaciju)
photo_merge_advanced.cylindrical = Cilindrična panorama
photo_merge_advanced.deghost = Uklonite duhove pokretnih objekata (prva referenca fotografije)
photo_merge_advanced.focal = Žarišna duljina (px) / širina slike (px)
photo_merge_advanced.masks = Izlaz fokusa koristi maske slojeva koje je moguće uređivati. Odaberite masku u Slojevima i obojite je za pročišćavanje.
photo_merge_advanced.no_match = Nije pronađeno pouzdano poravnanje. Koristite fotografije s teksturom sa značajnim preklapanjem i skromnim promjenama gledišta.
photo_merge_advanced.invalid = Nevažeće izvorne slike ili postavke spajanja.
