command.edit.undo.title = Deebisi
command.edit.undo.description = Seenaa deebisuu galmee keessaa galtee tokko duubatti deebi'i.
command.edit.redo.title = Irra Deebi'i
command.edit.redo.description = Gulaala dhuma irratti deebifame irra deebi'ii raawwadhu.
command.edit.copy.title = Garagalchi
command.edit.copy.description = Pikseloota filataman kan laayara ka'aa gara kilipboordii keessaatti garagalchi (yeroo filannoon hin jirre laayara guutuu).
command.edit.copy_merged.title = Kan Walitti Makame Garagalchi
command.edit.copy_merged.description = Filannoo laayara ka'aa qofa irraa osoo hin taane, akkuma laayaroonni mul'atan hundi walitti makanii mul'isanitti garagalchi.
command.edit.cut.title = Muri
command.edit.cut.description = Pikseloota filataman gara kilipboordiitti garagalchiitii laayara ka'aa keessaa haqi.
command.edit.paste.title = Maxxansi
command.edit.paste.description = Qabiyyee kilipboordii laayara haaraa kan laayara ka'aa gubbaa jiru, wiirtuu kanvaasii irratti maxxansi.
command.edit.paste.layer_name = Laayara Maxxanfame
command.edit.paste_in_place.title = Bakkuma Isaatti Maxxansi
command.edit.paste_in_place.description = Qabiyyee kilipboordii laayara haaraa irratti, ko'oordineetii inni irraa garagalchametti maxxansi.
command.edit.fill_foreground.title = Halluu Fuulduraatiin Guuti
command.edit.fill_foreground.description = Filannoo (yookaan yeroo filannoon hin jirre kanvaasii guutuu) halluu fuulduraatiin guuti.
command.edit.fill_background.title = Halluu Duubbeetiin Guuti
command.edit.fill_background.description = Filannoo (yookaan yeroo filannoon hin jirre kanvaasii guutuu) halluu duubbeetiin guuti.
command.select.all.title = Hunda Filadhu
command.select.all.description = Kanvaasii guutuu filadhu.
command.select.deselect.title = Filannoo Dhiisi
command.select.deselect.description = Filannoo dhiisi; kana booda gulaalli ammas laayara guutuu irratti hojii irra oola.
command.select.inverse.title = Faallaa Filadhu
command.select.inverse.description = Naannolee filatamanii fi hin filatamin wal jijjiiri.
command.select.reselect.title = Deebisii Filadhu
command.select.reselect.description = Filannoo dhuma irratti dhiifame deebisi.
command.select.reselect.msg.nothing_to_reselect = Wanti deebisanii filatan hin jiru
command.select.feather.title = Qarqara Filannoo Lallaafsi
command.select.feather.description = Qarqara filannoo bloorii pikselii lamaatiin lallaafsi; gulaalli itti aanu qarqara sana irratti suuta bada.
command.select.grow.title = Bal'isi
command.select.grow.description = Hanga obsa Ulee Sihrii keessatti, filannoo gara pikseloota isa tuqanii fi waan duraan filatame fakkaatanitti bal'isi.
command.select.similar.title = Walfakkaataa
command.select.similar.description = Hanga obsa Ulee Sihrii keessatti, pikseloota laayara keessaa filannoo fakkaatan hunda, filannoo tuqan yookaan hin tuqne, filadhu.
command.select.save.title = Filannoo Olkaa'i
command.select.save.description = Filannoo ammaa akka chaanaalii alfaa maqaa qabuutti galmee keessa kaa'i.
command.select.save.channel_name = Alfaa {n}
command.select.load.title = Filannoo Fe'i
command.select.load.description = Filannoo yeroo dhumaaf olkaa'ame deebisi.
command.layer.new.title = Laayara Haaraa
command.layer.new.description = Laayara raasterii duwwaa laayara ka'aa gubbaatti ida'ii isa ka'aa godhi.
command.layer.duplicate.title = Laayara Garagalchi
command.layer.duplicate.description = Laayara ka'aa, qabiyyee isaa hundumaa wajjin, laayara haaraa isa gubbaatti garagalchi.
command.layer.smart_object.title = Gara Smart Objecttti Jijjiiri
command.layer.smart_object.description = Pikseloota laayara raasterii ka'aa Smart Object keessa kaa'i; kanaan jijjiiramoonni fi calaltuuwwan boodaa madda hin tuqamne irraa deebi'anii saamplii godhu.
command.layer.rasterize.title = Laayara Raasterii Godhi
command.layer.rasterize.description = Laayara boca, barruu yookaan Smart Object gara pikseloota baramaatti jijjiirii dhaabi.
command.layer.delete.title = Laayara Haqi
command.layer.delete.description = Laayaroota filataman haqi.
command.layer.group.title = Laayaroota Gareessi
command.layer.group.description = Laayaroota filataman bakkuma isaanii irratti garee haaraa keessa kaa'i.
command.layer.raise.title = Gara Fuulduraatti Fidi
command.layer.raise.description = Laayara ka'aa tuulama garee isaa keessatti bakka tokko ol siqsi.
command.layer.lower.title = Gara Duubatti Ergi
command.layer.lower.description = Laayara ka'aa tuulama garee isaa keessatti bakka tokko gadi siqsi.
command.layer.to_front.title = Fuuldura Hundaatti Fidi
command.layer.to_front.description = Laayara ka'aa gara gubbaa garee isaatti sochoosi.
command.layer.to_back.title = Duuba Hundaatti Ergi
command.layer.to_back.description = Laayara ka'aa gara jala garee isaatti sochoosi.
command.layer.clipping_mask.title = Maaskii Kiliippii Uumi/Hiiki
command.layer.clipping_mask.description = Laayara ka'aa laayara isa jala jiruun daangeessi; yoo duraan daangeffame immoo hiiki. Laayarri daangeffame bakka laayarri bu'uuraa pikseloota qabu qofatti mul'ata.
command.layer.cut_to_new.title = Muruun Laayara Uumi
command.layer.cut_to_new.description = Pikseloota filataman laayara ka'aa keessaa baasii laayara haaraa isa gubbaa jirutti sochoosi.
command.layer.cut_to_new.layer_name = Muruun Laayara
command.layer.add_mask.title = Maaskii Laayaraa Ida'i
command.layer.add_mask.description = Laayara ka'aatti maaskii laayaraa ida'i; filannoon yoo jiraate isa qofa mul'isa.
command.layer.flatten.title = Suuraa Diriirsi
command.layer.flatten.description = Waan mul'atu hunda laayara Duubbee tokko kan ifa hin dabarsine keessatti walitti maki; laayaroota dhokatan gati.
command.layer.merge_down.title = Gara Jalaatti Walitti Maki
command.layer.merge_down.description = Laayara ka'aa laayara isa jala jiru keessatti walitti maki.
command.layer.merge_down.msg.no_layer_below = Laayarri jalaa itti makamu hin jiru
command.layer.merge_visible.title = Kan Mul'atan Walitti Maki
command.layer.merge_visible.description = Laayaroota mul'atan hunda tokko keessatti walitti maki; laayaroota dhokatan akkuma jiran hambisi.
command.msg.nothing_to_copy = Laayara pikselii irraa garagalchan filadhu
