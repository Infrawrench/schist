command.edit.undo.title = पूर्ववत् गर्नुहोस्
command.edit.undo.description = कागजातको पूर्ववत् इतिहासमा एक चरण पछाडि जानुहोस्।
command.edit.redo.title = पुनः गर्नुहोस्
command.edit.redo.description = पछिल्लो पटक पूर्ववत् गरिएको सम्पादन फेरि गर्नुहोस्।
command.edit.copy.title = प्रतिलिपि गर्नुहोस्
command.edit.copy.description = सक्रिय तहका चयनित पिक्सेल आन्तरिक क्लिपबोर्डमा प्रतिलिपि गर्नुहोस् (केही चयन नभए पूरै तह)।
command.edit.copy_merged.title = मर्ज गरिएको प्रतिलिपि गर्नुहोस्
command.edit.copy_merged.description = सक्रिय तहबाट मात्र होइन, सबै दृश्य तहले बनाएको संयुक्त रूपमै चयन प्रतिलिपि गर्नुहोस्।
command.edit.cut.title = काट्नुहोस्
command.edit.cut.description = चयनित पिक्सेल क्लिपबोर्डमा प्रतिलिपि गरेर सक्रिय तहबाट मेटाउनुहोस्।
command.edit.paste.title = टाँस्नुहोस्
command.edit.paste.description = क्लिपबोर्डलाई सक्रिय तहभन्दा माथि क्यानभासको केन्द्रमा नयाँ तहका रूपमा टाँस्नुहोस्।
command.edit.paste.layer_name = टाँसिएको तह
command.edit.paste_in_place.title = उही स्थानमा टाँस्नुहोस्
command.edit.paste_in_place.description = क्लिपबोर्डलाई प्रतिलिपि गरिएकै निर्देशाङ्कमा नयाँ तहका रूपमा टाँस्नुहोस्।
command.edit.fill_foreground.title = अग्रभूमिले भर्नुहोस्
command.edit.fill_foreground.description = चयनलाई अग्रभूमि रङले भर्नुहोस् (केही चयन नभए पूरै क्यानभास)।
command.edit.fill_background.title = पृष्ठभूमिले भर्नुहोस्
command.edit.fill_background.description = चयनलाई पृष्ठभूमि रङले भर्नुहोस् (केही चयन नभए पूरै क्यानभास)।
command.select.all.title = सबै चयन गर्नुहोस्
command.select.all.description = पूरै क्यानभास चयन गर्नुहोस्।
command.select.deselect.title = चयन हटाउनुहोस्
command.select.deselect.description = चयन हटाउनुहोस्, ताकि सम्पादन फेरि पूरै तहमा लागू होस्।
command.select.inverse.title = चयन उल्टाउनुहोस्
command.select.inverse.description = चयनित र अचयनित क्षेत्रहरू साट्नुहोस्।
command.select.reselect.title = पुनः चयन गर्नुहोस्
command.select.reselect.description = पछिल्लो पटक हटाइएको चयन फेरि ल्याउनुहोस्।
command.select.reselect.msg.nothing_to_reselect = पुनः चयन गर्न केही छैन
command.select.feather.title = चयन फेदर गर्नुहोस्
command.select.feather.description = चयनको किनारा दुई पिक्सेल धमिलो बनाएर नरम पार्नुहोस्, ताकि अर्को सम्पादन किनारातिर बिस्तारै हराओस्।
command.select.grow.title = बढाउनुहोस्
command.select.grow.description = जादुई छडीको सहनशीलताभित्र चयनित भागसँग मिल्ने र जोडिएका पिक्सेलसम्म चयन फैलाउनुहोस्।
command.select.similar.title = समान
command.select.similar.description = जादुई छडीको सहनशीलताभित्र चयनसँग मिल्ने तहका सबै पिक्सेल चयन गर्नुहोस्, जोडिएका हुन् वा होइनन्।
command.select.save.title = चयन बचत गर्नुहोस्
command.select.save.description = हालको चयनलाई कागजातमा नाम दिइएको अल्फा च्यानलका रूपमा राख्नुहोस्।
command.select.save.channel_name = अल्फा {n}
command.select.load.title = चयन लोड गर्नुहोस्
