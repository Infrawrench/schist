photo_merge_advanced.projective = Go tlhamalatsa pono (go akaretsa go dikologa)
photo_merge_advanced.cylindrical = Panorama ya selindara
photo_merge_advanced.deghost = Tlosa ditshwantsho tse di ipoeletsang tsa dilo tse di tsamayang (setshwantsho sa ntlha ke tshupiso)
photo_merge_advanced.focal = Boleele jwa tsepamiso (px) / bophara jwa setshwantsho (px)
photo_merge_advanced.masks = Sephetho sa tsepamiso se dirisa dimaseke tsa dillaga tse di ka baakanngwang. Tlhopha maseke mo Dillageng mme o pente go e tokafatsa.
photo_merge_advanced.no_match = Ga go tlhamalatso e e ikanyegang e e bonweng. Dirisa ditshwantsho tse di nang le dintlha tse dintsi, tse di kopanang thata, le diphetogo tse dinnye tsa pono.
photo_merge_advanced.invalid = Ditshwantsho tsa motswedi kgotsa dithulaganyo tsa go kopanya ga di a siama.
