command.edit.undo.title = Dirolola
command.edit.undo.description = Boela morago ka kgato e le nngwe mo hisetoring ya undo ya tokomane.
command.edit.redo.title = Dira Gape
command.edit.redo.description = Dira gape phetolo e e neng ya dirololwa la bofelo.
command.edit.copy.title = Kopolola
command.edit.copy.description = Kopolola dipiksele tse di tlhophilweng tsa llaga e e dirang go clipboard ya ka fa teng (llaga yotlhe fa go se na tlhopho).
