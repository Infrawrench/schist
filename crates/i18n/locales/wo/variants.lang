# Virtual copies.
variants.create = Sos koppi virtuel…
variants.rename = Soppi turu koppi virtuel…
variants.delete = Far koppi virtuel
variants.close = Tëj foto bii ak koppi virtuel yi mu am laata nga leen toxal walla far.
variants.saved_hint = Koppi bi day tàmbali ci coppite bi ñu denc, walla ci foto bu njëkk bi su amul coppite. Dencal coppite yi des njëkk.
variants.move_original = Toxal foto bu njëkk bi ngir toxal ay koppi virtuelam.
variants.protected_export = Tànnal beneen barab. Li ñuy génne ci galeri manul wuutu foto bu njëkk bi walla dencukaayu ay coppiteem.
