# Інструменти елементів документа.
tool.artboard.name = Монтажна область
tool.artboard.description = Протягніть, щоб створити монтажну область — іменовану ділянку полотна, яка експортується окремо. Перетягування всередині наявної області переміщує її.
tool.artboard.default_name = Монтажна область {n}
tool.slice.name = Фрагмент
tool.slice.description = Протягніть, щоб створити фрагмент для експорту — іменований прямокутник полотна, що експортується як окреме зображення. Перетягування всередині наявного фрагмента переміщує його.
tool.slice.default_name = Фрагмент {n}
tool.frame.name = Рамка
tool.frame.description = Протягніть, щоб створити рамку — прямокутний або еліптичний шар, який маскує все розміщене в ньому.
tool.frame.default_name = Рамка {n}
tool.frame.choice.rectangle = Прямокутник
tool.frame.choice.ellipse = Еліпс
tool.frame.history.frame = Рамка
tool.note.name = Нотатка
tool.note.description = Клацніть порожнє місце полотна, щоб закріпити там нотатку з автором і кольором зі стану редактора; клацніть наявну позначку, щоб вибрати її для панелі «Нотатки».
tool.note.history.place = Додавання нотатки
tool.note.history.move = Переміщення нотатки
tool.note.history.delete = Видалення нотатки
tool.count.name = Лічильник
tool.count.description = Клацніть, щоб додати на полотно нумеровану позначку, або клацніть наявну позначку, щоб видалити її.
tool.count.default_name = Лічильник {n}
