# Інструменти малювання.
tool.brush.name = Пензель
tool.brush.description = Малює штрих із м'якими краями кольором переднього плану, використовуючи розмір, жорсткість і непрозорість пензля редактора.
tool.brush.history.stroke = Пензель
tool.pencil.name = Олівець
tool.pencil.description = Малює штрих із жорсткими краями без згладжування кольором переднього плану.
tool.pencil.history.stroke = Олівець
tool.eraser.name = Гумка
tool.eraser.description = Стирає вздовж штриха, повертаючи шару прозорість.
tool.eraser.history.stroke = Гумка
tool.clone.name = Штамп
tool.clone.description = Штамп: клацніть з Alt, щоб задати джерело, а потім малюйте скопійованими з нього пікселями з тим самим зміщенням.
tool.clone.history.stroke = Штамп
tool.dodge.name = Освітлювач
tool.dodge.description = Освітлює пікселі вздовж штриха.
tool.dodge.history.stroke = Освітлювач
tool.burn.name = Затемнювач
tool.burn.description = Затемнює пікселі вздовж штриха.
tool.burn.history.stroke = Затемнювач
tool.sponge.name = Губка
tool.sponge.description = Збільшує або зменшує насиченість пікселів уздовж штриха.
tool.sponge.history.stroke = Губка
tool.blur.name = Розмиття
tool.blur.description = Розмиває пікселі вздовж штриха.
tool.blur.history.stroke = Розмиття
tool.sharpen.name = Різкість
tool.sharpen.description = Підвищує різкість пікселів уздовж штриха.
tool.sharpen.history.stroke = Різкість
tool.smudge.name = Палець
tool.smudge.description = Розтягує колір уздовж штриха, наче вологу фарбу.
tool.smudge.history.stroke = Палець
tool.heal.name = Пензель відновлення
tool.heal.description = Пензель відновлення: клацніть з Alt, щоб задати джерело, а потім малюйте; текстура джерела змішується з кольором і освітленням місця призначення.
tool.heal.history.stroke = Пензель відновлення
tool.spot_heal.name = Точковий пензель відновлення
tool.spot_heal.description = Зафарбуйте дефект, і його буде замінено текстурою з навколишньої ділянки — задавати джерело не потрібно.
tool.spot_heal.history.stroke = Точковий пензель відновлення
tool.history_brush.name = Архівний пензель
tool.history_brush.description = Відновлює пікселі зі знімка історії документа, скасовуючи пізніші зміни штрих за штрихом.
tool.history_brush.history.stroke = Архівний пензель
tool.background_eraser.name = Фонова гумка
tool.background_eraser.description = Стирає колір, узятий під центром пензля, і залишає відмінні пікселі, щоб відокремити об'єкт від тла.
tool.background_eraser.history.stroke = Фонова гумка
tool.gradient.name = Градієнт
tool.gradient.description = Протягніть, щоб залити шар — у межах виділення, якщо воно є — лінійним градієнтом від кольору переднього плану до кольору тла вздовж перетягування.
tool.gradient.radial.name = Радіальний градієнт
tool.gradient.radial.description = Протягніть від центра назовні, щоб створити радіальний градієнт між кольорами переднього плану й тла.
tool.gradient.option.gradient = Градієнт
tool.gradient.option.reverse = Обернути
tool.gradient.option.dither = Дизеринг
tool.gradient.choice.foreground_to_background = Від переднього плану до тла
tool.gradient.choice.foreground_to_transparent = Від переднього плану до прозорого
tool.gradient.choice.linear = Лінійний
tool.gradient.choice.radial = Радіальний
tool.gradient.choice.angle = Кутовий
tool.gradient.choice.reflected = Дзеркальний
tool.gradient.choice.diamond = Ромбоподібний
tool.gradient.history.gradient = Градієнт
tool.bucket.name = Заливка
tool.bucket.description = Клацніть, щоб залити кольором переднього плану суміжну ділянку подібного кольору під вказівником у межах допуску інструмента.
tool.bucket.option.contiguous = Суміжні
tool.bucket.option.all_layers = Усі шари
tool.bucket.history.fill = Заливка
