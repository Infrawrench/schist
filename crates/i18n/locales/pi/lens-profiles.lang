# Ālokakācalakkhaṇāni.
lens_profiles.invalid = Samatthitakamera- vā ālokakāca-datāhi saddhiṃ yuttaṃ Lensfun v1/v2 XML datāsañcayaṃ (8 MiB pariyantaṃ) uccinatha.
lens_profiles.calibration = Ālokakācassa pamāṇasodhanaṃ
lens_profiles.no_calibration = Imāsu ṭhapanāsu yuttaṃ pamāṇasodhanaṃ natthi. Fokala-dūrañca kamerāya chedanānupātañca oloketha; hatthena sodhanaṃ labbhati.
lens_profiles.import = Lensfun XML pavesetha…
lens_profiles.imported = Imasmiṃ samaye Lensfun datāsañcayo pavesito. Lakkhaṇaṃ uccinatha vā chāyācittassa metadatāhi samīkaretha.
lens_profiles.manual = Hatthena sodhanam eva
lens_profiles.saved = Rakkhitaṃ pamāṇasodhanaṃ (datāsañcayo na labbhati)
lens_profiles.profile = Ālokakācalakkhaṇaṃ
lens_profiles.aperture = Vivaraṃ (0 = aññātaṃ)
lens_profiles.distance = Fokala-dūraṃ (0 = aññātaṃ)
lens_profiles.vignette = Pamāṇasodhitaṃ pariyantandhakāraṃ
lens_profiles.color_context = Pamāṇasodhitassa pariyantandhakārassa antoṭṭhitaṃ sRGB lakkhaṇaṃ icchitabbaṃ. Rūpaṃ rakkhituṃ sRGB-aṃ parivattetha, tato Ālokakācasodhanaṃ puna vivaratha. Pubbe sRGB-rūpānaṃ acihnitānaṃ piksēlānaṃ sRGB lakkhaṇaṃ dātuṃ alaṃ. Ākāra- vaṇṇapariyanta-sodhanāni labbhanti.
lens_profiles.vignette_missing = Vivarañca fokala-dūrañca anurūpaṃ pariyantandhakārassa pamāṇasodhanaṃ natthi. Taṃ pavattetuṃ mitāni mānāni pakkhipatha; anekesu Lensfun lakkhaṇesu 1000 m dūraṭṭhaṃ fokusaṃ dīpeti.
lens_profiles.note = Pamāṇasodhitaṃ sodhanaṃ hatthena ṭhapanāhi pubbe pavattati. Sakalaṃ mūlarūpaṃ payojetha; pacchā chindatha. Sampādetabbaṃ pamāṇasodhanaṃ rakkhituṃ PSD/PSB-smiṃ filterānaṃ samūhaṃ rakkhatha.
lens_profiles.automatic = Chāyācittassa metadatāhi samīkaretha
lens_profiles.components = Lakkhaṇassa payogo: vikaṭatā {distortion}; vaṇṇapariyantā {tca}; pariyantandhakāraṃ {vignette}.
