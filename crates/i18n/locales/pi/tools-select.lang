tool.select.mode.subtract = Apanayanaṃ
tool.select.mode.intersect = Aññamaññacchedo
tool.marquee.rect.name = Dīghacaturassagahaṇaṃ
tool.marquee.rect.description = Dīghacaturassagahaṇaṃ ākaḍḍhatha. Ākaḍḍhanārambhe Shift gahaṇaṃ vaḍḍheti, alt hāpeti, ubho aññamaññacchedaṃ gaṇhanti; ākaḍḍhane Shift taṃ samacaturassaṃ karoti. Anākaḍḍhitaphusanaṃ gahaṇaṃ muñcati.
tool.marquee.ellipse.name = Aṇḍākāragahaṇaṃ
tool.marquee.ellipse.description = Aṇḍākāragahaṇaṃ ākaḍḍhatha; Shift/alt dīghacaturassagahaṇe viya saṃyojenti.
tool.lasso.name = Pāsagahaṇaṃ
tool.lasso.description = Yathāhatthaṃ paricchedaṃ ākaḍḍhatha; ākaḍḍhanaṃ niṭṭhitaṃ ce paricchedo antānaṃ antaraṃ pidahati. Shift vaḍḍheti, alt hāpeti.
tool.lasso.history.select = Pāsagahaṇaṃ
tool.lasso.polygonal.name = Bahukoṇapāsagahaṇaṃ
tool.lasso.polygonal.description = Ujupassagahaṇaṃ kātuṃ koṇaṃ anantaraṃ koṇaṃ phusatha; pidahituṃ paṭhamabindussa āsannaṃ phusatha.
tool.lasso.polygonal.history.select = Bahukoṇapāsagahaṇaṃ
tool.lasso.magnetic.name = Ākaḍḍhakapāsagahaṇaṃ
tool.lasso.magnetic.description = Pariyantaṃ anumānena anugacchatha; paricchedo maggassa āsanne balavatamaṃ ālokavirodhaṃ bandhati.
tool.lasso.magnetic.history.select = Ākaḍḍhakapāsagahaṇaṃ
tool.lasso.magnetic.option.frequency = Bāhullaṃ
tool.wand.name = Iddhimayadaṇḍo
tool.wand.description = Niddesakassa heṭṭhā sambaddhaṃ samānavaṇṇapadesaṃ, sahanasīmāvikappassa anto, phusitvā gaṇhatha; Vaḍḍhanaṃ, Samānaṃ, Vaṇṇapadeso ca imaṃ sahanasīmaṃ paṭhanti.
tool.wand.option.contiguous = Sambaddhaṃ
tool.wand.history.select = Iddhimayadaṇḍo
tool.quick_select.name = Khippagahaṇaṃ
tool.quick_select.description = Padesaṃ limpatha; tūlikāya atikkantasamānapikselesu gahaṇaṃ vaḍḍhati.
tool.quick_select.history.select = Khippagahaṇaṃ
tool.object_select.name = Vatthugahaṇaṃ
tool.object_select.description = Vatthussa samantā koṭṭhakaṃ ākaḍḍhatha; gahaṇaṃ tassa anto laddhavatthuṃ bandhati.
tool.object_select.history.select = Vatthugahaṇaṃ
