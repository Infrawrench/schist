command.edit.undo.title = Paṭilometha
command.edit.undo.description = Potthakassa paṭilomitihāse ekaṃ padaṃ pacchā gacchatha.
command.edit.redo.title = Puna karotha
command.edit.redo.description = Pacchā paṭilomitaṃ sampādanaṃ puna karotha.
command.edit.copy.title = Paṭirūpaṃ gaṇhatha
command.edit.copy.description = Kammakārakasantharassa gahitapiksele abbhantara-phalake gaṇhatha; gahaṇe asati sakalasantharaṃ.
command.edit.copy_merged.title = Saṃyuttaṃ paṭirūpaṃ gaṇhatha
command.edit.copy_merged.description = Kammakārakasantharato ekato aggahetvā, sabbe dissamānasantharā yathā missanti tathā gahaṇaṃ paṭirūpaṃ karotha.
command.edit.cut.title = Chindatha
command.edit.cut.description = Gahitapiksele phalake gahetvā kammakārakasantharato apamajjatha.
command.edit.paste.title = Laggetha
command.edit.paste.description = Phalakaṃ kammakārakasantharassa upari navasanthare, phalakamajjhe, laggetha.
command.edit.paste.layer_name = Laggitasantharo
command.edit.paste_in_place.title = Yathāṭhāne laggetha
command.edit.paste_in_place.description = Phalakaṃ yasmā ṭhānā gahitaṃ tattheva navasanthare laggetha.
command.edit.fill_foreground.title = Purimavaṇṇena pūretha
command.edit.fill_foreground.description = Gahaṇaṃ, gahaṇe asati sakalaphalakaṃ, purimavaṇṇena pūretha.
command.edit.fill_background.title = Pacchimavaṇṇena pūretha
command.edit.fill_background.description = Gahaṇaṃ, gahaṇe asati sakalaphalakaṃ, pacchimavaṇṇena pūretha.
command.select.all.title = Sabbaṃ gaṇhatha
command.select.all.description = Sakalaphalakaṃ gaṇhatha.
command.select.deselect.title = Gahaṇaṃ muñcatha
command.select.deselect.description = Gahaṇaṃ muñcatha; tato sampādanā puna sakalasanthare payujjanti.
command.select.inverse.title = Viparītagahaṇaṃ
command.select.inverse.description = Gahitapadese agahitapadese ca aññamaññaṃ parivattetha.
command.select.reselect.title = Puna gaṇhatha
command.select.reselect.description = Pacchā muttagahaṇaṃ puna āharatha.
command.select.reselect.msg.nothing_to_reselect = Puna gahetabbaṃ natthi
command.select.feather.title = Gahaṇaṃ mudumalīkarotha
command.select.feather.description = Gahaṇapariyantaṃ dvi-piksela-tikhiṇatāhāniyā mudukaṃ karotha, yena anantarasampādanaṃ tattha anukkamena hāyati.
command.select.grow.title = Vaḍḍhetha
command.select.grow.description = Iddhimayadaṇḍassa sahanasīmāya, gahitapiksele sadise phusamānapiksele gahaṇaṃ vitthāretha.
command.select.similar.title = Samānaṃ
command.select.similar.description = Iddhimayadaṇḍassa sahanasīmāya, gahaṇasadise sabbasantharapiksele gaṇhatha, phusantu vā mā vā.
command.select.save.title = Gahaṇaṃ rakkhatha
command.select.save.description = Vattamānagahaṇaṃ nāmayutta-alpha-vaṇṇamaggarūpena potthake rakkhatha.
command.select.save.channel_name = Alpha {n}
command.select.load.title = Gahaṇaṃ āharatha
command.select.load.description = Pacchā rakkhitagahaṇaṃ puna patiṭṭhāpetha.
command.layer.new.title = Nava-santharo
command.layer.new.description = Kammakārakasantharassa upari suñña-raster-santharaṃ pakkhipitvā taṃ kammakārakaṃ karotha.
command.layer.duplicate.title = Santharassa paṭirūpaṃ
command.layer.duplicate.description = Kammakārakasantharaṃ sabbantogatayuttaṃ upari navasanthare paṭirūpaṃ karotha.
command.layer.smart_object.title = Paññāvatthuṃ karotha
command.layer.smart_object.description = Kammakāraka-raster-santharassa piksele paññāvatthunā veṭhetha; pacchā parivattanā sodhakā ca anāmaṭṭhamūlaṃ puna mānenti.
command.layer.rasterize.title = Santharaṃ pikselīkarotha
command.layer.rasterize.description = Saṇṭhānaṃ, akkharāni vā paññāvatthuṃ vā pakatipikselesu pacatha.
command.layer.delete.title = Santharaṃ nāsetha
command.layer.delete.description = Gahitasanthare nāsetha.
command.layer.group.title = Santhare gaṇetha
command.layer.group.description = Gahitasanthare yathāṭhāne navagaṇena veṭhetha.
command.layer.raise.title = Purato āharatha
command.layer.raise.description = Kammakārakasantharaṃ tassa gaṇarāsimhi ekaṭṭhānaṃ upari cāletha.
command.layer.lower.title = Pacchato pesetha
command.layer.lower.description = Kammakārakasantharaṃ tassa gaṇarāsimhi ekaṭṭhānaṃ heṭṭhā cāletha.
command.layer.to_front.title = Purimatamaṃ āharatha
command.layer.to_front.description = Kammakārakasantharaṃ tassa gaṇassa uparimaṭṭhānaṃ cāletha.
command.layer.to_back.title = Pacchimatamaṃ pesetha
command.layer.to_back.description = Kammakārakasantharaṃ tassa gaṇassa heṭṭhimaṭṭhānaṃ cāletha.
command.layer.clipping_mask.title = Chedapaṭicchādakaṃ karotha/muñcatha
command.layer.clipping_mask.description = Kammakārakasantharaṃ heṭṭhāsantharena chindatha, atha vā pubbe chinno ce muñcatha; chinnasantharo mūlasanthare pikselā yattha atthi tattheva dissati.
command.layer.cut_to_new.title = Chedanena navasantharo
command.layer.cut_to_new.description = Gahitapiksele kammakārakasantharato upari navasantharaṃ cāletha.
command.layer.cut_to_new.layer_name = Chedanena santharo
command.layer.add_mask.title = Santharapaṭicchādakaṃ pakkhipatha
command.layer.add_mask.description = Kammakārakasanthare paṭicchādakaṃ pakkhipatha; gahaṇe sati gahaṇameva pakāseti.
command.layer.flatten.title = Chāyārūpaṃ ekatalīkarotha
command.layer.flatten.description = Sabbaṃ dissamānaṃ ekasmiṃ avinivijjhadassī Pacchimabhāgasanthare missetvā paṭicchannasanthare chaḍḍetha.
command.layer.merge_down.title = Heṭṭhā saṃyojetha
command.layer.merge_down.description = Kammakārakasantharaṃ heṭṭhāsanthare missetha.
command.layer.merge_down.msg.no_layer_below = Saṃyojetuṃ heṭṭhā santharo natthi
command.layer.merge_visible.title = Dissamāne saṃyojetha
command.layer.merge_visible.description = Sabbe dissamānasanthare ekaṃ karotha; paṭicchannasanthare anāmasatha.
