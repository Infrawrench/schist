tool.liquify.name = Fandefahana
tool.liquify.description = Tosika, ahodina, ahena na ampibontsina ireo piksel eo ambanin'ny borosy lehibe — ny safidy fomba no mamaritra izay atao. Miangona ao anaty harato ny fanolanana ary ampiharina amin'ny sosona rehefa ankatoavina.
