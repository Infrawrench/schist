command.edit.paste_in_place.title = Pegar a la meteissa plaça
command.edit.paste_in_place.description = Pegar lo quichapapièrs dins un calc novèl a las coordenadas d'origina de la còpia.
command.edit.fill_foreground.title = Emplenar amb lo primièr plan
command.edit.fill_foreground.description = Emplenar la seleccion (o tota la tela quand i a pas cap de seleccion) amb la color de primièr plan.
command.edit.fill_background.title = Emplenar amb lo rèireplan
command.edit.fill_background.description = Emplenar la seleccion (o tota la tela quand i a pas cap de seleccion) amb la color de rèireplan.

command.select.all.title = Seleccionar tot
command.select.all.description = Seleccionar la tela entièra.
