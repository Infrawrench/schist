command.select.save.description = Conservar la seleccion actuala dins lo document coma canal alfa nomenat.
command.select.save.channel_name = Alfa {n}
command.select.load.title = Cargar la seleccion
command.select.load.description = Restablir la seleccion enregistrada mai recentament.

