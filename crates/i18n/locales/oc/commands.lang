command.edit.undo.title = Desfar
command.edit.undo.description = Recular d'una entrada dins l'istoric d'anullacion del document.
command.edit.redo.title = Tornar far
command.edit.redo.description = Tornar far la darrièra modificacion desfacha.
command.edit.copy.title = Copiar
command.edit.copy.description = Copiar los pixèls seleccionats del calc actiu dins lo quichapapièrs intèrne (lo calc entièr quand i a pas cap de seleccion).
command.edit.copy_merged.title = Copiar la fusion
command.edit.copy_merged.description = Copiar la seleccion tala coma la compausan totes los calques visibles, puslèu que sonque lo calc actiu.
command.edit.cut.title = Talhar
command.edit.cut.description = Copiar los pixèls seleccionats dins lo quichapapièrs e los escafar del calc actiu.
command.edit.paste.title = Pegar
command.edit.paste.description = Pegar lo quichapapièrs dins un calc novèl al dessús del calc actiu, centrat sus la tela.
