lens_profiles.invalid = აირჩიეთ სწორი Lensfun v1/v2 XML მონაცემთა ბაზა (8 MiB-მდე) მხარდაჭერილი კამერის ან ლინზების მონაცემებით.
lens_profiles.calibration = ლინზების კალიბრაცია
lens_profiles.no_calibration = არანაირი კალიბრაცია არ მოიცავს ამ პარამეტრებს. შეამოწმეთ ფოკუსური მანძილი და კამერის ჩამოჭრის ფაქტორი; ხელით შესწორება რჩება ხელმისაწვდომი.
lens_profiles.import = Lensfun XML-ის იმპორტი…
lens_profiles.imported = Lensfun მონაცემთა ბაზა იმპორტირებულია ამ სესიისთვის. აირჩიეთ პროფილი ან ემთხვევა ფოტო მეტამონაცემებს.
lens_profiles.manual = მხოლოდ ხელით შესწორება
lens_profiles.saved = შენახული კალიბრაცია (მონაცემთა ბაზა მიუწვდომელია)
lens_profiles.profile = ლინზის პროფილი
lens_profiles.aperture = დიაფრაგმა (0 = უცნობი)
lens_profiles.distance = ფოკუსირების მანძილი (0 = უცნობია)
lens_profiles.vignette = კალიბრირებული ვინეტი
lens_profiles.color_context = კალიბრირებული ვინეტინგისთვის საჭიროა ჩაშენებული sRGB პროფილი. კონვერტაცია sRGB-ზე გარეგნობის შესანარჩუნებლად, შემდეგ ხელახლა გახსენით ობიექტივის კორექცია. უკვე sRGB არატეგირებული პიქსელებისთვის საკმარისია sRGB მინიჭება. გეომეტრია და ქრომატული კორექტირება რჩება ხელმისაწვდომი.
lens_profiles.vignette_missing = ვინეტინგის კალიბრაცია არ ფარავს დიაფრაგმასა და ფოკუსირების მანძილს. შეიყვანეთ გაზომილი მნიშვნელობები მის გასააქტიურებლად; 1000 მ წარმოადგენს შორეულ ფოკუსს Lensfun-ის ბევრ პროფილში.
lens_profiles.note = კალიბრირებული შესწორება სრულდება ხელით მართვამდე. გამოიყენეთ სრული საწყისი კადრი; ამის შემდეგ ჩამოჭერით. რედაქტირებადი კალიბრაციის შესანარჩუნებლად შეინახეთ ფილტრების დასტა PSD/PSB ფორმატში.
lens_profiles.automatic = ემთხვევა ფოტო მეტამონაცემებს
lens_profiles.components = პროფილის გამოყენება: დამახინჯება {distortion}; ფერადი არშიები {tca}; ვინეტირება {vignette}.
