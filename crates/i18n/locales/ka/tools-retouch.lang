# საკერებელი
tool.patch.name = საკერებელი
tool.patch.description = შემოხაზეთ დეფექტი, შემდეგ მონიშნული არე სუფთა პიქსელებზე გადაათრიეთ: იქაური ტექსტურა დეფექტს მოერგება. საკერებლის რეჟიმი განსაზღვრავს, წყვილის რომელ ბოლოს გადაათრევთ.
