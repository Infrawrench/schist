# Photographic merging. Machine-assisted translation with terminology review.
photo_merge.title = ფოტოების შერწყმა…
photo_merge.align = ავტომატური გასწორება
photo_merge.focus = ფოტოების შერწყმა სხვადასხვა ფოკუსის მანძილით
photo_merge.hdr = HDR მრავალჯერადი ექსპოზიციის დონიდან
photo_merge.panorama = ფოტოების შერწყმა პანორამაში
photo_merge.translation = გამოსახულების მხოლოდ ჰორიზონტალური და ვერტიკალური მოძრაობა (X/Y); არანაირი ბრუნვა ან პერსპექტივის კორექტირება.
photo_merge.crop = ჩამოჭრა საზიარო ზონაში
photo_merge.exposure_note = დააყენეთ თითოეული ფოტოს ფარდობითი ექსპოზიცია: +1 EV ნიშნავს ორჯერ მეტ შუქს. გამორთეთ გამოსახულების ტონის რუქა 32-ბიტიანი HDR-ის შესანარჩუნებლად.
photo_merge.tone_map = გამოსახულების ტონის რუქა
photo_merge.order = გამოიყენეთ ღია დოკუმენტის ჩანართების თანმიმდევრობა. თითოეული პანორამული ფოტო უნდა გადაფარავდეს წინა ფოტოს მინიმუმ 25%-ით.
photo_merge.invalid = აირჩიეთ 2–16 სწორი სურათი და შეამოწმეთ ექსპოზიციის პარამეტრები.
photo_merge.limit = ლიმიტი: 64 მილიონი პიქსელი სურათზე ან გამომავალზე, სულ 128 მილიონი; 30000 პიქსელი თითო მხარეს.
photo_merge.no_match = საიმედო გადახურვა ვერ მოიძებნა. გამოიყენეთ გადახურული ფოტოები ბრუნვის ან პერსპექტივის ცვლილების გარეშე.
