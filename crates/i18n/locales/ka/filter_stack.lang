# რედაქტირებადი ფილტრების დასტები.
filter_stack.title = ფილტრების დასტა
filter_stack.add = ფილტრის დამატება
filter_stack.enable = ჩართვა
filter_stack.disable = გამორთვა
filter_stack.up = ზემოთ
filter_stack.down = ქვემოთ
filter_stack.remove = მოცილება
filter_stack.bake = დასტის ჩაშენება
filter_stack.note = ეფექტები შენარჩუნებულ წყაროზე ზემოდან ქვემოთ სრულდება. რედაქტირებისთვის დააწკაპუნეთ ფილტრზე. ხატვა, გადაადგილება, გარდაქმნა ან ფერის რეჟიმის შეცვლა დასტას ჩააშენებს; გაუქმება მას აღადგენს.
filter_stack.eligibility = სიაში მხოლოდ თვითკმარი ფილტრებია. ფილტრი, რომელსაც რუკა, კონტური, ფონი ან გარე დიალოგი სჭირდება, დასტაში ვერ შეინახება.
filter_stack.unavailable = ფილტრების დასტის რედაქტირებისთვის აირჩიეთ განბლოკილი პიქსელური ფენა ან ჭკვიანი ობიექტი.
filter_stack.render_failed = ფილტრების დასტის რენდერი ვერ მოხერხდა. მისი წყარო და შენახული პარამეტრები უცვლელია.
filter_stack.edit_history = ფილტრების დასტის რედაქტირება
filter_stack.bake_history = ფილტრების დასტის ჩაშენება
filter_stack.updated = ფილტრების დასტა განახლდა
filter_stack.missing = მიუწვდომელი ფილტრი: {id}
