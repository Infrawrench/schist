photo_merge_advanced.projective = პერსპექტიული გასწორება (მოიცავს როტაციას)
photo_merge_advanced.cylindrical = ცილინდრული პანორამა
photo_merge_advanced.deghost = მოძრავი საგნის მოჩვენებების ამოღება (პირველი ფოტო მითითება)
photo_merge_advanced.focal = ფოკუსური მანძილი (px) / სურათის სიგანე (px)
photo_merge_advanced.masks = ფოკუსის გამომავალი იყენებს რედაქტირებად ფენის ნიღბებს. აირჩიეთ ნიღაბი ფენებში და დახატეთ გასაუმჯობესებლად.
photo_merge_advanced.no_match = საიმედო გასწორება ვერ მოიძებნა. გამოიყენეთ ტექსტურირებული ფოტოები მნიშვნელოვანი გადახურვით და ზომიერი ხედვის ცვლილებებით.
photo_merge_advanced.invalid = არასწორი წყაროს სურათები ან გაერთიანების პარამეტრები.
