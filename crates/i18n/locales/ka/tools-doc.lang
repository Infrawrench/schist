# დოკუმენტის დამხმარე ხელსაწყოები: სამონტაჟო არეები, ფრაგმენტები, ჩარჩოები, შენიშვნები და მთვლელები.

# სამონტაჟო არე
tool.artboard.name = სამონტაჟო არე
tool.artboard.description = შემოხაზეთ სამონტაჟო არე — ტილოს სახელდებული უბანი, რომელიც ცალკე ექსპორტირდება. არსებულ არეში გადათრევა მას გადაადგილებს.
tool.artboard.default_name = სამონტაჟო არე {n}

# ფრაგმენტი
tool.slice.name = ფრაგმენტი
tool.slice.description = შემოხაზეთ საექსპორტო ფრაგმენტი — ტილოს სახელდებული მართკუთხედი, რომელიც ცალკე გამოსახულებად ექსპორტირდება. არსებულ ფრაგმენტში გადათრევა მას გადაადგილებს.
tool.slice.default_name = ფრაგმენტი {n}

# ჩარჩო
tool.frame.name = ჩარჩო
tool.frame.description = შემოხაზეთ ჩარჩო — მართკუთხა (ან ელიფსური) ფენა, რომელიც მასში მოთავსებულ შიგთავსს ნიღბავს.
tool.frame.default_name = ჩარჩო {n}
tool.frame.choice.rectangle = მართკუთხედი
tool.frame.choice.ellipse = ელიფსი
tool.frame.history.frame = ჩარჩო

# შენიშვნა
tool.note.name = შენიშვნა
tool.note.description = ცარიელ ტილოზე დაწკაპუნებით მიამაგრეთ შენიშვნა, რომელსაც რედაქტორის მდგომარეობიდან ავტორი და ფერი მიენიჭება; არსებულ ნიშნულზე დაწკაპუნებით იგი შენიშვნების პანელში შეირჩევა.
tool.note.history.place = შენიშვნის განთავსება
tool.note.history.move = შენიშვნის გადაადგილება
tool.note.history.delete = შენიშვნის წაშლა

# მთვლელი
tool.count.name = მთვლელი
tool.count.description = დაწკაპუნებით დაამატეთ ტილოზე დანომრილი მთვლელის ნიშნულები; არსებულ ნიშნულზე დაწკაპუნება მას წაშლის.
tool.count.default_name = მთვლელი {n}
