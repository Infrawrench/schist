tool.liquify.choice.twirl_cw = Vířit doprava
tool.liquify.choice.twirl_ccw = Vířit doleva
tool.liquify.choice.pucker = Smrštit
tool.liquify.choice.bloat = Nafouknout
tool.liquify.choice.push_left = Posunout doleva
tool.liquify.history.liquify = Zkapalnění

tool.puppet_warp.name = Pokřivení loutky
tool.puppet_warp.description = Kliknutím připněte vrstvu v několika bodech a potom jeden z nich přetáhněte. Mřížka se kolem připínáčků ohne volněji či pevněji podle nastavení Tuhost. Potvrzením deformaci použijete.
tool.puppet_warp.option.stiffness = Tuhost
tool.puppet_warp.history.puppet_warp = Pokřivení loutky

tool.vanishing_point.name = Úběžný bod
tool.vanishing_point.description = Tažením vyznačte rovinu nad objektem v perspektivě, potom přepněte režim na Klonovat a malujte. Kopírované obrazové body sledují rovinu a se vzdáleností se zmenšují.
