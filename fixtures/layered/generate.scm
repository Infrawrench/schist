(let* ((img (car (gimp-image-new 67 65 RGB)))
       (bottom (car (gimp-layer-new img 67 65 RGBA-IMAGE "Red background" 100 NORMAL-MODE)))
       (top (car (gimp-layer-new img 3 2 RGBA-IMAGE "Blue offset" 50 MULTIPLY-MODE))))
  (gimp-image-insert-layer img bottom 0 0)
  (gimp-context-set-foreground '(255 0 0))
  (gimp-drawable-fill bottom FOREGROUND-FILL)
  (gimp-image-insert-layer img top 0 0)
  (gimp-context-set-foreground '(0 0 255))
  (gimp-drawable-fill top FOREGROUND-FILL)
  (gimp-layer-set-offsets top -1 1)
  (gimp-xcf-save RUN-NONINTERACTIVE img top "fixtures/layered/gimp-rle.xcf" "fixtures/layered/gimp-rle.xcf")
  (let* ((group (car (gimp-layer-group-new img)))
         (mask (car (gimp-layer-create-mask top ADD-WHITE-MASK))))
    (gimp-item-set-name group "Group")
    (gimp-image-insert-layer img group 0 0)
    (gimp-image-reorder-item img top group 0)
    (gimp-layer-add-mask top mask)
    (gimp-context-set-foreground '(128 128 128))
    (gimp-drawable-fill mask FOREGROUND-FILL)
    (gimp-layer-set-apply-mask top FALSE)
    (gimp-image-convert-precision img PRECISION-U16-GAMMA)
    (gimp-xcf-save RUN-NONINTERACTIVE img top "fixtures/layered/gimp-group-16.xcf" "fixtures/layered/gimp-group-16.xcf"))
  (gimp-image-delete img))
